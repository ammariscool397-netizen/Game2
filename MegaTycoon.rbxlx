	end)
	charCommand("freeze", {}, 1, "Freeze players in place", true, function(_, _, _, root)
		root.Anchored = true
	end)
	charCommand("thaw", { "unfreeze" }, 1, "Unfreeze players", false, function(_, _, _, root)
