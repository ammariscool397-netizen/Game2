	"The Nuke Shield Dome (floor 2) protects your tower from disasters.",
	"There are 12 secrets hidden around the map. Each one boosts your income!",
	"Upgraders multiply the value of every drop on their floor.",
	"Rebirth to reset your tower and earn a permanent cash multiplier.",
	"Minigames start every few minutes - join them for big rewards!",
	"You earn cash while offline. Come back to collect it!",
	"Codes can be redeemed in the Codes menu. Try RELEASE!",
	"Finish quests (bottom right) for big rewards - a new one appears every time you claim!",
	"Stay in the server: playtime gifts open during your first hour.",
	"Follow the glowing beam - it points to the next upgrade you can afford.",
	"Playing with friends? Every friend in the server gives +10% income!",
	"Every 45 minutes there's a 2x CASH HOUR for everyone.",
	"Earthquakes dig up cash geodes - grab them before they vanish!",
}

-- the highest rebirth rank reached with `rebirths` rebirths: index, rank (nil before the first)
function Config.RebirthRank(rebirths: number): (number?, any?)
	local index
	for i, rank in Config.Rebirth.Ranks do
		if rebirths >= rank.Rebirths then
			index = i
		end
	end
	return index, index and Config.Rebirth.Ranks[index]
end

-- total of one perk kind over every rank earned with `rebirths` rebirths
function Config.RebirthPerk(rebirths: number, kind: string): number
	local total = 0
	for _, rank in Config.Rebirth.Ranks do
		if rebirths >= rank.Rebirths then
			total += rank.Perks[kind] or 0
		end
	end
	return total
end

Config.PetById = {}
for _, pet in Config.Pets.List do
	Config.PetById[pet.Id] = pet
end

-- the income bonus (+x) of one pet type
function Config.PetBonus(petId: string): number
	local pet = Config.PetById[petId]
	return pet and Config.Pets.Rarities[pet.Rarity].Bonus or 0
end

-- how many pets can be equipped with `rebirths` rebirths
function Config.PetSlots(rebirths: number): number
	local slots = Config.Pets.MaxEquipped
	for _, needed in Config.Pets.SlotRebirths do
		if rebirths >= needed then
			slots += 1
		end
	end
	return slots
end

-- the total income bonus (+x) of a player's equipped pets (`pets` = the saved pet data)
function Config.PetsBonus(pets: any): number
	if type(pets) ~= "table" or type(pets.Owned) ~= "table" or type(pets.Equipped) ~= "table" then
		return 0
	end
	local byUid = {}
	for _, pet in pets.Owned do
		byUid[pet.Uid] = pet
	end
	local total = 0
	for _, uid in pets.Equipped do
		local pet = byUid[uid]
		if pet then
			total += Config.PetBonus(pet.Id)
		end
	end
	return total
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	All networking goes through these remotes. The server creates them,
	the client waits for them. Usage: Remotes.Notify:FireClient(...)
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify", -- server -> client  { Text, Type, Duration }
	"Announce", -- server -> all    { Title, Text, Color }
	"VFX", -- server -> client  (effectName, params)
	"Music", -- server -> client  (action, params)
	"ClientCommand", -- server -> client  (command, ...) fly/noclip/fling/launch/abduct/openfloors...
	"MinigameState", -- server -> client  state table
	"MinigameJoin", -- client -> server
	"RequestRebirth", -- client -> server
	"BuyPass", -- client -> server  (passKey)
	"BuyProduct", -- client -> server  (productKey)
	"GoHome", -- client -> server
	"SaveSettings", -- client -> server  (settings)
	"TycoonUpdate", -- server -> client  { Type = "Bought"|"Reset"|"Disabled"|"Repaired"|"Secret", ... }
	"BuyAll", -- client -> server
	"TeleportFloor", -- client -> server  (plotIndex, floor)
	"Disaster", -- server -> client  disaster state
	"DuoInvite", -- client -> server  (targetUserId)
	"DuoRespond", -- client -> server  (hostUserId, accept)
	"DuoLeave", -- client -> server  (kick partner if host / leave if partner)
	"DuoInvited", -- server -> client  { HostName, HostUserId, Timeout }
	"QuestUpdate", -- server -> client  (quests, claimedCount)
	"GiftUpdate", -- server -> client  { Index, ReadyIn, Total }
	"WeeklyUpdate", -- server -> client  { Days, DayFlags, Claimed, ResetsIn }
	"PetUpdate", -- server -> client  { Owned, Equipped, Slots, Eggs }
}

local FUNCTIONS = {
	"RedeemCode", -- (code) -> ok, message
	"ClaimDaily", -- () -> ok, message
	"AdminCommand", -- (text) -> ok, message
	"AdminData", -- (what) -> data
	"BuyItem", -- (itemId) -> ok, message
	"GetTycoonState", -- () -> state
	"ClaimQuest", -- (quest type or slot) -> ok, message
	"ClaimGift", -- () -> ok, message
	"SpinWheel", -- () -> ok, segment index (0 if none), message
	"ActivateShield", -- () -> ok, message
	"Travel", -- (island id or "Plaza") -> ok, message
	"ClaimWeekly", -- (milestone index) -> ok, message
	"PetAction", -- (action, arg) -> ok, message   (Hatch eggId | Equip uid | Unequip uid | Sell uid | EquipBest | Refresh)
}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing :: Folder
	else
		local created = Instance.new("Folder")
		created.Name = "Remotes"
		for _, name in EVENTS do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = created
		end
		for _, name in FUNCTIONS do
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = created
		end
		created.Parent = ReplicatedStorage
		folder = created
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

local Remotes = {}
setmetatable(Remotes, {
	__index = function(_, name)
		local remote = folder:WaitForChild(name, 15)
		if not remote then
			error("Remote not found: " .. tostring(name))
		end
		rawset(Remotes, name, remote)
		return remote
	end,
})

return Remotes :: any
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[ Minimal signal class used for server-side events between services ]]
local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> () }

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local handler = { fn = fn, connected = true }
	table.insert(self._handlers, handler)
	local signal = self
	return {
		Disconnect = function()
			handler.connected = false
			local index = table.find(signal._handlers, handler)
			if index then
				table.remove(signal._handlers, index)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, handler in table.clone(self._handlers) do
		if handler.connected then
			task.spawn(handler.fn, ...)
		end
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">TycoonItems</string>
          <string name="Source"><![CDATA[--[[
	TycoonItems - generates every buyable item of the 8-floor tower
	(8 floors x 62 upgrades + 6 rooftop items + 12 secret relics = 514).

	Costs and values are CALIBRATED automatically: walking the items in their
	natural order, each item costs "N seconds of the income you would have at
	that point" (Config.Tycoon.PaceStartSeconds -> PaceEndSeconds), and each
	dropper / generator adds a fixed share of income. Change the pace in
	Config and every price rescales consistently.

	Positions are in FLOOR-LOCAL space: X = left/right (-42..42),
	Z = front/back (-42 is the front, facing the lobby), Y = up from the floor.
	Secret relics use PLOT-LOCAL space (front yard).

	Kinds: Unlock, Dropper, Mk2, Upgrader, Generator, Conveyor, Boost, Decor,
	       Wall, Special, Trophy, Roof, Secret
]]

local Config = require(script.Parent.Config)

local TC = Config.Tycoon
local FLOORS = TC.Floors
local OVERLAP = 40 -- a new floor unlocks around item 40 of the previous floor

local Items = {}

---------------------------------------------------------------------------
-- Themes (one per floor)
---------------------------------------------------------------------------
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Items.Themes = {
	{
		Name = "Starter Factory", Adj = "Factory",
		Primary = rgb(150, 155, 165), Secondary = rgb(70, 75, 85), Accent = rgb(255, 140, 0),
		Floor = Enum.Material.DiamondPlate, Wall = Enum.Material.Brick, Drop = Enum.Material.Metal, Hue = 0.08,
		Droppers = { "Scrap", "Bolt", "Gear", "Pipe", "Steel", "Copper", "Brass", "Chrome", "Titanium", "Turbo" },
		Generators = { "Coin Press", "Bill Printer", "Steam Engine", "Cash Furnace", "Gear Spinner", "Money Compressor", "Smelter", "Mega Press" },
		Special = "Panic Bunker", SpecialKind = "Bunker",
	},
	{
		Name = "Gold Mine", Adj = "Golden",
		Primary = rgb(200, 160, 60), Secondary = rgb(110, 80, 45), Accent = rgb(255, 215, 0),
		Floor = Enum.Material.Slate, Wall = Enum.Material.Rock, Drop = Enum.Material.Foil, Hue = 0.13,
		Droppers = { "Pebble", "Nugget", "Ore", "Gold Bar", "Gold Coin", "Gold Brick", "Treasure", "Royal", "Midas", "Golden Idol" },
		Generators = { "Mine Cart", "Drill Rig", "Gold Sifter", "Ore Crusher", "Pickaxe Bot", "Gold Smelter", "Dynamite Crate", "Golden Drill" },
		Special = "Nuke Shield Dome", SpecialKind = "Shield",
	},
	{
		Name = "Jungle Greenhouse", Adj = "Jungle",
		Primary = rgb(70, 170, 80), Secondary = rgb(90, 65, 40), Accent = rgb(170, 255, 90),
		Floor = Enum.Material.Grass, Wall = Enum.Material.Wood, Drop = Enum.Material.Grass, Hue = 0.3,
		Droppers = { "Seed", "Sprout", "Leaf", "Vine", "Bamboo", "Coconut", "Mango", "Orchid", "Venus Trap", "Ancient Tree" },
		Generators = { "Money Tree", "Cash Flower", "Sprinkler", "Compost Bin", "Bee Hive", "Mushroom Farm", "Water Wheel", "Jungle Totem" },
		Special = "Money Fountain", SpecialKind = "Bonus",
	},
	{
		Name = "Crystal Lab", Adj = "Crystal",
		Primary = rgb(120, 200, 230), Secondary = rgb(60, 50, 110), Accent = rgb(190, 90, 255),
		Floor = Enum.Material.Marble, Wall = Enum.Material.Glass, Drop = Enum.Material.Glass, Hue = 0.55,
		Droppers = { "Quartz", "Amethyst", "Topaz", "Sapphire", "Emerald", "Ruby", "Opal", "Diamond", "Prism", "Void Crystal" },
		Generators = { "Growth Tank", "Laser Cutter", "Plasma Coil", "Particle Mixer", "Tesla Tower", "Quantum PC", "Hologram Core", "Crystal Reactor" },
		Special = "Diamond Vault", SpecialKind = "Bonus",
	},
	{
		Name = "Volcano Forge", Adj = "Molten",
		Primary = rgb(200, 70, 40), Secondary = rgb(50, 40, 40), Accent = rgb(255, 120, 0),
		Floor = Enum.Material.Basalt, Wall = Enum.Material.CrackedLava, Drop = Enum.Material.CrackedLava, Hue = 0.03,
		Droppers = { "Ember", "Magma", "Obsidian", "Lava", "Fire Opal", "Inferno", "Phoenix", "Dragonstone", "Hellfire", "Volcano Core" },
		Generators = { "Lava Pump", "Forge Anvil", "Fire Pit", "Magma Turbine", "Dragon Furnace", "Obsidian Press", "Fire Elemental", "Volcano Vent" },
		Special = "Lava Reactor", SpecialKind = "Bonus",
	},
	{
		Name = "Ice Palace", Adj = "Frozen",
		Primary = rgb(200, 235, 255), Secondary = rgb(120, 170, 220), Accent = rgb(0, 220, 255),
		Floor = Enum.Material.Ice, Wall = Enum.Material.Glacier, Drop = Enum.Material.Ice, Hue = 0.52,
		Droppers = { "Snowflake", "Icicle", "Frost", "Glacier", "Aurora", "Blizzard", "Frozen Gem", "Ice Crown", "Polar Star", "Absolute Zero" },
		Generators = { "Snow Machine", "Ice Sculptor", "Frost Generator", "Penguin Bank", "Aurora Projector", "Glacier Drill", "Yeti Treadmill", "Ice Throne" },
		Special = "Ice Dragon Statue", SpecialKind = "Bonus",
	},
	{
		Name = "Cyber City", Adj = "Neon",
		Primary = rgb(40, 40, 60), Secondary = rgb(20, 20, 30), Accent = rgb(255, 0, 200),
		Floor = Enum.Material.SmoothPlastic, Wall = Enum.Material.Metal, Drop = Enum.Material.Neon, Hue = 0.85,
		Droppers = { "Byte", "Pixel", "Circuit", "Chip", "Neon", "Hologram", "Cyber", "Quantum", "Mainframe", "AI Core" },
		Generators = { "Server Rack", "Crypto Miner", "Arcade Cabinet", "Neon Billboard", "Drone Dock", "Data Center", "Robot Arm", "Supercomputer" },
		Special = "Hologram Tower", SpecialKind = "Bonus",
	},
	{
		Name = "Galaxy Penthouse", Adj = "Cosmic",
		Primary = rgb(60, 30, 100), Secondary = rgb(15, 10, 30), Accent = rgb(140, 120, 255),
		Floor = Enum.Material.Glass, Wall = Enum.Material.Glass, Drop = Enum.Material.Neon, Hue = 0.72,
		Droppers = { "Stardust", "Comet", "Meteorite", "Moon Rock", "Planet", "Nebula", "Supernova", "Black Hole", "Galaxy", "Universe" },
		Generators = { "Star Forge", "Rocket Pad", "Alien Reactor", "Wormhole", "Satellite", "Space Bank", "Gravity Well", "Big Bang Machine" },
		Special = "Galaxy Portal", SpecialKind = "Bonus",
	},
}

Items.DecorNames = {
	"Crate Stack", "Barrel", "Lamp", "Potted Plant", "Bench", "Table", "Rug", "Shelf", "Statue",
	"Banner", "TV Screen", "Mini Fountain", "Crystal", "Money Pile", "Light Pillar", "Couch", "Vending Machine",
}
Items.WallNames = { "Left Wall", "Right Wall", "Back Wall", "Front Windows", "Corner Pillars", "Neon Trim" }
Items.WallSides = { "Left", "Right", "Back", "Front", "Pillars", "Trim" }
Items.UpgraderNames = { "Polisher", "Refiner", "Enchanter", "Supercharger" }
Items.UpgraderMult = { 1.2, 1.35, 1.5, 1.75 }
Items.BoostNames = { "Power Booster", "Mega Booster", "Ultra Booster" }
Items.BoostMult = { 1.25, 1.5, 2 }
Items.ConveyorNames = { "Fast Conveyor", "Turbo Conveyor" }

Items.DecorBonus = 0.02 -- +2% floor income each
Items.WallBonus = 0.01 -- +1% floor income each
Items.ConveyorBonus = 0.15 -- +15% floor drop income each
Items.SpecialBonus = 0.08 -- +8% total income (specials & trophies)
Items.RoofBonus = 0.10
Items.SecretBonus = (Config.SecretRewards.BonusPercent or 5) / 100

-- Floor-local layout
Items.DropperX = {}
for k = 1, 10 do
	Items.DropperX[k] = -35 + (k - 1) * 5.6
end
Items.UpgraderX = { 20, 24.5, 29, 33.5 }
Items.BeltZ = 8
Items.BeltStartX = -38
Items.BeltEndX = 35
Items.GeneratorPos = {}
for k = 1, 8 do
	Items.GeneratorPos[k] = Vector3.new(-35 + (k - 1) * 10, 0, 30)
end
Items.DecorPos = {
	Vector3.new(-24, 0, -38), Vector3.new(-14, 0, -38), Vector3.new(14, 0, -38), Vector3.new(24, 0, -38),
	Vector3.new(-34, 0, -6), Vector3.new(-24, 0, -6), Vector3.new(-14, 0, -6), Vector3.new(0, 0, -6), Vector3.new(14, 0, -6), Vector3.new(24, 0, -6),
	Vector3.new(-36, 0, 20), Vector3.new(-24, 0, 20), Vector3.new(-12, 0, 20), Vector3.new(0, 0, 20), Vector3.new(12, 0, 20), Vector3.new(24, 0, 20), Vector3.new(36, 0, 20),
}
Items.BoostPos = { Vector3.new(-20, 15, 39.4), Vector3.new(0, 15, 39.4), Vector3.new(20, 15, 39.4) }
Items.SpecialPos = Vector3.new(35.5, 0, -37)
Items.TrophyPos = Vector3.new(0, 13, 36)
Items.ElevatorPos = Vector3.new(-37, 0, -37)
Items.VaultPadPos = Vector3.new(37, 0, -4)
Items.CollectorPos = Vector3.new(37, 0, Items.BeltZ)
Items.ButtonSlots = {}
for row = 0, 1 do
	for col = 0, 5 do
		table.insert(Items.ButtonSlots, Vector3.new(-27 + col * 10.8, 0, -20 - row * 10))
	end
end
Items.RoofPos = {
	Vector3.new(0, 0, 0), -- helipad
	Vector3.new(-30, 0, 30), -- antenna
	Vector3.new(25, 0, 25), -- pool
	Vector3.new(0, 0, -36), -- billboard
	Vector3.new(-30, 0, -24), -- fireworks
	Vector3.new(28, 0, -20), -- crown
}
Items.RoofNames = { "Rooftop Helipad", "Giant Antenna", "Rooftop Pool", "Mega Billboard", "Fireworks Launcher", "Golden Crown" }
Items.RoofModels = { "Helipad", "Antenna", "Pool", "Billboard", "Fireworks", "Crown" }
-- secret relics sit in the front yard of the plot (plot-local)
Items.SecretPos = {}
for i, x in { -10, 10, -18, 18, -26, 26, -34, 34, -42, 42, -50, 50 } do
	Items.SecretPos[i] = Vector3.new(x, 0, -47)
end

---------------------------------------------------------------------------
-- Per-floor sequence (62 items)
---------------------------------------------------------------------------
local SEQ = {
	"Unlock", "D1", "W1", "D2", "Decor", "D3", "G1", "U1", "D4", "Decor",
	"M1", "D5", "G2", "Decor", "M2", "W2", "D6", "U2", "G3", "Decor",
	"M3", "D7", "C1", "Decor", "G4", "M4", "D8", "B1", "Decor", "W3",
	"M5", "G5", "D9", "U3", "Decor", "M6", "Special", "Decor", "G6", "D10",
	"M7", "Decor", "W4", "B2", "G7", "Decor", "M8", "C2", "Decor", "U4",
	"G8", "M9", "Decor", "W5", "Decor", "M10", "B3", "Decor", "W6", "Decor",
	"Decor", "Trophy",
}
Items.Sequence = SEQ
Items.PerFloor = #SEQ

local List = {}
local ById = {}

local function add(item)
	table.insert(List, item)
	ById[item.Id] = item
	return item
end

for F = 1, FLOORS do
	local theme = Items.Themes[(F - 1) % #Items.Themes + 1]
	local decorCount = 0
	local ids = {}
	for i, code in SEQ do
		local id = "F" .. F .. "_" .. i
		ids[i] = id
		local item: any = { Id = id, Floor = F, Index = i, Pos = (F - 1) * OVERLAP + i, Theme = theme }
		local letter, number = code:match("^(%a)(%d+)$")
		number = tonumber(number)
		if code == "Unlock" then
			item.Kind = "Unlock"
			item.Name = F == 1 and "Starter Base" or ("Floor " .. F .. ": " .. theme.Name)
		elseif code == "Decor" then
			decorCount += 1
			item.Kind = "Decor"
			item.Slot = decorCount
			item.Model = decorCount
			item.Name = theme.Adj .. " " .. Items.DecorNames[decorCount]
			item.LocalPos = Items.DecorPos[decorCount]
		elseif code == "Special" then
			item.Kind = "Special"
			item.Effect = theme.SpecialKind
			item.Name = theme.Special
			item.LocalPos = Items.SpecialPos
		elseif code == "Trophy" then
			item.Kind = "Trophy"
			item.Name = "Floor " .. F .. " Trophy"
			item.LocalPos = Items.TrophyPos
		elseif letter == "D" then
			item.Kind = "Dropper"
			item.Slot = number
			item.Tier = number
			item.Name = theme.Droppers[number] .. " Dropper"
			item.LocalPos = Vector3.new(Items.DropperX[number], 0, Items.BeltZ)
			item.Interval = TC.DropInterval
		elseif letter == "M" then
			item.Kind = "Mk2"
			item.Slot = number
			item.Name = theme.Droppers[number] .. " Dropper Mk II"
			item.LocalPos = Vector3.new(Items.DropperX[number], 0, Items.BeltZ)
			item.Multiplier = 2
		elseif letter == "U" then
			item.Kind = "Upgrader"
			item.Slot = number
			item.Multiplier = Items.UpgraderMult[number]
			item.Name = theme.Adj .. " " .. Items.UpgraderNames[number] .. " (x" .. Items.UpgraderMult[number] .. ")"
			item.LocalPos = Vector3.new(Items.UpgraderX[number], 0, Items.BeltZ)
		elseif letter == "G" then
			item.Kind = "Generator"
			item.Slot = number
			item.Name = theme.Generators[number]
			item.LocalPos = Items.GeneratorPos[number]
			item.Cycle = TC.GeneratorCycle
		elseif letter == "C" then
			item.Kind = "Conveyor"
			item.Slot = number
			item.Name = Items.ConveyorNames[number]
		elseif letter == "B" then
			item.Kind = "Boost"
			item.Slot = number
			item.Multiplier = Items.BoostMult[number]
			item.Name = Items.BoostNames[number] .. " (x" .. Items.BoostMult[number] .. ")"
			item.LocalPos = Items.BoostPos[number]
		elseif letter == "W" then
			item.Kind = "Wall"
			item.Slot = number
			item.Side = Items.WallSides[number]
			item.Name = theme.Adj .. " " .. Items.WallNames[number]
		end
		-- requirements: the item 3 steps earlier on this floor (so ~3 buttons show at a time)
		local requires = {}
		if i >= 2 then
			table.insert(requires, ids[math.max(1, i - 3)])
		elseif F > 1 then
			table.insert(requires, "F" .. (F - 1) .. "_40") -- previous floor's 10th dropper
		end
		item.Requires = requires
		add(item)
	end
	-- Mk II upgrades require their dropper
	for i, code in SEQ do
		local n = code:match("^M(%d+)$")
		if n then
			local dropperIndex = table.find(SEQ, "D" .. n)
			local item = ById[ids[i]]
			item.Dropper = ids[dropperIndex]
			table.insert(item.Requires, ids[dropperIndex])
		end
	end
end

-- rooftop items (need floor 8)
for k = 1, #Items.RoofNames do
	add({
		Id = "Roof_" .. k,
		Floor = FLOORS + 1,
		Index = k,
		Pos = FLOORS * OVERLAP + 62 + k,
		Kind = "Roof",
		Model = Items.RoofModels[k],
		Name = Items.RoofNames[k],
		LocalPos = Items.RoofPos[k],
		Requires = { k == 1 and ("F" .. FLOORS .. "_1") or ("Roof_" .. (k - 1)) },
		Theme = Items.Themes[FLOORS],
	})
end

-- secret relics (free, unlocked by finding secrets, survive rebirths)
for i, secret in Config.Secrets do
	add({
		Id = "Secret_" .. secret.Id,
		Floor = 0,
		Index = i,
		Pos = math.huge,
		Kind = "Secret",
		SecretId = secret.Id,
		Name = secret.Name .. " Relic",
		Color = secret.Color,
		LocalPos = Items.SecretPos[i],
		Requires = {},
		Cost = 0,
	})
end

---------------------------------------------------------------------------
-- Calibration (see header). Walk items in natural order.
---------------------------------------------------------------------------
local function nice(x: number): number
	if x < 100 then
		return math.max(1, math.floor(x + 0.5))
	end
	local p = 10 ^ (math.floor(math.log10(x)) - 1)
	return math.floor(x / p + 0.5) * p
end

do
	local order = {}
	for _, item in List do
		if item.Kind ~= "Secret" then
			table.insert(order, item)
		end
	end
	table.sort(order, function(a, b)
		if a.Pos ~= b.Pos then
			return a.Pos < b.Pos
		end
		return a.Floor < b.Floor
	end)

	local N = #order
	local floors = {}
	for F = 1, FLOORS + 1 do
		floors[F] = { dr = 0, gr = 0, um = 1, bm = 1, dec = 0, wall = 0, conv = 0, drops = {} }
	end
	local bonus = 0
	local function floorIncome(f)
		return (f.dr * f.um * (1 + Items.ConveyorBonus * f.conv) + f.gr) * f.bm * (1 + Items.DecorBonus * f.dec + Items.WallBonus * f.wall)
	end
	local function total()
		local sum = 0
		for _, f in floors do
			sum += floorIncome(f)
		end
		return sum * (1 + bonus)
	end
	local BASE = 4
	local lastCost = 0
	for n, item in order do
		local income = math.max(total(), BASE)
		local x = (n - 1) / N
		local T = TC.PaceStartSeconds + (TC.PaceEndSeconds - TC.PaceStartSeconds) * x ^ 1.2
		local cost
		if item.Floor == 1 and item.Kind == "Unlock" then
			cost = 0
		elseif item.Floor == 1 and item.Index == 2 then
			cost = 25
		else
			cost = nice(math.max(income * T, lastCost * 1.04))
		end
		if cost > 0 then
			lastCost = cost
		end
		item.Cost = cost

		local f = floors[item.Floor]
		local mult = f.um * (1 + Items.ConveyorBonus * f.conv) * f.bm * (1 + Items.DecorBonus * f.dec + Items.WallBonus * f.wall) * (1 + bonus)
		local kind = item.Kind
		if kind == "Dropper" then
			local rate = (item.Floor == 1 and item.Slot == 1) and 3 or income * 0.15 / mult
			local value = nice(rate * item.Interval)
			item.Value = value -- cash per drop (before multipliers)
			rate = value / item.Interval
			f.dr += rate
			f.drops[item.Slot] = rate
		elseif kind == "Mk2" then
			f.dr += f.drops[item.Slot] or 0
		elseif kind == "Generator" then
			local gmult = f.bm * (1 + Items.DecorBonus * f.dec + Items.WallBonus * f.wall) * (1 + bonus)
			local rate = income * 0.06 / gmult
			local value = nice(rate * item.Cycle)
			item.Value = value -- cash per cycle (before multipliers)
			f.gr += value / item.Cycle
		elseif kind == "Upgrader" then
			f.um *= item.Multiplier
		elseif kind == "Boost" then
			f.bm *= item.Multiplier
		elseif kind == "Decor" then
			f.dec += 1
		elseif kind == "Wall" then
			f.wall += 1
		elseif kind == "Conveyor" then
			f.conv += 1
		elseif kind == "Special" or kind == "Trophy" then
			item.Bonus = Items.SpecialBonus
			bonus += Items.SpecialBonus
		elseif kind == "Roof" then
			item.Bonus = Items.RoofBonus
			bonus += Items.RoofBonus
		end
	end
end

for _, item in List do
	if item.Kind == "Secret" then
		item.Bonus = Items.SecretBonus
	end
end

-- where an item's physical button lives (floor unlocks are bought one floor down)
for _, item in List do
	if item.Kind == "Unlock" then
		item.ButtonFloor = math.max(1, item.Floor - 1)
	elseif item.Kind == "Roof" then
		item.ButtonFloor = FLOORS
	elseif item.Kind == "Secret" then
		item.ButtonFloor = nil
	else
		item.ButtonFloor = item.Floor
	end
end

Items.List = List
Items.ById = ById
Items.Count = #List
Items.BuyableCount = 0
for _, item in List do
	if item.Kind ~= "Secret" then
		Items.BuyableCount += 1
	end
end

-- items per floor (in order), floor 0 = secrets, FLOORS+1 = roof
Items.ByFloor = {}
for _, item in List do
	Items.ByFloor[item.Floor] = Items.ByFloor[item.Floor] or {}
	table.insert(Items.ByFloor[item.Floor], item)
end

function Items.FloorUnlockId(floor: number): string
	return "F" .. floor .. "_1"
end

function Items.GetRebirthCost(rebirths: number): number
	local base = ById[Items.FloorUnlockId(math.clamp(Config.Rebirth.RequiredFloor, 2, FLOORS))].Cost
	return nice(base * (Config.Rebirth.CostGrowth ^ rebirths))
end

--[[
	Income of a tower (shared by server + client so the numbers always match).
	purchased: { [itemId] = true }, disabled: { [itemId] = true } (wrecked items),
	secrets: { [secretId] = true }, fast: Fast Droppers pass.
	Returns (incomePerSecond, worth) where worth[itemId] = cash per drop for
	droppers / per cycle for generators. Global multipliers (rebirths,
	passes, boosts, events) are NOT included.
]]
function Items.ComputeIncome(purchased: { [string]: boolean }, disabled: { [string]: boolean }?, secrets: { [string]: boolean }?, fast: boolean?)
	disabled = disabled or {}
	secrets = secrets or {}
	local floors = {}
	for F = 0, FLOORS + 1 do
		floors[F] = { dr = 0, gr = 0, um = 1, bm = 1, dec = 0, wall = 0, conv = 0, mk2 = {} }
	end
	local bonus = 0
	local function active(item)
		return purchased[item.Id] and not (disabled :: any)[item.Id]
	end
	for _, item in List do
		local kind = item.Kind
		if kind == "Secret" then
			if (secrets :: any)[item.SecretId] then
				bonus += item.Bonus
			end
		elseif active(item) then
			local f = floors[item.Floor]
			if kind == "Upgrader" then
				f.um *= item.Multiplier
			elseif kind == "Boost" then
				f.bm *= item.Multiplier
			elseif kind == "Decor" then
				f.dec += 1
			elseif kind == "Wall" then
				f.wall += 1
			elseif kind == "Conveyor" then
				f.conv += 1
			elseif kind == "Mk2" then
				f.mk2[item.Slot] = true
			elseif item.Bonus then
				bonus += item.Bonus
			end
		end
	end
	local worth = {}
	local total = 0
	local bonusMult = 1 + bonus
	for F = 0, FLOORS + 1 do
		local f = floors[F]
		local extras = f.bm * (1 + Items.DecorBonus * f.dec + Items.WallBonus * f.wall) * bonusMult
		local dropMult = f.um * (1 + Items.ConveyorBonus * f.conv) * extras
		local items = Items.ByFloor and Items.ByFloor[F]
		if items then
			for _, item in items do
				if active(item) then
					if item.Kind == "Dropper" then
						local mk = f.mk2[item.Slot] and 2 or 1
						local perDrop = item.Value * mk * dropMult
						worth[item.Id] = perDrop
						total += perDrop / item.Interval * (fast and 2 or 1)
					elseif item.Kind == "Generator" then
						local perCycle = item.Value * extras
						worth[item.Id] = perCycle
						total += perCycle / item.Cycle
					end
				end
			end
		end
	end
	return total, worth
end

function Items.IsAvailable(item, purchased: { [string]: boolean }): boolean
	if purchased[item.Id] or item.Kind == "Secret" then
		return false
	end
	for _, req in item.Requires do
		if not purchased[req] then
			return false
		end
	end
	return true
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--[[
	UIKit - tiny helper library for building good-looking UI from code.
	Client only.
]]
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Config = require(script.Parent.Config)

local UIKit = {}

UIKit.Theme = {
	Background = Color3.fromRGB(22, 24, 36),
	Panel = Color3.fromRGB(32, 35, 52),
	PanelLight = Color3.fromRGB(46, 50, 74),
	Accent = Color3.fromRGB(255, 196, 0),
	Accent2 = Color3.fromRGB(0, 200, 255),
	Green = Color3.fromRGB(60, 210, 100),
	Red = Color3.fromRGB(235, 70, 70),
	Purple = Color3.fromRGB(150, 80, 255),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(180, 185, 210),
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamBold,
}

local soundCache: { [string]: Sound } = {}

function UIKit.PlaySound(name: string, volume: number?, pitch: number?)
	local id = Config.Sounds[name] or name
	if not id or id == "" then
		return
	end
	local key = id .. tostring(pitch or 1)
	local sound = soundCache[key]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = volume or 0.5
		sound.PlaybackSpeed = pitch or 1
		sound.Parent = SoundService
		soundCache[key] = sound
	end
	if UIKit.SFXEnabled == false then
		return
	end
	sound.Volume = volume or 0.5
	SoundService:PlayLocalSound(sound)
end

UIKit.SFXEnabled = true

function UIKit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.Corner(parent: Instance, radius: number?)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function UIKit.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	return UIKit.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIKit.TextStroke(parent: Instance, thickness: number?)
	return UIKit.new("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = parent,
	})
end

function UIKit.Gradient(parent: Instance, a: Color3, b: Color3, rotation: number?)
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.Padding(parent: Instance, px: number)
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function UIKit.List(parent: Instance, padding: number?, direction: Enum.FillDirection?, align: Enum.HorizontalAlignment?)
	return UIKit.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = direction or Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function UIKit.Label(props: { [string]: any })
	local label = UIKit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = UIKit.Theme.Font,
		TextColor3 = UIKit.Theme.Text,
		TextScaled = true,
		Text = "",
	})
	for k, v in props do
		if k ~= "Parent" and k ~= "Stroke" then
			label[k] = v
		end
	end
	if props.Stroke ~= false then
		UIKit.TextStroke(label, 1.5)
	end
	label.Parent = props.Parent
	return label
end

-- A chunky "game style" button with hover + press animation and click sound
function UIKit.Button(props: { [string]: any })
	local color: Color3 = props.Color or UIKit.Theme.Accent
	local button = UIKit.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = props.Text or "",
		Font = UIKit.Theme.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	})
	UIKit.Corner(button, props.Radius or 10)
	UIKit.Stroke(button, Color3.new(0, 0, 0), 2.5, 0.2)
	UIKit.TextStroke(button, 1.5)
	local h, s, v = color:ToHSV()
	UIKit.Gradient(button, Color3.fromHSV(h, s * 0.7, math.min(v * 1.15, 1)), Color3.fromHSV(h, s, v * 0.8), 90)
	UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		Parent = button,
	})
	local scale = UIKit.new("UIScale", { Parent = button })
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, info, { Scale = 0.94 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.06 }):Play()
	end)
	if props.Callback then
		button.Activated:Connect(function()
			UIKit.PlaySound("Click", 0.5)
			props.Callback()
		end)
	end
	button.Parent = props.Parent
	return button
end

-- Centered popup panel with title + close button. Returns (frame, content)
function UIKit.Panel(props: { [string]: any })
	local frame = UIKit.new("Frame", {
		Name = props.Name or "Panel",
		Size = props.Size or UDim2.fromOffset(520, 420),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UIKit.Theme.Panel,
		Visible = false,
		ZIndex = 5,
	})
	UIKit.Corner(frame, 18)
	UIKit.Stroke(frame, Color3.new(0, 0, 0), 4, 0.1)
	UIKit.Gradient(frame, UIKit.Theme.PanelLight, UIKit.Theme.Panel, 90)
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(props.MaxWidth or 900, 800), Parent = frame })
	UIKit.new("UIScale", { Name = "PopScale", Parent = frame })

	local header = UIKit.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = props.Color or UIKit.Theme.Accent,
		ZIndex = 6,
		Parent = frame,
	})
	UIKit.Corner(header, 18)
	local hcolor: Color3 = props.Color or UIKit.Theme.Accent
	local h, s, v = hcolor:ToHSV()
	UIKit.Gradient(header, Color3.fromHSV(h, s * 0.6, math.min(1, v * 1.2)), hcolor, 90)
	-- square off the bottom corners of the header
	UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -18),
		BackgroundColor3 = hcolor,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = header,
	})
	UIKit.Label({
		Text = props.Title or "Panel",
		Size = UDim2.new(1, -120, 0, 40),
		Position = UDim2.fromOffset(20, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
		Parent = header,
	})
	local close = UIKit.Button({
		Name = "Close",
		Text = "X",
		Color = UIKit.Theme.Red,
		Size = UDim2.fromOffset(42, 42),
		Position = UDim2.new(1, -50, 0, 7),
		ZIndex = 7,
		Parent = header,
	})

	local content = UIKit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -24, 1, -72),
		Position = UDim2.fromOffset(12, 64),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = frame,
	})
	frame.Parent = props.Parent
	return frame, content, close
end

function UIKit.Scroll(props: { [string]: any })
	local scroll = UIKit.new("ScrollingFrame", {
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UIKit.Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = props.ZIndex or 6,
	})
	scroll.Parent = props.Parent
	return scroll
end

function UIKit.TextBox(props: { [string]: any })
	local box = UIKit.new("TextBox", {
		Size = props.Size or UDim2.fromOffset(200, 40),
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = UIKit.Theme.Background,
		PlaceholderText = props.Placeholder or "",
		PlaceholderColor3 = UIKit.Theme.SubText,
		Text = props.Text or "",
		Font = UIKit.Theme.BodyFont,
		TextColor3 = UIKit.Theme.Text,
		TextScaled = true,
		ClearTextOnFocus = props.ClearTextOnFocus or false,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 6,
	})
	UIKit.Corner(box, 8)
	UIKit.Stroke(box, UIKit.Theme.PanelLight, 2)
	UIKit.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = box })
	box.Parent = props.Parent
	return box
end

-- Pop a panel open / closed with a bouncy tween. The token makes sure a
-- close animation that finishes after a quick re-open can't hide the panel.
local popTokens: { [GuiObject]: number } = setmetatable({}, { __mode = "k" }) :: any

function UIKit.Open(frame: GuiObject)
	popTokens[frame] = (popTokens[frame] or 0) + 1
	local scale = frame:FindFirstChild("PopScale") :: UIScale?
	frame.Visible = true
	if scale then
		scale.Scale = 0.6
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	UIKit.PlaySound("Whoosh", 0.25, 1.4)
end

function UIKit.Close(frame: GuiObject)
	popTokens[frame] = (popTokens[frame] or 0) + 1
	local token = popTokens[frame]
	local scale = frame:FindFirstChild("PopScale") :: UIScale?
	if scale then
		local tween = TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.6 })
		tween:Play()
		tween.Completed:Once(function()
			if popTokens[frame] == token then
				frame.Visible = false
			end
		end)
	else
		frame.Visible = false
	end
end

return UIKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[ Small helpers shared by server and client ]]
local Util = {}

local SUFFIXES = {
	"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc",
	"Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg",
}

-- true for real numbers (not NaN, not +/-inf)
function Util.IsFinite(n: any): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- tonumber() that only accepts finite numbers (Luau's tonumber parses "nan" and "inf")
function Util.Number(value: any): number?
	local n = tonumber(value)
	if n == nil or not Util.IsFinite(n) then
		return nil
	end
	return n
end

-- 1234567 -> "1.23M"
function Util.Abbreviate(n: number): string
	n = tonumber(n) or 0
	if n ~= n then
		return "0"
	elseif n == math.huge then
		return "∞"
	elseif n == -math.huge then
		return "-∞"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n))
		return negative and "-" .. s or s
	end
	if n >= 1000 ^ #SUFFIXES then
		-- past the last suffix
		local text = string.format("%.2e", n)
		return negative and "-" .. text or text
	end
	local index = math.clamp(math.floor(math.log10(n) / 3), 0, #SUFFIXES - 1)
	local value = n / (1000 ^ index)
	-- log10 can land just below an integer (999.99...): fix the suffix
	if value >= 1000 and index < #SUFFIXES - 1 then
		index += 1
		value /= 1000
	elseif value < 1 and index > 0 then
		index -= 1
		value *= 1000
	end
	local text
	if value >= 100 then
		text = string.format("%d", math.floor(value))
	elseif value >= 10 then
		text = string.format("%.1f", math.floor(value * 10) / 10)
	else
		text = string.format("%.2f", math.floor(value * 100) / 100)
	end
	if text:find("%.") then
		text = (text:gsub("0+$", ""):gsub("%.$", ""))
	end
	text ..= SUFFIXES[index + 1]
	return negative and "-" .. text or text
end

function Util.Money(n: number): string
	return "$" .. Util.Abbreviate(n)
end

-- 1234567 -> "1,234,567"
function Util.Commas(n: number): string
	n = tonumber(n) or 0
	if not Util.IsFinite(n) or math.abs(n) >= 1e15 then
		return Util.Abbreviate(n)
	end
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""):gsub("^%-,", "-"))
end

-- 3725 -> "1h 2m 5s"
function Util.FormatTime(seconds: number): string
	seconds = math.max(0, math.floor(Util.Number(seconds) or 0))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %dm %ds", h, m, s)
	elseif m > 0 then
		return string.format("%dm %ds", m, s)
	end
	return string.format("%ds", s)
end

function Util.Clock(seconds: number): string
	seconds = math.max(0, math.floor(Util.Number(seconds) or 0))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- The server's clock (os.time() on a client is the device clock, which can
-- be hours off; server timestamps like BoostEnd must be compared with this)
function Util.ServerNow(): number
	local ok, now = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and now or os.time()
end

-- Runs fn(...) protected, so one bug can't kill a loop that keeps the game
-- running. Logs the first few failures per label (no output spam).
local failures: { [string]: number } = {}
function Util.Try(label: string, fn: (...any) -> ...any, ...): boolean
	local ok, err = pcall(fn, ...)
	if not ok then
		local n = (failures[label] or 0) + 1
		failures[label] = n
		if n <= 3 then
			warn(("[%s] %s"):format(label, tostring(err)))
		end
	end
	return ok
end

function Util.DeepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	local copy = {}
	for k, v in t :: any do
		copy[k] = Util.DeepCopy(v)
	end
	return copy :: any
end

-- Fill in keys missing from `data` with values from `template`. Values of
-- the wrong type (corrupted saves) and NaN / inf numbers are replaced too.
function Util.Reconcile(data: { [any]: any }, template: { [any]: any })
	for k, v in template do
		local current = data[k]
		if current == nil or type(current) ~= type(v) or (type(v) == "number" and not Util.IsFinite(current)) then
			data[k] = Util.DeepCopy(v)
		elseif type(v) == "table" then
			Util.Reconcile(current, v)
		end
	end
	return data
end

-- Replace NaN / inf numbers anywhere in `t` (so a save can never fail on them).
-- Returns how many values were fixed.
function Util.Sanitize(t: { [any]: any }, template: { [any]: any }?, depth: number?): number
	local fixed = 0
	if (depth or 0) > 20 then
		return 0
	end
	for k, v in t do
		if type(v) == "number" and not Util.IsFinite(v) then
			local default = template and template[k]
			t[k] = type(default) == "number" and default or 0
			fixed += 1
		elseif type(v) == "table" then
			local sub = template and type(template[k]) == "table" and template[k] or nil
			fixed += Util.Sanitize(v, sub, (depth or 0) + 1)
		end
	end
	return fixed
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	MEGA TYCOON - server bootstrap.
	Loads every service in Services/, calls :Init(S) on each (S = registry of
	all services so they can talk to each other), then :Start().
]]
local ServerScriptService = game:GetService("ServerScriptService")

local servicesFolder = ServerScriptService:WaitForChild("Services")

local ORDER = {
	"WorldBuilder",
	"DataService",
	"MonetizationService",
	"TycoonService",
	"ObbyService",
	"SecretService",
	"DuoService",
	"QuestService",
	"GiftService",
	"WheelService",
	"ShieldService",
	"PetService",
	"IslandService",
	"WeeklyService",
	"DisasterService",
	"AdminService",
	"AntiCheatService",
	"MinigameService",
	"RewardService",
	"LeaderboardService",
}

local S = {}
for _, name in ORDER do
	local module = servicesFolder:FindFirstChild(name)
	if module then
		local ok, result = pcall(require, module)
		if ok then
			S[name] = result
		else
			warn("[MegaTycoon] Failed to load " .. name .. ": " .. tostring(result))
		end
	end
end

for _, name in ORDER do
	local service = S[name]
	if service and service.Init then
		local ok, err = pcall(service.Init, service, S)
		if not ok then
			warn("[MegaTycoon] Init failed for " .. name .. ": " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local service = S[name]
