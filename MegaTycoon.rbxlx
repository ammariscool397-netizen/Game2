<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>
  <Item class="ReplicatedFirst" referent="1">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="2">
      <Properties>
        <string name="Name">LoadingScreen</string>
        <string name="Source"><![CDATA[--[[
	Loading screen - animated background, spinning logo, progress bar with
	asset preloading, rotating tips, loading music and a skip button.
]]
local ContentProvider = game:GetService("ContentProvider")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

ReplicatedFirst:RemoveDefaultLoadingScreen()

-- defaults until the shared config replicates
local GAME_NAME = "MEGA TYCOON"
local TIPS = { "Loading the money printers..." }

local function new(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function stroke(parent: Instance, thickness: number?)
	return new("UIStroke", { Thickness = thickness or 3, Color = Color3.new(0, 0, 0), Parent = parent })
end

local gui = new("ScreenGui", {
	Name = "LoadingScreen",
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	DisplayOrder = 1000,
	Parent = playerGui,
})

local background = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(1, 1, 1),
	Parent = gui,
})
local bgGradient = new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 20, 70)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 30, 140)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 90, 120)),
	}),
	Rotation = 45,
	Parent = background,
})

-- floating money in the background
local floaters = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = background })
local EMOJIS = { "💵", "💰", "🪙", "💎", "⭐" }

local title = new("TextLabel", {
	Text = GAME_NAME,
	Size = UDim2.new(0.8, 0, 0.16, 0),
	Position = UDim2.fromScale(0.5, 0.3),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.FredokaOne,
	TextColor3 = Color3.new(1, 1, 1),
	Parent = background,
})
stroke(title, 5)
new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 245, 140)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 180, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 0)),
	}),
	Rotation = 90,
	Parent = title,
})
local titleScale = new("UIScale", { Scale = 0, Parent = title })
new("UISizeConstraint", { MaxSize = Vector2.new(900, 160), Parent = title })

local subtitle = new("TextLabel", {
	Text = "Build your empire. Rule the server.",
	Size = UDim2.new(0.6, 0, 0, 30),
	Position = UDim2.fromScale(0.5, 0.41),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextColor3 = Color3.fromRGB(220, 220, 255),
	TextTransparency = 1,
	Parent = background,
})

-- spinner (two rotating rounded squares)
local spinnerHolder = new("Frame", {
	Size = UDim2.fromOffset(70, 70),
	Position = UDim2.fromScale(0.5, 0.58),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	Parent = background,
})
local spinA = new("Frame", { Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 196, 0), Parent = spinnerHolder })
new("UICorner", { CornerRadius = UDim.new(0, 14), Parent = spinA })
stroke(spinA, 3)
local spinB = new("Frame", { Size = UDim2.fromScale(0.55, 0.55), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(0, 200, 255), Parent = spinnerHolder })
new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = spinB })
stroke(spinB, 3)
local coin = new("TextLabel", { Text = "$", Size = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, TextScaled = true, Font = Enum.Font.FredokaOne, TextColor3 = Color3.new(1, 1, 1), Parent = spinB })
stroke(coin, 2)

-- progress bar
local barBack = new("Frame", {
	Size = UDim2.new(0.5, 0, 0, 26),
	Position = UDim2.fromScale(0.5, 0.72),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundColor3 = Color3.fromRGB(20, 15, 40),
	Parent = background,
})
new("UICorner", { CornerRadius = UDim.new(0, 13), Parent = barBack })
stroke(barBack, 3)
new("UISizeConstraint", { MinSize = Vector2.new(260, 26), MaxSize = Vector2.new(600, 26), Parent = barBack })
local barFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = barBack })
new("UICorner", { CornerRadius = UDim.new(0, 13), Parent = barFill })
local fillGradient = new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 255, 140)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 230, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 255, 140)),
	}),
	Parent = barFill,
})
local percent = new("TextLabel", {
	Text = "0%",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.FredokaOne,
	TextColor3 = Color3.new(1, 1, 1),
	ZIndex = 3,
	Parent = barBack,
})
stroke(percent, 2)

local status = new("TextLabel", {
	Text = "Connecting...",
	Size = UDim2.new(0.6, 0, 0, 22),
	Position = UDim2.fromScale(0.5, 0.77),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextColor3 = Color3.fromRGB(200, 200, 230),
	Parent = background,
})

local tip = new("TextLabel", {
	Text = "",
	Size = UDim2.new(0.8, 0, 0, 26),
	Position = UDim2.fromScale(0.5, 0.9),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextColor3 = Color3.fromRGB(255, 230, 120),
	Parent = background,
})
stroke(tip, 2)

local skip = new("TextButton", {
	Text = "SKIP ▶",
	Size = UDim2.fromOffset(130, 44),
	Position = UDim2.new(1, -20, 1, -20),
	AnchorPoint = Vector2.new(1, 1),
	BackgroundColor3 = Color3.fromRGB(255, 196, 0),
	TextScaled = true,
	Font = Enum.Font.FredokaOne,
	TextColor3 = Color3.new(1, 1, 1),
	Visible = false,
	Parent = background,
})
new("UICorner", { CornerRadius = UDim.new(0, 10), Parent = skip })
stroke(skip, 3)
new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = skip })

local blur = new("BlurEffect", { Name = "LoadingBlur", Size = 24, Parent = Lighting })

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

---------------------------------------------------------------------------
-- Animation loop
---------------------------------------------------------------------------
local finished = false
local skipped = false
local displayed = 0
local target = 0

TweenService:Create(titleScale, TweenInfo.new(0.9, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
task.delay(0.5, function()
	TweenService:Create(subtitle, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
end)

local renderConn = RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	bgGradient.Rotation = (bgGradient.Rotation + dt * 12) % 360
	spinA.Rotation = (t * 180) % 360
	spinB.Rotation = -(t * 260) % 360
	titleScale.Scale = finished and titleScale.Scale or (titleScale.Scale > 0.95 and (1 + math.sin(t * 2.5) * 0.03) or titleScale.Scale)
	fillGradient.Offset = Vector2.new(math.sin(t * 2) * 0.5, 0)
	displayed += (target - displayed) * math.min(dt * 6, 1)
	barFill.Size = UDim2.fromScale(math.clamp(displayed, 0, 1), 1)
	percent.Text = math.floor(displayed * 100 + 0.5) .. "%"
end)

task.spawn(function()
	while not finished do
		local label = new("TextLabel", {
			Text = EMOJIS[math.random(1, #EMOJIS)],
			Size = UDim2.fromOffset(math.random(26, 54), math.random(26, 54)),
			Position = UDim2.new(math.random(), 0, 1.1, 0),
			BackgroundTransparency = 1,
			TextScaled = true,
			TextTransparency = 0.35,
			Rotation = math.random(-30, 30),
			Parent = floaters,
		})
		local duration = math.random(40, 80) / 10
		TweenService:Create(label, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
			Position = UDim2.new(label.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, -0.15, 0),
			Rotation = math.random(-180, 180),
		}):Play()
		task.delay(duration, function()
			label:Destroy()
		end)
		task.wait(0.25)
	end
end)

-- loading music + config
local music: Sound? = nil
task.spawn(function()
	local shared = ReplicatedStorage:WaitForChild("Shared", 20)
	local configModule = shared and shared:WaitForChild("Config", 10)
	if not configModule then
		return
	end
	local Config = require(configModule) :: any
	GAME_NAME = Config.GameName
	title.Text = GAME_NAME
	TIPS = Config.Tips
	if Config.Music.Loading and not finished then
		local sound = Instance.new("Sound")
		sound.SoundId = Config.Music.Loading.Id
		sound.Volume = 0
		sound.Looped = true
		sound.Parent = SoundService
		sound:Play()
		TweenService:Create(sound, TweenInfo.new(2), { Volume = 0.3 }):Play()
		music = sound
	end
end)

task.spawn(function()
	local i = 0
	while not finished do
		i = i % #TIPS + 1
		tip.Text = "💡 TIP: " .. TIPS[i]
		tip.TextTransparency = 1
		TweenService:Create(tip, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
		task.wait(4)
	end
end)

task.delay(6, function()
	if not finished then
		skip.Visible = true
	end
end)
skip.Activated:Connect(function()
	skipped = true
end)

---------------------------------------------------------------------------
-- Actual loading
---------------------------------------------------------------------------
local startTime = os.clock()

status.Text = "Loading game..."
if not game:IsLoaded() then
	game.Loaded:Wait()
end
target = 0.2

-- wait for the server to finish building the world
status.Text = "Building the world..."
local waited = 0
while not workspace:GetAttribute("ServerReady") and waited < 20 and not skipped do
	waited += task.wait(0.2)
end
target = 0.35

-- preload assets (in chunks so the bar moves)
status.Text = "Loading assets..."
local assets = {}
for _, d in workspace:GetDescendants() do
	if d:IsA("ParticleEmitter") or d:IsA("Decal") or d:IsA("Texture") or d:IsA("MeshPart") or d:IsA("Sound") then
		table.insert(assets, d)
	end
end
local total = math.max(#assets, 1)
local chunk = 25
for i = 1, #assets, chunk do
	if skipped then
		break
	end
	local slice = {}
	for j = i, math.min(i + chunk - 1, #assets) do
		table.insert(slice, assets[j])
	end
	pcall(function()
		ContentProvider:PreloadAsync(slice)
	end)
	target = 0.35 + 0.45 * (math.min(i + chunk, total) / total)
	status.Text = string.format("Loading assets... %d / %d", math.min(i + chunk - 1, #assets), #assets)
end
target = 0.8

-- wait for player data
status.Text = "Loading your tycoon..."
waited = 0
while not player:GetAttribute("DataLoaded") and waited < 25 and not skipped do
	waited += task.wait(0.2)
end
target = 1
status.Text = "Ready!"

-- minimum time so the screen doesn't just flash
while os.clock() - startTime < 3.5 and not skipped do
	task.wait(0.1)
end
task.wait(0.4)

---------------------------------------------------------------------------
-- Fade out
---------------------------------------------------------------------------
finished = true
skip.Visible = false
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
end)
local fadeInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
TweenService:Create(titleScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 }):Play()
TweenService:Create(background, fadeInfo, { BackgroundTransparency = 1 }):Play()
TweenService:Create(blur, TweenInfo.new(1.2), { Size = 0 }):Play()
for _, d in background:GetDescendants() do
	if d:IsA("TextLabel") or d:IsA("TextButton") then
		TweenService:Create(d, fadeInfo, { TextTransparency = 1 }):Play()
	end
	if d:IsA("Frame") then
		TweenService:Create(d, fadeInfo, { BackgroundTransparency = 1 }):Play()
	end
	if d:IsA("UIStroke") then
		TweenService:Create(d, fadeInfo, { Transparency = 1 }):Play()
	end
end
if music then
	TweenService:Create(music, TweenInfo.new(1), { Volume = 0 }):Play()
end
player:SetAttribute("LoadingDone", true)
task.wait(1.3)
renderConn:Disconnect()
blur:Destroy()
gui:Destroy()
if music then
	music:Destroy()
end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="3">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	MEGA TYCOON - Main configuration
	Everything you might want to tweak lives here: economy, game passes,
	developer products, admins, music, minigames, codes and daily rewards.

	>>> BEFORE PUBLISHING <<<
	1. Create your Game Passes / Developer Products on the Creator Dashboard
	   and paste their IDs into GamePasses / Products below.
	2. Add your own UserId to Admin.Admins (the game creator is always Owner).
	3. Replace the music IDs with tracks you can use (Creator Store > Audio).
	4. Game Settings > Security > Enable Studio Access to API Services
	   (needed for saving in Studio).
]]

local Config = {}

Config.GameName = "MEGA TYCOON"
Config.Version = "1.0.0"

---------------------------------------------------------------------------
-- Data / economy
---------------------------------------------------------------------------
Config.DataStoreName = "MegaTycoon_PlayerData_v1"
Config.AutoSaveInterval = 90 -- seconds

Config.StartingCash = 100
Config.BaseWalkSpeed = 16

Config.Rebirth = {
	BaseCost = 2_500_000,
	CostGrowth = 2.5, -- cost = BaseCost * CostGrowth ^ rebirths
	MultiplierPerRebirth = 0.5, -- each rebirth adds +0.5x to all income
}

function Config.GetRebirthCost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * (Config.Rebirth.CostGrowth ^ rebirths))
end

Config.ConveyorSpeed = 9
Config.DropLifetime = 25
Config.MaxPlots = 6

---------------------------------------------------------------------------
-- Monetization
-- Id = 0 means "not configured yet". While in Roblox Studio, buying an item
-- with Id 0 simulates the purchase so you can test everything for free.
---------------------------------------------------------------------------
Config.Monetization = {
	SimulateUnconfiguredInStudio = true,
}

Config.GamePasses = {
	DoubleCash = {
		Id = 0,
		Name = "2x Cash",
		Description = "Double ALL income, forever!",
		PriceHint = 299,
		Icon = "💵",
		Color = Color3.fromRGB(70, 200, 90),
		Order = 1,
	},
	AutoCollect = {
		Id = 0,
		Name = "Auto Collect",
		Description = "Cash goes straight to your wallet. No more vault!",
		PriceHint = 149,
		Icon = "🧲",
		Color = Color3.fromRGB(80, 160, 255),
		Order = 2,
	},
	FastDroppers = {
		Id = 0,
		Name = "Fast Droppers",
		Description = "All droppers drop 2x faster.",
		PriceHint = 249,
		Icon = "⚡",
		Color = Color3.fromRGB(255, 200, 40),
		Order = 3,
	},
	VIP = {
		Id = 0,
		Name = "VIP",
		Description = "+50% cash, golden VIP chat tag, VIP aura & daily bonus x2.",
		PriceHint = 399,
		Icon = "👑",
		Color = Color3.fromRGB(255, 170, 0),
		Order = 4,
	},
	SuperSpeed = {
		Id = 0,
		Name = "Super Speed",
		Description = "Run 2x faster around the map.",
		PriceHint = 99,
		Icon = "👟",
		Color = Color3.fromRGB(255, 90, 160),
		Order = 5,
	},
}

Config.Products = {
	CashSmall = {
		Id = 0,
		Name = "Pile of Cash",
		Description = "+$10K (scales with rebirths)",
		PriceHint = 25,
		Icon = "💰",
		Cash = 10_000,
		Order = 1,
	},
	CashMedium = {
		Id = 0,
		Name = "Bag of Cash",
		Description = "+$100K (scales with rebirths)",
		PriceHint = 99,
		Icon = "💰",
		Cash = 100_000,
		Order = 2,
	},
	CashLarge = {
		Id = 0,
		Name = "Vault of Cash",
		Description = "+$1M (scales with rebirths)",
		PriceHint = 299,
		Icon = "🏦",
		Cash = 1_000_000,
		Order = 3,
	},
	CashHuge = {
		Id = 0,
		Name = "Cash Mountain",
		Description = "+$10M (scales with rebirths)",
		PriceHint = 799,
		Icon = "⛰️",
		Cash = 10_000_000,
		Order = 4,
	},
	Boost = {
		Id = 0,
		Name = "2x Boost (15 min)",
		Description = "Double income for 15 minutes. Stacks time!",
		PriceHint = 49,
		Icon = "🚀",
		BoostSeconds = 15 * 60,
		Order = 5,
	},
	CashRain = {
		Id = 0,
		Name = "Server Cash Rain",
		Description = "Make it rain cash for EVERYONE in the server!",
		PriceHint = 149,
		Icon = "🌧️",
		ServerEvent = "CashRain",
		Order = 6,
	},
}

---------------------------------------------------------------------------
-- Admin
-- Ranks: 0 = Player, 1 = Mod, 2 = Admin, 3 = HeadAdmin, 4 = Owner
---------------------------------------------------------------------------
Config.Admin = {
	Prefix = ";",
	CreatorIsOwner = true, -- the place owner (or group owner) is always Owner
	StudioEveryoneIsOwner = true, -- in Studio play-tests everyone is Owner
	Admins = {
		-- [123456789] = 4,
	},
	GroupId = 0, -- set to your group id to give ranks by group rank
	GroupRanks = {
		-- [255] = 4, [254] = 3, [200] = 2, [100] = 1,
	},
	BanDataStore = "MegaTycoon_Bans_v1",
}

Config.RankNames = {
	[0] = "Player",
	[1] = "Mod",
	[2] = "Admin",
	[3] = "Head Admin",
	[4] = "Owner",
}

---------------------------------------------------------------------------
-- Music / sounds
-- Replace these with any audio you have permission to use (search the
-- Creator Store for music uploaded by "Roblox" - those are free to use).
-- Tracks that fail to load are skipped automatically.
---------------------------------------------------------------------------
Config.Music = {
	DefaultVolume = 0.35,
	Lobby = {
		{ Id = "rbxassetid://1837849285", Name = "Tycoon Groove" },
		{ Id = "rbxassetid://1843463175", Name = "Sunny Day" },
		{ Id = "rbxassetid://1839246711", Name = "Chill Vibes" },
		{ Id = "rbxassetid://1845756489", Name = "Money Maker" },
	},
	Minigame = {
		{ Id = "rbxassetid://1838028467", Name = "Minigame Rush" },
		{ Id = "rbxassetid://1836057733", Name = "Adrenaline" },
	},
	Loading = { Id = "rbxassetid://1846368080", Name = "Loading" },
}

-- Built-in engine sounds (always available, no upload needed)
Config.Sounds = {
	Click = "rbxasset://sounds/clickfast.wav",
	Hover = "rbxasset://sounds/button.wav",
	Purchase = "rbxasset://sounds/electronicpingshort.wav",
	Error = "rbxasset://sounds/uuhhh.mp3",
	Cash = "rbxasset://sounds/electronicpingshort.wav",
	Notify = "rbxasset://sounds/button.wav",
	Rebirth = "rbxasset://sounds/victory.wav",
	Win = "rbxasset://sounds/victory.wav",
	Countdown = "rbxasset://sounds/clickfast.wav",
	Whoosh = "rbxasset://sounds/swordslash.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Boom = "rbxasset://sounds/collide.wav",
}

---------------------------------------------------------------------------
-- Minigames
---------------------------------------------------------------------------
Config.Minigames = {
	Enabled = true,
	Intermission = 150, -- seconds between minigames
	JoinTime = 20, -- seconds players get to press "Join"
	MinPlayers = 1,
	ArenaCenter = Vector3.new(0, 600, 0),
	Games = {
		CoinRush = {
			DisplayName = "Coin Rush",
			Description = "Grab as many coins as you can in 45 seconds!",
			Duration = 45,
			CoinValue = 250, -- cash per coin (x (1 + rebirths))
			WinnerBonus = 5000,
		},
		FallingTiles = {
			DisplayName = "Falling Tiles",
			Description = "Tiles fall after you touch them. Be the last one standing!",
			Duration = 90,
			SurviveReward = 3000,
			WinnerBonus = 10000,
		},
		MeteorShower = {
			DisplayName = "Meteor Shower",
			Description = "Dodge the meteors raining from the sky for 60 seconds!",
			Duration = 60,
			SurviveReward = 6000,
			WinnerBonus = 4000,
		},
	},
}

---------------------------------------------------------------------------
-- Obby
---------------------------------------------------------------------------
Config.Obby = {
	Reward = 15_000, -- x (1 + rebirths)
	Cooldown = 10 * 60, -- seconds between rewarded completions
}

---------------------------------------------------------------------------
-- Daily rewards (index = streak day, loops after the last one)
---------------------------------------------------------------------------
Config.Daily = {
	Cooldown = 20 * 60 * 60, -- 20 hours
	StreakResetAfter = 48 * 60 * 60,
	Rewards = { 1_000, 2_500, 5_000, 10_000, 20_000, 40_000, 100_000 },
}

---------------------------------------------------------------------------
-- Codes (case-insensitive). Remove a code or set Expired = true to disable.
---------------------------------------------------------------------------
Config.Codes = {
	RELEASE = { Cash = 1_000 },
	MEGATYCOON = { Cash = 5_000 },
	BOOST = { BoostSeconds = 10 * 60 },
	THANKYOU = { Cash = 25_000 },
}

---------------------------------------------------------------------------
-- Loading screen tips
---------------------------------------------------------------------------
Config.Tips = {
	"Step on the green buttons in your tycoon to buy upgrades!",
	"Upgraders multiply the value of every drop that passes through.",
	"Rebirth to reset your tycoon and earn a permanent cash multiplier.",
	"Minigames start every few minutes - join them for big rewards!",
	"Finish the obby next to the lobby for a huge cash prize.",
	"Claim your daily reward every day to build your streak.",
	"Codes can be redeemed in the Codes menu. Try RELEASE!",
	"Don't forget to collect your vault!",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	All networking goes through these remotes. The server creates them,
	the client waits for them. Usage: Remotes.Notify:FireClient(...)
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify", -- server -> client  { Text, Type, Duration }
	"Announce", -- server -> all    { Title, Text, Color }
	"VFX", -- server -> client  (effectName, params)
	"Music", -- server -> client  (action, params)
	"ClientCommand", -- server -> client  (command, ...) used by admin fly/noclip/etc
	"MinigameState", -- server -> client  state table
	"MinigameJoin", -- client -> server
	"RequestRebirth", -- client -> server
	"BuyPass", -- client -> server  (passKey)
	"BuyProduct", -- client -> server  (productKey)
	"GoHome", -- client -> server
	"SaveSettings", -- client -> server  (settings)
}

local FUNCTIONS = {
	"RedeemCode", -- (code) -> ok, message
	"ClaimDaily", -- () -> ok, message
	"AdminCommand", -- (text) -> ok, message
	"AdminData", -- (what) -> data
	"GetLeaderboard", -- () -> rows
}

local folder: Folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in EVENTS do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		for _, name in FUNCTIONS do
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
		folder.Parent = ReplicatedStorage
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

local Remotes = {}
setmetatable(Remotes, {
	__index = function(_, name)
		local remote = folder:WaitForChild(name, 15)
		if not remote then
			error("Remote not found: " .. tostring(name))
		end
		rawset(Remotes, name, remote)
		return remote
	end,
})

return Remotes :: any
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[ Minimal signal class used for server-side events between services ]]
local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> () }

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local handler = { fn = fn, connected = true }
	table.insert(self._handlers, handler)
	local signal = self
	return {
		Disconnect = function()
			handler.connected = false
			local index = table.find(signal._handlers, handler)
			if index then
				table.remove(signal._handlers, index)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, handler in table.clone(self._handlers) do
		if handler.connected then
			task.spawn(handler.fn, ...)
		end
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">TycoonItems</string>
          <string name="Source"><![CDATA[--[[
	Every buyable item in a tycoon. Positions are in the plot's local space:
	  X = left/right (-60..60), Z = front/back (-60 is the entrance), Y = up.
	Buttons are laid out automatically in a grid at the front of the plot.

	Kinds:
	  Dropper  - spawns drops worth `Value` every `Interval` seconds
	  Upgrader - multiplies drops passing through by `Multiplier`
	  Walls    - decorative walls (`Side` = Left / Right / Back)
	  Decor    - decorative build (`Model` = Garden / Fountain / Sign / Statue / Tower)
	  SpeedPad - pad that gives a short speed boost
]]

export type Item = {
	Id: string,
	Name: string,
	Cost: number,
	Kind: string,
	Requires: string?,
	Pos: Vector3,
	Value: number?,
	Interval: number?,
	Multiplier: number?,
	Color: Color3?,
	Material: Enum.Material?,
	Tier: number?,
	Side: string?,
	Model: string?,
}

local DROPPER_X = { -48, -41.5, -35, -28.5, -22, -15.5, -9, -2.5, 4 }
local DROPPER_Z = 10

local Items: { Item } = {
	{ Id = "Dropper1", Name = "Basic Dropper", Cost = 25, Kind = "Dropper", Pos = Vector3.new(DROPPER_X[1], 0, DROPPER_Z),
		Value = 6, Interval = 1.5, Tier = 1, Color = Color3.fromRGB(170, 170, 170), Material = Enum.Material.SmoothPlastic },
	{ Id = "Dropper2", Name = "Stone Dropper", Cost = 150, Kind = "Dropper", Requires = "Dropper1", Pos = Vector3.new(DROPPER_X[2], 0, DROPPER_Z),
		Value = 12, Interval = 1.5, Tier = 2, Color = Color3.fromRGB(110, 110, 120), Material = Enum.Material.Slate },
	{ Id = "WallLeft", Name = "Left Walls", Cost = 250, Kind = "Walls", Requires = "Dropper1", Side = "Left", Pos = Vector3.new(-59, 0, 0) },
	{ Id = "Dropper3", Name = "Iron Dropper", Cost = 600, Kind = "Dropper", Requires = "Dropper2", Pos = Vector3.new(DROPPER_X[3], 0, DROPPER_Z),
		Value = 25, Interval = 1.5, Tier = 3, Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal },
	{ Id = "WallRight", Name = "Right Walls", Cost = 800, Kind = "Walls", Requires = "WallLeft", Side = "Right", Pos = Vector3.new(59, 0, 0) },
	{ Id = "Upgrader1", Name = "Basic Upgrader (x1.5)", Cost = 1_200, Kind = "Upgrader", Requires = "Dropper3", Pos = Vector3.new(14, 0, DROPPER_Z),
		Multiplier = 1.5, Color = Color3.fromRGB(0, 170, 255) },
	{ Id = "Dropper4", Name = "Gold Dropper", Cost = 2_500, Kind = "Dropper", Requires = "Dropper3", Pos = Vector3.new(DROPPER_X[4], 0, DROPPER_Z),
		Value = 55, Interval = 1.5, Tier = 4, Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Foil },
	{ Id = "Garden", Name = "Tree Garden", Cost = 3_500, Kind = "Decor", Requires = "WallRight", Model = "Garden", Pos = Vector3.new(-40, 0, 40) },
	{ Id = "WallBack", Name = "Back Wall", Cost = 4_500, Kind = "Walls", Requires = "WallRight", Side = "Back", Pos = Vector3.new(0, 0, 59) },
	{ Id = "Dropper5", Name = "Emerald Dropper", Cost = 7_500, Kind = "Dropper", Requires = "Dropper4", Pos = Vector3.new(DROPPER_X[5], 0, DROPPER_Z),
		Value = 120, Interval = 1.5, Tier = 5, Color = Color3.fromRGB(40, 220, 110), Material = Enum.Material.Glass },
	{ Id = "Fountain", Name = "Fountain", Cost = 10_000, Kind = "Decor", Requires = "Garden", Model = "Fountain", Pos = Vector3.new(0, 0, 40) },
	{ Id = "Upgrader2", Name = "Neon Upgrader (x2)", Cost = 18_000, Kind = "Upgrader", Requires = "Dropper5", Pos = Vector3.new(24, 0, DROPPER_Z),
		Multiplier = 2, Color = Color3.fromRGB(255, 0, 200) },
	{ Id = "Dropper6", Name = "Ruby Dropper", Cost = 30_000, Kind = "Dropper", Requires = "Dropper5", Pos = Vector3.new(DROPPER_X[6], 0, DROPPER_Z),
		Value = 260, Interval = 1.5, Tier = 6, Color = Color3.fromRGB(230, 30, 60), Material = Enum.Material.Glass },
	{ Id = "NeonSign", Name = "Neon Sign", Cost = 40_000, Kind = "Decor", Requires = "WallBack", Model = "Sign", Pos = Vector3.new(0, 12, 58) },
	{ Id = "SpeedPad", Name = "Speed Pad", Cost = 60_000, Kind = "SpeedPad", Requires = "Dropper6", Pos = Vector3.new(-50, 0, -50) },
	{ Id = "Dropper7", Name = "Sapphire Dropper", Cost = 80_000, Kind = "Dropper", Requires = "Dropper6", Pos = Vector3.new(DROPPER_X[7], 0, DROPPER_Z),
		Value = 550, Interval = 1.5, Tier = 7, Color = Color3.fromRGB(40, 90, 255), Material = Enum.Material.Glass },
	{ Id = "Upgrader3", Name = "Plasma Upgrader (x3)", Cost = 150_000, Kind = "Upgrader", Requires = "Dropper7", Pos = Vector3.new(34, 0, DROPPER_Z),
		Multiplier = 3, Color = Color3.fromRGB(255, 120, 0) },
	{ Id = "Dropper8", Name = "Diamond Dropper", Cost = 300_000, Kind = "Dropper", Requires = "Dropper7", Pos = Vector3.new(DROPPER_X[8], 0, DROPPER_Z),
		Value = 1_200, Interval = 1.5, Tier = 8, Color = Color3.fromRGB(150, 240, 255), Material = Enum.Material.Ice },
	{ Id = "Statue", Name = "Golden Statue", Cost = 450_000, Kind = "Decor", Requires = "NeonSign", Model = "Statue", Pos = Vector3.new(22, 0, 44) },
	{ Id = "Dropper9", Name = "Galaxy Dropper", Cost = 900_000, Kind = "Dropper", Requires = "Dropper8", Pos = Vector3.new(DROPPER_X[9], 0, DROPPER_Z),
		Value = 3_000, Interval = 1.5, Tier = 9, Color = Color3.fromRGB(140, 60, 255), Material = Enum.Material.Neon },
	{ Id = "Tower", Name = "Cash Tower", Cost = 1_500_000, Kind = "Decor", Requires = "Dropper9", Model = "Tower", Pos = Vector3.new(45, 0, 40) },
}

local ById: { [string]: Item } = {}
for index, item in Items do
	ById[item.Id] = item
	-- auto button layout: 9 columns, rows going toward the entrance
	local col = (index - 1) % 9
	local row = (index - 1) // 9
	;(item :: any).ButtonPos = Vector3.new(-48 + col * 12, 0, -14 - row * 12)
end

return {
	List = Items,
	ById = ById,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--[[
	UIKit - tiny helper library for building good-looking UI from code.
	Client only.
]]
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Config = require(script.Parent.Config)

local UIKit = {}

UIKit.Theme = {
	Background = Color3.fromRGB(22, 24, 36),
	Panel = Color3.fromRGB(32, 35, 52),
	PanelLight = Color3.fromRGB(46, 50, 74),
	Accent = Color3.fromRGB(255, 196, 0),
	Accent2 = Color3.fromRGB(0, 200, 255),
	Green = Color3.fromRGB(60, 210, 100),
	Red = Color3.fromRGB(235, 70, 70),
	Purple = Color3.fromRGB(150, 80, 255),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(180, 185, 210),
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamBold,
}

local soundCache: { [string]: Sound } = {}

function UIKit.PlaySound(name: string, volume: number?, pitch: number?)
	local id = Config.Sounds[name] or name
	if not id or id == "" then
		return
	end
	local key = id .. tostring(pitch or 1)
	local sound = soundCache[key]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = volume or 0.5
		sound.PlaybackSpeed = pitch or 1
		sound.Parent = SoundService
		soundCache[key] = sound
	end
	if UIKit.SFXEnabled == false then
		return
	end
	sound.Volume = volume or 0.5
	SoundService:PlayLocalSound(sound)
end

UIKit.SFXEnabled = true

function UIKit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.Corner(parent: Instance, radius: number?)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function UIKit.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	return UIKit.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function UIKit.TextStroke(parent: Instance, thickness: number?)
	return UIKit.new("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = parent,
	})
end

function UIKit.Gradient(parent: Instance, a: Color3, b: Color3, rotation: number?)
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.Padding(parent: Instance, px: number)
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function UIKit.List(parent: Instance, padding: number?, direction: Enum.FillDirection?, align: Enum.HorizontalAlignment?)
	return UIKit.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = direction or Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function UIKit.Label(props: { [string]: any })
	local label = UIKit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = UIKit.Theme.Font,
		TextColor3 = UIKit.Theme.Text,
		TextScaled = true,
		Text = "",
	})
	for k, v in props do
		if k ~= "Parent" and k ~= "Stroke" then
			label[k] = v
		end
	end
	if props.Stroke ~= false then
		UIKit.TextStroke(label, 1.5)
	end
	label.Parent = props.Parent
	return label
end

-- A chunky "game style" button with hover + press animation and click sound
function UIKit.Button(props: { [string]: any })
	local color: Color3 = props.Color or UIKit.Theme.Accent
	local button = UIKit.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = props.Text or "",
		Font = UIKit.Theme.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	})
	UIKit.Corner(button, props.Radius or 10)
	UIKit.Stroke(button, Color3.new(0, 0, 0), 2.5, 0.2)
	UIKit.TextStroke(button, 1.5)
	local h, s, v = color:ToHSV()
	UIKit.Gradient(button, Color3.fromHSV(h, s * 0.7, math.min(v * 1.15, 1)), Color3.fromHSV(h, s, v * 0.8), 90)
	UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		Parent = button,
	})
	local scale = UIKit.new("UIScale", { Parent = button })
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, info, { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, info, { Scale = 0.94 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, info, { Scale = 1.06 }):Play()
	end)
	if props.Callback then
		button.Activated:Connect(function()
			UIKit.PlaySound("Click", 0.5)
			props.Callback()
		end)
	end
	button.Parent = props.Parent
	return button
end

-- Centered popup panel with title + close button. Returns (frame, content)
function UIKit.Panel(props: { [string]: any })
	local frame = UIKit.new("Frame", {
		Name = props.Name or "Panel",
		Size = props.Size or UDim2.fromOffset(520, 420),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UIKit.Theme.Panel,
		Visible = false,
		ZIndex = 5,
	})
	UIKit.Corner(frame, 18)
	UIKit.Stroke(frame, Color3.new(0, 0, 0), 4, 0.1)
	UIKit.Gradient(frame, UIKit.Theme.PanelLight, UIKit.Theme.Panel, 90)
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(props.MaxWidth or 900, 800), Parent = frame })
	UIKit.new("UIScale", { Name = "PopScale", Parent = frame })

	local header = UIKit.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = props.Color or UIKit.Theme.Accent,
		ZIndex = 6,
		Parent = frame,
	})
	UIKit.Corner(header, 18)
	local hcolor: Color3 = props.Color or UIKit.Theme.Accent
	local h, s, v = hcolor:ToHSV()
	UIKit.Gradient(header, Color3.fromHSV(h, s * 0.6, math.min(1, v * 1.2)), hcolor, 90)
	-- square off the bottom corners of the header
	UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -18),
		BackgroundColor3 = hcolor,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = header,
	})
	UIKit.Label({
		Text = props.Title or "Panel",
		Size = UDim2.new(1, -120, 0, 40),
		Position = UDim2.fromOffset(20, 8),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
		Parent = header,
	})
	local close = UIKit.Button({
		Name = "Close",
		Text = "X",
		Color = UIKit.Theme.Red,
		Size = UDim2.fromOffset(42, 42),
		Position = UDim2.new(1, -50, 0, 7),
		ZIndex = 7,
		Parent = header,
	})

	local content = UIKit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -24, 1, -72),
		Position = UDim2.fromOffset(12, 64),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = frame,
	})
	frame.Parent = props.Parent
	return frame, content, close
end

function UIKit.Scroll(props: { [string]: any })
	local scroll = UIKit.new("ScrollingFrame", {
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UIKit.Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = props.ZIndex or 6,
	})
	scroll.Parent = props.Parent
	return scroll
end

function UIKit.TextBox(props: { [string]: any })
	local box = UIKit.new("TextBox", {
		Size = props.Size or UDim2.fromOffset(200, 40),
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = UIKit.Theme.Background,
		PlaceholderText = props.Placeholder or "",
		PlaceholderColor3 = UIKit.Theme.SubText,
		Text = props.Text or "",
		Font = UIKit.Theme.BodyFont,
		TextColor3 = UIKit.Theme.Text,
		TextScaled = true,
		ClearTextOnFocus = props.ClearTextOnFocus or false,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 6,
	})
	UIKit.Corner(box, 8)
	UIKit.Stroke(box, UIKit.Theme.PanelLight, 2)
	UIKit.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = box })
	box.Parent = props.Parent
	return box
end

-- Pop a panel open / closed with a bouncy tween
function UIKit.Open(frame: GuiObject)
	local scale = frame:FindFirstChild("PopScale") :: UIScale?
	frame.Visible = true
	if scale then
		scale.Scale = 0.6
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	UIKit.PlaySound("Whoosh", 0.25, 1.4)
end

function UIKit.Close(frame: GuiObject)
	local scale = frame:FindFirstChild("PopScale") :: UIScale?
	if scale then
		local tween = TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.6 })
		tween:Play()
		tween.Completed:Once(function()
			if scale.Scale <= 0.61 then
				frame.Visible = false
			end
		end)
	else
		frame.Visible = false
	end
end

return UIKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[ Small helpers shared by server and client ]]
local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234567 -> "1.23M"
function Util.Abbreviate(n: number): string
	n = tonumber(n) or 0
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n))
		return negative and "-" .. s or s
	end
	local index = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local value = n / (1000 ^ index)
	local text
	if value >= 100 then
		text = string.format("%d", math.floor(value))
	elseif value >= 10 then
		text = string.format("%.1f", math.floor(value * 10) / 10)
	else
		text = string.format("%.2f", math.floor(value * 100) / 100)
	end
	if text:find("%.") then
		text = (text:gsub("0+$", ""):gsub("%.$", ""))
	end
	text ..= SUFFIXES[index + 1]
	return negative and "-" .. text or text
end

function Util.Money(n: number): string
	return "$" .. Util.Abbreviate(n)
end

-- 1234567 -> "1,234,567"
function Util.Commas(n: number): string
	local s = tostring(math.floor(tonumber(n) or 0))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""):gsub("^%-,", "-"))
end

-- 3725 -> "1h 2m 5s"
function Util.FormatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %dm %ds", h, m, s)
	elseif m > 0 then
		return string.format("%dm %ds", m, s)
	end
	return string.format("%ds", s)
end

function Util.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Util.DeepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	local copy = {}
	for k, v in t :: any do
		copy[k] = Util.DeepCopy(v)
	end
	return copy :: any
end

-- Fill in keys missing from `data` with values from `template`
function Util.Reconcile(data: { [any]: any }, template: { [any]: any })
	for k, v in template do
		if data[k] == nil then
			data[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" then
			Util.Reconcile(data[k], v)
		end
	end
	return data
end

return Util
]]></string>
        </Properties>
      </Item>
