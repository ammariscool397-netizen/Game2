	register({
		Name = "shutdown",
		Aliases = {},
		Rank = 4,
		Args = "",
		Desc = "Shut the server down (saves everyone first)",
		Run = function(executor)
			Remotes.Announce:FireAllClients({ Title = "⚠️ SERVER SHUTTING DOWN", Text = "Your data is being saved. Please rejoin!", Color = Color3.fromRGB(255, 60, 60) })
			task.delay(4, function()
				for _, p in Players:GetPlayers() do
					S.DataService:Save(p)
					p:Kick("Server shut down by " .. executor.Name .. ". Your data was saved - please rejoin!")
				end
			end)
			return "Shutting down..."
		end,
	})
end

---------------------------------------------------------------------------
-- Bans
---------------------------------------------------------------------------
function AdminService:Ban(userId: number, reason: string, by: string)
	if not banStore then
		return
	end
	pcall(function()
		(banStore :: DataStore):SetAsync(tostring(userId), { Reason = reason, By = by, Time = os.time() })
	end)
end

-- Returns true (and kicks) if banned
function AdminService:CheckBan(player: Player): boolean
	if not banStore then
		return false
	end
	local ok, entry = pcall(function()
		return (banStore :: DataStore):GetAsync(tostring(player.UserId))
	end)
	if ok and type(entry) == "table" then
		player:Kick("You are banned from this game. Reason: " .. tostring(entry.Reason))
		return true
	end
	return false
end

---------------------------------------------------------------------------
-- Execution
---------------------------------------------------------------------------
function AdminService:Execute(executor: Player, text: string): (boolean, string)
	if type(text) ~= "string" then
		return false, "Invalid command"
	end
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	local prefix = Config.Admin.Prefix
	if text:sub(1, #prefix) == prefix then
		text = text:sub(#prefix + 1)
	end
	local args = {}
	for word in text:gmatch("%S+") do
		table.insert(args, word)
	end
	if #args == 0 then
		return false, "Type a command"
	end
	local name = (table.remove(args, 1) :: string):lower()
	local command = byName[name]
	if not command then
		return false, "Unknown command '" .. name .. "'. Try " .. prefix .. "cmds"
	end
	local rank = self:GetRank(executor)
	if rank < command.Rank then
		return false, "You need " .. Config.RankNames[command.Rank] .. " for that"
	end
	local ok, result = pcall(command.Run, executor, args)
	table.insert(logs, 1, { Time = os.time(), By = executor.Name, Text = prefix .. text })
	if #logs > 200 then
		table.remove(logs)
	end
	if not ok then
		warn("[Admin] " .. tostring(result))
		return false, "Error: " .. tostring(result)
	end
	return true, tostring(result or "Done")
end

function AdminService:Init(services)
	S = services
	buildCommands()

	local function onPlayer(player: Player)
		task.spawn(function()
			player:SetAttribute("AdminRank", computeRank(player))
		end)
		-- with TextChatService the client sends chat commands through the
		-- AdminCommand remote (see Admin controller); Chatted is the fallback
		-- for the legacy chat system only, so commands never run twice
		player.Chatted:Connect(function(message)
			if TextChatService.ChatVersion ~= Enum.ChatVersion.LegacyChatService then
				return
			end
			local prefix = Config.Admin.Prefix
			if message:sub(1, #prefix) ~= prefix or self:GetRank(player) <= 0 then
				return
			end
			local ok, result = self:Execute(player, message)
			Remotes.Notify:FireClient(player, { Text = result, Type = ok and "success" or "error" })
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		if jails[player] then
			jails[player]:Destroy()
			jails[player] = nil
		end
	end)

	Remotes.AdminCommand.OnServerInvoke = function(player, text)
		if self:GetRank(player) <= 0 then
			if S.AntiCheatService then
				S.AntiCheatService:Flag(player, "AdminRemote", "Called the AdminCommand remote without an admin rank")
			end
			return false, "You are not an admin"
		end
		return self:Execute(player, text)
	end

	Remotes.AdminData.OnServerInvoke = function(player, what)
		local rank = self:GetRank(player)
		if rank <= 0 then
			if S.AntiCheatService then
				S.AntiCheatService:Flag(player, "AdminRemote", "Called the AdminData remote without an admin rank")
			end
			return nil
		end
		if what == "anticheat" then
			-- the evidence is for Head Admins (they can unban)
			return rank >= 3 and S.AntiCheatService and S.AntiCheatService:GetReport() or nil
		elseif what == "commands" then
			local list = {}
			for _, c in commands do
				table.insert(list, { Name = c.Name, Aliases = c.Aliases, Rank = c.Rank, Args = c.Args, Desc = c.Desc, Allowed = rank >= c.Rank })
			end
			return list
		elseif what == "logs" then
			return logs
		elseif what == "players" then
			local list = {}
			for _, p in Players:GetPlayers() do
				table.insert(list, {
					Name = p.Name,
					DisplayName = p.DisplayName,
					UserId = p.UserId,
					Rank = self:GetRank(p),
					Cash = p:GetAttribute("Cash") or 0,
					Rebirths = p:GetAttribute("Rebirths") or 0,
				})
			end
			return list
		end
		return nil
	end
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">AntiCheatService</string>
          <string name="Source"><![CDATA[--[[
	AntiCheatService - catches common exploits on the server (never trust the client).

	What it looks for (all tunable in Config.AntiCheat):
	  Speed        running on the ground much faster than WalkSpeed allows
	  Fly          staying in the air for a long time without falling
	  Teleport     lots of big position jumps in a short time
	  Reach        rewards / touches claimed from far away (BuildKit.IsNear fails)
	  RemoteSpam   hundreds of remote events per second
	  AdminRemote  calling the admin remotes without a rank

	Every detection is a STRIKE: the player is kicked and the proof (what was
	seen, with numbers) is saved. Strikes are stored in a DataStore, so they
	count across servers and sessions. The StrikesToBan-th strike bans the player.
	Head Admins review the evidence in the admin panel (Anti-Cheat tab) and can
	unban from there or with ;unban. Strikes are forgotten after
	StrikeExpireDays without a new one.
]]
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local AC = Config.AntiCheat

local AntiCheatService = {}
local S

local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore(AC.DataStore)
end)

-- the saved registry (cached): both tables are keyed by tostring(UserId)
--   Strikes[id] = { Name, Count, Last, Evidence = { { Time, Kind, Detail, Server } } }
--   Bans[id]    = { UserId, Name, Time, By, Reason, Strikes, Evidence }
local registry: { Strikes: { [string]: any }, Bans: { [string]: any } } = { Strikes = {}, Bans = {} }

local handled: { [Player]: boolean } = {} -- already struck this session (being kicked)
local tracks: { [Player]: any } = {} -- movement samples
local scores: { [Player]: { [string]: any } } = {} -- [kind] = { Score, Since, Notes }
local remoteCounts: { [Player]: number } = {}
local spamSeconds: { [Player]: number } = {}

local function title(kind: string): string
	local def = AC.Kinds[kind]
	return def and def.Title or kind
end

---------------------------------------------------------------------------
-- The saved registry
---------------------------------------------------------------------------
-- applies `mutate` to the saved registry (atomically across servers) and
-- caches the result; without a DataStore it only changes this server's copy
function AntiCheatService:_commit(mutate: (any) -> ()): boolean
	local dataStore = store
	if dataStore then
		local ok, result = pcall(function()
			return dataStore:UpdateAsync("Registry", function(old)
				local reg = type(old) == "table" and old or {}
				reg.Strikes = reg.Strikes or {}
				reg.Bans = reg.Bans or {}
				mutate(reg)
				return reg
			end)
		end)
		if ok and type(result) == "table" then
			registry = result
			return true
		end
		warn("[AntiCheat] could not save the registry: " .. tostring(result))
	end
	mutate(registry)
	return false
end

-- re-reads the saved registry and kicks anyone in this server who got banned elsewhere
function AntiCheatService:Refresh(): boolean
	local dataStore = store
	if not dataStore then
		return false
	end
	local ok, result = pcall(function()
		return dataStore:GetAsync("Registry")
	end)
	if not ok or type(result) ~= "table" then
		return false
	end
	result.Strikes = result.Strikes or {}
	result.Bans = result.Bans or {}
	registry = result
	for _, player in Players:GetPlayers() do
		local ban = registry.Bans[tostring(player.UserId)]
		if ban then
			handled[player] = true
			player:Kick("You are banned for cheating: " .. tostring(ban.Reason))
		end
	end
	return true
end

-- plain lists for the admin panel (newest first); the evidence is what was seen
function AntiCheatService:GetReport()
	self:Refresh()
	local bans, strikes = {}, {}
	for _, ban in registry.Bans do
		table.insert(bans, ban)
	end
	for _, record in registry.Strikes do
		table.insert(strikes, { UserId = record.UserId or 0, Name = record.Name, Count = record.Count, Time = record.Last or 0, Evidence = record.Evidence })
	end
	local function newestFirst(a, b)
		return a.Time > b.Time
	end
	table.sort(bans, newestFirst)
	table.sort(strikes, newestFirst)
	return { Bans = bans, Strikes = strikes, StrikesToBan = AC.StrikesToBan }
end

-- (strikes, banned) of one user
function AntiCheatService:GetStrikes(userId: number): (number, boolean)
	local key = tostring(userId)
	local ban = registry.Bans[key]
	if ban then
		return ban.Strikes or AC.StrikesToBan, true
	end
	local record = registry.Strikes[key]
	return record and record.Count or 0, false
end

function AntiCheatService:Unban(userId: number): boolean
	local key = tostring(userId)
	local existed = false
	self:_commit(function(reg)
		existed = reg.Bans[key] ~= nil or reg.Strikes[key] ~= nil
		reg.Bans[key] = nil
		reg.Strikes[key] = nil
	end)
	return existed
end

function AntiCheatService:ClearStrikes(userId: number): boolean
	local key = tostring(userId)
	local existed = false
	self:_commit(function(reg)
		existed = reg.Strikes[key] ~= nil
		reg.Strikes[key] = nil
	end)
	return existed
end

-- a ban an admin made by hand: listed in the panel too, so it can be undone there
function AntiCheatService:RecordBan(userId: number, name: string, reason: string, by: string)
	self:_commit(function(reg)
		reg.Bans[tostring(userId)] = { UserId = userId, Name = name, Time = os.time(), By = by, Reason = reason, Strikes = 0, Evidence = {} }
	end)
end

---------------------------------------------------------------------------
-- Strikes
---------------------------------------------------------------------------
function AntiCheatService:IsExempt(player: Player): boolean
	return S.AdminService ~= nil and S.AdminService:GetRank(player) >= AC.ExemptRank
end

-- tell the online admins what happened
function AntiCheatService:_tell(text: string)
	if not S.AdminService then
		return
	end
	for _, admin in Players:GetPlayers() do
		if S.AdminService:GetRank(admin) >= 2 then
			Remotes.Notify:FireClient(admin, { Text = "🛡️ " .. text, Type = "error", Duration = 8 })
		end
	end
end

-- "Speed hacking x3, Flying x2"
local function summarize(evidence): string
	local counts, order = {}, {}
	for _, entry in evidence do
		if not counts[entry.Kind] then
			counts[entry.Kind] = 0
			table.insert(order, entry.Kind)
		end
		counts[entry.Kind] += 1
	end
	local parts = {}
	for _, kind in order do
		table.insert(parts, title(kind) .. " x" .. counts[kind])
	end
	return table.concat(parts, ", ")
end

function AntiCheatService:_strike(player: Player, kind: string, detail: string)
	if handled[player] then
		return
	end
	handled[player] = true -- one strike per visit: they're about to be kicked
	local userId, name = player.UserId, player.Name
	local key = tostring(userId)
	local evidence = { Time = os.time(), Kind = kind, Detail = string.sub(detail, 1, 500), Server = game.JobId }
	task.spawn(function()
		local count, banned, reason = 0, false, ""
		self:_commit(function(reg)
			-- forget players whose last strike is old
			local expire = os.time() - AC.StrikeExpireDays * 86400
			for otherKey, other in reg.Strikes do
				if (other.Last or 0) < expire then
					reg.Strikes[otherKey] = nil
				end
			end
			local record = reg.Strikes[key] or { Count = 0, Evidence = {} }
			record.Name = name
			record.UserId = userId
			record.Last = evidence.Time
			record.Count += 1
			table.insert(record.Evidence, evidence)
			while #record.Evidence > AC.MaxEvidence do
				table.remove(record.Evidence, 1)
			end
			count = record.Count
			banned = count >= AC.StrikesToBan
			if banned then
				reason = "Cheating: " .. summarize(record.Evidence)
				reg.Bans[key] = { UserId = userId, Name = name, Time = evidence.Time, By = "Anti-Cheat", Reason = reason, Strikes = count, Evidence = record.Evidence }
				reg.Strikes[key] = nil
			else
				reg.Strikes[key] = record
			end
		end)
		if banned then
			if S.AdminService then
				S.AdminService:Ban(userId, reason, "Anti-Cheat")
			end
			self:_tell(name .. " was BANNED by the anti-cheat (" .. reason .. ")")
			player:Kick("You are banned for cheating (" .. reason .. "). If this is a mistake, contact the game owner.")
		else
			self:_tell(("%s was kicked: %s (strike %d/%d)"):format(name, title(kind), count, AC.StrikesToBan))
			local warning = count == AC.StrikesToBan - 1 and " The next strike is a permanent ban!" or ""
			player:Kick(("Anti-cheat: %s detected (strike %d/%d).%s"):format(title(kind), count, AC.StrikesToBan, warning))
		end
	end)
end

-- a sign of cheating. Some kinds need several signs within a window before they count.
function AntiCheatService:Flag(player: Player, kind: string, detail: string, weight: number?)
	local def = AC.Kinds[kind]
	if not AC.Enabled or not def or handled[player] or self:IsExempt(player) then
		return
	end
	local byKind = scores[player]
	if not byKind then
		byKind = {}
		scores[player] = byKind
	end
	local now = os.clock()
	local entry = byKind[kind]
	if not entry or now - entry.Since > def.Window then
		entry = { Score = 0, Since = now, Notes = {} }
		byKind[kind] = entry
	end
	entry.Score += weight or 1
	if #entry.Notes < 3 then
		table.insert(entry.Notes, detail)
	end
	if entry.Score >= def.Threshold then
		byKind[kind] = nil
		local text = detail
		if #entry.Notes > 1 then
			text = ("%s (%d signs in %ds: %s)"):format(kind, math.floor(entry.Score), def.Window, table.concat(entry.Notes, "; "))
		end
		self:_strike(player, kind, text)
	end
end

---------------------------------------------------------------------------
-- Detection
---------------------------------------------------------------------------
local function describe(position: Vector3): string
	return ("(%d, %d, %d)"):format(position.X, position.Y, position.Z)
end

-- movement: called every Speed.Interval seconds for every player
function AntiCheatService:_sample(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not humanoid or not root or humanoid.Health <= 0 then
		tracks[player] = nil
		return
	end
	local now = os.clock()
	local track = tracks[player]
	if not track or track.Character ~= character then
		tracks[player] = { Character = character, Position = root.Position, Time = now, Streak = 0, Worst = 0, Airborne = 0, Start = root.Position }
		return
	end
	local dt = now - track.Time
	if dt < AC.Speed.Interval * 0.5 then
		return
	end
	local delta = root.Position - track.Position
	local from = track.Position
	track.Position, track.Time = root.Position, now
	local flat = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local speed = flat / dt

	local state = humanoid:GetState()
	local special = humanoid.Sit or humanoid.PlatformStand
		or state == Enum.HumanoidStateType.Climbing or state == Enum.HumanoidStateType.Swimming
		or state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.Physics
		or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown
		or player:GetAttribute("InMinigame") == true or workspace:GetAttribute("Disaster") == "Tornado"
	if special then
		track.Streak, track.Worst, track.Airborne = 0, 0, 0
		return
	end
	if flat > AC.Speed.TeleportDistance then
		-- a teleport (going home, into a minigame...) happens now and then; many in a row is a cheat
		track.Streak, track.Worst, track.Airborne = 0, 0, 0
		self:Flag(player, "Teleport", ("Jumped %d studs in %.2fs: %s -> %s"):format(flat, dt, describe(from), describe(root.Position)))
		return
	end

	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	local allowed = humanoid.WalkSpeed * AC.Speed.Tolerance + AC.Speed.Slack
	if grounded and speed > allowed then
		if track.Streak == 0 then
			track.Start = from
		end
		track.Streak += 1
		track.Worst = math.max(track.Worst, speed)
		if track.Streak >= AC.Speed.Samples then
			local detail = ("Ran %d studs/s for %.1fs on the ground (WalkSpeed %d allows %d), %s -> %s"):format(track.Worst, track.Streak * AC.Speed.Interval, humanoid.WalkSpeed, allowed, describe(track.Start), describe(root.Position))
			track.Streak, track.Worst = 0, 0
			self:Flag(player, "Speed", detail)
		end
	else
		track.Streak, track.Worst = 0, 0
	end

	-- flying: a long time in the air, and not falling
	if not grounded and delta.Y / dt > -AC.Fly.MinFallSpeed then
		track.Airborne += dt
		if track.Airborne >= AC.Fly.Seconds then
			local detail = ("In the air for %ds without falling (vertical speed %d studs/s) at %s"):format(track.Airborne, delta.Y / dt, describe(root.Position))
			track.Airborne = 0
			self:Flag(player, "Fly", detail)
		end
	else
		track.Airborne = 0
	end
end

-- remote events: counted once per second
function AntiCheatService:_checkSpam()
	for player, count in remoteCounts do
		if count > AC.RemoteSpam.PerSecond then
			spamSeconds[player] = (spamSeconds[player] or 0) + 1
			if spamSeconds[player] >= AC.RemoteSpam.Seconds then
				spamSeconds[player] = 0
				self:Flag(player, "RemoteSpam", ("Sent %d remote events in one second (limit %d), %d seconds in a row"):format(count, AC.RemoteSpam.PerSecond, AC.RemoteSpam.Seconds))
			end
		else
			spamSeconds[player] = 0
		end
	end
	table.clear(remoteCounts)
end

function AntiCheatService:Init(services)
	S = services
	if not AC.Enabled then
		return
	end
	-- touches from far away (BuildKit.IsNear says no)
	BuildKit.OnFarTouch = function(player, part, distance, allowed)
		if distance > allowed + AC.Reach.Margin then
			self:Flag(player, "Reach", ("Touched %s from %d studs away (allowed %d)"):format(part:GetFullName(), distance, allowed))
		end
	end
	-- every remote event counts toward the spam check
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	for _, remote in folder and folder:GetChildren() or {} do
		if remote:IsA("RemoteEvent") then
			remote.OnServerEvent:Connect(function(player)
				remoteCounts[player] = (remoteCounts[player] or 0) + 1
			end)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		handled[player], tracks[player], scores[player] = nil, nil, nil
		remoteCounts[player], spamSeconds[player] = nil, nil
	end)
	task.spawn(function()
		self:Refresh()
	end)
end

function AntiCheatService:Start()
	if not AC.Enabled then
		return
	end
	task.spawn(function()
		while true do
			task.wait(1)
			Util.Try("AntiCheat spam", self._checkSpam, self)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(AC.RefreshSeconds)
			Util.Try("AntiCheat refresh", self.Refresh, self)
		end
	end)
	while true do
		task.wait(AC.Speed.Interval)
		for _, player in Players:GetPlayers() do
			if not handled[player] and not self:IsExempt(player) then
				Util.Try("AntiCheat", self._sample, self, player)
			end
		end
	end
end

return AntiCheatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BuildKit</string>
          <string name="Source"><![CDATA[--[[ BuildKit - helpers to build geometry from code (no assets needed) ]]
local CollectionService = game:GetService("CollectionService")

local BuildKit = {}

-- BuildKit.Part({ Size=, CFrame=, Color=, Material=, Parent=, ... })
function BuildKit.Part(props: { [string]: any }): BasePart
	local className = props.ClassName or "Part"
	local part = Instance.new(className) :: any
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" and key ~= "ClassName" and key ~= "Tags" then
			part[key] = value
		end
	end
	if props.Tags then
		for _, tag in props.Tags do
			CollectionService:AddTag(part, tag)
		end
	end
	part.Parent = props.Parent
	return part
end

function BuildKit.Model(name: string, parent: Instance?): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- Floating text above a part
function BuildKit.Billboard(adornee: BasePart, text: string, props: { [string]: any }?)
	local p: { [string]: any } = props or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = p.Name or "Billboard"
	gui.Size = p.Size or UDim2.fromOffset(200, 50)
	gui.StudsOffset = p.Offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = p.AlwaysOnTop or false
	gui.MaxDistance = p.MaxDistance or 120
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = p.Font or Enum.Font.FredokaOne
	label.TextColor3 = p.Color or Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = adornee
	return gui, label
end

-- Text painted on the face of a part
function BuildKit.SurfaceText(part: BasePart, face: Enum.NormalId, text: string, props: { [string]: any }?)
	local p: { [string]: any } = props or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = p.PixelsPerStud or 30
	gui.LightInfluence = 0
	gui.Brightness = p.Brightness or 1.5
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = p.Font or Enum.Font.FredokaOne
	label.TextColor3 = p.Color or Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = part
	return gui, label
end

function BuildKit.Particles(parent: Instance, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.LightEmission = 1
	emitter.Rate = 10
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(30, 30)
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = parent
	return emitter
end

function BuildKit.Light(parent: Instance, color: Color3, range: number?, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 2
	light.Shadows = false
	light.Parent = parent
	return light
end

function BuildKit.Size(n: number, from: number?, to: number?)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, from or n), NumberSequenceKeypoint.new(1, to or 0) })
end

-- Is the player really at `part`? Exploits can fake touches with parts
-- anywhere on the map, so every rewarding touch checks the distance too.
BuildKit.OnFarTouch = nil :: ((player: Player, part: BasePart, distance: number, allowed: number) -> ())? -- set by the anti-cheat
function BuildKit.IsNear(player: Player, part: BasePart, slack: number?): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	local distance = (root.Position - part.Position).Magnitude
	local allowed = part.Size.Magnitude / 2 + (slack or 12)
	if distance > allowed and BuildKit.OnFarTouch then
		BuildKit.OnFarTouch(player, part, distance, allowed)
	end
	return distance <= allowed
end

-- Is `hit` part of a character? Returns (player, humanoid)
function BuildKit.PlayerFromHit(hit: BasePart): (Player?, Humanoid?)
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil, nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return game:GetService("Players"):GetPlayerFromCharacter(model), humanoid
end

return BuildKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService - loads, saves and edits player data.

	Values the client needs are mirrored to Player attributes
	(Cash, Vault, Rebirths, TotalEarned, Multiplier, Income, BoostEnd, ...)
	so UI can simply listen to GetAttributeChangedSignal.

	DUO WALLETS: a duo partner spends and earns from the host's wallet.
	AddCash / SpendCash / AddVault automatically route to the "wallet owner"
	(the host), and the partner's Cash/Vault attributes mirror the host's.
	The partner's own saved data is untouched while they are in a duo.
]]
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)
local TycoonItems = require(Shared.TycoonItems)

local DataService = {}
DataService.PlayerLoaded = Signal.new() -- (player, data)
DataService.BeforeSave = Signal.new() -- (player, data)

local S

local TEMPLATE = {
	Cash = Config.StartingCash,
	Vault = 0,
	TotalEarned = 0,
	Rebirths = 0,
	Purchased = { F1_1 = true },
	Passes = {}, -- passes granted by admins / simulated in Studio
	Secrets = {},
	RedeemedCodes = {},
	DailyStreak = 0,
	LastDaily = 0,
	BoostEnd = 0,
	LastObbyReward = 0,
	ObbyCompletions = 0,
	MinigameWins = 0,
	PlayTime = 0,
	LastOnline = 0,
	LastIncome = 0,
	Quests = { List = {}, Claimed = 0 },
	Wheel = { Last = 0, Spins = 0 },
	Gifts = { Day = 0, Index = 1, Played = 0 }, -- playtime gifts (see GiftService)
	Shield = { Start = 0 }, -- when the personal shield was last activated
	Pets = { Owned = {}, Equipped = {}, NextUid = 1, Hatched = 0 }, -- see PetService
	Chests = {}, -- island chest id -> when you last opened it (see IslandService)
	Weekly = { Week = 0, Days = {}, Claimed = {} }, -- days joined this week + milestones claimed (see WeeklyService)
	Settings = { MusicVolume = Config.Music.DefaultVolume, SFX = true, LowGraphics = false, Guide = true, AutoBuild = true },
}

local profiles: { [Player]: any } = {}
-- who in the server is friends with whom (asked once per pair, on join)
local friendPairs: { [Player]: { [Player]: boolean } } = {}
local canSave: { [Player]: boolean } = {}
local joinTime: { [Player]: number } = {}

local store: DataStore? = nil
local earnedStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
		earnedStore = DataStoreService:GetOrderedDataStore(Config.DataStoreName .. "_TotalEarnedLog")
	end)
	if not ok then
		warn("[DataService] DataStores unavailable: " .. tostring(err))
	end
end

local function keyFor(player: Player)
	return "Player_" .. player.UserId
end

local function retry<T>(fn: () -> T, attempts: number?): (boolean, T | string)
	local lastErr
	for i = 1, attempts or 3 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		-- no point retrying when API access is disabled (Studio) or the place is unpublished
		local message = tostring(result)
		if message:find("StudioAccessToApisNotAllowed") or message:find("403") or message:find("publish") then
			break
		end
		task.wait(1 + i)
	end
	return false, tostring(lastErr)
end

--[[ Session locks: a save says which server is using it ({ Job, Time }).
	A player who hops servers quickly would otherwise get their new progress
	overwritten by the old server's late save. The new server waits for the
	old one to release the lock (its leave-save does), and steals it if the
	lock is stale (that server crashed) or never released. A server that
	lost its lock never writes again. ]]
local SESSION_STALE = 150 -- seconds without a save = that server is gone
local SESSION_WAIT = 15 -- seconds we wait for another server to let go
local SESSION_RETRY = 3

local function jobId(): string
	return game.JobId ~= "" and game.JobId or "studio"
end

local function lockedByOther(old, now: number): boolean
	if type(old) ~= "table" or type(old.Session) ~= "table" then
		return false
	end
	local session = old.Session
	return session.Job ~= jobId() and type(session.Time) == "number" and now - session.Time < SESSION_STALE
end

-- loads the save and takes its lock. Returns (ok, data | error, waited)
local function loadAndLock(key: string)
	local started = os.time()
	while true do
		local blocked = false
		local steal = os.time() - started >= SESSION_WAIT
		local ok, result = retry(function()
			return (store :: DataStore):UpdateAsync(key, function(old)
				local now = os.time()
				blocked = false -- (Roblox may run this more than once)
				if not steal and lockedByOther(old, now) then
					blocked = true
					return nil -- leave it alone for now
				end
				if old ~= nil and type(old) ~= "table" then
					old = nil -- garbage: start fresh (Reconcile fills it)
				end
				old = old or {}
				old.Session = { Job = jobId(), Time = now }
				return old
			end)
		end)
		if not ok then
			return false, result
		end
		if not blocked then
			if steal then
				warn("[DataService] Took over a session lock that was never released (" .. key .. ")")
			end
			return true, result
		end
		task.wait(SESSION_RETRY)
	end
end

-- Leaderboard values are stored as log10 so huge numbers still sort correctly
function DataService.EncodeEarned(n: number): number
	return math.floor(math.log10(math.max(n, 0) + 1) * 1e13)
end

function DataService.DecodeEarned(v: number): number
	return 10 ^ (v / 1e13) - 1
end

---------------------------------------------------------------------------
function DataService:Init(services)
	S = services
	workspace:SetAttribute("EventMultiplier", 1)
	workspace:SetAttribute("EventEnds", 0)
end

function DataService:Start()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(self._updateFriends, self, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		friendPairs[player] = nil
		for _, known in friendPairs do
			known[player] = nil
		end
		task.defer(self._countFriends, self)
	end)
	Players.PlayerMembershipChanged:Connect(function(player)
		self:RefreshMultiplier(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		self:_onJoin(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_onLeave(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(self._onJoin, self, player)
		task.spawn(self._updateFriends, self, player)
	end

	game:BindToClose(function()
		local threads = {}
		for _, player in Players:GetPlayers() do
			table.insert(threads, task.spawn(function()
				self:Save(player, true)
			end))
		end
		local start = os.clock()
		while os.clock() - start < (RunService:IsStudio() and 3 or 25) do
			local busy = false
			for _, thread in threads do
				if coroutine.status(thread) ~= "dead" then
					busy = true
				end
			end
			if not busy then
				break
			end
			task.wait(0.1)
		end
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for _, player in Players:GetPlayers() do
				task.spawn(self.Save, self, player)
			end
		end
	end)
	-- boost / event expiry
	task.spawn(function()
		while true do
			task.wait(1)
			Util.Try("Boost expiry", self._expireBoosts, self)
			Util.Try("Auto events", self._autoEvent, self)
		end
	end)
end

-- start a server-wide cash event (admins: ;doublecash, and Config.AutoEvents)
function DataService:StartEvent(multiplier: number, seconds: number, title: string, text: string)
	workspace:SetAttribute("EventMultiplier", multiplier)
	workspace:SetAttribute("EventEnds", os.time() + seconds)
	for _, p in Players:GetPlayers() do
		self:RefreshMultiplier(p)
	end
	Remotes.Announce:FireAllClients({ Title = title, Text = text, Color = Color3.fromRGB(255, 90, 40) })
	Remotes.VFX:FireAllClients("Confetti", {})
end

function DataService:_autoEvent()
	local AE = Config.AutoEvents
	if not AE or not AE.Enabled then
		return
	end
	self._nextAutoEvent = self._nextAutoEvent or os.time() + AE.EveryMinutes * 60
	if os.time() < self._nextAutoEvent then
		return
	end
	self._nextAutoEvent = os.time() + AE.EveryMinutes * 60
	if (workspace:GetAttribute("EventMultiplier") or 1) ~= 1 then
		return -- an admin event is already running
	end
	self:StartEvent(AE.Multiplier, AE.DurationMinutes * 60, "🔥 " .. AE.Multiplier .. "x CASH HOUR! 🔥", "Everyone earns " .. AE.Multiplier .. "x for " .. AE.DurationMinutes .. " minutes!")
end

function DataService:_expireBoosts()
	local ends = workspace:GetAttribute("EventEnds")
	local mult = workspace:GetAttribute("EventMultiplier") or 1
	if mult ~= 1 and (not Util.IsFinite(ends) or os.time() >= ends) then
		workspace:SetAttribute("EventMultiplier", 1)
		Remotes.Announce:FireAllClients({ Title = "EVENT OVER", Text = "The cash multiplier event has ended.", Color = Color3.fromRGB(200, 200, 200) })
		for _, p in Players:GetPlayers() do
			self:RefreshMultiplier(p)
		end
	end
	for player, data in profiles do
		if data.BoostEnd > 0 and os.time() >= data.BoostEnd then
			data.BoostEnd = 0
			self:Sync(player)
			Remotes.Notify:FireClient(player, { Text = "Your 2x Boost has ended.", Type = "info" })
		end
	end
end

function DataService:_onJoin(player: Player)
	if profiles[player] then
		return
	end
	joinTime[player] = os.time()

	-- ban check first
	if S.AdminService and S.AdminService.CheckBan then
		local banned = S.AdminService:CheckBan(player)
		if banned then
			return
		end
	end

	local data
	if store then
		local ok, result = loadAndLock(keyFor(player))
		if ok then
			canSave[player] = true
			data = result
		else
			canSave[player] = false
			warn("[DataService] Could not load data for " .. player.Name .. ": " .. tostring(result))
			task.delay(5, function()
				if player.Parent then
					Remotes.Notify:FireClient(player, {
						Text = RunService:IsStudio() and "Data not saving: enable Studio API access in Game Settings > Security." or "We couldn't load your data. Progress this session won't be saved. Try rejoining!",
						Type = "error",
						Duration = 10,
					})
				end
			end)
		end
	else
		canSave[player] = false
	end

	if not player.Parent then
		return
	end

	if type(data) ~= "table" then
		data = Util.DeepCopy(TEMPLATE)
	else
		Util.Reconcile(data, TEMPLATE)
		local fixed = Util.Sanitize(data, TEMPLATE)
		if fixed > 0 then
			warn("[DataService] Repaired " .. fixed .. " invalid numbers in " .. player.Name .. "'s data")
		end
	end
	-- drop purchases of items that no longer exist (old versions)
	for id in data.Purchased do
		if not TycoonItems.ById[id] then
			data.Purchased[id] = nil
		end
	end
	data.Purchased.F1_1 = true
	profiles[player] = data

	-- leaderstats
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	leaderstats.Parent = player

	self:Sync(player)
	player:SetAttribute("DataLoaded", true)
	self.PlayerLoaded:Fire(player, data)
end

function DataService:_onLeave(player: Player)
	if profiles[player] then
		self:Save(player, true)
	end
	profiles[player] = nil
	canSave[player] = nil
	joinTime[player] = nil
end

-- release = this is the last save (player leaving / server closing): unlock it
function DataService:Save(player: Player, release: boolean?)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return false
	end
	if joinTime[player] then
		data.PlayTime += os.time() - joinTime[player]
		joinTime[player] = os.time()
	end
	data.LastOnline = os.time()
	self.BeforeSave:Fire(player, data)
	-- NaN / inf can't be saved (the whole save would fail): repair them first
	local fixed = Util.Sanitize(data, TEMPLATE)
	if fixed > 0 then
		warn("[DataService] Repaired " .. fixed .. " invalid numbers before saving " .. player.Name)
	end
	local releasing = release == true
	local lost = false
	local ok, err = retry(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			lost = false
			if type(old) == "table" and type(old.Session) == "table" and old.Session.Job ~= jobId() then
				lost = true
				return nil -- another server took this player over: never overwrite it
			end
			data.Session = (not releasing) and { Job = jobId(), Time = os.time() } or nil
			return data
		end)
	end)
	if lost then
		canSave[player] = false
		warn("[DataService] " .. player.Name .. "'s data is open in another server; this server stopped saving it")
		return false
	end
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
	if earnedStore then
		pcall(function()
			(earnedStore :: OrderedDataStore):SetAsync(tostring(player.UserId), DataService.EncodeEarned(data.TotalEarned))
		end)
	end
	return ok
end

function DataService:GetEarnedStore()
	return earnedStore
end

function DataService:Get(player: Player)
	return profiles[player]
end

function DataService:IsLoaded(player: Player)
	return profiles[player] ~= nil
end

---------------------------------------------------------------------------
-- Duo wallet helpers
---------------------------------------------------------------------------
function DataService:GetWalletOwner(player: Player): Player
	local hostId = player:GetAttribute("DuoHost")
	if hostId then
		local host = Players:GetPlayerByUserId(hostId)
		if host and profiles[host] then
			return host
		end
	end
	return player
end

function DataService:GetPartner(host: Player): Player?
	local partnerId = host:GetAttribute("DuoPartner")
	if partnerId then
		local partner = Players:GetPlayerByUserId(partnerId)
		if partner and partner.Parent then
			return partner
		end
	end
	return nil
end

function DataService:GetWallet(player: Player)
	return profiles[self:GetWalletOwner(player)]
end

-- the host plus their partner (if any)
function DataService:GetTeam(player: Player): { Player }
	local host = self:GetWalletOwner(player)
	local team = { host }
	local partner = self:GetPartner(host)
	if partner then
		table.insert(team, partner)
	end
	return team
end

function DataService:TeamHasPass(player: Player, key: string): boolean
	if not S.MonetizationService then
		return false
	end
	for _, member in self:GetTeam(player) do
		if S.MonetizationService:HasPass(member, key) then
			return true
		end
	end
	return false
end

-- Global income multiplier of the wallet that `player` uses.
-- permanentOnly = the player's own rebirths + passes (no duo, boosts or events),
-- used for offline earnings
function DataService:GetMultiplier(player: Player, permanentOnly: boolean?): number
	if permanentOnly then
		local own = profiles[player]
		if not own then
			return 1
		end
		local mult = 1 + own.Rebirths * Config.Rebirth.MultiplierPerRebirth + Config.RebirthPerk(own.Rebirths, "Income") + Config.PetsBonus(own.Pets)
		local monetization = S and S.MonetizationService
		if monetization and monetization:HasPass(player, "DoubleCash") then
			mult *= 2
		end
		if monetization and monetization:HasPass(player, "VIP") then
			mult *= 1.5
		end
		return mult
	end
	local host = self:GetWalletOwner(player)
	local data = profiles[host]
	if not data then
		return 1
	end
	local mult = 1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth + Config.RebirthPerk(data.Rebirths, "Income")
	if self:TeamHasPass(host, "DoubleCash") then
		mult *= 2
	end
	if self:TeamHasPass(host, "VIP") then
		mult *= 1.5
	end
	local boosted = false
	for _, member in self:GetTeam(host) do
		local memberData = profiles[member]
		if memberData then
			mult += Config.PetsBonus(memberData.Pets) -- (a duo's pets both help)
			if memberData.BoostEnd > os.time() then
				boosted = true
			end
		end
	end
	if boosted then
		mult *= 2
	end
	local event = workspace:GetAttribute("EventMultiplier")
	if Util.IsFinite(event) and event > 0 then
		mult *= event
	end
	return mult * self:GetSocialBonus(host)
end

-- Premium + friends-in-the-server bonus of a wallet owner (see Config.Bonuses)
function DataService:GetSocialBonus(host: Player): number
	local bonus = 1
	if host.MembershipType == Enum.MembershipType.Premium then
		bonus *= 1 + Config.Bonuses.PremiumPercent / 100
	end
	local friends = math.min(tonumber(host:GetAttribute("FriendsHere")) or 0, Config.Bonuses.MaxFriends)
	return bonus * (1 + friends * Config.Bonuses.FriendPercent / 100)
end

function DataService:_updateFriends(player: Player)
	friendPairs[player] = friendPairs[player] or {}
	for _, other in Players:GetPlayers() do
		if other ~= player and friendPairs[player][other] == nil then
			local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
			local value = ok and isFriend == true
			friendPairs[player][other] = value
			friendPairs[other] = friendPairs[other] or {}
			friendPairs[other][player] = value
		end
	end
	self:_countFriends()
end

function DataService:_countFriends()
	for player, known in friendPairs do
		local n = 0
		for other, isFriend in known do
			if isFriend and other.Parent then
				n += 1
			end
		end
		if player.Parent and player:GetAttribute("FriendsHere") ~= n then
			player:SetAttribute("FriendsHere", n)
			self:RefreshMultiplier(player)
		end
	end
end

function DataService:RefreshMultiplier(player: Player)
	for _, member in self:GetTeam(player) do
		member:SetAttribute("Multiplier", self:GetMultiplier(member))
	end
end

local function syncWallet(target: Player, wallet)
	target:SetAttribute("Cash", wallet.Cash)
	target:SetAttribute("Vault", wallet.Vault)
	target:SetAttribute("TotalEarned", wallet.TotalEarned)
	target:SetAttribute("WalletRebirths", wallet.Rebirths)
	target:SetAttribute("RebirthCost", TycoonItems.GetRebirthCost(wallet.Rebirths))
	local leaderstats = target:FindFirstChild("leaderstats")
	if leaderstats then
		(leaderstats :: any).Cash.Value = Util.Money(wallet.Cash)
	end
end

-- Push data values to attributes + leaderstats (for the player and their duo team)
function DataService:Sync(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	-- personal values
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("BoostEnd", data.BoostEnd)
	player:SetAttribute("LastDaily", data.LastDaily)
	player:SetAttribute("DailyStreak", data.DailyStreak)
	player:SetAttribute("MusicVolume", data.Settings.MusicVolume)
	player:SetAttribute("SFX", data.Settings.SFX)
	player:SetAttribute("LowGraphics", data.Settings.LowGraphics)
	player:SetAttribute("Guide", data.Settings.Guide)
	player:SetAttribute("AutoBuild", data.Settings.AutoBuild)
	local found = {}
	for id in data.Secrets do
		table.insert(found, id)
	end
	player:SetAttribute("SecretsFound", table.concat(found, ","))
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		(leaderstats :: any).Rebirths.Value = data.Rebirths
	end
	-- wallet values (host's for a duo partner)
	local host = self:GetWalletOwner(player)
	local wallet = profiles[host] or data
	for _, member in self:GetTeam(host) do
		syncWallet(member, wallet)
	end
	self:RefreshMultiplier(player)
end

-- Add cash to the player's wallet. `earned` = counts toward TotalEarned (income), default true
-- every wallet change goes through these; a bad number (NaN / inf) must never
-- reach the saved data, so it's refused here (and totals are capped)
local MAX_CASH = 1e300

local function capped(n: number): number
	return math.clamp(n, 0, MAX_CASH)
end

local function validAmount(amount: any, what: string): boolean
	if Util.IsFinite(amount) then
		return true
	end
	warn("[DataService] Ignored invalid " .. what .. " amount: " .. tostring(amount))
	return false
end

function DataService:AddCash(player: Player, amount: number, earned: boolean?)
	if not validAmount(amount, "cash") then
		return
	end
	local host = self:GetWalletOwner(player)
	local data = profiles[host]
	if not data then
		return
	end
	data.Cash = capped(data.Cash + amount)
	if earned ~= false and amount > 0 then
		data.TotalEarned = capped(data.TotalEarned + amount)
	end
	self:Sync(host)
end

function DataService:SetCash(player: Player, amount: number)
	if not validAmount(amount, "cash") then
		return
	end
	local host = self:GetWalletOwner(player)
	local data = profiles[host]
	if not data then
		return
	end
	data.Cash = capped(amount)
	self:Sync(host)
end

function DataService:SpendCash(player: Player, amount: number): boolean
	if not validAmount(amount, "spend") or amount < 0 then
		return false
	end
	local host = self:GetWalletOwner(player)
	local data = profiles[host]
	if not data or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	self:Sync(host)
	return true
end

function DataService:AddVault(player: Player, amount: number)
	if not validAmount(amount, "vault") then
		return
	end
	local host = self:GetWalletOwner(player)
	local data = profiles[host]
	if not data then
		return
	end
	data.Vault = capped(data.Vault + amount)
	data.TotalEarned = capped(data.TotalEarned + amount)
	for _, member in self:GetTeam(host) do
		member:SetAttribute("Vault", data.Vault)
		member:SetAttribute("TotalEarned", data.TotalEarned)
	end
end

-- moves the vault into the wallet (TotalEarned was already counted)
function DataService:CollectVault(player: Player): number
	local host = self:GetWalletOwner(player)
	local data = profiles[host]
	if not data or data.Vault <= 0 then
		return 0
	end
	local amount = data.Vault
	data.Vault = 0
	data.Cash = capped(data.Cash + amount)
	self:Sync(host)
	return amount
end

function DataService:AddBoost(player: Player, seconds: number)
	if not validAmount(seconds, "boost") then
		return
	end
	local data = profiles[player]
	if not data then
		return
	end
	data.BoostEnd = math.max(data.BoostEnd, os.time()) + seconds
	self:Sync(player)
end

function DataService:ResetData(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	local fresh = Util.DeepCopy(TEMPLATE)
	fresh.Passes = data.Passes -- never take away paid stuff
	for k in data do
		data[k] = nil
	end
	for k, v in fresh do
		data[k] = v
	end
	self:Sync(player)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">DisasterService</string>
          <string name="Source"><![CDATA[--[[
	DisasterService - random server-wide disasters:
	  ☢️ Nuke      siren + countdown, hide in a bunker / shield dome or get
	               vaporized; the shockwave wrecks part of unshielded towers
	  ☄️ Meteors   meteors rain down; hits hurt players, wreck tower items and
	               leave cash crystals on the ground
	  🌪️ Tornado   a tornado sweeps across the map flinging players and
	               wrecking whatever it touches
	  🛸 UFO       UFOs abduct players and drop alien cash
	Wrecked items rebuild themselves after a while (or with Instant Repair).
	The Nuke Shield Dome (floor 2 special) protects a tower and everyone in it.

	Visuals are rendered on the clients (Disasters controller); the server only
	decides what happens and when.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local DC = Config.Disasters

local DisasterService = {}
local S

local active: string? = nil
local queue = {}
local stopRequested = false
local folder: Folder
local rng = Random.new()

local KINDS = { "Nuke", "Meteors", "Tornado", "UFO", "Earthquake" }
local TITLES = {
	Nuke = "☢️ NUKE INCOMING!",
	Meteors = "☄️ METEOR STORM!",
	Tornado = "🌪️ TORNADO WARNING!",
	UFO = "🛸 UFO INVASION!",
	Earthquake = "🌍 EARTHQUAKE!",
}

local function broadcast(state)
	Remotes.Disaster:FireAllClients(state)
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

-- players on the main map (not in the sky minigame arena)
local function mainMapPlayers(): { { Player: Player, Root: BasePart, Humanoid: Humanoid } }
	local list = {}
	for _, player in Players:GetPlayers() do
		local root, humanoid = getRoot(player), getHumanoid(player)
		if root and humanoid and humanoid.Health > 0 and not player:GetAttribute("InMinigame") and root.Position.Y < DC.MainMapMaxY then
			table.insert(list, { Player = player, Root = root, Humanoid = humanoid })
		end
	end
	return list
end

local function insideBox(position: Vector3, cf: CFrame, size: Vector3): boolean
	local p = cf:PointToObjectSpace(position)
	return math.abs(p.X) <= size.X / 2 and math.abs(p.Y) <= size.Y / 2 + 2 and math.abs(p.Z) <= size.Z / 2
end

function DisasterService:IsSheltered(position: Vector3): boolean
	local public = S.WorldBuilder.Shelter
	if public and insideBox(position, public.CFrame, public.Size) then
		return true
	end
	local boxes, spheres = S.TycoonService:GetShelters()
	for _, box in boxes do
		if insideBox(position, box.CFrame, box.Size) then
			return true
		end
	end
	for _, sphere in spheres do
		if (position - sphere.Center).Magnitude <= sphere.Radius then
			return true
		end
	end
	return false
end

-- sheltered (bunker, dome, roof) or wearing a personal shield
function DisasterService:IsProtected(player: Player, position: Vector3): boolean
	return self:IsSheltered(position) or (S.ShieldService ~= nil and S.ShieldService:IsShielded(player))
end

function DisasterService:GetShelterInfo()
	local boxes, spheres, doors = S.TycoonService:GetShelters()
	local public = S.WorldBuilder.Shelter
	if public then
		table.insert(boxes, 1, { CFrame = public.CFrame, Size = public.Size })
		table.insert(doors, 1, public.Door)
	end
	return { Boxes = boxes, Spheres = spheres, Doors = doors }
end

function DisasterService:IsActive(): boolean
	return active ~= nil
end

local function fling(player: Player, velocity: Vector3)
	Remotes.ClientCommand:FireClient(player, "fling", velocity)
end

local function rewardFor(player: Player, seconds: number, minimum: number): number
	local data = S.DataService:Get(S.DataService:GetWalletOwner(player))
	local rebirths = data and data.Rebirths or 0
	return math.max(minimum * (1 + rebirths), S.TycoonService:GetIncome(player) * seconds)
end

-- a collectible that pays a few seconds of income
local function spawnCollectible(position: Vector3, kind: string, seconds: number, minimum: number, anchored: boolean)
	local color = kind == "Crystal" and Color3.fromRGB(0, 255, 220) or Color3.fromRGB(120, 255, 80)
	local part = BuildKit.Part({
		Name = kind,
		Shape = kind == "Crystal" and Enum.PartType.Block or Enum.PartType.Ball,
		Size = kind == "Crystal" and Vector3.new(1.6, 3, 1.6) or Vector3.one * 2,
		CFrame = CFrame.new(position) * (kind == "Crystal" and CFrame.Angles(0, 0, math.rad(15)) or CFrame.identity),
		Color = color,
		Material = Enum.Material.Neon,
		Anchored = anchored,
		CanCollide = not anchored,
		Tags = anchored and { "Spin", "Bob" } or {},
		Parent = folder,
	})
	BuildKit.Light(part, color, 12, 2)
	BuildKit.Billboard(part, kind == "Crystal" and "💎 CASH CRYSTAL" or "👽 ALIEN CASH", { Size = UDim2.fromOffset(130, 24), Offset = Vector3.new(0, 2.5, 0), Color = color, MaxDistance = 70 })
	if not anchored then
		pcall(function()
			part:SetNetworkOwner(nil)
		end)
	end
	local taken = false
	part.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = BuildKit.PlayerFromHit(hit)
		if player and BuildKit.IsNear(player, part) then
			taken = true
			local amount = rewardFor(player, seconds, minimum)
			S.DataService:AddCash(player, amount, false)
			Remotes.VFX:FireClient(player, "CoinPop", { Position = part.Position })
			Remotes.Notify:FireClient(player, { Text = (kind == "Crystal" and "💎 Cash crystal" or "👽 Alien cash") .. ": +" .. Util.Money(amount), Type = "success", Duration = 3 })
			part:Destroy()
		end
	end)
	task.delay(30, function()
		if part.Parent then
			part:Destroy()
		end
	end)
	return part
end

local function notifyPlot(plot, text: string, kind: string?)
	for _, member in { plot.Owner, plot.Partner } do
		if member then
			Remotes.Notify:FireClient(member, { Text = text, Type = kind or "error", Duration = 7 })
		end
	end
end

---------------------------------------------------------------------------
-- ☢️ Nuke
---------------------------------------------------------------------------
local handlers = {}

function handlers.Nuke(by: string?)
	local cfg = DC.Nuke
	local target = Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
	Remotes.Announce:FireAllClients({
		Title = TITLES.Nuke,
		Text = (by and (by .. " launched a nuke! ") or "") .. "Get inside a bunker in " .. cfg.Warning .. " seconds!",
		Color = Color3.fromRGB(255, 60, 40),
	})
	for t = cfg.Warning, 1, -1 do
		if stopRequested then
			return
		end
		broadcast({ Phase = "Warning", Kind = "Nuke", TimeLeft = t, Target = target, Shelters = DisasterService:GetShelterInfo(), By = by })
		task.wait(1)
	end
	broadcast({ Phase = "Impact", Kind = "Nuke", Target = target, ShockSpeed = cfg.ShockSpeed })

	local start = os.clock()
	local hitPlayers, hitPlots = {}, {}
	local maxRadius = 1500
	while not stopRequested do
		local radius = (os.clock() - start) * cfg.ShockSpeed
		for _, info in mainMapPlayers() do
			local player = info.Player
			if not hitPlayers[player] and (info.Root.Position - target).Magnitude <= radius then
				hitPlayers[player] = true
				if DisasterService:IsProtected(info.Player, info.Root.Position) then
					Remotes.Notify:FireClient(player, { Text = DisasterService:IsSheltered(info.Root.Position) and "🛡️ You survived the nuke! Smart move." or "🛡️ Your shield absorbed the nuke!", Type = "success" })
				else
					local away = info.Root.Position - target
					local dir = away.Magnitude > 1 and away.Unit or Vector3.new(0, 0, 1)
					fling(player, dir * 120 + Vector3.new(0, 80, 0))
					Remotes.ClientCommand:FireClient(player, "vaporized")
					info.Humanoid:TakeDamage(1e9)
				end
			end
		end
		for _, plot in S.TycoonService:GetPlots() do
			if plot.Owner and not hitPlots[plot] then
				local d = (plot.TowerCF.Position - target) * Vector3.new(1, 0, 1)
				if d.Magnitude <= radius then
					hitPlots[plot] = true
					if S.TycoonService:IsShielded(plot) then
						Remotes.VFX:FireAllClients("ShieldHit", { Center = plot.ShieldCenter, Radius = plot.ShieldRadius })
						notifyPlot(plot, "🛡️ Your Nuke Shield Dome protected your tower!", "success")
					else
						local wrecked = S.TycoonService:KnockOutFraction(plot, cfg.KnockoutFraction, cfg.KnockoutSeconds)
						if wrecked > 0 then
							notifyPlot(plot, "☢️ The nuke wrecked " .. wrecked .. " upgrades! They rebuild in " .. Util.FormatTime(cfg.KnockoutSeconds) .. " (or buy Instant Repair). Get the Nuke Shield on floor 2!")
						end
					end
				end
			end
		end
		if radius > maxRadius then
			break
		end
		task.wait(0.1)
	end
	broadcast({ Phase = "Aftermath", Kind = "Nuke", Duration = 25 })
	task.wait(4)
end

---------------------------------------------------------------------------
-- ☄️ Meteors
---------------------------------------------------------------------------
local function meteorImpact(target: Vector3, cfg)
	local plot = S.TycoonService:PlotAt(target)
	local shielded = plot ~= nil and S.TycoonService:IsShielded(plot)
	local impact = target
	if plot and shielded then
		local c, r = plot.ShieldCenter, plot.ShieldRadius
		local dx, dz = target.X - c.X, target.Z - c.Z
		impact = Vector3.new(target.X, c.Y + math.sqrt(math.max(r * r - dx * dx - dz * dz, 0)), target.Z)
	elseif plot then
		-- hits the top of the tower
		local floors = 0
		for f = 1, Config.Tycoon.Floors do
			if S.TycoonService:IsFloorUnlocked(plot, f) then
				floors = f
			end
		end
		impact = Vector3.new(target.X, plot.TowerCF.Position.Y + floors * Config.Tycoon.FloorHeight, target.Z)
	else
		-- find the ground (terrain, trees, buildings)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local exclude = { folder }
		for _, p in Players:GetPlayers() do
			if p.Character then
				table.insert(exclude, p.Character)
			end
		end
		params.FilterDescendantsInstances = exclude
		local result = workspace:Raycast(Vector3.new(target.X, 450, target.Z), Vector3.new(0, -900, 0), params)
		if result then
			impact = result.Position
		end
	end
	broadcast({ Phase = "Meteor", Kind = "Meteors", Target = impact, Delay = 1.4, Radius = cfg.Radius, Shield = shielded })
	task.delay(1.4, function()
		if stopRequested then
			return
		end
		for _, info in mainMapPlayers() do
			local d = (info.Root.Position - impact).Magnitude
			if d <= cfg.Radius and not DisasterService:IsProtected(info.Player, info.Root.Position) then
				info.Humanoid:TakeDamage(cfg.Damage)
				local away = info.Root.Position - impact
				fling(info.Player, (away.Magnitude > 0.1 and away.Unit or Vector3.yAxis) * 60 + Vector3.new(0, 50, 0))
			end
		end
		if plot and not shielded then
			local wrecked = S.TycoonService:KnockOutNear(plot, impact, 20, 2, cfg.KnockoutSeconds)
			if wrecked > 0 then
				notifyPlot(plot, "☄️ A meteor wrecked " .. wrecked .. " of your upgrades!")
			end
		elseif not plot and rng:NextNumber() < cfg.CrystalChance and impact.Y < 50 then
			spawnCollectible(impact + Vector3.new(0, 2, 0), "Crystal", cfg.CrystalIncomeSeconds, 1000, true)
		end
	end)
end

function handlers.Meteors(by: string?)
	local cfg = DC.Meteors
	Remotes.Announce:FireAllClients({
		Title = TITLES.Meteors,
		Text = (by and (by .. " called a meteor storm! ") or "") .. "Dodge the red circles and grab the cash crystals!",
		Color = Color3.fromRGB(255, 120, 30),
	})
	local endTime = os.clock() + cfg.Duration
	local lastTick = 0
	while os.clock() < endTime and not stopRequested do
		local now = os.clock()
		if now - lastTick >= 1 then
			lastTick = now
			broadcast({ Phase = "Active", Kind = "Meteors", TimeLeft = math.ceil(endTime - now) })
		end
		local players = mainMapPlayers()
		local target
		if #players > 0 and rng:NextNumber() < 0.45 then
			local pick = players[rng:NextInteger(1, #players)]
			target = pick.Root.Position + Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
			target = Vector3.new(target.X, 0, target.Z)
		else
			local a = rng:NextNumber(0, math.pi * 2)
			local r = math.sqrt(rng:NextNumber()) * 650
			target = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		end
		meteorImpact(target, cfg)
		task.wait(cfg.Interval * rng:NextNumber(0.7, 1.3))
	end
	task.wait(2)
end

---------------------------------------------------------------------------
-- 🌪️ Tornado
---------------------------------------------------------------------------
local function persistentCore(name: string, tag: string, position: Vector3)
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local core = BuildKit.Part({ Name = "Core", Size = Vector3.one * 2, Position = position, Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = model })
	model.PrimaryPart = core
	core:AddTag(tag)
	model.Parent = folder
	return model, core
end

function handlers.Tornado(by: string?)
	local cfg = DC.Tornado
	Remotes.Announce:FireAllClients({
		Title = TITLES.Tornado,
		Text = (by and (by .. " summoned a tornado! ") or "") .. "Stay away from it - or hide under your Nuke Shield!",
		Color = Color3.fromRGB(160, 170, 190),
	})
	local a = rng:NextNumber(0, math.pi * 2)
	local startPos = Vector3.new(math.cos(a) * 700, 0, math.sin(a) * 700)
	local mid = Vector3.new(rng:NextNumber(-150, 150), 0, rng:NextNumber(-150, 150))
	local b = a + math.pi + rng:NextNumber(-0.6, 0.6)
	local endPos = Vector3.new(math.cos(b) * 700, 0, math.sin(b) * 700)
	local total = (mid - startPos).Magnitude + (endPos - mid).Magnitude

	local model, core = persistentCore("Tornado", "Tornado", startPos)
	core:SetAttribute("Radius", cfg.Radius)
	local startTime = os.clock()
	local lastEffect, lastWreck, lastTick = 0, 0, 0
	local wreckedPlots = {}
	while not stopRequested do
		local elapsed = os.clock() - startTime
		if elapsed >= cfg.Duration then
			break
		end
		local dist = elapsed / cfg.Duration * total
		local pos
		local first = (mid - startPos).Magnitude
		if dist <= first then
			pos = startPos:Lerp(mid, dist / first)
		else
			pos = mid:Lerp(endPos, (dist - first) / (total - first))
		end
		pos += Vector3.new(math.sin(elapsed * 1.7) * 6, 0, math.cos(elapsed * 1.3) * 6)
		core.CFrame = CFrame.new(pos)
		local now = os.clock()
		if now - lastTick >= 1 then
			lastTick = now
			broadcast({ Phase = "Active", Kind = "Tornado", TimeLeft = math.ceil(cfg.Duration - elapsed) })
		end
		if now - lastEffect >= 0.25 then
			lastEffect = now
			for _, info in mainMapPlayers() do
				local flat = (info.Root.Position - pos) * Vector3.new(1, 0, 1)
				if flat.Magnitude <= cfg.Radius and info.Root.Position.Y < 220 and not DisasterService:IsProtected(info.Player, info.Root.Position) then
					Remotes.ClientCommand:FireClient(info.Player, "tornado", pos)
					info.Humanoid:TakeDamage(3)
				end
			end
		end
		if now - lastWreck >= 0.5 then
			lastWreck = now
			for _, plot in S.TycoonService:GetPlots() do
				if plot.Owner and not S.TycoonService:IsShielded(plot) then
					local flat = (plot.TowerCF.Position - pos) * Vector3.new(1, 0, 1)
					if flat.Magnitude < 90 then
						local wrecked = S.TycoonService:KnockOutNear(plot, pos, cfg.Radius, 3, cfg.KnockoutSeconds, true)
						if wrecked > 0 and not wreckedPlots[plot] then
							wreckedPlots[plot] = true
							notifyPlot(plot, "🌪️ The tornado is tearing through your tower!")
						end
					end
				end
			end
		end
		task.wait(0.1)
	end
	model:Destroy()
end

---------------------------------------------------------------------------
-- 🛸 UFO
---------------------------------------------------------------------------
function handlers.UFO(by: string?)
	local cfg = DC.UFO
	Remotes.Announce:FireAllClients({
		Title = TITLES.UFO,
		Text = (by and (by .. " called the aliens! ") or "") .. "Watch out for tractor beams - and grab the alien cash!",
		Color = Color3.fromRGB(120, 255, 80),
	})
	local ufos = {}
	for i = 1, cfg.Count do
		local a = i / cfg.Count * math.pi * 2
		local start = Vector3.new(math.cos(a) * 600, 120, math.sin(a) * 600)
		local model, core = persistentCore("UFO" .. i, "UFO", start)
		core:SetAttribute("BeamOn", false)
		table.insert(ufos, { Model = model, Core = core, Pos = start, Target = Vector3.new(rng:NextNumber(-400, 400), 120, rng:NextNumber(-400, 400)), NextAbduct = os.clock() + rng:NextNumber(2, cfg.AbductEvery), Busy = false })
	end
	local endTime = os.clock() + cfg.Duration
	local lastCash, lastTick = 0, 0
	local last = os.clock()
	while os.clock() < endTime and not stopRequested do
		local now = os.clock()
		local dt = now - last
		last = now
		if now - lastTick >= 1 then
			lastTick = now
			broadcast({ Phase = "Active", Kind = "UFO", TimeLeft = math.ceil(endTime - now) })
		end
		local players = mainMapPlayers()
		for _, ufo in ufos do
			if not ufo.Busy then
				local delta = ufo.Target - ufo.Pos
				if delta.Magnitude < 5 then
					ufo.Target = Vector3.new(rng:NextNumber(-500, 500), 120, rng:NextNumber(-500, 500))
				else
					ufo.Pos += delta.Unit * math.min(delta.Magnitude, 45 * dt)
				end
				-- abduct the nearest exposed player
				if now >= ufo.NextAbduct then
					ufo.NextAbduct = now + cfg.AbductEvery
					local best, bestD = nil, 180
					for _, info in players do
						local flat = (info.Root.Position - ufo.Pos) * Vector3.new(1, 0, 1)
						if flat.Magnitude < bestD and not DisasterService:IsProtected(info.Player, info.Root.Position) then
							best, bestD = info, flat.Magnitude
						end
					end
					if best then
						ufo.Busy = true
						local victim = best
						task.spawn(function()
							-- fly over the victim, beam them up, drop them
							local hover = victim.Root.Position + Vector3.new(0, 60, 0)
							local t0 = os.clock()
							local from = ufo.Pos
							while os.clock() - t0 < 1.2 do
								ufo.Pos = from:Lerp(hover, (os.clock() - t0) / 1.2)
								ufo.Core.CFrame = CFrame.new(ufo.Pos)
								task.wait()
							end
							ufo.Pos = hover
							ufo.Core.CFrame = CFrame.new(hover)
							ufo.Core:SetAttribute("BeamOn", true)
							if victim.Player.Parent then
								Remotes.ClientCommand:FireClient(victim.Player, "abduct", hover - Vector3.new(0, 6, 0), 2.5)
							end
							task.wait(2.8)
							ufo.Core:SetAttribute("BeamOn", false)
							spawnCollectible(hover - Vector3.new(0, 8, 0), "AlienCash", cfg.CashIncomeSeconds, 500, false)
							ufo.Busy = false
						end)
					end
				end
				ufo.Core.CFrame = CFrame.new(ufo.Pos)
			end
		end
		if now - lastCash >= cfg.CashEvery then
			lastCash = now
			local ufo = ufos[rng:NextInteger(1, #ufos)]
			if not ufo.Busy then
				spawnCollectible(ufo.Pos - Vector3.new(0, 8, 0), "AlienCash", cfg.CashIncomeSeconds, 500, false)
			end
		end
		task.wait(0.05)
	end
	for _, ufo in ufos do
		ufo.Model:Destroy()
	end
end

---------------------------------------------------------------------------
-- 🌍 Earthquake
---------------------------------------------------------------------------
local function crack(position: Vector3, length: number, angle: number)
	local cf = CFrame.new(position) * CFrame.Angles(0, angle, 0)
	local model = Instance.new("Model")
	model.Name = "Crack"
	BuildKit.Part({ Name = "Rim", Size = Vector3.new(2.2, 0.4, length), CFrame = cf, Color = Color3.fromRGB(45, 35, 28), Material = Enum.Material.Slate, CanCollide = false, CanTouch = false, CanQuery = false, Parent = model })
	BuildKit.Part({ Name = "Glow", Size = Vector3.new(0.8, 0.5, length - 1), CFrame = cf, Color = Color3.fromRGB(255, 110, 20), Material = Enum.Material.Neon, CanCollide = false, CanTouch = false, CanQuery = false, Parent = model })
	model.Parent = folder
	return model
end

function handlers.Earthquake(by: string?)
	local cfg = DC.Earthquake
	Remotes.Announce:FireAllClients({
		Title = TITLES.Earthquake,
		Text = (by and (by .. " shook the ground! ") or "") .. "Hold on tight - and grab the cash geodes it digs up!",
		Color = Color3.fromRGB(210, 150, 90),
	})
	for _ = 1, cfg.GeodeCount do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(40, 220)
		spawnCollectible(Vector3.new(math.cos(a) * r, 2.5, math.sin(a) * r), "Crystal", cfg.GeodeIncomeSeconds, 750, true)
	end
	local cracks = {}
	local notified = {}
	local endTime = os.clock() + cfg.Duration
	local nextShock = os.clock() + 1
	local lastTick = 0
	while os.clock() < endTime and not stopRequested do
		local now = os.clock()
		if now - lastTick >= 1 then
			lastTick = now
			broadcast({ Phase = "Active", Kind = "Earthquake", TimeLeft = math.ceil(endTime - now) })
		end
		if now >= nextShock then
			nextShock = now + cfg.WaveEvery
			broadcast({ Phase = "Shock", Kind = "Earthquake", Intensity = rng:NextNumber(0.6, 1) })
			for _, info in mainMapPlayers() do
				if not DisasterService:IsProtected(info.Player, info.Root.Position) then
					info.Humanoid:TakeDamage(cfg.Damage)
					fling(info.Player, Vector3.new(rng:NextNumber(-12, 12), 28, rng:NextNumber(-12, 12)))
				end
			end
			for _, plot in S.TycoonService:GetPlots() do
				if plot.Owner and not S.TycoonService:IsShielded(plot) then
					local wrecked = S.TycoonService:KnockOutFraction(plot, cfg.KnockoutFraction, cfg.KnockoutSeconds)
					if wrecked > 0 and not notified[plot] then
						notified[plot] = true
						notifyPlot(plot, "🌍 The earthquake is shaking your tower apart! Wrecked upgrades rebuild by themselves.")
					end
				end
			end
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(20, 200)
			table.insert(cracks, crack(Vector3.new(math.cos(a) * r, 0.6, math.sin(a) * r), rng:NextNumber(18, 45), rng:NextNumber(0, math.pi)))
		end
		task.wait(0.1)
	end
	task.wait(1)
	for _, model in cracks do
		model:Destroy()
	end
end

---------------------------------------------------------------------------
function DisasterService:Init(services)
	S = services
	folder = Instance.new("Folder")
	folder.Name = "Disasters"
	folder.Parent = workspace
end

function DisasterService:_run(kind: string, by: string?)
	active = kind
	stopRequested = false
	workspace:SetAttribute("Disaster", kind)
	-- who's out there (survivors = same character, still alive at the end)
	local present = {}
	for _, info in mainMapPlayers() do
		present[info.Player] = info.Player.Character
	end
	local ok, err = pcall(handlers[kind], by)
	if not ok then
		warn("[Disasters] " .. kind .. " failed: " .. tostring(err))
	end
	for player, character in present do
		local humanoid = getHumanoid(player)
		if player.Parent and player.Character == character and humanoid and humanoid.Health > 0 and S.QuestService then
			S.QuestService:Progress(player, "Survive", 1)
		end
	end
	broadcast({ Phase = "End", Kind = kind })
	workspace:SetAttribute("Disaster", nil)
	active = nil
	stopRequested = false
end

function DisasterService:Start()
	if not DC.Enabled then
		-- still allow forced (bought / admin) disasters
		while true do
			if #queue > 0 then
				local job = table.remove(queue, 1)
				self:_run(job.Kind, job.By)
			end
			task.wait(1)
		end
	end
	local nextTime = os.clock() + DC.FirstDelay
	while true do
		if #queue > 0 then
			local job = table.remove(queue, 1)
			self:_run(job.Kind, job.By)
			nextTime = math.max(nextTime, os.clock() + 60)
		elseif os.clock() >= nextTime then
			local total = 0
			for _, kind in KINDS do
				total += DC[kind].Weight
			end
			local roll = rng:NextNumber(0, total)
			local pick = KINDS[1]
			for _, kind in KINDS do
				roll -= DC[kind].Weight
				if roll <= 0 then
					pick = kind
					break
				end
			end
			self:_run(pick, nil)
			nextTime = os.clock() + rng:NextNumber(DC.MinInterval, DC.MaxInterval)
		end
		task.wait(1)
	end
end

-- start (or queue) a disaster. by = name shown in the announcement
function DisasterService:Trigger(kind: string, by: string?): string
	local key
	for _, k in KINDS do
		if k:lower() == tostring(kind):lower() then
			key = k
		end
	end
	if not key then
		return "Unknown disaster. Options: " .. table.concat(KINDS, ", ")
	end
	table.insert(queue, { Kind = key, By = by })
	if active then
		return key .. " queued (a " .. active .. " is happening right now)"
	end
	return key .. " incoming!"
end

function DisasterService:Stop(): string
	if not active then
		return "No disaster is active"
	end
	stopRequested = true
	queue = {}
	return "Stopping " .. tostring(active)
end

return DisasterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DuoService</string>
          <string name="Source"><![CDATA[--[[
	DuoService - invite a friend to build ONE tower together with ONE shared
	wallet. Progress saves to the tower owner (host). When the duo ends,
	the partner gets their own tower back with their own saved progress.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DuoService = {}
local S

local invites: { [Player]: { Host: Player, Expires: number } } = {}
local cooldown: { [Player]: number } = {}

local function inDuo(player: Player): boolean
	return player:GetAttribute("DuoHost") ~= nil or player:GetAttribute("DuoPartner") ~= nil
end

function DuoService:Init(services)
	S = services
	if not Config.Duo.Enabled then
		return
	end

	Remotes.DuoInvite.OnServerEvent:Connect(function(host, targetUserId)
		local target = typeof(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
		if target then
			self:Invite(host, target)
		end
	end)
	Remotes.DuoRespond.OnServerEvent:Connect(function(player, hostUserId, accept)
		self:Respond(player, hostUserId, accept == true)
	end)
	Remotes.DuoLeave.OnServerEvent:Connect(function(player)
		self:Leave(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		invites[player] = nil
		cooldown[player] = nil
	end)
end

function DuoService:Invite(host: Player, target: Player): (boolean, string)
	local function fail(message: string)
		Remotes.Notify:FireClient(host, { Text = message, Type = "error" })
		return false, message
	end
	if host == target then
		return fail("You can't invite yourself!")
	end
	if cooldown[host] and os.clock() - cooldown[host] < 4 then
		return fail("Wait a moment before inviting again.")
	end
	local plot = S.TycoonService:GetPlot(host)
	if not plot or plot.Owner ~= host then
		return fail("You need your own tower to invite someone.")
	end
	if plot.Partner then
		return fail("You already have a duo partner!")
	end
	if inDuo(target) then
		return fail(target.DisplayName .. " is already in a duo.")
	end
	if not S.DataService:IsLoaded(target) then
		return fail(target.DisplayName .. " is still loading.")
	end
	cooldown[host] = os.clock()
	invites[target] = { Host = host, Expires = os.clock() + Config.Duo.InviteTimeout }
	Remotes.DuoInvited:FireClient(target, { HostName = host.DisplayName, HostUserId = host.UserId, Timeout = Config.Duo.InviteTimeout })
	Remotes.Notify:FireClient(host, { Text = "Duo invite sent to " .. target.DisplayName .. "!", Type = "success" })
	return true, "Invite sent"
end

function DuoService:Respond(player: Player, hostUserId: any, accept: boolean)
	local invite = invites[player]
	invites[player] = nil
	if not invite or invite.Host.UserId ~= hostUserId then
		return
	end
	local host = invite.Host
	if not accept then
		if host.Parent then
			Remotes.Notify:FireClient(host, { Text = player.DisplayName .. " declined your duo invite.", Type = "info" })
		end
		return
	end
	if os.clock() > invite.Expires or not host.Parent then
		Remotes.Notify:FireClient(player, { Text = "That invite expired.", Type = "error" })
		return
	end
	self:Join(host, player)
end

function DuoService:Join(host: Player, partner: Player): (boolean, string)
	if inDuo(host) then
		return false, host.DisplayName .. " is already in a duo"
	end
	if inDuo(partner) then
		return false, partner.DisplayName .. " is already in a duo"
	end
	if partner:GetAttribute("InMinigame") then
		return false, partner.DisplayName .. " is in a minigame"
	end
	local ok = S.TycoonService:AddPartner(host, partner)
	if not ok then
		Remotes.Notify:FireClient(partner, { Text = "Couldn't join that tower.", Type = "error" })
		return false, "Couldn't join"
	end
	Remotes.Notify:FireClient(partner, { Text = "👥 You're now building with " .. host.DisplayName .. "! You share one wallet. Your own tower is saved for later.", Type = "success", Duration = 8 })
	Remotes.Notify:FireClient(host, { Text = "👥 " .. partner.DisplayName .. " joined your tower!", Type = "success", Duration = 6 })
	Remotes.Announce:FireAllClients({ Title = "👥 NEW DUO!", Text = host.DisplayName .. " & " .. partner.DisplayName .. " are building together", Color = Color3.fromRGB(0, 200, 255) })
	Remotes.VFX:FireClient(host, "Confetti", {})
	Remotes.VFX:FireClient(partner, "Confetti", {})
	return true, "Duo formed"
end

-- partner leaves, or host kicks their partner
function DuoService:Leave(player: Player)
	local plot = S.TycoonService:GetPlot(player)
	if not plot or not plot.Partner then
		return
	end
	local partner = plot.Partner
	local host = plot.Owner
	S.TycoonService:RemovePartner(plot, true)
	if host and host.Parent then
		Remotes.Notify:FireClient(host, { Text = (player == host and "You ended the duo." or (partner.DisplayName .. " left your duo.")), Type = "info" })
	end
	if partner.Parent then
		Remotes.Notify:FireClient(partner, { Text = (player == partner and "You left the duo. Back to your own tower!" or (host.DisplayName .. " ended the duo. Back to your own tower!")), Type = "info", Duration = 6 })
	end
end

return DuoService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">GiftService</string>
          <string name="Source"><![CDATA[--[[
	GiftService - playtime gifts (see Config.Gifts). The longer you play today,
	the more gifts unlock; each pays minutes of your income and the last one
	also gives a 2x boost. Time played and the gifts opened are SAVED, so
	leaving and rejoining doesn't restart the wait. A new UTC day starts over.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local GC = Config.Gifts

local GiftService = {}
local S

-- when this visit's playtime was last added to the saved total
local sessions: { [Player]: { Start: number } } = {}

local function today(): number
	return os.time() // 86400
end

-- adds the time played since the last call to the saved total (and starts a new day over)
function GiftService:_bank(player: Player)
	local session = sessions[player]
	local data = S.DataService:Get(player)
	if not session or not data then
		return
	end
	local gifts = data.Gifts
	local now = os.time()
	if gifts.Day ~= today() then
		gifts.Day, gifts.Index, gifts.Played = today(), 1, 0
		session.Start = now
		return
	end
	gifts.Played += math.max(0, now - session.Start)
	session.Start = now
end

function GiftService:GetState(player: Player)
	local data = S.DataService:Get(player)
	if not data or not sessions[player] then
		return nil
	end
	self:_bank(player)
	local gifts = data.Gifts
	local total = #GC.Minutes
	if gifts.Index > total then
		return { Index = gifts.Index, Total = total, ReadyIn = -1 }
	end
	return { Index = gifts.Index, Total = total, ReadyIn = math.max(0, GC.Minutes[gifts.Index] * 60 - gifts.Played) }
end

function GiftService:_send(player: Player)
	local state = self:GetState(player)
	if state and player.Parent then
		Remotes.GiftUpdate:FireClient(player, state)
	end
end

function GiftService:GetReward(player: Player, index: number): number
	local wallet = S.DataService:GetWallet(player)
	local rebirths = wallet and wallet.Rebirths or 0
	local cash = math.max(GC.MinCash[index] * (1 + rebirths), S.TycoonService:GetIncome(player) * GC.IncomeMinutes[index] * 60)
	return math.floor(cash * (1 + Config.RebirthPerk(rebirths, "Gift")))
end

function GiftService:Claim(player: Player): (boolean, string)
	local state = self:GetState(player)
	if not state then
		return false, "Data still loading..."
	end
	local data = S.DataService:Get(player)
	if state.ReadyIn < 0 then
		return false, "You opened every gift today! Come back tomorrow."
	end
	if state.ReadyIn > 0 then
		return false, "Your next gift opens in " .. Util.FormatTime(state.ReadyIn)
	end
	local index = state.Index
	data.Gifts.Index += 1
	local cash = self:GetReward(player, index)
	S.DataService:AddCash(player, cash, false)
	local text = "🎁 Gift " .. index .. "/" .. #GC.Minutes .. ": +" .. Util.Money(cash)
	if index == #GC.Minutes and GC.FinalBoostSeconds then
		S.DataService:AddBoost(player, GC.FinalBoostSeconds)
		text ..= " & 2x Boost!"
	end
	Remotes.VFX:FireClient(player, "CashBurst", { Amount = cash })
	Remotes.VFX:FireClient(player, "Confetti", {})
	self:_send(player)
	return true, text
end

function GiftService:Init(services)
	S = services
	if not GC.Enabled then
		return
	end
	Remotes.ClaimGift.OnServerInvoke = function(player)
		return self:Claim(player)
	end
	S.DataService.PlayerLoaded:Connect(function(player)
		sessions[player] = { Start = os.time() }
		self:_bank(player) -- (starts a new day over)
		self:_send(player)
	end)
	-- the time played so far is saved with the rest of the data
	S.DataService.BeforeSave:Connect(function(player)
		self:_bank(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

-- a new day while someone is playing: their gifts start over
function GiftService:Start()
	if not GC.Enabled then
		return
	end
	while true do
		task.wait(30)
		for player in sessions do
			local data = S.DataService:Get(player)
			if data and data.Gifts.Day ~= today() then
				Util.Try("Gifts", self._send, self, player)
			end
		end
	end
end

return GiftService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">IslandService</string>
          <string name="Source"><![CDATA[--[[
	IslandService - the far islands (see Config.Islands): travelling there and
	the treasure chests. Each chest closes for Cooldown seconds after YOU open
	it; the time is saved with your data, so rejoining doesn't reopen it.
	Players get attributes the Travel panel shows:
	  ChestsReady_<island>  chests you can open now
	  ChestNext_<island>    when your next closed chest opens (epoch, 0 = none)
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local IC = Config.Islands

local IslandService = {}
local S

local islandById = {}
for _, island in IC.List do
	islandById[island.Id] = island
end

local lastTravel: { [Player]: number } = {}
local lastChestNote: { [Player]: { [string]: number } } = {}

function IslandService:_unlocked(player: Player, island): boolean
	local data = S.DataService:Get(player)
	return data ~= nil and data.Rebirths >= island.Rebirths
end

-- (ready now, the earliest time a closed chest opens or 0)
function IslandService:_status(player: Player, islandId: string): (number, number)
	local data = S.DataService:Get(player)
	local ready, nextAt = 0, 0
	if not data then
		return 0, 0
	end
	for _, entry in S.WorldBuilder.Chests do
		if entry.Island == islandId then
			local openAt = (data.Chests[entry.Id] or 0) + IC.Cooldown
			if os.time() >= openAt then
				ready += 1
			elseif nextAt == 0 or openAt < nextAt then
				nextAt = openAt
			end
		end
	end
	return ready, nextAt
end

function IslandService:_sync(player: Player)
	local total = 0
	for _, island in IC.List do
		local ready, nextAt = self:_status(player, island.Id)
		player:SetAttribute("ChestsReady_" .. island.Id, ready)
		player:SetAttribute("ChestNext_" .. island.Id, nextAt)
		if self:_unlocked(player, island) then
			total += ready
		end
	end
	player:SetAttribute("ChestsReady", total)
end

function IslandService:OpenChest(player: Player, entry)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local island = islandById[entry.Island]
	local openAt = (data.Chests[entry.Id] or 0) + IC.Cooldown
	if os.time() < openAt then
		-- say it once in a while, not every touch
		local notes = lastChestNote[player] or {}
		lastChestNote[player] = notes
		if not notes[entry.Id] or os.clock() - notes[entry.Id] > 6 then
			notes[entry.Id] = os.clock()
			Remotes.Notify:FireClient(player, { Text = "🔒 This chest opens again in " .. Util.FormatTime(openAt - os.time()), Type = "info" })
		end
		return
	end
	data.Chests[entry.Id] = os.time()
	local wallet = S.DataService:GetWallet(player)
	local rebirths = wallet and wallet.Rebirths or 0
	local cash = math.floor(math.max(island.MinCash * (1 + rebirths), S.TycoonService:GetIncome(player) * island.IncomeSeconds))
	S.DataService:AddCash(player, cash, false)
	Remotes.VFX:FireClient(player, "CashBurst", { Amount = cash })
	Remotes.VFX:FireClient(player, "PurchaseSound", {})
	Remotes.Notify:FireClient(player, { Text = "💰 " .. island.Name .. " chest: +" .. Util.Money(cash) .. "!", Type = "success" })
	self:_sync(player)
end

-- ("Plaza" or an island id) -> ok, message
function IslandService:Travel(player: Player, destination: any): (boolean, string)
	local data = S.DataService:Get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not character or not humanoid or humanoid.Health <= 0 then
		return false, "You can't travel right now."
	end
	if player:GetAttribute("InMinigame") then
		return false, "Finish the minigame first!"
	end
	if lastTravel[player] and os.clock() - lastTravel[player] < IC.TravelDelay then
		return false, "Slow down - wait a moment between trips."
	end
	local target, text
	if destination == "Plaza" then
		target, text = IC.Plaza, "🏠 Back on the main island!"
	else
		local island = type(destination) == "string" and islandById[destination]
		local info = island and S.WorldBuilder.Islands[destination]
		if not island or not info then
			return false, "Unknown destination."
		end
		if not self:_unlocked(player, island) then
			return false, island.Name .. " unlocks at " .. island.Rebirths .. " rebirths."
		end
		target, text = info.Spawn, island.Icon .. " Welcome to " .. island.Name .. "!"
	end
	lastTravel[player] = os.clock()
	character:PivotTo(CFrame.new(target))
	return true, text
end

function IslandService:Init(services)
	S = services
	Remotes.Travel.OnServerInvoke = function(player, destination)
		if not IC.Enabled then
			return false, "Travel is turned off."
		end
		return self:Travel(player, destination)
	end
	-- the chests
	for _, entry in S.WorldBuilder.Chests do
		entry.Part.Touched:Connect(function(hit)
			local player = BuildKit.PlayerFromHit(hit)
			if player and BuildKit.IsNear(player, entry.Part) then
				self:OpenChest(player, entry)
			end
		end)
	end
	-- the pads back to the plaza
	for _, pad in S.WorldBuilder.ReturnPads do
		pad.Part.Touched:Connect(function(hit)
			local player = BuildKit.PlayerFromHit(hit)
			if player and BuildKit.IsNear(player, pad.Part) then
				self:Travel(player, "Plaza")
			end
		end)
	end
	S.DataService.PlayerLoaded:Connect(function(player)
		self:_sync(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastTravel[player], lastChestNote[player] = nil, nil
	end)
end

-- the "chests ready" numbers change as the cooldowns run out
function IslandService:Start()
	while true do
		task.wait(5)
		for _, player in Players:GetPlayers() do
			if S.DataService:Get(player) then
				Util.Try("Islands", self._sync, self, player)
			end
		end
	end
end

return IslandService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService - global "Top Earners" board in the lobby
	(OrderedDataStore, refreshes every 2 minutes).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local LeaderboardService = {}
local S

local nameCache: { [number]: string } = {}
local REFRESH = 120

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("User " .. userId)
	return nameCache[userId]
end

local function abbreviate(n: number): string
	return Util.Money(n)
end

function LeaderboardService:Init(services)
	S = services
end

function LeaderboardService:_render(rows)
	local body = S.WorldBuilder.LeaderboardBody
	if not body then
		return
	end
	body:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = body
	if #rows == 0 then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 60)
		label.BackgroundTransparency = 1
		label.Text = "Leaderboard loads in the live game\n(publish + enable API access)"
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.fromRGB(200, 200, 220)
		label.Parent = body
		return
	end
	local medal = { "🥇", "🥈", "🥉" }
	for i, row in rows do
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, 0, 0, 40)
		frame.BackgroundColor3 = i % 2 == 0 and Color3.fromRGB(40, 42, 60) or Color3.fromRGB(32, 34, 50)
		frame.LayoutOrder = i
		frame.Parent = body
		local rank = Instance.new("TextLabel")
		rank.Size = UDim2.new(0.15, 0, 1, 0)
		rank.BackgroundTransparency = 1
		rank.Text = medal[i] or ("#" .. i)
		rank.TextScaled = true
		rank.Font = Enum.Font.FredokaOne
		rank.TextColor3 = Color3.new(1, 1, 1)
		rank.Parent = frame
		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(0.5, 0, 1, 0)
		name.Position = UDim2.new(0.15, 0, 0, 0)
		name.BackgroundTransparency = 1
		name.Text = row.Name
		name.TextScaled = true
		name.Font = Enum.Font.GothamBold
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = Color3.new(1, 1, 1)
		name.Parent = frame
		local value = Instance.new("TextLabel")
		value.Size = UDim2.new(0.33, 0, 1, 0)
		value.Position = UDim2.new(0.66, 0, 0, 0)
		value.BackgroundTransparency = 1
		value.Text = abbreviate(row.Value)
		value.TextScaled = true
		value.Font = Enum.Font.FredokaOne
		value.TextXAlignment = Enum.TextXAlignment.Right
		value.TextColor3 = Color3.fromRGB(120, 255, 150)
		value.Parent = frame
	end
end

function LeaderboardService:Refresh()
	local store = S.DataService:GetEarnedStore()
	local rows = {}
	if store then
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			for _, entry in pages:GetCurrentPage() do
				local userId = tonumber(entry.key)
				if userId then
					table.insert(rows, { Name = nameFor(userId), Value = S.DataService.DecodeEarned(entry.value) })
				end
			end
		end
	end
	self:_render(rows)
end

function LeaderboardService:Start()
	task.wait(5)
	while true do
		Util.Try("Leaderboard", self.Refresh, self)
		task.wait(REFRESH)
	end
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">MinigameService</string>
          <string name="Source"><![CDATA[--[[
	MinigameService - round based minigames in a sky arena.
	Flow: Intermission -> Join window (players press JOIN) -> Countdown ->
	Playing -> Results -> everyone is sent home.

	Games: CoinRush, FallingTiles, MeteorShower (configure in Config.Minigames)
]]
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part
local MG = Config.Minigames

local MinigameService = {}
local S

local running = false
local forced: string? = nil
local joined: { [Player]: boolean } = {}
local acceptingJoins = false

local function broadcast(state)
	Remotes.MinigameState:FireAllClients(state)
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function rebirthScale(player: Player): number
	return 1 + (tonumber(player:GetAttribute("Rebirths")) or 0)
end

-- the bigger of a fixed minimum (scaled by rebirths) or N seconds of the player's income
local function incomeReward(player: Player, seconds: number, minimum: number): number
	return math.max(minimum * rebirthScale(player), S.TycoonService:GetIncome(player) * seconds)
end

local function barrier(folder: Instance, center: Vector3, size: number, height: number)
	for _, data in {
		{ Vector3.new(size, height, 2), Vector3.new(0, height / 2, size / 2 + 1) },
		{ Vector3.new(size, height, 2), Vector3.new(0, height / 2, -size / 2 - 1) },
		{ Vector3.new(2, height, size), Vector3.new(size / 2 + 1, height / 2, 0) },
		{ Vector3.new(2, height, size), Vector3.new(-size / 2 - 1, height / 2, 0) },
	} do
		Part({ Name = "Barrier", Size = data[1], Position = center + data[2], Transparency = 0.85, Color = Color3.fromRGB(120, 200, 255), Material = Enum.Material.ForceField, Parent = folder })
	end
end

---------------------------------------------------------------------------
-- Games. Each has Setup(ctx) and Run(ctx); Run returns when the round ends.
---------------------------------------------------------------------------
local Games = {}

Games.CoinRush = {
	Setup = function(ctx)
		local c = ctx.Center
		Part({ Name = "Floor", Size = Vector3.new(110, 2, 110), Position = c, Color = Color3.fromRGB(70, 60, 110), Material = Enum.Material.Slate, Parent = ctx.Folder })
		Part({ Name = "Edge", Size = Vector3.new(114, 1.8, 114), Position = c - Vector3.new(0, 0.2, 0), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Neon, Parent = ctx.Folder })
		barrier(ctx.Folder, c, 110, 30)
		local rng = Random.new()
		for _ = 1, 14 do
			local size = Vector3.new(rng:NextNumber(4, 10), rng:NextNumber(3, 9), rng:NextNumber(4, 10))
			Part({
				Name = "Obstacle",
				Size = size,
				Position = c + Vector3.new(rng:NextNumber(-45, 45), 1 + size.Y / 2, rng:NextNumber(-45, 45)),
				Color = Color3.fromHSV(rng:NextNumber(), 0.6, 0.9),
				Parent = ctx.Folder,
			})
		end
		ctx.SpawnRadius = 40
	end,
	Run = function(ctx)
		local rng = Random.new()
		local coins = 0
		local info = MG.Games.CoinRush
		local function spawnCoin()
			coins += 1
			local coin = Part({
				Name = "Coin",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.5, 3, 3),
				CFrame = CFrame.new(ctx.Center + Vector3.new(rng:NextNumber(-50, 50), 4, rng:NextNumber(-50, 50))) * CFrame.Angles(0, rng:NextNumber(0, 6), 0),
				Color = Color3.fromRGB(255, 205, 40),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Tags = { "Spin" },
				Parent = ctx.Folder,
			})
			BuildKit.Light(coin, Color3.fromRGB(255, 205, 40), 8, 1)
			local taken = false
			coin.Touched:Connect(function(hit)
				if taken then
					return
				end
				local player = BuildKit.PlayerFromHit(hit)
				if player and ctx.Alive[player] and BuildKit.IsNear(player, coin) then
					taken = true
					coins -= 1
					ctx.Scores[player] = (ctx.Scores[player] or 0) + 1
					player:SetAttribute("MinigameScore", ctx.Scores[player])
					Remotes.VFX:FireClient(player, "CoinPop", { Position = coin.Position })
					coin:Destroy()
				end
			end)
		end
		for _ = 1, 20 do
			spawnCoin()
		end
		ctx:Loop(info.Duration, function()
			if coins < 40 then
				spawnCoin()
			end
			return false
		end, function(player)
			-- fell off: put them back
			ctx:Place(player)
			return true
		end)
	end,
	Rewards = function(ctx)
		local info = MG.Games.CoinRush
		local best, bestScore = nil, 0
		local results = {}
		for player in ctx.Participants do
			local score = ctx.Scores[player] or 0
			if score > bestScore then
				best, bestScore = player, score
			end
		end
		for player in ctx.Participants do
			local score = ctx.Scores[player] or 0
			local reward = score * incomeReward(player, info.CoinIncomeSeconds, info.CoinMin)
			if player == best then
				reward += incomeReward(player, info.WinnerIncomeSeconds, info.WinnerMin)
			end
			table.insert(results, { Player = player, Score = score .. " coins", Reward = reward, Winner = player == best })
		end
		return results
	end,
}

Games.FallingTiles = {
	Setup = function(ctx)
		local c = ctx.Center
		local tiles = 13
		local size = 7
		local offset = (tiles - 1) * size / 2
		for layer = 0, 1 do
			for x = 0, tiles - 1 do
				for z = 0, tiles - 1 do
					local hue = ((x + z) % 6) / 6
					local tile = Part({
						Name = "Tile",
						Size = Vector3.new(size - 0.2, 1, size - 0.2),
						Position = c + Vector3.new(x * size - offset, -layer * 22, z * size - offset),
						Color = Color3.fromHSV(hue, 0.55, 1),
						Material = Enum.Material.SmoothPlastic,
						Parent = ctx.Folder,
					})
					local triggered = false
					tile.Touched:Connect(function(hit)
						if triggered then
							return
						end
						local player = BuildKit.PlayerFromHit(hit)
						if not player or not ctx.Alive[player] or not ctx.Started or not BuildKit.IsNear(player, tile) then
							return
						end
						triggered = true
						tile.Color = Color3.fromRGB(255, 60, 60)
						tile.Material = Enum.Material.Neon
						task.delay(0.5, function()
							tile.CanCollide = false
							TweenService:Create(tile, TweenInfo.new(0.4), { Transparency = 1, Position = tile.Position - Vector3.new(0, 6, 0) }):Play()
							task.delay(0.5, function()
								tile:Destroy()
							end)
						end)
					end)
				end
			end
		end
		ctx.SpawnRadius = 35
		ctx.FallDepth = 45
	end,
	Run = function(ctx)
		ctx:Loop(MG.Games.FallingTiles.Duration, function()
			local alive = ctx:AliveCount()
			if ctx.StartCount > 1 then
				return alive <= 1
			end
			return alive == 0
		end)
	end,
	Rewards = function(ctx)
		return ctx:SurvivalRewards(MG.Games.FallingTiles)
	end,
}

Games.MeteorShower = {
	Setup = function(ctx)
		local c = ctx.Center
		Part({ Name = "Floor", Size = Vector3.new(110, 3, 110), Position = c, Color = Color3.fromRGB(90, 80, 80), Material = Enum.Material.Basalt, Parent = ctx.Folder })
		Part({ Name = "Glow", Size = Vector3.new(112, 2.6, 112), Position = c - Vector3.new(0, 0.4, 0), Color = Color3.fromRGB(255, 100, 0), Material = Enum.Material.Neon, Parent = ctx.Folder })
		ctx.SpawnRadius = 40
		ctx.FallDepth = 30
	end,
	Run = function(ctx)
		local rng = Random.new()
		local elapsed = 0
		local duration = MG.Games.MeteorShower.Duration
		local function meteor()
			local target
			local alive = {}
			for p in ctx.Alive do
				table.insert(alive, p)
			end
			if #alive > 0 and rng:NextNumber() < 0.55 then
				local root = getRoot(alive[rng:NextInteger(1, #alive)])
				if root then
					target = Vector3.new(root.Position.X + rng:NextNumber(-6, 6), ctx.Center.Y + 1.6, root.Position.Z + rng:NextNumber(-6, 6))
				end
			end
			target = target or ctx.Center + Vector3.new(rng:NextNumber(-52, 52), 1.6, rng:NextNumber(-52, 52))
			local radius = 10
			local warning = Part({
				Name = "Warning",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.2, radius * 2, radius * 2),
				CFrame = CFrame.new(target) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.Neon,
				Transparency = 0.5,
				CanCollide = false,
				CanTouch = false,
				Parent = ctx.Folder,
			})
			task.delay(1.3, function()
				if not ctx.Folder.Parent then
					return
				end
				local rock = Part({
					Name = "Meteor",
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * 7,
					Position = target + Vector3.new(rng:NextNumber(-20, 20), 120, rng:NextNumber(-20, 20)),
					Color = Color3.fromRGB(120, 50, 20),
					Material = Enum.Material.CrackedLava,
					CanCollide = false,
					CanTouch = false,
					Parent = ctx.Folder,
				})
				local fire = Instance.new("Fire")
				fire.Size = 12
				fire.Heat = 20
				fire.Parent = rock
				BuildKit.Light(rock, Color3.fromRGB(255, 120, 0), 30, 4)
				local tween = TweenService:Create(rock, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = target })
				tween:Play()
				tween.Completed:Wait()
				warning:Destroy()
				rock:Destroy()
				if not ctx.Folder.Parent then
					return
				end
				local explosion = Instance.new("Explosion")
				explosion.Position = target
				explosion.BlastRadius = radius
				explosion.BlastPressure = 0
				explosion.DestroyJointRadiusPercent = 0
				explosion.Parent = workspace
				Debris:AddItem(explosion, 2)
				Remotes.VFX:FireAllClients("Shockwave", { Position = target, Color = Color3.fromRGB(255, 120, 0), Size = radius * 3 })
				for p in ctx.Alive do
					local root = getRoot(p)
					local humanoid = getHumanoid(p)
					if root and humanoid and (root.Position - target).Magnitude <= radius then
						humanoid:TakeDamage(55)
						local away = root.Position - target
						Remotes.ClientCommand:FireClient(p, "fling", ((away.Magnitude > 0.1 and away.Unit or Vector3.yAxis) + Vector3.new(0, 1.5, 0)) * 50)
					end
				end
			end)
		end
		local accumulator = 0
		ctx:Loop(duration, function(dt)
			elapsed += dt
			accumulator += dt
			local interval = math.max(0.15, 0.7 - elapsed / duration * 0.55)
			while accumulator >= interval do
				accumulator -= interval
				meteor()
			end
			return ctx:AliveCount() == 0
		end)
	end,
	Rewards = function(ctx)
		return ctx:SurvivalRewards(MG.Games.MeteorShower)
	end,
}

Games.LavaRise = {
	Setup = function(ctx)
		local c = ctx.Center
		Part({ Name = "Floor", Size = Vector3.new(70, 2, 70), Position = c, Color = Color3.fromRGB(70, 70, 80), Material = Enum.Material.Slate, Parent = ctx.Folder })
		barrier(ctx.Folder, c, 70, 110)
		-- a spiral of platforms around a central pillar
		Part({ Name = "Pillar", Size = Vector3.new(8, 100, 8), Position = c + Vector3.new(0, 50, 0), Color = Color3.fromRGB(50, 50, 60), Material = Enum.Material.Basalt, Parent = ctx.Folder })
		for i = 1, 28 do
			local angle = i * math.rad(32)
			local height = 3 + i * 3.2
			Part({
				Name = "Step",
				Size = Vector3.new(9, 1.2, 9),
				Position = c + Vector3.new(math.cos(angle) * 16, height, math.sin(angle) * 16),
				Color = Color3.fromHSV((i / 28) % 1, 0.6, 1),
				Parent = ctx.Folder,
			})
		end
		Part({ Name = "Summit", Size = Vector3.new(14, 1.2, 14), Position = c + Vector3.new(0, 3 + 29 * 3.2, 0), Color = Color3.fromRGB(255, 210, 40), Material = Enum.Material.Neon, Parent = ctx.Folder })
		ctx.Lava = Part({
			Name = "Lava",
			Size = Vector3.new(76, 4, 76),
			Position = c - Vector3.new(0, 6, 0),
			Color = Color3.fromRGB(255, 80, 0),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = ctx.Folder,
		})
		BuildKit.Light(ctx.Lava, Color3.fromRGB(255, 110, 20), 60, 3)
		ctx.SpawnRadius = 25
		ctx.FallDepth = 1000 -- the lava decides
	end,
	Run = function(ctx)
		local info = MG.Games.LavaRise
		local lava = ctx.Lava :: BasePart
		local startY = lava.Position.Y
		local elapsed = 0
		ctx:Loop(info.Duration, function(dt)
			elapsed += dt
			local top = startY + elapsed * info.RiseSpeed
			lava.Position = Vector3.new(ctx.Center.X, top, ctx.Center.Z)
			for player in ctx.Alive do
				local root = getRoot(player)
				if root and root.Position.Y < top + lava.Size.Y / 2 + 1 then
					ctx:Eliminate(player, "🌋 The lava got you!")
				end
			end
			if ctx.StartCount > 1 then
				return ctx:AliveCount() <= 1
			end
			return ctx:AliveCount() == 0
		end)
	end,
	Rewards = function(ctx)
		return ctx:SurvivalRewards(MG.Games.LavaRise)
	end,
}

---------------------------------------------------------------------------
-- Round context
---------------------------------------------------------------------------
local Context = {}
Context.__index = Context

function Context:AliveCount()
	local n = 0
	for _ in self.Alive do
		n += 1
	end
	return n
end

function Context:Place(player: Player)
	local character = player.Character
	if not character then
		return
	end

	local r = self.SpawnRadius or 30
	local offset = Vector3.new(math.random(-r, r), 6, math.random(-r, r))
	character:PivotTo(CFrame.new(self.Center + offset))
	local root = getRoot(player)
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

function Context:Eliminate(player: Player, reason: string?)
	if not self.Alive[player] then
		return
	end
	self.Alive[player] = nil
	self.EliminatedAt[player] = os.clock() - self.StartTime
	player:SetAttribute("InMinigame", nil)
	if player.Parent then
		Remotes.Notify:FireClient(player, { Text = reason or "You were eliminated!", Type = "error" })
		local humanoid = getHumanoid(player)
		if humanoid and humanoid.Health > 0 then
			S.TycoonService:TeleportHome(player)
		end
	end
end

-- Runs the round loop for `duration` seconds. `tick(dt)` returns true to end early.
-- `onFall(player)` returns true if the fall was handled (otherwise: eliminated)
function Context:Loop(duration: number, tick: (number) -> boolean, onFall: ((Player) -> boolean)?)
	local endTime = os.clock() + duration
	local lastBroadcast = 0
	local last = os.clock()
	while os.clock() < endTime do
		local now = os.clock()
		local dt = now - last
		last = now
		for player in self.Alive do
			local root = getRoot(player)
			local humanoid = getHumanoid(player)
			if not player.Parent then
				self.Alive[player] = nil
			elseif not root or not humanoid or humanoid.Health <= 0 then
				self:Eliminate(player, "You died!")
			elseif root.Position.Y < self.Center.Y - (self.FallDepth or 25) then
				if not (onFall and onFall(player)) then
					self:Eliminate(player, "You fell!")
				end
			end
		end
		if tick(dt) then
			break
		end
		if self:AliveCount() == 0 then
			break
		end
		if now - lastBroadcast >= 1 then
			lastBroadcast = now
			broadcast({ Phase = "Playing", Name = self.DisplayName, TimeLeft = math.ceil(endTime - now), Alive = self:AliveCount() })
		end
		task.wait(0.1)
	end
end

function Context:SurvivalRewards(info)
	local results = {}
	local survivors = {}
	for player in self.Alive do
		table.insert(survivors, player)
	end
	local duration = os.clock() - self.StartTime
	for player in self.Participants do
		local survived = self.Alive[player] ~= nil
		local time = survived and duration or (self.EliminatedAt[player] or 0)
		local fraction = math.clamp(time / math.max(duration, 1), 0, 1)
		local reward = math.floor(incomeReward(player, info.SurviveIncomeSeconds, info.SurviveMin) * (survived and 1 or fraction * 0.5))
		local winner = survived and #survivors <= 3
		if winner then
			reward += incomeReward(player, info.WinnerIncomeSeconds, info.WinnerMin)
		end
		table.insert(results, { Player = player, Score = string.format("%.0fs", time), Reward = reward, Winner = winner })
	end
	return results
end

---------------------------------------------------------------------------
function MinigameService:Init(services)
	S = services
	Remotes.MinigameJoin.OnServerEvent:Connect(function(player)
		if not acceptingJoins or joined[player] then
			return
		end
		if not S.DataService:IsLoaded(player) then
			return
		end
		joined[player] = true
		player:SetAttribute("MinigameJoined", true)
		Remotes.Notify:FireClient(player, { Text = "You joined the minigame! Get ready...", Type = "success" })
	end)
	Players.PlayerRemoving:Connect(function(player)
		joined[player] = nil
	end)
end

function MinigameService:ForceStart(name: string?): string
	if running then
		return "A minigame is already running"
	end
	local key
	if name then
		for k in Games do
			if k:lower() == name:lower() then
				key = k
			end
		end
		if not key then
			local names = {}
			for k in Games do
				table.insert(names, k)
			end
			table.sort(names)
			return "Unknown minigame. Options: " .. table.concat(names, ", ")
		end
	else
		local keys = {}
		for k in Games do
			table.insert(keys, k)
		end
		key = keys[math.random(1, #keys)]
	end
	forced = key
	return "Starting " .. MG.Games[key].DisplayName .. "!"
end

function MinigameService:Start()
	if not MG.Enabled then
		return
	end
	local keys = {}
	for k in Games do
		if MG.Games[k] then
			table.insert(keys, k)
		end
	end
	table.sort(keys)
	local lastKey
	while true do
		local t = MG.Intermission
		while t > 0 and not forced do
			broadcast({ Phase = "Intermission", TimeLeft = t })
			task.wait(1)
			t -= 1
		end
		local key = forced
		forced = nil
		if not key then
			repeat
				key = keys[math.random(1, #keys)]
			until key ~= lastKey or #keys == 1
		end
		lastKey = key
		local ok, err = pcall(self.RunGame, self, key)
		if not ok then
			warn("[Minigames] " .. tostring(err))
		end
		running = false
		acceptingJoins = false
		joined = {}
		for _, p in Players:GetPlayers() do
			p:SetAttribute("MinigameJoined", nil)
			p:SetAttribute("MinigameScore", nil)
		end
	end
end

function MinigameService:RunGame(key: string)
	running = true
	local info = MG.Games[key]
	local def = Games[key]

	-- join window
	joined = {}
	acceptingJoins = true
	for t = MG.JoinTime, 1, -1 do
		broadcast({ Phase = "Join", Game = key, Name = info.DisplayName, Description = info.Description, TimeLeft = t })
		task.wait(1)
	end
	acceptingJoins = false

	local participants = {}
	local count = 0
	for player in joined do
		local humanoid = getHumanoid(player)
		if player.Parent and humanoid and humanoid.Health > 0 then
			participants[player] = true
			count += 1
		end
	end
	if count < MG.MinPlayers then
		broadcast({ Phase = "Cancelled", Name = info.DisplayName, Text = "Not enough players joined." })
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "Minigame_" .. key
	folder.Parent = workspace

	local ctx = setmetatable({
		Key = key,
		DisplayName = info.DisplayName,
		Center = MG.ArenaCenter,
		Folder = folder,
		Participants = participants,
		Alive = table.clone(participants),
		Scores = {},
		EliminatedAt = {},
		StartCount = count,
		Started = false,
		StartTime = os.clock(),
	}, Context)

	local okSetup, setupErr = pcall(def.Setup, ctx)
	if not okSetup then
		warn("[Minigames] setup failed: " .. tostring(setupErr))
		folder:Destroy()
		return
	end

	-- stream the arena in for everyone (in parallel) before teleporting
	local pending = 0
	for player in participants do
		pending += 1
		task.spawn(function()
			pcall(player.RequestStreamAroundAsync, player, ctx.Center, 3)
			pending -= 1
		end)
	end
	local waitStart = os.clock()
	while pending > 0 and os.clock() - waitStart < 3.5 do
		task.wait(0.1)
	end

	-- send players in
	local deathConns = {}
	for player in participants do
		player:SetAttribute("InMinigame", true)
		player:SetAttribute("MinigameScore", 0)
		player:SetAttribute("ObbyStage", 0)
		ctx:Place(player)
		local humanoid = getHumanoid(player)
		if humanoid then
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.UseJumpPower = true
			table.insert(deathConns, humanoid.Died:Connect(function()
				ctx:Eliminate(player, "You died!")
			end))
		end
	end
	Remotes.VFX:FireAllClients("Flash", {})

	for n = 3, 1, -1 do
		broadcast({ Phase = "Countdown", Name = info.DisplayName, Count = n })
		task.wait(1)
	end
	broadcast({ Phase = "Countdown", Name = info.DisplayName, Count = 0 })
	for player in ctx.Alive do
		local humanoid = getHumanoid(player)
		if humanoid then
			humanoid.WalkSpeed = S.MonetizationService:GetBaseSpeed(player)
			humanoid.JumpPower = 50
		end
	end
	ctx.Started = true
	ctx.StartTime = os.clock()

	local okRun, runErr = pcall(def.Run, ctx)
	if not okRun then
		warn("[Minigames] run failed: " .. tostring(runErr))
	end

	-- results
	local results = {}
	local okRewards, rewardResult = pcall(def.Rewards, ctx)
	if okRewards then
		results = rewardResult
	end
	table.sort(results, function(a, b)
		return a.Reward > b.Reward
	end)
	local summary = {}
	for _, r in results do
		local player = r.Player
		if player.Parent then
			if S.QuestService then
				S.QuestService:Progress(player, "Minigame", 1)
			end
			local data = S.DataService:Get(player)
			if data and r.Reward > 0 then
				S.DataService:AddCash(player, r.Reward, false)
				if r.Winner then
					data.MinigameWins += 1
				end
				Remotes.VFX:FireClient(player, r.Winner and "Confetti" or "CashBurst", { Amount = r.Reward })
			end
		end
		table.insert(summary, { Name = player.DisplayName, Score = r.Score, Reward = r.Reward, Winner = r.Winner })
	end
	broadcast({ Phase = "Results", Name = info.DisplayName, Results = summary })

	for _, conn in deathConns do
		conn:Disconnect()
	end
	for player in participants do
		if player.Parent then
			local wasAlive = player:GetAttribute("InMinigame")
			player:SetAttribute("InMinigame", nil)
			if wasAlive then
				S.TycoonService:TeleportHome(player)
			end
		end
	end
	task.delay(1, function()
		folder:Destroy()
	end)
	local winners = {}
	for _, r in summary do
		if r.Winner then
			table.insert(winners, r.Name)
		end
	end
	if #winners > 0 then
		Remotes.Announce:FireAllClients({
			Title = "🏆 " .. info.DisplayName .. " Winner" .. (#winners > 1 and "s" or ""),
			Text = table.concat(winners, ", ") .. " won " .. Util.Money(summary[1].Reward) .. "!",
			Color = Color3.fromRGB(170, 80, 255),
		})
	end
	task.wait(6)
end

return MinigameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService - game passes + developer products (Robux shop).
	Pass ownership is mirrored to player attributes "Pass_<Key>" = true.
	Unconfigured items (Id = 0) are simulated in Studio for easy testing.
]]
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local MonetizationService = {}
local S

local purchaseHistory: DataStore? = nil
pcall(function()
	purchaseHistory = DataStoreService:GetDataStore(Config.DataStoreName .. "_Purchases")
end)

local passByKey = Config.GamePasses
local passKeyById: { [number]: string } = {}
local productKeyById: { [number]: string } = {}
for key, pass in passByKey do
	if pass.Id ~= 0 then
		passKeyById[pass.Id] = key
	end
end
for key, product in Config.Products do
	if product.Id ~= 0 then
		productKeyById[product.Id] = key
	end
end

local function canSimulate()
	return RunService:IsStudio() and Config.Monetization.SimulateUnconfiguredInStudio
end

function MonetizationService:Init(services)
	S = services

	S.DataService.PlayerLoaded:Connect(function(player, data)
		for key, pass in passByKey do
			local owns = data.Passes[key] == true
			if not owns and pass.Id ~= 0 then
				local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
				owns = ok and result == true
			end
			if owns then
				self:_applyPass(player, key, false)
			end
		end
		S.DataService:RefreshMultiplier(player)
		self:RefreshCharacter(player) -- rebirth rank speed and tag (the character may have spawned first)
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			self:_applyCharacterPerks(player, character)
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function(character)
			self:_applyCharacterPerks(player, character)
		end)
	end

	Remotes.BuyPass.OnServerEvent:Connect(function(player, key)
		self:PromptPass(player, key)
	end)
	Remotes.BuyProduct.OnServerEvent:Connect(function(player, key)
		self:PromptProduct(player, key)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passKeyById[passId] then
			self:_applyPass(player, passKeyById[passId], true)
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		return self:_processReceipt(receipt)
	end
end

function MonetizationService:HasPass(player: Player, key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

function MonetizationService:GetBaseSpeed(player: Player): number
	local data = S.DataService:Get(player)
	local perk = data and Config.RebirthPerk(data.Rebirths, "Speed") or 0
	return (self:HasPass(player, "SuperSpeed") and Config.BaseWalkSpeed * 2 or Config.BaseWalkSpeed) + perk
end

-- the rebirth rank tag above a character's head
function MonetizationService:_applyRankTag(player: Player, character: Model)
	local head = character:FindFirstChild("Head")
	local data = S.DataService:Get(player)
	local _, rank = Config.RebirthRank(data and data.Rebirths or 0)
	local tag = head and head:FindFirstChild("RankTag") :: BillboardGui?
	if not head or not rank then
		return
	end
	if not tag then
		tag = Instance.new("BillboardGui")
		assert(tag)
		tag.Name = "RankTag"
		tag.Size = UDim2.fromOffset(120, 24)
		tag.StudsOffset = Vector3.new(0, self:HasPass(player, "VIP") and 3.6 or 2.6, 0)
		tag.MaxDistance = 80
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.fromRGB(220, 170, 255)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = label
		label.Parent = tag
		tag.Parent = head
	end
	local label = tag:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = rank.Icon .. " " .. rank.Name
	end
end

-- re-apply speed and the rank tag to the current character (after a rebirth)
function MonetizationService:RefreshCharacter(player: Player)
	local character = player.Character
	if character then
		task.spawn(self._applyCharacterPerks, self, player, character)
	end
end

-- grant = also store in data (admin / simulated purchases)
function MonetizationService:GrantPass(player: Player, key: string)
	local data = S.DataService:Get(player)
	if data then
		data.Passes[key] = true
	end
	self:_applyPass(player, key, true)
end

function MonetizationService:RevokePass(player: Player, key: string)
	local data = S.DataService:Get(player)
	if data then
		data.Passes[key] = nil
	end
	player:SetAttribute("Pass_" .. key, nil)
	S.DataService:RefreshMultiplier(player)
	if S.TycoonService then
		S.TycoonService:RefreshPlayer(player)
	end
end

function MonetizationService:_applyPass(player: Player, key: string, announce: boolean)
	if not passByKey[key] then
		return
	end
	player:SetAttribute("Pass_" .. key, true)
	S.DataService:RefreshMultiplier(player)
	if S.TycoonService then
		if key == "AutoCollect" then
			S.TycoonService:CollectVault(player)
		end
		S.TycoonService:RefreshPlayer(player)
	end
	if player.Character then
		self:_applyCharacterPerks(player, player.Character)
	end
	if announce then
		local pass = passByKey[key]
		Remotes.Notify:FireClient(player, { Text = "Thanks for buying " .. pass.Name .. "! " .. pass.Icon, Type = "success", Duration = 6 })
		Remotes.VFX:FireAllClients("Purchase", { Position = player.Character and player.Character:GetPivot().Position, Color = pass.Color, Big = true })
		Remotes.Announce:FireAllClients({ Title = "🎉 " .. player.DisplayName .. " bought " .. pass.Name .. "!", Text = pass.Description, Color = pass.Color })
	end
end

function MonetizationService:_applyCharacterPerks(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = self:GetBaseSpeed(player)
	self:_applyRankTag(player, character)
	if self:HasPass(player, "VIP") then
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and not root:FindFirstChild("VIPAura") then
			local attachment = Instance.new("Attachment")
			attachment.Name = "VIPAura"
			attachment.Parent = root
			local sparkle = Instance.new("ParticleEmitter")
			sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
			sparkle.LightEmission = 1
			sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
			sparkle.Rate = 8
			sparkle.Lifetime = NumberRange.new(1, 1.5)
			sparkle.Speed = NumberRange.new(1, 2)
			sparkle.SpreadAngle = Vector2.new(180, 180)
			sparkle.Parent = attachment
		end
		local head = character:FindFirstChild("Head")
		if head and not head:FindFirstChild("VIPTag") then
			local tag = Instance.new("BillboardGui")
			tag.Name = "VIPTag"
			tag.Size = UDim2.fromOffset(80, 26)
			tag.StudsOffset = Vector3.new(0, 2.6, 0)
			tag.AlwaysOnTop = false
			tag.MaxDistance = 80
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Text = "👑 VIP"
			label.TextScaled = true
			label.Font = Enum.Font.FredokaOne
			label.TextColor3 = Color3.fromRGB(255, 210, 0)
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 2
			stroke.Parent = label
			label.Parent = tag
			tag.Parent = head
		end
	end
end

function MonetizationService:PromptPass(player: Player, key: any)
	local pass = type(key) == "string" and passByKey[key]
	if not pass then
		return
	end
	if self:HasPass(player, key) then
		Remotes.Notify:FireClient(player, { Text = "You already own " .. pass.Name .. "!", Type = "info" })
		return
	end
	if pass.Id == 0 then
		if canSimulate() then
			Remotes.Notify:FireClient(player, { Text = "[Studio] Simulated purchase of " .. pass.Name, Type = "info" })
			self:GrantPass(player, key)
		else
			Remotes.Notify:FireClient(player, { Text = "This pass isn't available yet!", Type = "error" })
		end
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

function MonetizationService:PromptProduct(player: Player, key: any)
	local product = type(key) == "string" and Config.Products[key]
	if not product then
		return
	end
	if product.Id == 0 then
		if canSimulate() then
			Remotes.Notify:FireClient(player, { Text = "[Studio] Simulated purchase of " .. product.Name, Type = "info" })
			self:_grantProduct(player, key)
		else
			Remotes.Notify:FireClient(player, { Text = "This product isn't available yet!", Type = "error" })
		end
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

function MonetizationService:_grantProduct(player: Player, key: string): boolean
	local product = Config.Products[key]
	local data = S.DataService:Get(player)
	if not product or not data then
		return false
	end
	if product.Minutes then
		local amount = math.max(product.MinCash * (1 + data.Rebirths), S.TycoonService:GetIncome(player) * product.Minutes * 60)
		S.DataService:AddCash(player, amount, false)
		Remotes.Notify:FireClient(player, { Text = "+" .. Util.Money(amount) .. " added! Thank you! 💰", Type = "success", Duration = 6 })
		Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
	end
	if product.Repair then
		local count = S.TycoonService:RepairAll(player)
		Remotes.Notify:FireClient(player, { Text = count > 0 and ("🔧 Repaired " .. count .. " upgrades!") or "🔧 Nothing was broken - your tower is fine!", Type = "success", Duration = 6 })
	end
	if product.BoostSeconds then
		S.DataService:AddBoost(player, product.BoostSeconds)
		Remotes.Notify:FireClient(player, { Text = "2x Boost activated! 🚀", Type = "success", Duration = 6 })
	end
	if product.ServerEvent == "CashRain" then
		self:CashRain(player.DisplayName)
	elseif product.ServerEvent and S.DisasterService then
		local message = S.DisasterService:Trigger(product.ServerEvent, player.DisplayName)
		Remotes.Notify:FireClient(player, { Text = message, Type = "info" })
	end
	Remotes.VFX:FireClient(player, "Confetti", {})
	return true
end

-- Everybody in the server gets cash, with a big falling-cash effect
function MonetizationService:CashRain(byName: string)
	Remotes.Announce:FireAllClients({
		Title = "🌧️ CASH RAIN! 🌧️",
		Text = byName .. " made it rain for the whole server!",
		Color = Color3.fromRGB(80, 220, 120),
	})
	Remotes.VFX:FireAllClients("CashRain", { Duration = 8 })
	for _, p in Players:GetPlayers() do
		local data = S.DataService:Get(p)
		if data then
			local amount = math.max(5_000 * (1 + data.Rebirths), S.TycoonService:GetIncome(p) * 120)
			S.DataService:AddCash(p, amount, false)
			Remotes.Notify:FireClient(p, { Text = "Cash Rain: +" .. Util.Money(amount), Type = "success" })
		end
	end
end

function MonetizationService:_processReceipt(receipt)
	local key = productKeyById[receipt.ProductId]
	if not key then
		warn("[Monetization] Unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not S.DataService:IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local historyKey = receipt.PlayerId .. "_" .. receipt.PurchaseId
	if purchaseHistory then
		local ok, already = pcall(function()
			return (purchaseHistory :: DataStore):GetAsync(historyKey)
		end)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if already then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	local granted = self:_grantProduct(player, key)
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- persist the player's data right away so the purchase is never lost
	S.DataService:Save(player)
	if purchaseHistory then
		pcall(function()
			(purchaseHistory :: DataStore):SetAsync(historyKey, true)
		end)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ObbyService</string>
          <string name="Source"><![CDATA[--[[
	ObbyService - generates an obstacle course west of the lobby with
	checkpoints, kill bricks, spinners, trusses and a finish reward.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part

local ObbyService = {}
local S

local checkpoints: { [number]: CFrame } = {}
local spinners = {}
local startTimes: { [Player]: number } = {}
local finishDebounce: { [Player]: boolean } = {}

local START_X = -420
local KILL_COLOR = Color3.fromRGB(255, 40, 40)

local folder: Model
local rng = Random.new(2024)

local function platform(size: Vector3, pos: Vector3, color: Color3?)
	return Part({
		Name = "Platform",
		Size = size,
		Position = pos,
		Color = color or Color3.fromHSV(rng:NextNumber(), 0.55, 0.95),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function killPart(props)
	props.Color = KILL_COLOR
	props.Material = Enum.Material.Neon
	props.Parent = props.Parent or folder
	local part = Part(props)
	part:SetAttribute("Kill", true)
	part.Touched:Connect(function(hit)
		local _, humanoid = BuildKit.PlayerFromHit(hit)
		if humanoid then
			humanoid.Health = 0
		end
	end)
	return part
end

-- every segment starts at the edge `x` (previous platform ends there) at height `y`
local segments = {}

function segments.Jumps(x: number, y: number)
	for _ = 1, 5 do
		local gap = rng:NextNumber(3.5, 5.5)
		local size = rng:NextNumber(5, 7)
		y += rng:NextNumber(0, 1.5)
		local cx = x - gap - size / 2
		platform(Vector3.new(size, 1, size), Vector3.new(cx, y, rng:NextNumber(-4, 4)))
		x = cx - size / 2
	end
	return x, y
end

function segments.KillBricks(x: number, y: number)
	local length = 40
	platform(Vector3.new(length, 1, 10), Vector3.new(x - length / 2, y, 0), Color3.fromRGB(60, 60, 75))
	for i = 1, 4 do
		killPart({ Name = "KillBrick", Size = Vector3.new(1.6, 1.4, 10), Position = Vector3.new(x - i * 8, y + 1.2, 0) })
	end
	return x - length, y
end

function segments.Beam(x: number, y: number)
	local length = 28
	platform(Vector3.new(length, 1, 1.4), Vector3.new(x - length / 2, y, 0), Color3.fromRGB(255, 200, 40))
	platform(Vector3.new(8, 1, 8), Vector3.new(x - length - 4, y, 0))
	return x - length - 8, y
end

function segments.Truss(x: number, y: number)
	local height = 18
	local truss = Instance.new("TrussPart")
	truss.Anchored = true
	truss.Size = Vector3.new(2, height, 2)
	truss.Position = Vector3.new(x - 1, y + height / 2 - 0.5, 0)
	truss.Color = Color3.fromRGB(90, 90, 100)
	truss.Parent = folder
	y += height
	platform(Vector3.new(10, 1, 10), Vector3.new(x - 2 - 5, y, 0))
	return x - 12, y
end

function segments.Spinner(x: number, y: number)
	local size = 26
	local center = Vector3.new(x - size / 2, y, 0)
	platform(Vector3.new(size, 1, size), center, Color3.fromRGB(70, 70, 90))
	local bar = killPart({ Name = "Spinner", Size = Vector3.new(24, 1.2, 1.2), Position = center + Vector3.new(0, 1.6, 0) })
	Part({ Name = "Hub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(center + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = folder })
	table.insert(spinners, { Part = bar, Center = center + Vector3.new(0, 1.6, 0), Speed = rng:NextNumber(1.6, 2.4) * (rng:NextNumber() > 0.5 and 1 or -1), Angle = 0 })
	return x - size, y
end

function segments.Stairs(x: number, y: number)
	for _ = 1, 6 do
		y += 2
		platform(Vector3.new(4, 1, 8), Vector3.new(x - 2 - 2, y, 0))
		x -= 6
	end
	return x, y
end

function segments.Zigzag(x: number, y: number)
	local side = 1
	for _ = 1, 6 do
		local cx = x - 6
		platform(Vector3.new(4, 1, 4), Vector3.new(cx, y, side * 4))
		side = -side
		x = cx - 2
	end
	return x, y
end

local LAYOUT = {
	"Jumps", "KillBricks", "Checkpoint",
	"Beam", "Jumps", "Checkpoint",
	"Truss", "Spinner", "Checkpoint",
	"Zigzag", "Stairs", "Checkpoint",
	"KillBricks", "Beam", "Checkpoint",
	"Spinner", "Jumps", "Checkpoint",
	"Truss", "Zigzag", "Spinner", "Finish",
}

function ObbyService:Init(services)
	S = services
	folder = BuildKit.Model("Obby", workspace)

	-- start area
	local start = platform(Vector3.new(20, 1, 22), Vector3.new(START_X, 0.5, 0), Color3.fromRGB(0, 200, 255))
	start.Material = Enum.Material.Neon
	for _, z in { -10, 10 } do
		Part({ Name = "Arch", Size = Vector3.new(2, 16, 2), Position = Vector3.new(START_X - 9, 8, z), Color = Color3.fromRGB(40, 40, 55), Material = Enum.Material.Metal, Parent = folder })
	end
	local arch = Part({ Name = "ArchTop", Size = Vector3.new(2, 4, 22), Position = Vector3.new(START_X - 9, 17, 0), Color = Color3.fromRGB(255, 80, 160), Material = Enum.Material.Neon, Parent = folder })
	BuildKit.SurfaceText(arch, Enum.NormalId.Right, "🏃 OBBY - BIG CASH REWARD", { PixelsPerStud = 18 })
	local startLine = Part({ Name = "StartLine", Size = Vector3.new(1, 14, 18), Position = Vector3.new(START_X - 9, 7, 0), Transparency = 1, CanCollide = false, Parent = folder })
	startLine.Touched:Connect(function(hit)
		local player = BuildKit.PlayerFromHit(hit)
		if player and (player:GetAttribute("ObbyStage") or 0) == 0 and BuildKit.IsNear(player, startLine) then
			startTimes[player] = os.clock()
			player:SetAttribute("ObbyStage", 0)
		end
	end)

	local x, y = START_X - 10, 4
	platform(Vector3.new(8, 1, 8), Vector3.new(x - 6, y, 0))
	x -= 10
	local stage = 0
	for _, name in LAYOUT do
		if name == "Checkpoint" or name == "Finish" then
			local isFinish = name == "Finish"
			x -= 4
			local pad = platform(Vector3.new(12, 1, 12), Vector3.new(x - 6, y, 0), isFinish and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(60, 220, 100))
			pad.Material = Enum.Material.Neon
			if isFinish then
				self:_buildFinish(pad)
			else
				stage += 1
				local thisStage = stage
				if thisStage == 3 then
					self:_buildSecretPath(pad.Position)
				end
				checkpoints[thisStage] = CFrame.lookAt(pad.Position + Vector3.new(0, 4, 0), pad.Position + Vector3.new(-10, 4, 0))
				local flag = Part({ Name = "Flag", Size = Vector3.new(0.4, 8, 0.4), Position = pad.Position + Vector3.new(4, 4.5, 4), Color = Color3.fromRGB(230, 230, 230), Parent = folder })
				local cloth = Part({ Name = "Cloth", Size = Vector3.new(0.2, 2.4, 3.6), Position = flag.Position + Vector3.new(0, 2.6, -1.9), Color = Color3.fromRGB(60, 220, 100), Material = Enum.Material.Fabric, Parent = folder })
				BuildKit.Billboard(pad, "CHECKPOINT " .. thisStage, { Size = UDim2.fromOffset(180, 36), Offset = Vector3.new(0, 5, 0), Color = Color3.fromRGB(150, 255, 170), MaxDistance = 90 })
				pad.Touched:Connect(function(hit)
					local player = BuildKit.PlayerFromHit(hit)
					if player and (player:GetAttribute("ObbyStage") or 0) < thisStage and BuildKit.IsNear(player, pad) then
						player:SetAttribute("ObbyStage", thisStage)
						cloth.Color = Color3.fromRGB(255, 220, 40)
						Remotes.Notify:FireClient(player, { Text = "Checkpoint " .. thisStage .. " reached!", Type = "success" })
						Remotes.VFX:FireClient(player, "Confetti", { Position = pad.Position + Vector3.new(0, 3, 0), Small = true })
					end
				end)
			end
			x -= 12
		else
			x, y = segments[name](x, y)
		end
	end

	-- lava floor under the whole course
	local length = START_X - 12 - x + 40
	killPart({
		Name = "Lava",
		Size = Vector3.new(length, 1, 70),
		Position = Vector3.new(START_X - 12 - length / 2, 0.4, 0),
	}).Color = Color3.fromRGB(255, 90, 0)

	Players.PlayerRemoving:Connect(function(player)
		startTimes[player] = nil
		finishDebounce[player] = nil
	end)
end

-- barely-visible platforms branching off checkpoint 3 lead to a secret
function ObbyService:_buildSecretPath(origin: Vector3)
	for k = 1, 5 do
		local ghost = Part({
			Name = "Ghost",
			Size = Vector3.new(5, 1, 5),
			Position = origin + Vector3.new(rng:NextNumber(-2, 2), k * 1.4, 8 + k * 7.5),
			Color = Color3.fromRGB(200, 220, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.93,
			Parent = folder,
		})
		ghost.Name = "Ghost" .. k
	end
	local hideout = Part({
		Name = "Hideout",
		Size = Vector3.new(9, 1, 9),
		Position = origin + Vector3.new(0, 8.4, 54),
		Color = Color3.fromRGB(255, 80, 160),
		Material = Enum.Material.Neon,
		Transparency = 0.6,
		Parent = folder,
	})
	ObbyService.SecretSpot = hideout.Position + Vector3.new(0, 3, 0)
end

function ObbyService:_buildFinish(pad: BasePart)
	local trophy = Part({
		Name = "Trophy",
		Size = Vector3.new(3, 4, 3),
		Position = pad.Position + Vector3.new(0, 4, 0),
		Color = Color3.fromRGB(255, 210, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin", "Bob" },
		Parent = folder,
	})
	BuildKit.Light(trophy, Color3.fromRGB(255, 210, 40), 30, 3)
	BuildKit.Particles(trophy, { Color = ColorSequence.new(Color3.fromRGB(255, 230, 80)), Size = BuildKit.Size(1), Rate = 25, SpreadAngle = Vector2.new(180, 180) })
	BuildKit.Billboard(pad, "🏆 FINISH! 🏆", { Size = UDim2.fromOffset(220, 50), Offset = Vector3.new(0, 9, 0), Color = Color3.fromRGB(255, 220, 60), MaxDistance = 150 })

	pad.Touched:Connect(function(hit)
		local player = BuildKit.PlayerFromHit(hit)
		if not player or finishDebounce[player] or not BuildKit.IsNear(player, pad) then
			return
		end
		if (player:GetAttribute("ObbyStage") or 0) <= 0 then
			return -- must have actually run the course
		end
		finishDebounce[player] = true
		self:_finish(player)
		task.delay(3, function()
			finishDebounce[player] = nil
			if player.Parent then
				player:SetAttribute("ObbyStage", 0)
				S.TycoonService:TeleportHome(player)
			end
		end)
	end)
end

function ObbyService:_finish(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local elapsed = startTimes[player] and (os.clock() - startTimes[player]) or nil
	startTimes[player] = nil
	data.ObbyCompletions += 1
	if S.QuestService then
		S.QuestService:Progress(player, "Obby", 1)
	end
	Remotes.VFX:FireClient(player, "Confetti", {})
	Remotes.VFX:FireClient(player, "WinSound", {})
	local now = os.time()
	if now - data.LastObbyReward >= Config.Obby.Cooldown then
		data.LastObbyReward = now
		local reward = math.max(Config.Obby.MinReward * (1 + data.Rebirths), S.TycoonService:GetIncome(player) * Config.Obby.RewardIncomeSeconds)
		S.DataService:AddCash(player, reward, false)
		Remotes.Notify:FireClient(player, { Text = "Obby complete! +" .. Util.Money(reward), Type = "success", Duration = 6 })
		Remotes.VFX:FireClient(player, "CashBurst", { Amount = reward })
	else
		Remotes.Notify:FireClient(player, {
			Text = "Obby complete! Next reward in " .. Util.FormatTime(Config.Obby.Cooldown - (now - data.LastObbyReward)),
			Type = "info",
			Duration = 6,
		})
	end
	Remotes.Announce:FireAllClients({
		Title = "🏃 " .. player.DisplayName .. " beat the obby!",
		Text = elapsed and ("Time: " .. string.format("%.1f", elapsed) .. "s") or "",
		Color = Color3.fromRGB(255, 80, 160),
	})
end

function ObbyService:GetCheckpointCFrame(stage: number): CFrame?
	return checkpoints[stage]
end

function ObbyService:Start()
	RunService.Heartbeat:Connect(function(dt)
		for _, spinner in spinners do
			spinner.Angle += dt * spinner.Speed
			spinner.Part.CFrame = CFrame.new(spinner.Center) * CFrame.Angles(0, spinner.Angle, 0)
		end
	end)
end

return ObbyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">PetService</string>
          <string name="Source"><![CDATA[--[[
	PetService - pets (see Config.Pets). Eggs cost cash and hatch a random pet;
	equipped pets follow you and add a permanent income bonus (DataService
	counts them in the multiplier). Everything is decided here: the client only
	asks. Pets are saved with the player.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local PC = Config.Pets

local PetService = {}
local S

local lastAction: { [Player]: number } = {}

local function rebirthsOf(player: Player): number
	local data = S.DataService:Get(player)
	return data and data.Rebirths or 0
end

function PetService:GetEggCost(player: Player, egg): number
	local wallet = S.DataService:GetWallet(player)
	local rebirths = wallet and wallet.Rebirths or 0
	return math.floor(math.max(egg.MinCash * (1 + rebirths), S.TycoonService:GetIncome(player) * egg.IncomeSeconds))
end

function PetService:GetSellValue(player: Player, petId: string): number
	local pet = Config.PetById[petId]
	return pet and math.floor(PC.Rarities[pet.Rarity].SellCash * (1 + rebirthsOf(player))) or 0
end

local function findOwned(data, uid: any)
	for index, pet in data.Pets.Owned do
		if pet.Uid == uid then
			return pet, index
		end
	end
	return nil, nil
end

local function equippedIndex(data, uid: number): number?
	for index, equipped in data.Pets.Equipped do
		if equipped == uid then
			return index
		end
	end
	return nil
end

-- picks a pet from an egg: first a rarity by the egg's weights, then a pet of it
function PetService:_roll(egg)
	local total = 0
	for _, weight in egg.Weights do
		total += weight
	end
	local roll = math.random() * total
	local rarity
	for _, name in PC.RarityOrder do
		local weight = egg.Weights[name]
		if weight then
			rarity = name
			roll -= weight
			if roll < 0 then
				break
			end
		end
	end
	local options = {}
	for _, pet in PC.List do
		if pet.Rarity == rarity then
			table.insert(options, pet)
		end
	end
	return options[math.random(1, #options)]
end

-- the client's view: the pets, the slots and what the eggs cost right now
function PetService:_state(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return nil
	end
	local eggs = {}
	for _, egg in PC.Eggs do
		table.insert(eggs, { Id = egg.Id, Cost = self:GetEggCost(player, egg) })
	end
	local owned = {}
	for _, pet in data.Pets.Owned do
		table.insert(owned, { Uid = pet.Uid, Id = pet.Id, Sell = self:GetSellValue(player, pet.Id) })
	end
	return { Owned = owned, Equipped = data.Pets.Equipped, Slots = Config.PetSlots(data.Rebirths), Eggs = eggs, Bonus = Config.PetsBonus(data.Pets) }
end

-- everyone sees equipped pets (attribute), the owner gets the full list
function PetService:_sync(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local ids = {}
	local byUid = {}
	for _, pet in data.Pets.Owned do
		byUid[pet.Uid] = pet
	end
	for _, uid in data.Pets.Equipped do
		if byUid[uid] then
			table.insert(ids, byUid[uid].Id)
		end
	end
	player:SetAttribute("Pets", table.concat(ids, ","))
	S.DataService:RefreshMultiplier(player)
	if player.Parent then
		Remotes.PetUpdate:FireClient(player, self:_state(player))
	end
end

-- drops equipped pets that don't exist or don't fit the slots (e.g. after a data edit)
function PetService:_clean(data)
	local seen, kept = {}, {}
	local slots = Config.PetSlots(data.Rebirths)
	for _, uid in data.Pets.Equipped do
		if not seen[uid] and findOwned(data, uid) and #kept < slots then
			seen[uid] = true
			table.insert(kept, uid)
		end
	end
	data.Pets.Equipped = kept
end

-- gives pets (hatching and the admin command); returns how many fit
function PetService:Give(player: Player, petId: string, count: number?): number
	local data = S.DataService:Get(player)
	if not data or not Config.PetById[petId] then
		return 0
	end
	local given = 0
	for _ = 1, count or 1 do
		if #data.Pets.Owned >= PC.MaxOwned then
			break
		end
		table.insert(data.Pets.Owned, { Uid = data.Pets.NextUid, Id = petId })
		data.Pets.NextUid += 1
		given += 1
	end
	self:_sync(player)
	return given
end

function PetService:Hatch(player: Player, eggId: any): (boolean, string)
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	local egg
	for _, candidate in PC.Eggs do
		if candidate.Id == eggId then
			egg = candidate
		end
	end
	if not egg then
		return false, "Unknown egg."
	end
	if #data.Pets.Owned >= PC.MaxOwned then
		return false, "Your pet storage is full (" .. PC.MaxOwned .. ") - sell some pets!"
	end
	local cost = self:GetEggCost(player, egg)
	if not S.DataService:SpendCash(player, cost) then
		return false, "You need " .. Util.Money(cost) .. " for a " .. egg.Name .. "!"
	end
	local pet = self:_roll(egg)
	self:Give(player, pet.Id, 1)
	data.Pets.Hatched += 1
	if S.QuestService then
		S.QuestService:Progress(player, "Hatch", 1)
	end
	local rarity = PC.Rarities[pet.Rarity]
	if rarity.Bonus >= 1 then
		Remotes.VFX:FireClient(player, "Confetti", {})
		if rarity.Bonus >= 2 then
			Remotes.Announce:FireAllClients({
				Title = "🥚 " .. player.DisplayName .. " hatched a MYTHIC!",
				Text = pet.Icon .. " " .. pet.Name .. " (+" .. rarity.Bonus .. "x income)",
				Color = rarity.Color,
			})
		end
	end
	return true, ("%s You hatched a %s %s! (%s, +%sx income)"):format(pet.Icon, pet.Rarity, pet.Name, pet.Rarity, tostring(rarity.Bonus))
end

function PetService:Equip(player: Player, uid: any): (boolean, string)
	local data = S.DataService:Get(player)
	local pet = data and findOwned(data, uid)
	if not data or not pet then
		return false, "You don't have that pet."
	end
	if equippedIndex(data, pet.Uid) then
		return false, "Already equipped."
	end
	local slots = Config.PetSlots(data.Rebirths)
	if #data.Pets.Equipped >= slots then
		return false, "All " .. slots .. " pet slots are used - unequip one first. (More slots at " .. table.concat(PC.SlotRebirths, " and ") .. " rebirths.)"
	end
	table.insert(data.Pets.Equipped, pet.Uid)
	self:_sync(player)
	return true, "Equipped " .. Config.PetById[pet.Id].Name .. "!"
end

function PetService:Unequip(player: Player, uid: any): (boolean, string)
	local data = S.DataService:Get(player)
	local index = data and type(uid) == "number" and equippedIndex(data, uid)
	if not data or not index then
		return false, "That pet isn't equipped."
	end
	table.remove(data.Pets.Equipped, index)
	self:_sync(player)
	return true, "Unequipped."
end

function PetService:Sell(player: Player, uid: any): (boolean, string)
	local data = S.DataService:Get(player)
	local pet, index = nil, nil
	if data then
		pet, index = findOwned(data, uid)
	end
	if not data or not pet or not index then
		return false, "You don't have that pet."
	end
	local value = self:GetSellValue(player, pet.Id)
	local equipped = equippedIndex(data, pet.Uid)
	if equipped then
		table.remove(data.Pets.Equipped, equipped)
	end
	table.remove(data.Pets.Owned, index)
	S.DataService:AddCash(player, value, false)
	self:_sync(player)
	return true, "Sold " .. Config.PetById[pet.Id].Name .. " for " .. Util.Money(value) .. "."
end

-- the best pets (by bonus) fill the slots
function PetService:EquipBest(player: Player): (boolean, string)
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	local sorted = table.clone(data.Pets.Owned)
	table.sort(sorted, function(a, b)
		local ba, bb = Config.PetBonus(a.Id), Config.PetBonus(b.Id)
		if ba ~= bb then
			return ba > bb
		end
		return a.Uid < b.Uid
	end)
	data.Pets.Equipped = {}
	for _, pet in sorted do
		if #data.Pets.Equipped < Config.PetSlots(data.Rebirths) then
			table.insert(data.Pets.Equipped, pet.Uid)
		end
	end
	self:_sync(player)
	return true, "Equipped your best pets (+" .. tostring(Config.PetsBonus(data.Pets)) .. "x income)."
end

function PetService:Init(services)
	S = services
	Remotes.PetAction.OnServerInvoke = function(player, action, arg)
		if not PC.Enabled then
			return false, "Pets are turned off."
		end
		if lastAction[player] and os.clock() - lastAction[player] < 0.25 then
			return false, "Slow down!"
		end
		lastAction[player] = os.clock()
		if action == "Hatch" then
			return self:Hatch(player, arg)
		elseif action == "Equip" then
			return self:Equip(player, arg)
		elseif action == "Unequip" then
			return self:Unequip(player, arg)
		elseif action == "Sell" then
			return self:Sell(player, arg)
		elseif action == "EquipBest" then
			return self:EquipBest(player)
		elseif action == "Refresh" then
			self:_sync(player)
			return true, ""
		end
		return false, "Unknown action."
	end
	S.DataService.PlayerLoaded:Connect(function(player, data)
		self:_clean(data)
		self:_sync(player)
	end)
	-- a rebirth can't remove slots, but a data edit could: keep the list valid
	S.DataService.BeforeSave:Connect(function(_, data)
		self:_clean(data)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return PetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--[[
	QuestService - every player has 3 quests (see Config.Quests). Other
	services report what players do (QuestService:Progress / :Reach); when a
	quest is complete the player claims it from the quest tracker and a new
	one takes its place. Quests are saved with the player's data.

	Rewards are paid when claimed, so they scale with the income you have
	then: the bigger of RewardSeconds of income or MinCash x (1 + rebirths).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local TycoonItems = require(Shared.TycoonItems)

local QC = Config.Quests

local QuestService = {}
local S

local dirty: { [Player]: boolean } = {}

local function count(map): number
	local n = 0
	for _ in map do
		n += 1
	end
	return n
end

-- lowest floor (2..roof) the tower hasn't unlocked yet
local function nextFloor(towerData): number?
	for floor = 2, Config.Tycoon.Floors do
		if not towerData.Purchased[TycoonItems.FloorUnlockId(floor)] then
			return floor
		end
	end
	if not towerData.Purchased.Roof_1 then
		return Config.Tycoon.Floors + 1
	end
	return nil
end

local function highestFloor(towerData): number
	local highest = 1
	for floor = 2, Config.Tycoon.Floors do
		if towerData.Purchased[TycoonItems.FloorUnlockId(floor)] then
			highest = floor
		end
	end
	if towerData.Purchased.Roof_1 then
		highest = Config.Tycoon.Floors + 1
	end
	return highest
end

local function floorName(floor: number): string
	return floor > Config.Tycoon.Floors and "the roof" or ("floor " .. floor)
end

function QuestService:_towerData(player: Player)
	return S.DataService:GetWallet(player) or S.DataService:Get(player)
end

-- can this kind of quest be done? (new = picking a new quest; existing quests
-- are only dropped when they became impossible, not when they're slow - e.g.
-- the tower is still rebuilding after a rejoin and has no income yet)
function QuestService:_available(kind: string, player: Player, data, new: boolean?): boolean
	local tower = self:_towerData(player)
	if kind == "Floor" then
		return tower ~= nil and nextFloor(tower) ~= nil
	elseif kind == "Secret" then
		return count(data.Secrets) < #Config.Secrets
	elseif kind == "Minigame" then
		return Config.Minigames.Enabled
	elseif kind == "Survive" then
		return Config.Disasters.Enabled
	elseif kind == "Hatch" then
		return Config.Pets.Enabled
	elseif kind == "Buy" then
		return tower ~= nil and count(tower.Purchased) < TycoonItems.BuyableCount
	elseif kind == "Earn" then
		return not new or S.TycoonService:GetIncome(player) > 0
	end
	return QC.Types[kind] ~= nil
end

function QuestService:_new(player: Player, data, taken: { [string]: boolean })
	local kinds = {}
	for kind in QC.Types do
		if not taken[kind] and self:_available(kind, player, data, true) then
			table.insert(kinds, kind)
		end
	end
	if #kinds == 0 then
		return nil
	end
	table.sort(kinds) -- stable order, then a random pick
	local kind = kinds[math.random(1, #kinds)]
	local def = QC.Types[kind]
	local quest = { Type = kind, Progress = 0, Target = 1 }
	if def.Targets then
		quest.Target = def.Targets[math.random(1, #def.Targets)]
	elseif kind == "Earn" then
		local seconds = def.IncomeSeconds[math.random(1, #def.IncomeSeconds)]
		quest.Target = math.max(def.MinTarget, Util.Number(math.floor(S.TycoonService:GetIncome(player) * seconds)) or 0)
	elseif kind == "Floor" then
		local tower = self:_towerData(player)
		quest.Target = nextFloor(tower) or Config.Tycoon.Floors + 1
		quest.Progress = highestFloor(tower)
	end
	return quest
end

-- top up to QC.Active quests (and drop ones that can't be done any more)
function QuestService:_fill(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local list = data.Quests.List
	local tower = self:_towerData(player)
	for i = #list, 1, -1 do
		local quest = list[i]
		local def = QC.Types[quest.Type]
		local done = def and quest.Progress >= quest.Target
		local stale = quest.Type == "Floor" and tower and nextFloor(tower) ~= quest.Target -- e.g. after a rebirth
		if not def or (not done and (stale or not self:_available(quest.Type, player, data))) then
			table.remove(list, i)
		end
	end
	local taken = {}
	for _, quest in list do
		taken[quest.Type] = true
	end
	while #list < QC.Active do
		local quest = self:_new(player, data, taken)
		if not quest then
			break
		end
		taken[quest.Type] = true
		table.insert(list, quest)
	end
	dirty[player] = true
end

function QuestService:_reward(player: Player, quest)
	local def = QC.Types[quest.Type]
	local wallet = self:_towerData(player)
	local rebirths = wallet and wallet.Rebirths or 0
	local cash = math.max(def.MinCash * (1 + rebirths), S.TycoonService:GetIncome(player) * def.RewardSeconds)
	return math.floor(cash * (1 + Config.RebirthPerk(rebirths, "Quest"))), def.BoostSeconds
end

function QuestService:_text(quest): string
	local def = QC.Types[quest.Type]
	if quest.Type == "Earn" then
		return string.format(def.Text, Util.Money(quest.Target))
	elseif quest.Type == "Floor" then
		return string.format(def.Text, floorName(quest.Target))
	end
	return (string.format(def.Text, quest.Target))
end

-- what the client shows
function QuestService:GetQuests(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return {}
	end
	local out = {}
	for i, quest in data.Quests.List do
		local cash, boost = self:_reward(player, quest)
		local progress, target = quest.Progress, quest.Target
		if quest.Type == "Floor" then
			-- show "floor 3 of 4" style progress as done / not done
			progress, target = (quest.Progress >= quest.Target) and 1 or 0, 1
		end
		out[i] = {
			Slot = i,
			Type = quest.Type,
			Text = self:_text(quest),
			Progress = math.min(progress, target),
			Target = target,
			Done = quest.Progress >= quest.Target,
			Reward = cash,
			Boost = boost,
		}
	end
	return out
end

function QuestService:_send(player: Player)
	dirty[player] = nil
	if player.Parent then
		Remotes.QuestUpdate:FireClient(player, self:GetQuests(player), (S.DataService:Get(player) or { Quests = { Claimed = 0 } }).Quests.Claimed)
	end
end

-- something happened: add `amount` to every active quest of that kind
function QuestService:Progress(player: Player, kind: string, amount: number?)
	local data = S.DataService:Get(player)
	if not data or not QC.Enabled then
		return
	end
	amount = Util.Number(amount) or 1
	for _, quest in data.Quests.List do
		if quest.Type == kind and quest.Progress < quest.Target then
			quest.Progress = math.min(quest.Target, quest.Progress + amount)
			dirty[player] = true
			if quest.Progress >= quest.Target then
				Remotes.Notify:FireClient(player, { Text = "📜 Quest complete: " .. self:_text(quest) .. "! Claim your reward.", Type = "success" })
				Remotes.VFX:FireClient(player, "PurchaseSound", {})
			end
		end
	end
end

-- progress that's a level, not a count (highest floor reached)
function QuestService:Reach(player: Player, kind: string, value: number)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	for _, quest in data.Quests.List do
		if quest.Type == kind and value > quest.Progress then
			self:Progress(player, kind, math.min(value, quest.Target) - quest.Progress)
		end
	end
end

-- a floor was unlocked in `plot`: counts for everyone building it
function QuestService:FloorUnlocked(plot)
	local tower = plot.Owner and S.DataService:Get(plot.Owner)
	if not tower then
		return
	end
	local highest = highestFloor(tower)
	for _, member in { plot.Owner, plot.Partner } do
		if member then
			self:Reach(member, "Floor", highest)
		end
	end
end

-- re-check the quests (after a rebirth, a duo change...)
function QuestService:Refresh(player: Player)
	self:_fill(player)
	self:_send(player)
end

-- `which` is the quest's type (a player never has two of a type) or its slot
function QuestService:Claim(player: Player, which: any): (boolean, string)
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	local list = data.Quests.List
	local slot
	if type(which) == "string" then
		for i, quest in list do
			if quest.Type == which then
				slot = i
				break
			end
		end
	else
		slot = Util.Number(which)
	end
	local quest = slot and list[slot]
	if not quest then
		return false, "That quest doesn't exist."
	end
	if quest.Progress < quest.Target then
		return false, "Finish the quest first!"
	end
	local cash, boost = self:_reward(player, quest)
	table.remove(list, slot)
	data.Quests.Claimed += 1
	S.DataService:AddCash(player, cash, false)
	local text = "+" .. Util.Money(cash)
	if boost then
		S.DataService:AddBoost(player, boost)
		text ..= " & 2x Boost for " .. Util.FormatTime(boost)
	end
	Remotes.VFX:FireClient(player, "CashBurst", { Amount = cash })
	Remotes.VFX:FireClient(player, "Confetti", {})
	local kept = #list
	self:_fill(player)
	if #list == kept + 1 and slot <= kept then
		table.insert(list, slot, table.remove(list)) -- the new quest takes the claimed one's place
	end
	self:_send(player)
	return true, "Quest reward: " .. text .. "!"
end

function QuestService:Init(services)
	S = services
	if not QC.Enabled then
		Remotes.ClaimQuest.OnServerInvoke = function()
			return false, "Quests are turned off."
		end
		return
	end
	Remotes.ClaimQuest.OnServerInvoke = function(player, slot)
		return self:Claim(player, slot)
	end
	S.DataService.PlayerLoaded:Connect(function(player)
		task.defer(function()
			-- (the tower is assigned on load too; quests depend on it)
			self:_fill(player)
			self:_send(player)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
end

function QuestService:Start()
	if not QC.Enabled then
		return
	end
	-- batch updates (income progress changes every second)
	while true do
		task.wait(1)
		for player in dirty do
			Util.Try("Quests", self._send, self, player)
		end
	end
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--[[
	RewardService - daily rewards (with streaks), codes and settings saving.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local RewardService = {}
local S

local codeCooldown: { [Player]: number } = {}

function RewardService:Init(services)
	S = services

	Remotes.ClaimDaily.OnServerInvoke = function(player)
		return self:ClaimDaily(player)
	end
	Remotes.RedeemCode.OnServerInvoke = function(player, code)
		return self:Redeem(player, code)
	end
	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		local data = S.DataService:Get(player)
		if not data or type(settings) ~= "table" then
			return
		end
		if Util.IsFinite(settings.MusicVolume) then
			data.Settings.MusicVolume = math.clamp(settings.MusicVolume, 0, 1)
		end
		if type(settings.SFX) == "boolean" then
			data.Settings.SFX = settings.SFX
		end
		for _, key in { "LowGraphics", "Guide", "AutoBuild" } do
			if type(settings[key]) == "boolean" then
				data.Settings[key] = settings[key]
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		codeCooldown[player] = nil
	end)
end

local function incomeCash(player: Player, minutes: number, minimum: number): number
	return math.max(minimum * (1 + (tonumber(player:GetAttribute("Rebirths")) or 0)), S.TycoonService:GetIncome(player) * minutes * 60)
end

function RewardService:GetDailyReward(player: Player, streak: number): number
	local rewards = Config.Daily.Rewards
	local index = ((streak - 1) % #rewards) + 1
	local amount = incomeCash(player, Config.Daily.IncomeMinutes[index] or 1, rewards[index])
	if S.MonetizationService:HasPass(player, "VIP") then
		amount *= 2
	end
	return amount
end

function RewardService:ClaimDaily(player: Player): (boolean, string)
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	local now = os.time()
	local since = now - data.LastDaily
	if since < Config.Daily.Cooldown then
		return false, "Come back in " .. Util.FormatTime(Config.Daily.Cooldown - since)
	end
	if since > Config.Daily.StreakResetAfter then
		data.DailyStreak = 0
	end
	data.DailyStreak += 1
	data.LastDaily = now
	local amount = self:GetDailyReward(player, data.DailyStreak)
	S.DataService:AddCash(player, amount, false)
	S.DataService:Sync(player)
	Remotes.VFX:FireClient(player, "Confetti", {})
	Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
	return true, "Day " .. data.DailyStreak .. " reward: +" .. Util.Money(amount) .. "!"
end

function RewardService:Redeem(player: Player, code: any): (boolean, string)
	if type(code) ~= "string" then
		return false, "Invalid code"
	end
	if codeCooldown[player] and os.clock() - codeCooldown[player] < 2 then
		return false, "Slow down!"
	end
	codeCooldown[player] = os.clock()
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	code = code:upper():gsub("%s", "")
	local reward = Config.Codes[code]
	if not reward or reward.Expired then
		return false, "That code doesn't exist or expired."
	end
	if data.RedeemedCodes[code] then
		return false, "You already redeemed this code!"
	end
	data.RedeemedCodes[code] = true
	local parts = {}
	if reward.Cash then
		local amount = incomeCash(player, reward.IncomeMinutes or 0, reward.Cash)
		S.DataService:AddCash(player, amount, false)
		table.insert(parts, "+" .. Util.Money(amount))
		Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
	end
	if reward.BoostSeconds then
		S.DataService:AddBoost(player, reward.BoostSeconds)
		table.insert(parts, "2x Boost for " .. Util.FormatTime(reward.BoostSeconds))
	end
	Remotes.VFX:FireClient(player, "Confetti", {})
	return true, "Code redeemed! " .. table.concat(parts, " & ")
end

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">SecretService</string>
          <string name="Source"><![CDATA[--[[
	SecretService - 12 secrets hidden around the map (see Config.Secrets and
	the spots in WorldBuilder / ObbyService). Finding one gives cash and
	permanently builds a relic in your tower (+5% income, survives rebirths).
]]
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local SecretService = {}
local S

local byId = {}
for _, secret in Config.Secrets do
	byId[secret.Id] = secret
end

function SecretService:Init(services)
	S = services
	local folder = Instance.new("Folder")
	folder.Name = "Secrets"
	folder.Parent = workspace

	local spots = table.clone(S.WorldBuilder.SecretSpots)
	if S.ObbyService and S.ObbyService.SecretSpot then
		spots.Obby = S.ObbyService.SecretSpot
	end

	for _, secret in Config.Secrets do
		local pos = spots[secret.Id]
		if pos then
			self:_spawnGem(folder, secret, pos)
		else
			warn("[Secrets] No spot for secret " .. secret.Id)
		end
	end
end

function SecretService:_spawnGem(folder: Folder, secret, position: Vector3)
	local model = BuildKit.Model("Secret_" .. secret.Id, folder)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local gem = BuildKit.Part({
		Name = "SecretGem",
		Size = Vector3.one * 1.6,
		CFrame = CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = secret.Color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin", "Bob" },
		Parent = model,
	})
	BuildKit.Light(gem, secret.Color, 10, 1.5)
	BuildKit.Particles(gem, {
		Color = ColorSequence.new(secret.Color, Color3.new(1, 1, 1)),
		Size = BuildKit.Size(0.4),
		Rate = 8,
		Speed = NumberRange.new(1, 2),
		SpreadAngle = Vector2.new(180, 180),
	})
	-- generous touch box so it's easy to grab
	local hitbox = BuildKit.Part({ Name = "Hitbox", Size = Vector3.new(5, 6, 5), Position = position, Transparency = 1, CanCollide = false, Parent = model })
	local busy = {}
	hitbox.Touched:Connect(function(hit)
		local player = BuildKit.PlayerFromHit(hit)
		if player and not busy[player] and BuildKit.IsNear(player, hitbox) then
			busy[player] = true
			self:Find(player, secret.Id)
			task.delay(2, function()
				busy[player] = nil
			end)
		end
	end)
end

function SecretService:Count(player: Player): number
	local data = S.DataService:Get(player)
	if not data then
		return 0
	end
	local n = 0
	for _ in data.Secrets do
		n += 1
	end
	return n
end

function SecretService:Find(player: Player, secretId: string, silent: boolean?): boolean
	local data = S.DataService:Get(player)
	local secret = byId[secretId]
	if not data or not secret then
		return false
	end
	if data.Secrets[secretId] then
		if not silent then
			Remotes.Notify:FireClient(player, { Text = "You already found " .. secret.Name .. ".", Type = "info", Duration = 2 })
		end
		return false
	end
	data.Secrets[secretId] = true
	local count = self:Count(player)
	local rewards = Config.SecretRewards
	local cash = math.max(rewards.MinCash * (1 + data.Rebirths), S.TycoonService:GetIncome(player) * rewards.IncomeSeconds)
	S.DataService:AddCash(player, cash, false)
	S.DataService:Sync(player)
	S.TycoonService:OnSecretFound(player, secretId)
	if S.QuestService then
		S.QuestService:Progress(player, "Secret", 1)
	end
	if secret.BadgeId and secret.BadgeId ~= 0 then
		task.spawn(pcall, BadgeService.AwardBadge, BadgeService, player.UserId, secret.BadgeId)
	end
	if not silent then
		Remotes.VFX:FireClient(player, "SecretFound", { Name = secret.Name, Count = count, Total = #Config.Secrets, Color = secret.Color, Cash = cash })
		Remotes.Notify:FireClient(player, {
			Text = "🕵️ SECRET FOUND: " .. secret.Name .. " (" .. count .. "/" .. #Config.Secrets .. ") +" .. Util.Money(cash) .. " and +" .. rewards.BonusPercent .. "% income forever!",
			Type = "success",
			Duration = 8,
		})
		Remotes.Announce:FireAllClients({ Title = "🕵️ " .. player.DisplayName .. " found a secret!", Text = secret.Name .. " (" .. count .. "/" .. #Config.Secrets .. ")", Color = secret.Color })
		if count == #Config.Secrets then
			Remotes.Announce:FireAllClients({ Title = "🏅 SECRET MASTER!", Text = player.DisplayName .. " found ALL " .. count .. " secrets!", Color = Color3.fromRGB(255, 215, 0) })
		end
	end
	return true
end

function SecretService:FindAll(player: Player)
	for _, secret in Config.Secrets do
		self:Find(player, secret.Id, true)
	end
end

function SecretService:Reset(player: Player)
	local data = S.DataService:Get(player)
	if data then
		data.Secrets = {}
		S.DataService:Sync(player)
		S.TycoonService:Rebuild(player)
	end
end

return SecretService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">ShieldService</string>
          <string name="Source"><![CDATA[--[[
	ShieldService - the personal shield (see Config.Shield). While it's on you
	are protected from disaster damage (DisasterService:IsProtected) and wear a
	force-field bubble. The activation time is saved, so the cooldown can't be
	skipped by rejoining and an active shield survives a rejoin.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local SC = Config.Shield

local ShieldService = {}
local S

function ShieldService:_times(player: Player): (number, number)
	local data = S.DataService:Get(player)
	local start = data and data.Shield.Start or 0
	return start + SC.Seconds, start + SC.Cooldown -- (shield ends, ready again)
end

function ShieldService:IsShielded(player: Player): boolean
	local untilTime = self:_times(player)
	return SC.Enabled and os.time() < untilTime
end

-- the bubble and the attributes the client shows
function ShieldService:_apply(player: Player)
	local untilTime, readyAt = self:_times(player)
	player:SetAttribute("ShieldEnd", untilTime)
	player:SetAttribute("ShieldReadyAt", readyAt)
	local character = player.Character
	if not character then
		return
	end
	local field = character:FindFirstChild("ShieldBubble") -- (other force-fields, like the admin ;ff, are left alone)
	if self:IsShielded(player) then
		if not field then
			field = Instance.new("ForceField")
			field.Name = "ShieldBubble"
			field.Visible = true
			field.Parent = character
		end
	elseif field then
		field:Destroy()
	end
end

function ShieldService:Activate(player: Player): (boolean, string)
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	local _, readyAt = self:_times(player)
	if os.time() < readyAt then
		return false, "Your shield is recharging: " .. Util.FormatTime(readyAt - os.time())
	end
	data.Shield.Start = os.time()
	self:_apply(player)
	Remotes.VFX:FireAllClients("ShieldHit", { Center = player.Character and player.Character:GetPivot().Position or Vector3.zero, Radius = 8 })
	return true, "🛡️ Shield on for " .. Util.FormatTime(SC.Seconds) .. " - disasters can't hurt you!"
end

function ShieldService:Init(services)
	S = services
	Remotes.ActivateShield.OnServerInvoke = function(player)
		if not SC.Enabled then
			return false, "Shields are turned off."
		end
		return self:Activate(player)
	end
	S.DataService.PlayerLoaded:Connect(function(player)
		self:_apply(player)
	end)
	local function watch(player: Player)
		player.CharacterAdded:Connect(function()
			task.defer(function()
				self:_apply(player)
			end)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
end

-- the bubble goes away when the time is up
function ShieldService:Start()
	while true do
		task.wait(1)
		for _, player in Players:GetPlayers() do
			if S.DataService:Get(player) then
				Util.Try("Shield", self._apply, self, player)
			end
		end
	end
end

return ShieldService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">TycoonBuilder</string>
          <string name="Source"><![CDATA[--[[
	TycoonBuilder - procedural geometry for plots, 8-floor towers, buttons,
	rubble and every one of the 500+ tycoon items. No assets needed.

	Plot space: plot.CFrame at ground level, -Z faces the lobby.
	Tower space: floor F surface = plot.TowerCF * (0, (F-1) * FloorHeight, 0)
	Floor-local coordinates come from TycoonItems.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Items = require(Shared.TycoonItems)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part
local FH = Config.Tycoon.FloorHeight

local TycoonBuilder = {}

local PLOT_COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(80, 160, 255),
	Color3.fromRGB(90, 220, 110),
	Color3.fromRGB(255, 200, 40),
	Color3.fromRGB(190, 90, 255),
	Color3.fromRGB(255, 130, 40),
	Color3.fromRGB(0, 220, 220),
	Color3.fromRGB(255, 100, 200),
}

local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder upright
local DARK = Color3.fromRGB(40, 40, 50)

local function at(cf: CFrame, x: number, y: number, z: number): CFrame
	return cf * CFrame.new(x, y, z)
end

local function shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), amount)
	end
	return color:Lerp(Color3.new(0, 0, 0), -amount)
end

function TycoonBuilder.FloorCF(plot, floor: number): CFrame
	return plot.TowerCF * CFrame.new(0, (floor - 1) * FH, 0)
end

local function themeOf(item)
	return item.Theme or Items.Themes[1]
end

---------------------------------------------------------------------------
-- Plot base (always present)
---------------------------------------------------------------------------
function TycoonBuilder.BuildPlot(index: number, cf: CFrame, parent: Instance)
	local color = PLOT_COLORS[(index - 1) % #PLOT_COLORS + 1]
	local model = BuildKit.Model("Plot" .. index, parent)
	model:SetAttribute("PlotIndex", index)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	local base = BuildKit.Model("Base", model)
	Part({ Name = "Ground", Size = Vector3.new(120, 1, 120), CFrame = at(cf, 0, 0.5, 0), Color = Color3.fromRGB(225, 225, 230), Material = Enum.Material.Concrete, Parent = base })
	for _, data in {
		{ Vector3.new(120, 0.3, 1), Vector3.new(0, 1.1, -59.5) },
		{ Vector3.new(120, 0.3, 1), Vector3.new(0, 1.1, 59.5) },
		{ Vector3.new(1, 0.3, 120), Vector3.new(-59.5, 1.1, 0) },
		{ Vector3.new(1, 0.3, 120), Vector3.new(59.5, 1.1, 0) },
	} do
		Part({ Name = "Border", Size = data[1], CFrame = at(cf, data[2].X, data[2].Y, data[2].Z), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = base })
	end
	-- path from the gate to the tower door
	Part({ Name = "Path", Size = Vector3.new(12, 0.2, 28), CFrame = at(cf, 0, 1.1, -46), Color = Color3.fromRGB(170, 150, 120), Material = Enum.Material.Cobblestone, Parent = base })

	-- entrance gate with owner name
	for _, x in { -11, 11 } do
		Part({ Name = "GatePillar", Size = Vector3.new(2, 16, 2), CFrame = at(cf, x, 8, -58), Color = Color3.fromRGB(45, 45, 60), Material = Enum.Material.Metal, Parent = base })
		local orb = Part({ Name = "GateOrb", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, CFrame = at(cf, x, 17, -58), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = base })
		BuildKit.Light(orb, color, 20, 2)
	end
	local beam = Part({ Name = "GateSign", Size = Vector3.new(24, 4, 1.2), CFrame = at(cf, 0, 14, -58), Color = color, Parent = base })
	local _, signLabel = BuildKit.SurfaceText(beam, Enum.NormalId.Front, "EMPTY PLOT", { PixelsPerStud = 20 })
	local _, signLabelBack = BuildKit.SurfaceText(beam, Enum.NormalId.Back, "EMPTY PLOT", { PixelsPerStud = 20 })

	local folders = {}
	for _, name in { "Items", "Buttons", "Rubble" } do
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = model
		folders[name] = f
	end

	local towerCF = cf * CFrame.new(0, 1, 10)
	return {
		Index = index,
		CFrame = cf,
		TowerCF = towerCF,
		Color = color,
		Model = model,
		Items = folders.Items,
		Buttons = folders.Buttons,
		Rubble = folders.Rubble,
		SignLabels = { signLabel, signLabelBack },
		SpawnCFrame = at(cf, 0, 4, -50) * CFrame.Angles(0, math.pi, 0),
		ShieldCenter = (cf * CFrame.new(0, 60, 10)).Position,
		ShieldRadius = 130,
	}
end

---------------------------------------------------------------------------
-- Purchase button
---------------------------------------------------------------------------
function TycoonBuilder.BuildButton(plot, item, slot: number)
	local floorCF = TycoonBuilder.FloorCF(plot, item.ButtonFloor or 1)
	local pos = Items.ButtonSlots[slot]
	local model = BuildKit.Model(item.Id, plot.Buttons)
	local ring = Part({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 6.2, 6.2),
		CFrame = at(floorCF, pos.X, 0.2, pos.Z) * FLAT,
		Color = Color3.fromRGB(30, 30, 40),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local pad = Part({
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 5, 5),
		CFrame = at(floorCF, pos.X, 0.4, pos.Z) * FLAT,
		Color = Color3.fromRGB(235, 70, 70),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	local gui, label = BuildKit.Billboard(pad, item.Name .. "\n" .. Util.Money(item.Cost), {
		Size = UDim2.fromOffset(180, 56),
		Offset = Vector3.new(0, 3.5, 0),
		MaxDistance = 60,
	})
	model.PrimaryPart = ring
	pad.Size = Vector3.new(0.6, 0.5, 0.5)
	TweenService:Create(pad, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = Vector3.new(0.6, 5, 5) }):Play()
	return { Model = model, Pad = pad, Label = label, Gui = gui, Slot = slot, Floor = item.ButtonFloor }
end

---------------------------------------------------------------------------
-- Rubble left behind when a disaster wrecks an item
---------------------------------------------------------------------------
function TycoonBuilder.BuildRubble(plot, position: Vector3, id: string)
	local model = BuildKit.Model("Rubble_" .. id, plot.Rubble)
	local rng = Random.new()
	for _ = 1, 4 do
		Part({
			Name = "Debris",
			Size = Vector3.new(rng:NextNumber(1, 3), rng:NextNumber(0.5, 1.5), rng:NextNumber(1, 3)),
			CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-2, 2), 0.5, rng:NextNumber(-2, 2))) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 6), rng:NextNumber(-0.6, 0.6)),
			Color = Color3.fromRGB(45, 40, 38),
			Material = Enum.Material.Slate,
			CanCollide = false,
			Parent = model,
		})
	end
	local core = Part({ Name = "Core", Size = Vector3.new(2, 1, 2), Position = position + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(30, 25, 25), Material = Enum.Material.CrackedLava, CanCollide = false, Parent = model })
	local fire = Instance.new("Fire")
	fire.Size = 5
	fire.Heat = 8
	fire.Parent = core
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(40, 40, 40)
	smoke.Opacity = 0.25
	smoke.RiseVelocity = 4
	smoke.Size = 3
	smoke.Parent = core
	BuildKit.Billboard(core, "🔧 WRECKED", { Size = UDim2.fromOffset(110, 24), Offset = Vector3.new(0, 3, 0), Color = Color3.fromRGB(255, 120, 80), MaxDistance = 50 })
	return model
end

---------------------------------------------------------------------------
-- Item builders. Each gets (plot, item, model, floorCF, ownerName)
---------------------------------------------------------------------------
local builders = {}

-- Floor structure: slab, conveyor, collector, vault pad, elevator
function builders.Unlock(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local F = item.Floor
	if F > 1 then
		Part({ Name = "Slab", Size = Vector3.new(84, 1, 84), CFrame = at(cf, 0, -0.5, 0), Color = theme.Primary, Material = theme.Floor, Parent = model })
	else
		Part({ Name = "Tiles", Size = Vector3.new(84, 0.2, 84), CFrame = at(cf, 0, 0.1, 0), Color = theme.Primary, Material = theme.Floor, Parent = model })
	end
	for _, data in {
		{ Vector3.new(84.4, 0.4, 0.6), Vector3.new(0, -0.2, -42) },
		{ Vector3.new(84.4, 0.4, 0.6), Vector3.new(0, -0.2, 42) },
		{ Vector3.new(0.6, 0.4, 84.4), Vector3.new(-42, -0.2, 0) },
		{ Vector3.new(0.6, 0.4, 84.4), Vector3.new(42, -0.2, 0) },
	} do
		Part({ Name = "Edge", Size = data[1], CFrame = at(cf, data[2].X, data[2].Y + (F == 1 and 0.4 or 0), data[2].Z), Color = theme.Accent, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
	end

	-- conveyor
	local beltLength = Items.BeltEndX - Items.BeltStartX
	local beltX = (Items.BeltEndX + Items.BeltStartX) / 2
	Part({ Name = "Belt", Size = Vector3.new(beltLength, 1.2, 5), CFrame = at(cf, beltX, 0.6, Items.BeltZ), Color = Color3.fromRGB(35, 35, 42), Material = Enum.Material.DiamondPlate, Parent = model })
	for _, dz in { -2.75, 2.75 } do
		Part({ Name = "Rail", Size = Vector3.new(beltLength, 0.8, 0.5), CFrame = at(cf, beltX, 1.6, Items.BeltZ + dz), Color = theme.Accent, Material = Enum.Material.Neon, Parent = model })
	end
	local collector = Part({
		Name = "Collector",
		Size = Vector3.new(3, 3.5, 6),
		CFrame = at(cf, Items.CollectorPos.X, 1.75, Items.CollectorPos.Z),
		Color = Color3.fromRGB(40, 230, 110),
		Material = Enum.Material.Neon,
		Tags = { "Pulse" },
		Parent = model,
	})
	BuildKit.Light(collector, Color3.fromRGB(120, 255, 160), 14, 1.5)
	BuildKit.Billboard(collector, "COLLECTOR", { Size = UDim2.fromOffset(130, 30), Offset = Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(120, 255, 160), MaxDistance = 50 })

	-- vault pad
	local pad = Part({
		Name = "VaultPad",
		Size = Vector3.new(6, 0.4, 6),
		CFrame = at(cf, Items.VaultPadPos.X, 0.2, Items.VaultPadPos.Z),
		Color = Color3.fromRGB(255, 200, 30),
		Material = Enum.Material.Neon,
		Tags = { "Pulse" },
		Parent = model,
	})
	local _, vaultLabel = BuildKit.Billboard(pad, "🏦 VAULT: $0\nStep here to collect", { Size = UDim2.fromOffset(210, 60), Offset = Vector3.new(0, 4, 0), Color = Color3.fromRGB(255, 225, 90), MaxDistance = 70 })

	-- elevator booth
	local e = Items.ElevatorPos
	Part({ Name = "ElevatorPad", Size = Vector3.new(7, 0.4, 7), CFrame = at(cf, e.X, 0.2, e.Z), Color = Color3.fromRGB(0, 200, 255), Material = Enum.Material.Neon, Parent = model })
	for _, offset in { Vector2.new(-3.3, -3.3), Vector2.new(3.3, -3.3), Vector2.new(-3.3, 3.3), Vector2.new(3.3, 3.3) } do
		Part({ Name = "ElevatorFrame", Size = Vector3.new(0.5, 10, 0.5), CFrame = at(cf, e.X + offset.X, 5, e.Z + offset.Y), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	end
	Part({ Name = "ElevatorRoof", Size = Vector3.new(7.2, 0.5, 7.2), CFrame = at(cf, e.X, 10.2, e.Z), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	local console = Part({ Name = "Console", Size = Vector3.new(1.4, 3, 1), CFrame = at(cf, e.X + 2.2, 1.5, e.Z + 2.6), Color = Color3.fromRGB(0, 200, 255), Material = Enum.Material.Neon, Parent = model })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Choose Floor"
	prompt.ObjectText = "Elevator"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = console
	local signPart = Part({ Name = "FloorSign", Size = Vector3.new(7, 1.6, 0.3), CFrame = at(cf, e.X, 11.3, e.Z - 3.3), Color = DARK, Parent = model })
	BuildKit.SurfaceText(signPart, Enum.NormalId.Front, "🛗 FLOOR " .. F, { PixelsPerStud = 20 })
	BuildKit.SurfaceText(signPart, Enum.NormalId.Back, "🛗 FLOOR " .. F .. " • " .. string.upper(theme.Name), { PixelsPerStud = 20 })

	-- interior lights
	for _, x in { -20, 20 } do
		local lamp = Part({ Name = "Lamp", Size = Vector3.new(6, 0.3, 1), CFrame = at(cf, x, FH - 1.4, 0), Color = Color3.fromRGB(255, 245, 220), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		BuildKit.Light(lamp, Color3.fromRGB(255, 240, 210), 40, 1.2)
	end
	return { VaultPad = pad, VaultLabel = vaultLabel, ElevatorPrompt = prompt }
end

function builders.Dropper(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local k = item.Slot
	local x, z = item.LocalPos.X, item.LocalPos.Z
	local color = theme.Primary:Lerp(theme.Accent, (k - 1) / 9)
	local material = k >= 6 and theme.Drop or Enum.Material.SmoothPlastic
	Part({ Name = "Pillar", Size = Vector3.new(1.2, 13, 1.2), CFrame = at(cf, x, 6.5, z + 4.6), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Arm", Size = Vector3.new(1.2, 1.2, 3.6), CFrame = at(cf, x, 12.4, z + 2.8), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	local body = Part({ Name = "Body", Size = Vector3.new(4.2, 3.6, 4.2), CFrame = at(cf, x, 9.8, z), Color = color, Material = material, Parent = model })
	Part({ Name = "Band", Size = Vector3.new(4.4, 0.5, 4.4), CFrame = at(cf, x, 8.6, z), Color = theme.Accent, Material = Enum.Material.Neon, Parent = model })
	Part({ Name = "Funnel", Size = Vector3.new(2.2, 1.4, 2.2), CFrame = at(cf, x, 7.4, z), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	local gem = Part({
		Name = "Gem",
		Size = Vector3.one * 1.3,
		CFrame = at(cf, x, 12.9, z) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin" },
		Parent = model,
	})
	if k >= 5 then
		BuildKit.Particles(body, { Color = ColorSequence.new(color), Size = BuildKit.Size(0.4), Rate = k, Speed = NumberRange.new(1, 2), SpreadAngle = Vector2.new(180, 180) })
	end
	if k >= 8 then
		BuildKit.Light(gem, color, 12, 1.5)
	end
	BuildKit.Billboard(body, item.Name, { Size = UDim2.fromOffset(120, 22), Offset = Vector3.new(0, 4.6, 0), MaxDistance = 36, Color = shade(color, 0.4) })
	local spout = at(cf, x, 6.4, z).Position
	return {
		Spout = spout,
		BeltY = at(cf, 0, 1.2, 0).Position.Y,
		BeltEnd = at(cf, Items.BeltEndX, 1.2, Items.BeltZ).Position,
	}
end

function builders.Mk2(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local x, z = item.LocalPos.X, item.LocalPos.Z
	local ring = Part({
		Name = "Mk2Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 5.6, 5.6),
		CFrame = at(cf, x, 9.8, z) * FLAT,
		Color = theme.Accent,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	BuildKit.Particles(ring, {
		Color = ColorSequence.new(theme.Accent, Color3.new(1, 1, 1)),
		Size = BuildKit.Size(0.5),
		Rate = 10,
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(180, 180),
	})
	BuildKit.Billboard(ring, "MK II", { Size = UDim2.fromOffset(60, 20), Offset = Vector3.new(0, -3.4, 0), MaxDistance = 36, Color = theme.Accent })
	return {}
end

function builders.Upgrader(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local x, z = item.LocalPos.X, item.LocalPos.Z
	local color = Color3.fromHSV((theme.Hue + 0.12 * item.Slot) % 1, 0.8, 1)
	for _, dz in { -3.4, 3.4 } do
		Part({ Name = "Pillar", Size = Vector3.new(1.2, 8, 1.2), CFrame = at(cf, x, 4, z + dz), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	end
	Part({ Name = "Top", Size = Vector3.new(2, 1, 8), CFrame = at(cf, x, 8.4, z), Color = color, Material = Enum.Material.Neon, Parent = model })
	local detector = Part({ Name = "Detector", Size = Vector3.new(1.2, 4, 5), CFrame = at(cf, x, 3.2, z), Color = color, Material = Enum.Material.ForceField, Transparency = 0.2, CanCollide = false, Parent = model })
	BuildKit.Light(detector, color, 12, 1.5)
	local ring = Part({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2.6, 2.6),
		CFrame = at(cf, x, 10.4, z),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin" },
		Parent = model,
	})
	BuildKit.Billboard(ring, "x" .. tostring(item.Multiplier), { Size = UDim2.fromOffset(70, 26), Offset = Vector3.new(0, 2.2, 0), MaxDistance = 50, Color = shade(color, 0.4) })
	return { BeltPos = at(cf, x, 1.2, z).Position, Color = color }
end

-- 4 generator styles
local generatorStyles = {}

generatorStyles[1] = function(model, cf, x, z, theme, color) -- press
	Part({ Name = "Base", Size = Vector3.new(6, 2, 6), CFrame = at(cf, x, 1, z), Color = theme.Secondary, Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Column", Size = Vector3.new(1, 7, 1), CFrame = at(cf, x - 2.2, 5.5, z), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Column", Size = Vector3.new(1, 7, 1), CFrame = at(cf, x + 2.2, 5.5, z), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Head", Size = Vector3.new(5.4, 1.2, 3), CFrame = at(cf, x, 9.2, z), Color = color, Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Piston", Size = Vector3.new(2.4, 2, 2.4), CFrame = at(cf, x, 5, z), Color = color, Material = Enum.Material.Metal, Tags = { "Bob" }, Parent = model })
	return Part({ Name = "Coin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 2.4, 2.4), CFrame = at(cf, x, 2.6, z), Color = Color3.fromRGB(255, 210, 40), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Spin" }, Parent = model })
end

generatorStyles[2] = function(model, cf, x, z, theme, color) -- tank
	Part({ Name = "Base", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 6.5, 6.5), CFrame = at(cf, x, 0.5, z) * FLAT, Color = theme.Secondary, Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Tank", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, 5, 5), CFrame = at(cf, x, 5, z) * FLAT, Color = Color3.fromRGB(200, 230, 255), Material = Enum.Material.Glass, Transparency = 0.5, Parent = model })
	local fluid = Part({ Name = "Fluid", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6.5, 4.2, 4.2), CFrame = at(cf, x, 4.6, z) * FLAT, Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
	Part({ Name = "Cap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 5.6, 5.6), CFrame = at(cf, x, 9.2, z) * FLAT, Color = DARK, Material = Enum.Material.Metal, Parent = model })
	return fluid
end

generatorStyles[3] = function(model, cf, x, z, theme, color) -- ring tower
	Part({ Name = "Base", Size = Vector3.new(5, 1, 5), CFrame = at(cf, x, 0.5, z), Color = theme.Secondary, Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Pole", Size = Vector3.new(0.8, 10, 0.8), CFrame = at(cf, x, 5.5, z), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	for i = 1, 3 do
		Part({ Name = "Ring" .. i, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 5 - i, 5 - i), CFrame = at(cf, x, 2 + i * 2.4, z) * CFrame.Angles(0, 0, math.rad(90 - 25 * i)), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Spin" }, Parent = model })
	end
	return Part({ Name = "Orb", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = at(cf, x, 11, z), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
end

generatorStyles[4] = function(model, cf, x, z, theme, color) -- printer
	Part({ Name = "Body", Size = Vector3.new(6, 5, 5), CFrame = at(cf, x, 2.5, z), Color = theme.Secondary, Material = Enum.Material.Metal, Parent = model })
	local screen = Part({ Name = "Screen", Size = Vector3.new(4, 2, 0.2), CFrame = at(cf, x, 3.6, z - 2.55), Color = Color3.fromRGB(10, 10, 20), Parent = model })
	BuildKit.SurfaceText(screen, Enum.NormalId.Front, "$$$", { PixelsPerStud = 20, Color = color })
	Part({ Name = "Tray", Size = Vector3.new(4, 0.4, 2), CFrame = at(cf, x, 1.2, z - 3), Color = DARK, Parent = model })
	for i = 1, 3 do
		Part({ Name = "Bill", Size = Vector3.new(3, 0.1, 1.4), CFrame = at(cf, x, 1.45 + i * 0.12, z - 3) * CFrame.Angles(0, math.rad(i * 8 - 16), 0), Color = Color3.fromRGB(110, 200, 110), Parent = model })
	end
	return Part({ Name = "Light", Size = Vector3.new(6.2, 0.4, 5.2), CFrame = at(cf, x, 5.2, z), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
end

function builders.Generator(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local x, z = item.LocalPos.X, item.LocalPos.Z
	local color = Color3.fromHSV((theme.Hue + item.Slot * 0.07) % 1, 0.75, 1)
	local style = generatorStyles[(item.Slot - 1) % 4 + 1]
	local top = style(model, cf, x, z, theme, color)
	BuildKit.Particles(top, { Color = ColorSequence.new(color), Size = BuildKit.Size(0.5), Rate = 6, Speed = NumberRange.new(2, 4), SpreadAngle = Vector2.new(60, 60), EmissionDirection = Enum.NormalId.Top })
	BuildKit.Light(top, color, 12, 1.2)
	BuildKit.Billboard(top, item.Name, { Size = UDim2.fromOffset(130, 24), Offset = Vector3.new(0, 3, 0), MaxDistance = 40, Color = shade(color, 0.4) })
	return { PopPos = at(cf, x, 12, z).Position }
end

