        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	MEGA TYCOON - client bootstrap. Loads every controller in Controllers/,
	calls :Init(C) on each (C = registry of all controllers), then :Start().
]]
local controllersFolder = script.Parent:WaitForChild("Controllers")

local ORDER = {
	"UI",
	"Notifications",
	"Music",
	"VFX",
	"Animator",
	"Build",
	"HUD",
	"Shop",
	"Panels",
	"Duo",
	"Disasters",
	"Quests",
	"Gifts",
	"Wheel",
	"Shield",
	"Pets",
	"Travel",
	"Weekly",
	"Guide",
	"DropVisuals",
	"Admin",
	"Minigame",
	"ChatTags",
}

local C = {}
for _, name in ORDER do
	local module = controllersFolder:WaitForChild(name, 10)
	if module then
		local ok, result = pcall(require, module)
		if ok then
			C[name] = result
		else
			warn("[MegaTycoon] Failed to load controller " .. name .. ": " .. tostring(result))
		end
	end
end

for _, name in ORDER do
	local controller = C[name]
	if controller and controller.Init then
		local ok, err = pcall(controller.Init, controller, C)
		if not ok then
			warn("[MegaTycoon] Init failed for " .. name .. ": " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local controller = C[name]
	if controller and controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start, controller)
			if not ok then
				warn("[MegaTycoon] Start failed for " .. name .. ": " .. tostring(err))
			end
		end)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Admin</string>
            <string name="Source"><![CDATA[--[[
	Admin (client) - Admin Panel UI + client-side admin effects
	(fly, noclip, spectate). Opens with the 🛡️ button or F2.
	Chat commands (";speed me 50") are routed through here too.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Admin = {}
local C

local commandBox: TextBox
local resultLabel: TextLabel
local pages: { [string]: ScrollingFrame } = {}
local tabButtons: { [string]: TextButton } = {}
local currentTab = "Commands"

---------------------------------------------------------------------------
-- Fly / noclip / view
---------------------------------------------------------------------------
local flying = false
local flyParts = {}
local flyConn: RBXScriptConnection?
local noclipConn: RBXScriptConnection?

local function stopFly()
	flying = false
	if flyConn then
		flyConn:Disconnect()
		flyConn = nil
	end
	for _, inst in flyParts do
		inst:Destroy()
	end
	flyParts = {}
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
	end
end

local function startFly()
	stopFly()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return
	end
	flying = true
	local attachment = Instance.new("Attachment")
	attachment.Name = "FlyAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Attachment0 = attachment
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.MaxTorque = math.huge
	align.Responsiveness = 40
	align.Parent = root
	flyParts = { attachment, velocity, align }
	humanoid.PlatformStand = true

	flyConn = RunService.RenderStepped:Connect(function()
		if not root.Parent then
			stopFly()
			return
		end
		local cam = workspace.CurrentCamera
		local move = humanoid.MoveDirection
		local vertical = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
			vertical += 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			vertical -= 1
		end
		-- fly where the camera looks when moving forward
		local look = cam.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0 and move.Magnitude > 0 then
			local forwardAmount = move:Dot(flatLook.Unit)
			move += Vector3.new(0, look.Y * forwardAmount, 0)
		end
		local speed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 160 or 70
		velocity.VectorVelocity = (move + Vector3.new(0, vertical, 0)) * speed
		align.CFrame = cam.CFrame.Rotation
	end)
end

local function setNoclip(enabled: boolean)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
	if enabled then
		noclipConn = RunService.Stepped:Connect(function()
			local character = player.Character
			if character then
				for _, part in character:GetDescendants() do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end

local function view(target: Player?)
	local cam = workspace.CurrentCamera
	local character = (target or player).Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		cam.CameraSubject = humanoid
	end
end

---------------------------------------------------------------------------
-- Panel
---------------------------------------------------------------------------
local function run(text: string)
	if text == "" then
		return
	end
	local ok, message = Remotes.AdminCommand:InvokeServer(text)
	if resultLabel then
		resultLabel.Text = tostring(message)
		resultLabel.TextColor3 = ok and Theme.Green or Theme.Red
	end
	C.Notifications:Toast(tostring(message), ok and "success" or "error", 3)
	return ok
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function rowFrame(parent: Instance, order: number, height: number?)
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(1, -10, 0, height or 46),
		BackgroundColor3 = order % 2 == 0 and Theme.PanelLight or Theme.Panel,
		LayoutOrder = order,
		ZIndex = 7,
		Parent = parent,
	})
	UIKit.Corner(frame, 8)
	return frame
end

local function smallButton(parent: Instance, text: string, color: Color3, x: number, width: number, callback: () -> ())
	return UIKit.Button({
		Text = text,
		Color = color,
		Size = UDim2.fromOffset(width, 32),
		Position = UDim2.new(1, x, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 8,
		Parent = parent,
		Callback = callback,
	})
end

local function fillCommands()
	local page = pages.Commands
	clear(page)
	local list = Remotes.AdminData:InvokeServer("commands")
	if not list then
		return
	end
	table.sort(list, function(a, b)
		if a.Rank ~= b.Rank then
			return a.Rank < b.Rank
		end
		return a.Name < b.Name
	end)
	for i, cmd in list do
		local frame = rowFrame(page, i, 50)
		local rankColor = ({ Theme.Accent2, Theme.Green, Theme.Accent, Theme.Red })[cmd.Rank] or Theme.SubText
		local badge = UIKit.Label({ Text = Config.RankNames[cmd.Rank] or "?", Size = UDim2.fromOffset(84, 20), Position = UDim2.fromOffset(8, 15), TextColor3 = rankColor, Font = Theme.BodyFont, ZIndex = 8, Parent = frame })
		badge.TextXAlignment = Enum.TextXAlignment.Left
		UIKit.Label({
			Text = Config.Admin.Prefix .. cmd.Name .. " " .. (cmd.Args or ""),
			Size = UDim2.new(0.42, -90, 0, 22),
			Position = UDim2.fromOffset(96, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = cmd.Allowed and Theme.Text or Theme.SubText,
			ZIndex = 8,
			Parent = frame,
		})
		local aliases = (#cmd.Aliases > 0) and ("aliases: " .. table.concat(cmd.Aliases, ", ")) or ""
		UIKit.Label({
			Text = aliases,
			Size = UDim2.new(0.42, -90, 0, 16),
			Position = UDim2.fromOffset(96, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.SubText,
			Font = Theme.BodyFont,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
		UIKit.Label({
			Text = cmd.Desc,
			Size = UDim2.new(0.58, -90, 0, 30),
			Position = UDim2.new(0.42, 6, 0, 10),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			TextColor3 = Theme.SubText,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
		if cmd.Allowed then
			smallButton(frame, "USE", Theme.Accent, -76, 66, function()
				commandBox.Text = cmd.Name .. " "
				commandBox:CaptureFocus()
				commandBox.CursorPosition = #commandBox.Text + 1
			end)
		end
	end
end

local function fillPlayers()
	local page = pages.Players
	clear(page)
	local list = Remotes.AdminData:InvokeServer("players")
	if not list then
		return
	end
	for i, info in list do
		local frame = rowFrame(page, i, 56)
		UIKit.Label({
			Text = info.DisplayName .. "  (@" .. info.Name .. ")",
			Size = UDim2.new(0.4, 0, 0, 24),
			Position = UDim2.fromOffset(10, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = frame,
		})
		UIKit.Label({
			Text = (Config.RankNames[info.Rank] or "Player") .. " • " .. Util.Money(info.Cash) .. " • R" .. info.Rebirths,
			Size = UDim2.new(0.4, 0, 0, 18),
			Position = UDim2.fromOffset(10, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			TextColor3 = Theme.SubText,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
		local name = info.Name
		local actions = {
			{ "TO", Theme.Accent2, "to " .. name },
			{ "BRING", Theme.Accent2, "bring " .. name },
			{ "VIEW", Theme.Purple, "view " .. name },
			{ "+1M", Theme.Green, "givecash " .. name .. " 1m" },
			{ "FREEZE", Color3.fromRGB(120, 200, 255), "freeze " .. name },
			{ "KILL", Theme.Red, "kill " .. name },
			{ "KICK", Color3.fromRGB(150, 30, 30), "kick " .. name },
		}
		local x = -8
		for j = #actions, 1, -1 do
			local action = actions[j]
			x -= 62
			smallButton(frame, action[1], action[2], x, 58, function()
				run(action[3])
				if action[1] == "KICK" then
					task.wait(0.5)
					fillPlayers()
				end
			end)
		end
	end
end

local function fillLogs()
	local page = pages.Logs
	clear(page)
	local logs = Remotes.AdminData:InvokeServer("logs") or {}
	if #logs == 0 then
		UIKit.Label({ Text = "No commands run yet.", Size = UDim2.new(1, 0, 0, 30), Font = Theme.BodyFont, ZIndex = 8, Parent = page })
	end
	for i, entry in logs do
		local frame = rowFrame(page, i, 34)
		UIKit.Label({
			Text = os.date("%H:%M:%S", entry.Time) .. "  " .. entry.By .. ":  " .. entry.Text,
			Size = UDim2.new(1, -20, 1, -10),
			Position = UDim2.fromOffset(10, 5),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
	end
end

-- Anti-Cheat tab: bans and strikes with the proof, and the unban button
local function fillAntiCheat()
	local page = pages["Anti-Cheat"]
	clear(page)
	local report = Remotes.AdminData:InvokeServer("anticheat")
	if not report then
		UIKit.Label({ Text = "Head Admins and Owners only.", Size = UDim2.new(1, -10, 0, 30), Font = Theme.BodyFont, ZIndex = 8, Parent = page })
		return
	end
	local order = 0
	local function header(text: string)
		order += 1
		UIKit.Label({ Text = text, Size = UDim2.new(1, -10, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Accent, LayoutOrder = order, ZIndex = 8, Parent = page })
	end
	local function entryRow(entry, subtitle: string, buttonText: string, buttonColor: Color3, command: string)
		order += 1
		local evidence = entry.Evidence or {}
		local frame = rowFrame(page, order, 62 + 34 * #evidence)
		UIKit.Label({
			Text = entry.Name .. "  (id " .. tostring(entry.UserId) .. ")",
			Size = UDim2.new(1, -120, 0, 24),
			Position = UDim2.fromOffset(10, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = frame,
		})
		UIKit.new("TextLabel", {
			Text = subtitle,
			Size = UDim2.new(1, -120, 0, 30),
			Position = UDim2.fromOffset(10, 28),
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Font = Theme.BodyFont,
			TextColor3 = Theme.SubText,
			ZIndex = 8,
			Parent = frame,
		})
		for j, item in evidence do
			UIKit.new("TextLabel", {
				Name = "Evidence" .. j,
				Text = "📸 " .. os.date("%Y-%m-%d %H:%M", item.Time) .. "  " .. tostring(item.Kind) .. ": " .. tostring(item.Detail),
				Size = UDim2.new(1, -20, 0, 32),
				Position = UDim2.fromOffset(10, 62 + (j - 1) * 34),
				BackgroundTransparency = 1,
				TextWrapped = true,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Font = Theme.BodyFont,
				TextColor3 = Color3.fromRGB(255, 190, 150),
				ZIndex = 8,
				Parent = frame,
			})
		end
		smallButton(frame, buttonText, buttonColor, -102, 94, function()
			run(command)
			task.wait(0.6)
			fillAntiCheat()
		end).AnchorPoint = Vector2.new(0, 0)
	end
	header("🔨 BANNED (" .. #report.Bans .. ")")
	if #report.Bans == 0 then
		UIKit.Label({ Text = "Nobody is banned.", Size = UDim2.new(1, -10, 0, 26), Font = Theme.BodyFont, TextColor3 = Theme.SubText, LayoutOrder = order + 1, ZIndex = 8, Parent = page })
		order += 1
	end
	for _, ban in report.Bans do
		entryRow(ban, os.date("%Y-%m-%d %H:%M", ban.Time) .. " • by " .. tostring(ban.By) .. " • " .. tostring(ban.Reason), "UNBAN", Theme.Green, "unban " .. tostring(ban.UserId))
	end
	header("⚠️ STRIKES (" .. #report.Strikes .. ")  -  " .. report.StrikesToBan .. " = ban")
	for _, record in report.Strikes do
		entryRow(record, record.Count .. "/" .. report.StrikesToBan .. " strikes", "CLEAR", Theme.Accent2, "clearstrikes " .. tostring(record.UserId))
	end
end

local function buildServerPage()
	local page = pages.Server
	local order = 0
	local function section(title: string)
		order += 1
		UIKit.Label({ Text = title, Size = UDim2.new(1, -10, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Accent, LayoutOrder = order, ZIndex = 8, Parent = page })
	end
	local function buttonRow(buttons)
		order += 1
		local frame = UIKit.new("Frame", { Size = UDim2.new(1, -10, 0, 44), BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 7, Parent = page })
		UIKit.List(frame, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left)
		for _, def in buttons do
			UIKit.Button({ Text = def[1], Color = def[2], Size = UDim2.fromOffset(def[4] or 150, 40), ZIndex = 8, Parent = frame, Callback = function()
				run(def[3])
			end })
		end
	end
	local function inputRow(placeholder: string, buttonText: string, color: Color3, build: (string) -> string)
		order += 1
		local frame = UIKit.new("Frame", { Size = UDim2.new(1, -10, 0, 44), BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 7, Parent = page })
		local box = UIKit.TextBox({ Placeholder = placeholder, Size = UDim2.new(1, -170, 0, 40), ZIndex = 8, Parent = frame })
		UIKit.Button({ Text = buttonText, Color = color, Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -155, 0, 0), ZIndex = 8, Parent = frame, Callback = function()
			if box.Text ~= "" then
				run(build(box.Text))
				box.Text = ""
			end
		end })
	end

	section("💰 Economy")
	buttonRow({
		{ "🌧️ Cash Rain", Theme.Green, "cashrain" },
		{ "🔥 2x Event 10m", Color3.fromRGB(255, 110, 40), "doublecash 10 2" },
		{ "⚡ 5x Event 5m", Theme.Red, "doublecash 5 5" },
		{ "Me +$1B", Theme.Accent, "givecash me 1b", 120 },
	})
	buttonRow({
		{ "🏗️ Unlock All (me)", Theme.Accent2, "unlockall me", 190 },
		{ "🔄 Free Rebirth (me)", Theme.Purple, "rebirth me", 200 },
		{ "👑 VIP (me)", Theme.Accent, "givepass me VIP", 140 },
	})
	section("💥 Disasters")
	buttonRow({
		{ "☢️ NUKE", Theme.Red, "nuke", 120 },
		{ "☄️ Meteors", Color3.fromRGB(255, 120, 0), "meteors", 130 },
		{ "🌪️ Tornado", Color3.fromRGB(150, 160, 180), "tornado", 130 },
		{ "🛸 UFOs", Theme.Green, "ufo", 110 },
		{ "🌍 Quake", Color3.fromRGB(200, 140, 80), "earthquake", 110 },
		{ "⏹ Stop", Theme.SubText, "stopdisaster", 100 },
	})
	buttonRow({
		{ "🔧 Repair me", Theme.Accent2, "repair me", 150 },
		{ "💥 Wreck me 25%", Theme.Red, "wreck me 25", 170 },
		{ "🏢 Build to F4", Theme.Accent, "unlockfloor me 4", 160 },
		{ "🕵️ All secrets", Theme.Purple, "givesecrets me", 160 },
	})
	section("🎮 Minigames")
	buttonRow({
		{ "🪙 Coin Rush", Theme.Accent, "minigame CoinRush" },
		{ "🟥 Falling Tiles", Theme.Red, "minigame FallingTiles" },
		{ "☄️ Meteors", Color3.fromRGB(255, 120, 0), "minigame MeteorShower" },
		{ "🌋 Lava Rise", Color3.fromRGB(255, 80, 0), "minigame LavaRise" },
	})
	section("🌍 World")
	buttonRow({
		{ "☀️ Day", Theme.Accent, "time 14", 110 },
		{ "🌙 Night", Theme.Purple, "time 0", 110 },
		{ "🌅 Sunset", Color3.fromRGB(255, 120, 80), "time 18", 120 },
		{ "🎉 Confetti All", Theme.Green, "confetti all", 160 },
	})
	buttonRow({
		{ "🕊️ Fly", Theme.Accent2, "fly me", 110 },
		{ "🚫 Unfly", Theme.SubText, "unfly me", 110 },
		{ "👻 Noclip", Theme.Purple, "noclip me", 120 },
		{ "🧱 Clip", Theme.SubText, "clip me", 110 },
		{ "💪 God", Theme.Green, "god me", 100 },
	})
	section("📢 Messages & Music")
	inputRow("Announcement text...", "📢 ANNOUNCE", Theme.Accent, function(text)
		return "m " .. text
	end)
	inputRow("Sound id (numbers only)...", "🎵 PLAY", Theme.Purple, function(text)
		return "music " .. text
	end)
	buttonRow({ { "⏹ Reset Music", Theme.SubText, "stopmusic", 170 } })
end

local function selectTab(name: string)
	currentTab = name
	for tabName, page in pages do
		page.Visible = tabName == name
		tabButtons[tabName].BackgroundColor3 = tabName == name and Theme.Red or Theme.PanelLight
	end
	if name == "Commands" then
		task.spawn(fillCommands)
	elseif name == "Players" then
		task.spawn(fillPlayers)
	elseif name == "Logs" then
		task.spawn(fillLogs)
	elseif name == "Anti-Cheat" then
		task.spawn(fillAntiCheat)
	end
end

local function buildPanel()
	local _, content = C.UI:MakePanel("Admin", "🛡️ ADMIN PANEL", Theme.Red, 900, 600, function()
		selectTab(currentTab)
	end)

	-- command bar
	local bar = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	commandBox = UIKit.TextBox({ Placeholder = "Command (e.g. speed me 50) - press Enter", Size = UDim2.new(1, -130, 0, 42), ZIndex = 7, Parent = bar })
	UIKit.Button({ Text = "RUN ▶", Color = Theme.Green, Size = UDim2.fromOffset(120, 42), Position = UDim2.new(1, -120, 0, 0), ZIndex = 7, Parent = bar, Callback = function()
		run(commandBox.Text)
	end })
	commandBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			run(commandBox.Text)
		end
	end)
	resultLabel = UIKit.Label({ Text = "Rank: " .. (Config.RankNames[player:GetAttribute("AdminRank") or 0] or "?"), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 48), Font = Theme.BodyFont, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = content })

	-- tabs
	local tabs = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 74), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	UIKit.List(tabs, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left)
	for i, name in { "Commands", "Players", "Server", "Logs", "Anti-Cheat" } do
		tabButtons[name] = UIKit.Button({ Text = name:upper(), Color = Theme.PanelLight, Size = UDim2.fromOffset(i == 5 and 160 or 130, 38), LayoutOrder = i, ZIndex = 7, Parent = tabs, Callback = function()
			selectTab(name)
		end })
		local page = UIKit.Scroll({ Size = UDim2.new(1, 0, 1, -124), Position = UDim2.fromOffset(0, 122), Parent = content })
		page.Visible = false
		UIKit.List(page, 6)
		UIKit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = page })
		pages[name] = page
	end
	buildServerPage()
end

---------------------------------------------------------------------------
function Admin:Init(controllers)
	C = controllers
	buildPanel()

	Remotes.ClientCommand.OnClientEvent:Connect(function(command, value)
		if command == "fly" then
			if value then
				startFly()
				C.Notifications:Toast("Fly ON: WASD + Space/E up, Ctrl/Q down, Shift = fast", "info", 6)
			else
				stopFly()
			end
		elseif command == "noclip" then
			setNoclip(value == true)
		elseif command == "view" then
			view(value)
		elseif command == "openadmin" then
			currentTab = value or "Commands"
			C.UI:Open("Admin")
		end
	end)

	player.CharacterAdded:Connect(function()
		flying = false
		flyParts = {}
		if flyConn then
			flyConn:Disconnect()
			flyConn = nil
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F2 and (player:GetAttribute("AdminRank") or 0) > 0 then
			C.UI:Toggle("Admin")
		end
	end)

	-- chat commands (TextChatService): ";cmd args"
	pcall(function()
		TextChatService.SendingMessage:Connect(function(message: TextChatMessage)
			local text = message.Text
			local prefix = Config.Admin.Prefix
			if text:sub(1, #prefix) == prefix and (player:GetAttribute("AdminRank") or 0) > 0 then
				task.spawn(run, text)
			end
		end)
	end)
end

function Admin:IsFlying()
	return flying
end

return Admin
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--[[
	Animator - smooth client-side animation for tagged parts:
	  Spin  - rotates around world Y
	  Bob   - floats up and down
	  Pulse - neon glow pulsing
	  RainbowSign - rainbow text on owner signs
	Only animates things near the camera to keep FPS high.
]]
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Animator = {}

local spinning: { [BasePart]: { Base: CFrame, Speed: number, Phase: number, Spin: boolean, Bob: boolean } } = {}
local pulsing: { [BasePart]: { Color: Color3, Phase: number } } = {}
local rainbow: { [TextLabel]: boolean } = {}
local uiSpin: { [GuiObject]: boolean } = {}
local lowGraphics = false
local RANGE = 260

local function track(instance: Instance)
	if not instance:IsA("BasePart") or spinning[instance :: BasePart] then
		return
	end
	local part = instance :: BasePart
	spinning[part] = {
		Base = part.CFrame,
		Speed = 1.2 + math.random() * 0.8,
		Phase = math.random() * math.pi * 2,
		Spin = CollectionService:HasTag(part, "Spin"),
		Bob = CollectionService:HasTag(part, "Bob"),
	}
end

local function untrack(part: Instance)
	if part:IsA("BasePart") and not CollectionService:HasTag(part, "Spin") and not CollectionService:HasTag(part, "Bob") then
		spinning[part] = nil
	end
end

function Animator:IsLowGraphics(): boolean
	return lowGraphics
end

-- low graphics: no animations and no particles (also ones created later).
-- Only emitters we switched off are switched back on.
local quieted = setmetatable({}, { __mode = "k" })
local descendantConn: RBXScriptConnection?
local function quiet(d: Instance)
	if lowGraphics and d:IsA("ParticleEmitter") and d.Enabled then
		d.Enabled = false
		quieted[d] = true
	end
end

function Animator:SetLowGraphics(enabled: boolean)
	if enabled == lowGraphics then
		return
	end
	lowGraphics = enabled
	if enabled then
		for _, d in workspace:GetDescendants() do
			quiet(d)
		end
		descendantConn = workspace.DescendantAdded:Connect(function(d)
			if d:IsA("ParticleEmitter") then
				task.defer(quiet, d)
			end
		end)
	else
		if descendantConn then
			descendantConn:Disconnect()
			descendantConn = nil
		end
		for d in quieted do
			if d.Parent then
				(d :: ParticleEmitter).Enabled = true
			end
		end
		table.clear(quieted)
	end
end

function Animator:Init()
	for _, tag in { "Spin", "Bob" } do
		for _, part in CollectionService:GetTagged(tag) do
			track(part)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(part)
			-- refresh tag info (a part can have both tags)
			spinning[part] = nil
			track(part)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(untrack)
	end
	for _, part in CollectionService:GetTagged("Pulse") do
		if part:IsA("BasePart") then
			pulsing[part] = { Color = part.Color, Phase = math.random() * 6 }
		end
	end
	CollectionService:GetInstanceAddedSignal("Pulse"):Connect(function(part)
		if part:IsA("BasePart") then
			pulsing[part] = { Color = part.Color, Phase = math.random() * 6 }
		end
	end)
	CollectionService:GetInstanceRemovedSignal("Pulse"):Connect(function(part)
		pulsing[part] = nil
	end)

	local function trackSign(sign: Instance)
		for _, d in sign:GetDescendants() do
			if d:IsA("TextLabel") then
				rainbow[d] = true
			end
		end
	end
	for _, sign in CollectionService:GetTagged("RainbowSign") do
		trackSign(sign)
	end
	CollectionService:GetInstanceAddedSignal("RainbowSign"):Connect(function(sign)
		task.wait()
		trackSign(sign)
	end)

	for _, ui in CollectionService:GetTagged("UISpin") do
		uiSpin[ui] = true
	end
	CollectionService:GetInstanceAddedSignal("UISpin"):Connect(function(ui)
		uiSpin[ui] = true
	end)
end

function Animator:Start()
	-- the saved setting
	self:SetLowGraphics(player:GetAttribute("LowGraphics") == true)
	player:GetAttributeChangedSignal("LowGraphics"):Connect(function()
		self:SetLowGraphics(player:GetAttribute("LowGraphics") == true)
	end)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = workspace.CurrentCamera
		local camPos = cam.CFrame.Position

		for ui in uiSpin do
			if ui.Parent then
				ui.Rotation = math.sin(t * 2) * 15
			else
				uiSpin[ui] = nil
			end
		end

		if lowGraphics then
			return
		end

		for part, info in spinning do
			if not part.Parent then
				spinning[part] = nil
				continue
			end
			local base = info.Base
			if (base.Position - camPos).Magnitude > RANGE then
				continue
			end
			local pos = base.Position
			if info.Bob then
				pos += Vector3.new(0, math.sin(t * 2 + info.Phase) * 0.8, 0)
			end
			local rotation = base.Rotation
			if info.Spin then
				rotation = CFrame.Angles(0, t * info.Speed + info.Phase, 0) * rotation
			end
			part.CFrame = CFrame.new(pos) * rotation
		end

		for part, info in pulsing do
			if not part.Parent then
				pulsing[part] = nil
				continue
			end
			if (part.Position - camPos).Magnitude > RANGE then
				continue
			end
			local alpha = (math.sin(t * 3 + info.Phase) + 1) / 2
			part.Color = info.Color:Lerp(Color3.new(1, 1, 1), alpha * 0.3)
		end

		for label in rainbow do
			if not label.Parent then
				rainbow[label] = nil
				continue
			end
			label.TextColor3 = Color3.fromHSV((t * 0.15) % 1, 0.75, 1)
		end
	end)
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--[[
	Build (client) - keeps a live copy of your tower's state and draws:
	  • the BUILD menu: every upgrade by floor, with BUY / BUY ALL
	  • the FLOORS menu (elevator): teleport to any built floor
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)
local TycoonItems = require(Shared.TycoonItems)

local player = Players.LocalPlayer
local Theme = UIKit.Theme
local FLOORS = Config.Tycoon.Floors

local Build = {}
Build.State = { Plot = nil, Purchased = {}, Disabled = {}, Secrets = {}, IsOwner = true }
Build.Listeners = {}
local C

local ICONS = {
	Unlock = "🏢", Dropper = "⬇️", Mk2 = "⏫", Upgrader = "✨", Generator = "⚙️", Conveyor = "➡️",
	Boost = "🚀", Decor = "🪴", Wall = "🧱", Special = "⭐", Trophy = "🏆", Roof = "🚁", Secret = "🕵️",
}

local selectedFloor = 1
local listFrame: ScrollingFrame
local headerLabel: TextLabel
local floorButtons = {}
local rows = {}
local gains = {}
local floorsGrid: Frame
local floorsTitle: TextLabel
local floorsPlot: number? = nil

---------------------------------------------------------------------------
-- State
---------------------------------------------------------------------------
local function notify()
	for _, fn in Build.Listeners do
		task.spawn(fn)
	end
end

function Build:OnChanged(fn)
	table.insert(self.Listeners, fn)
end

function Build:Refetch()
	local ok, state = pcall(function()
		return Remotes.GetTycoonState:InvokeServer()
	end)
	if ok and type(state) == "table" then
		local disabled = {}
		for id, seconds in state.Disabled or {} do
			disabled[id] = os.clock() + seconds
		end
		self.State = {
			Plot = state.Plot,
			Purchased = state.Purchased or {},
			Disabled = disabled,
			Secrets = state.Secrets or {},
			IsOwner = state.IsOwner ~= false,
			OwnerName = state.OwnerName,
		}
		notify()
	end
end

function Build:WreckedCount(): (number, number)
	local n, soonest = 0, math.huge
	for _, untilTime in self.State.Disabled do
		n += 1
		soonest = math.min(soonest, untilTime - os.clock())
	end
	return n, soonest
end

function Build:BoughtCount(): number
	local n = 0
	for id in self.State.Purchased do
		local item = TycoonItems.ById[id]
		if item and item.Kind ~= "Secret" then
			n += 1
		end
	end
	return n
end

local function incomeNow(): number
	local disabled = {}
	for id in Build.State.Disabled do
		disabled[id] = true
	end
	return (TycoonItems.ComputeIncome(Build.State.Purchased, disabled, Build.State.Secrets, player:GetAttribute("Pass_FastDroppers") == true))
end

-- $/s each currently-available item would add (with your multipliers)
local function computeGains()
	gains = {}
	local base = incomeNow()
	local mult = player:GetAttribute("Multiplier") or 1
	for _, item in TycoonItems.List do
		if TycoonItems.IsAvailable(item, Build.State.Purchased) then
			local copy = table.clone(Build.State.Purchased)
			copy[item.Id] = true
			local after = TycoonItems.ComputeIncome(copy, nil, Build.State.Secrets, player:GetAttribute("Pass_FastDroppers") == true)
			gains[item.Id] = math.max(0, after - base) * mult
		end
	end
end

local function pct(x: number): string
	return tostring(math.floor(x * 100 + 0.5)) .. "%"
end

-- (numbers come from TycoonItems so the text always matches the real math)
local function describe(item): string
	local kind = item.Kind
	if kind == "Dropper" then
		return "A dropper on floor " .. item.Floor
	elseif kind == "Mk2" then
		return "Doubles its dropper"
	elseif kind == "Upgrader" then
		return "x" .. item.Multiplier .. " to all drops on this floor"
	elseif kind == "Generator" then
		return "Passive cash machine"
	elseif kind == "Conveyor" then
		return "+" .. pct(TycoonItems.ConveyorBonus) .. " drop income on this floor"
	elseif kind == "Boost" then
		return "x" .. item.Multiplier .. " everything on this floor"
	elseif kind == "Decor" then
		return "+" .. pct(TycoonItems.DecorBonus) .. " income on this floor"
	elseif kind == "Wall" then
		return "+" .. pct(TycoonItems.WallBonus) .. " income on this floor"
	elseif kind == "Unlock" then
		return item.Floor == 1 and "Your starting base" or "Opens a whole new floor!"
	elseif kind == "Special" then
		local bonus = pct(item.Bonus or TycoonItems.SpecialBonus)
		if item.Effect == "Bunker" then
			return "Nuke-proof bunker + " .. bonus .. " ALL income"
		elseif item.Effect == "Shield" then
			return "Protects your tower from ALL disasters + " .. bonus
		end
		return "+" .. bonus .. " ALL income"
	elseif kind == "Trophy" or kind == "Roof" then
		return "+" .. pct(item.Bonus or 0) .. " ALL income"
	end
	return ""
end

---------------------------------------------------------------------------
-- BUILD menu
---------------------------------------------------------------------------
local function isFloorUnlocked(floor: number): boolean
	if floor == FLOORS + 1 then
		return Build.State.Purchased["Roof_1"] == true
	end
	return Build.State.Purchased[TycoonItems.FloorUnlockId(floor)] == true
end
Build.IsFloorUnlocked = isFloorUnlocked

local function floorLabel(floor: number): string
	if floor == FLOORS + 1 then
		return "🚁 Roof"
	end
	return "F" .. floor .. " " .. TycoonItems.Themes[floor].Name
end

local function updateHeader()
	local mult = player:GetAttribute("Multiplier") or 1
	headerLabel.Text = string.format("Upgrades %d/%d   •   Income %s/s", Build:BoughtCount(), TycoonItems.BuyableCount, Util.Money(incomeNow() * mult))
	for floor, button in floorButtons do
		local items = TycoonItems.ByFloor[floor]
		local owned = 0
		for _, item in items do
			if Build.State.Purchased[item.Id] then
				owned += 1
			end
		end
		local unlocked = isFloorUnlocked(floor)
		local available = false
		for _, item in items do
			if TycoonItems.IsAvailable(item, Build.State.Purchased) then
				available = true
			end
		end
		button.Text = (unlocked and "" or (available and "🆕 " or "🔒 ")) .. floorLabel(floor) .. "  " .. owned .. "/" .. #items
		button.BackgroundColor3 = floor == selectedFloor and Theme.Accent or (unlocked and Theme.PanelLight or Theme.Background)
	end
end

local function updateRows()
	local cash = player:GetAttribute("Cash") or 0
	for id, row in rows do
		local item = TycoonItems.ById[id]
		local owned = Build.State.Purchased[id]
		local wrecked = Build.State.Disabled[id]
		local available = TycoonItems.IsAvailable(item, Build.State.Purchased)
		local button = row.Button
		if wrecked then
			button.Text = "🔧 " .. Util.Clock(math.max(0, wrecked - os.clock()))
			button.BackgroundColor3 = Color3.fromRGB(200, 90, 40)
		elseif owned then
			button.Text = "OWNED ✓"
			button.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
		elseif available then
			button.Text = Util.Money(item.Cost)
			button.BackgroundColor3 = cash >= item.Cost and Theme.Green or Theme.Red
		else
			button.Text = "🔒 " .. Util.Money(item.Cost)
			button.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
		end
		local gain = gains[id]
		row.Desc.Text = describe(item) .. ((gain and gain > 0) and ("  (+" .. Util.Money(gain) .. "/s)") or "")
		row.Frame.BackgroundColor3 = available and Color3.fromRGB(50, 56, 84) or Theme.Panel
	end
end

local function buildRows()
	for _, row in rows do
		row.Frame:Destroy()
	end
	rows = {}
	local items = TycoonItems.ByFloor[selectedFloor] or {}
	for i, item in items do
		local frame = UIKit.new("Frame", { Size = UDim2.new(1, -10, 0, 50), BackgroundColor3 = Theme.Panel, LayoutOrder = i, ZIndex = 7, Parent = listFrame })
		UIKit.Corner(frame, 8)
		UIKit.Label({ Text = ICONS[item.Kind] or "•", Size = UDim2.fromOffset(36, 36), Position = UDim2.fromOffset(6, 7), ZIndex = 8, Parent = frame })
		UIKit.Label({ Text = item.Name, Size = UDim2.new(1, -220, 0, 24), Position = UDim2.fromOffset(48, 4), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = frame })
		local desc = UIKit.Label({ Text = "", Size = UDim2.new(1, -220, 0, 16), Position = UDim2.fromOffset(48, 29), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.BodyFont, TextColor3 = Theme.SubText, Stroke = false, ZIndex = 8, Parent = frame })
		local button = UIKit.Button({
			Text = "",
			Color = Theme.Green,
			Size = UDim2.fromOffset(150, 38),
			Position = UDim2.new(1, -158, 0, 6),
			ZIndex = 8,
			Parent = frame,
			Callback = function()
				if Build.State.Purchased[item.Id] then
					return
				end
				local ok, message = Remotes.BuyItem:InvokeServer(item.Id)
				C.Notifications:Toast(message, ok and "success" or "error", 2.5)
			end,
		})
		rows[item.Id] = { Frame = frame, Button = button, Desc = desc }
	end
	updateRows()
end

local function selectFloor(floor: number)
	selectedFloor = floor
	buildRows()
	updateHeader()
end

local function refreshAll()
	computeGains()
	updateHeader()
	updateRows()
end

local function buildPanel()
	local _, content = C.UI:MakePanel("Build", "🏗️ BUILD", Color3.fromRGB(255, 150, 40), 940, 600, function()
		-- default to the highest floor with something to buy
		local best = 1
		for floor = 1, FLOORS + 1 do
			for _, item in TycoonItems.ByFloor[floor] do
				if TycoonItems.IsAvailable(item, Build.State.Purchased) then
					best = floor
					break
				end
			end
		end
		selectFloor(best)
		refreshAll()
	end)

	headerLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -420, 0, 30), Position = UDim2.fromOffset(4, 4), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = content })
	UIKit.Button({ Text = "BUY ALL (FLOOR)", Color = Theme.Accent2, Size = UDim2.fromOffset(190, 38), Position = UDim2.new(1, -400, 0, 0), ZIndex = 7, Parent = content, Callback = function()
		Remotes.BuyAll:FireServer(selectedFloor)
	end })
	UIKit.Button({ Text = "⚡ BUY ALL", Color = Theme.Green, Size = UDim2.fromOffset(200, 38), Position = UDim2.new(1, -200, 0, 0), ZIndex = 7, Parent = content, Callback = function()
		Remotes.BuyAll:FireServer(nil)
	end })

	local tabs = UIKit.Scroll({ Size = UDim2.new(0, 230, 1, -50), Position = UDim2.fromOffset(0, 48), Parent = content })
	UIKit.List(tabs, 6)
	for floor = 1, FLOORS + 1 do
		floorButtons[floor] = UIKit.Button({
			Text = floorLabel(floor),
			Color = Theme.PanelLight,
			Size = UDim2.new(1, -12, 0, 40),
			LayoutOrder = floor,
			ZIndex = 7,
			Parent = tabs,
			Callback = function()
				selectFloor(floor)
			end,
		})
		floorButtons[floor].TextXAlignment = Enum.TextXAlignment.Left
	end
	listFrame = UIKit.Scroll({ Size = UDim2.new(1, -240, 1, -50), Position = UDim2.fromOffset(240, 48), Parent = content })
	UIKit.List(listFrame, 6)
	UIKit.new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 6), Parent = listFrame })
end

---------------------------------------------------------------------------
-- FLOORS menu (elevator)
---------------------------------------------------------------------------
local function fillFloors()
	for _, child in floorsGrid:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local own = floorsPlot == Build.State.Plot
	floorsTitle.Text = own and "Your tower - pick a floor" or "Visiting tower #" .. tostring(floorsPlot)
	for floor = 1, FLOORS + 1 do
		local unlocked = true
		if own then
			unlocked = isFloorUnlocked(floor)
		end
		local theme = TycoonItems.Themes[math.min(floor, FLOORS)]
		local button = UIKit.Button({
			Text = (unlocked and "" or "🔒 ") .. (floor == FLOORS + 1 and "🚁 ROOF" or ("FLOOR " .. floor .. "\n" .. theme.Name)),
			Color = unlocked and theme.Accent or Color3.fromRGB(70, 70, 85),
			Size = UDim2.fromOffset(150, 70),
			LayoutOrder = floor,
			ZIndex = 7,
			Parent = floorsGrid,
			Callback = function()
				if floorsPlot then
					Remotes.TeleportFloor:FireServer(floorsPlot, floor)
					C.UI:Close()
				end
			end,
		})
		button.Name = "Floor" .. floor
	end
end

local function buildFloors()
	local _, content = C.UI:MakePanel("Floors", "🛗 ELEVATOR", Color3.fromRGB(0, 190, 255), 560, 420, function()
		fillFloors()
	end)
	floorsTitle = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 28), Font = Theme.BodyFont, ZIndex = 7, Parent = content })
	floorsGrid = UIKit.new("Frame", { Size = UDim2.new(1, 0, 1, -36), Position = UDim2.fromOffset(0, 36), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	local grid = UIKit.new("UIGridLayout", { CellSize = UDim2.fromOffset(150, 70), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = floorsGrid })
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
end

function Build:OpenFloors(plotIndex: number?)
	floorsPlot = plotIndex or self.State.Plot
	if not floorsPlot then
		C.Notifications:Toast("You don't have a tower yet!", "error")
		return
	end
	C.UI:Open("Floors")
end

---------------------------------------------------------------------------
function Build:Init(controllers)
	C = controllers
	buildPanel()
	buildFloors()

	Remotes.TycoonUpdate.OnClientEvent:Connect(function(update)
		local kind = update.Type
		if kind == "Reset" then
			self:Refetch()
			return
		elseif kind == "Bought" then
			self.State.Purchased[update.Id] = true
		elseif kind == "Disabled" then
			self.State.Disabled[update.Id] = os.clock() + (update.Seconds or 0)
		elseif kind == "Repaired" then
			self.State.Disabled[update.Id] = nil
		elseif kind == "Secret" then
			self.State.Secrets[update.Id] = true
		end
		notify()
	end)

	Remotes.ClientCommand.OnClientEvent:Connect(function(command, value)
		if command == "openfloors" then
			self:OpenFloors(value)
		end
	end)

	local pending = false
	local function scheduleRefresh()
		if pending then
			return
		end
		pending = true
		task.delay(0.4, function()
			pending = false
			if C.UI.Current == "Build" then
				refreshAll()
			end
		end)
	end
	self:OnChanged(function()
		if C.UI.Current == "Build" then
			refreshAll()
		elseif C.UI.Current == "Floors" then
			fillFloors()
		end
	end)
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		if C.UI.Current == "Build" then
			updateRows()
		end
	end)
	player:GetAttributeChangedSignal("Multiplier"):Connect(scheduleRefresh)
end

function Build:Start()
	if not player:GetAttribute("DataLoaded") then
		player:GetAttributeChangedSignal("DataLoaded"):Wait()
	end
	task.wait(1)
	self:Refetch()
	-- countdown timers on wrecked items
	local function tick()
		if C.UI.Current == "Build" and next(self.State.Disabled) then
			updateRows()
		end
		-- drop expired entries (server sends "Repaired" too; this is a safety net)
		for id, untilTime in self.State.Disabled do
			if os.clock() > untilTime + 5 then
				self.State.Disabled[id] = nil
			end
		end
	end
	while true do
		task.wait(1)
		Util.Try("Build", tick)
	end
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ChatTags</string>
            <string name="Source"><![CDATA[--[[ ChatTags - [Owner] / [Admin] / [VIP] / rebirth tags in the chat ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local ChatTags = {}

local RANK_COLORS = {
	[1] = "#4FC3F7",
	[2] = "#66BB6A",
	[3] = "#FFA726",
	[4] = "#EF5350",
}

function ChatTags:Init()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if not source then
			return properties
		end
		local sender = Players:GetPlayerByUserId(source.UserId)
		if not sender then
			return properties
		end
		local tags = {}
		local rank = sender:GetAttribute("AdminRank") or 0
		if rank > 0 then
			table.insert(tags, string.format("<font color='%s'>[%s]</font>", RANK_COLORS[rank] or "#FFFFFF", Config.RankNames[rank]))
		end
		if sender:GetAttribute("Pass_VIP") then
			table.insert(tags, "<font color='#FFD700'>[👑 VIP]</font>")
		end
		local found = sender:GetAttribute("SecretsFound") or ""
		if found ~= "" and #string.split(found, ",") >= #Config.Secrets then
			table.insert(tags, "<font color='#80FF9A'>[🕵️ Secret Master]</font>")
		end
		local rebirths = sender:GetAttribute("Rebirths") or 0
		if rebirths > 0 then
			table.insert(tags, string.format("<font color='#CE93D8'>[R%d]</font>", rebirths))
		end
		if #tags > 0 then
			properties.PrefixText = table.concat(tags, " ") .. " " .. message.PrefixText
		end
		return properties
	end
end

return ChatTags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Disasters</string>
            <string name="Source"><![CDATA[--[[
	Disasters (client) - everything you see and hear during disasters:
	  nuke siren, countdown, red vignette, green beam to the nearest bunker,
	  missile, flash, mushroom cloud, shockwave, ash fall-out;
	  meteor warning circles + fireballs; tornado funnels; UFOs with tractor
	  beams. Also the character effects sent by the server:
	  fling / tornado / abduct / launch / vaporized.
]]
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Disasters = {}
local C

local fxFolder: Folder
local banner: Frame
local bannerTitle: TextLabel
local bannerSub: TextLabel
local countdown: TextLabel
local statusChip: TextLabel
local vignette: Frame
local siren: Sound?
local sirenConn: RBXScriptConnection?
local beamParts = {}
local shelters = { Boxes = {}, Spheres = {}, Doors = {} }
local missile: Model?
local nukeActive = false

local function camera()
	return workspace.CurrentCamera
end

local function getRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function localPart(props): BasePart
	local part = Instance.new(props.ClassName or "Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "ClassName" then
			(part :: any)[k] = v
		end
	end
	part.Parent = fxFolder
	return part
end

local function shake(intensity: number, duration: number)
	if C.VFX and C.VFX.Shake then
		C.VFX:Shake(intensity, duration)
	end
end

---------------------------------------------------------------------------
-- UI
---------------------------------------------------------------------------
local function buildUI()
	banner = UIKit.new("Frame", {
		Name = "DisasterBanner",
		Size = UDim2.fromOffset(460, 64),
		Position = UDim2.new(0.5, 0, 0, 214),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(60, 15, 15),
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = C.UI.FX,
	})
	UIKit.Corner(banner, 12)
	UIKit.Stroke(banner, Theme.Red, 3)
	bannerTitle = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 4), TextColor3 = Color3.fromRGB(255, 220, 120), Parent = banner })
	bannerSub = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 39), Font = Theme.BodyFont, Parent = banner })

	countdown = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(300, 110),
		Position = UDim2.new(0.5, 0, 0, 282),
		AnchorPoint = Vector2.new(0.5, 0),
		TextColor3 = Color3.fromRGB(255, 60, 40),
		Visible = false,
		Parent = C.UI.FX,
	})
	UIKit.new("UIScale", { Parent = countdown })
	statusChip = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(320, 34),
		Position = UDim2.new(0.5, 0, 0, 392),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		Parent = C.UI.FX,
	})

	-- red vignette (4 edge gradients)
	vignette = UIKit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 2, Parent = C.UI.FX })
	for i, data in {
		{ UDim2.new(1, 0, 0.25, 0), UDim2.new(0, 0, 0, 0), 90 },
		{ UDim2.new(1, 0, 0.25, 0), UDim2.new(0, 0, 0.75, 0), -90 },
		{ UDim2.new(0.2, 0, 1, 0), UDim2.new(0, 0, 0, 0), 0 },
		{ UDim2.new(0.2, 0, 1, 0), UDim2.new(0.8, 0, 0, 0), 180 },
	} do
		local edge = UIKit.new("Frame", { Name = "Edge" .. i, Size = data[1], Position = data[2], BackgroundColor3 = Color3.fromRGB(255, 0, 0), BorderSizePixel = 0, ZIndex = 2, Parent = vignette })
		UIKit.new("UIGradient", { Rotation = data[3], Transparency = NumberSequence.new(0.35, 1), Parent = edge })
	end
end

local function showBanner(title: string, sub: string, color: Color3?)
	banner.Visible = true
	bannerTitle.Text = title
	bannerSub.Text = sub
	local stroke = banner:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color or Theme.Red
	end
end

local function hideAll()
	banner.Visible = false
	countdown.Visible = false
	statusChip.Visible = false
	vignette.Visible = false
end

---------------------------------------------------------------------------
-- Shelters
---------------------------------------------------------------------------
local function insideBox(position: Vector3, cf: CFrame, size: Vector3): boolean
	local p = cf:PointToObjectSpace(position)
	return math.abs(p.X) <= size.X / 2 and math.abs(p.Y) <= size.Y / 2 + 2 and math.abs(p.Z) <= size.Z / 2
end

local function isSheltered(position: Vector3): boolean
	for _, box in shelters.Boxes do
		if insideBox(position, box.CFrame, box.Size) then
			return true
		end
	end
	for _, sphere in shelters.Spheres do
		if (position - sphere.Center).Magnitude <= sphere.Radius then
			return true
		end
	end
	return false
end

local function clearBeam()
	for _, inst in beamParts do
		inst:Destroy()
	end
	beamParts = {}
end

local function updateBeam()
	local root = getRoot()
	if not root then
		clearBeam()
		return
	end
	local best, bestD = nil, math.huge
	for _, door in shelters.Doors do
		local d = (door - root.Position).Magnitude
		if d < bestD then
			best, bestD = door, d
		end
	end
	if not best or isSheltered(root.Position) then
		clearBeam()
		return
	end
	if #beamParts == 0 then
		local anchor = localPart({ Size = Vector3.one, Transparency = 1, Position = best })
		local a0 = Instance.new("Attachment")
		a0.Name = "ShelterBeamAttachment"
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Parent = anchor
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Color = ColorSequence.new(Color3.fromRGB(80, 255, 120))
		beam.LightEmission = 1
		beam.Width0 = 1.4
		beam.Width1 = 1.4
		beam.FaceCamera = true
		beam.Transparency = NumberSequence.new(0.2)
		beam.Parent = anchor
		local marker = localPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 4, Position = best + Vector3.new(0, 3, 0), Color = Color3.fromRGB(80, 255, 120), Material = Enum.Material.Neon, Transparency = 0.3 })
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(160, 40)
		gui.StudsOffset = Vector3.new(0, 4, 0)
		gui.AlwaysOnTop = true
		gui.Parent = marker
		UIKit.Label({ Text = "🛡️ BUNKER", Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(120, 255, 150), Parent = gui })
		beamParts = { anchor, a0, marker }
	else
		(beamParts[1] :: BasePart).Position = best
		;(beamParts[3] :: BasePart).Position = best + Vector3.new(0, 3, 0)
		local a0 = beamParts[2] :: Attachment
		if a0.Parent ~= root then
			a0.Parent = root
		end
	end
end

---------------------------------------------------------------------------
-- Siren
---------------------------------------------------------------------------
local function startSiren()
	if siren then
		return
	end
	local custom = Config.Sounds.Siren
	local sound = Instance.new("Sound")
	sound.SoundId = (custom and custom ~= "") and custom or "rbxasset://sounds/electronicpingshort.wav"
	sound.Looped = true
	sound.Volume = 0.55
	sound.Parent = SoundService
	sound:Play()
	siren = sound
	if not custom or custom == "" then
		-- fake an air-raid wail by sweeping the pitch
		sirenConn = RunService.Heartbeat:Connect(function()
			sound.PlaybackSpeed = 0.55 + (math.sin(os.clock() * 1.6) + 1) * 0.35
		end)
	end
end

local function stopSiren()
	if sirenConn then
		sirenConn:Disconnect()
		sirenConn = nil
	end
	if siren then
		local s = siren
		siren = nil
		TweenService:Create(s, TweenInfo.new(1), { Volume = 0 }):Play()
		Debris:AddItem(s, 1.1)
	end
end

---------------------------------------------------------------------------
-- Nuke visuals
---------------------------------------------------------------------------
local function spawnMissile(target: Vector3, flightTime: number)
	if missile then
		missile:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "Missile"
	local start = target + Vector3.new(80, 700, -40)
	local look = CFrame.lookAt(start, target)
	local body = localPart({ Size = Vector3.new(4, 4, 30), CFrame = look, Color = Color3.fromRGB(200, 200, 205), Material = Enum.Material.Metal })
	body.Parent = model
	local nose = localPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 4.4, CFrame = look * CFrame.new(0, 0, -15), Color = Color3.fromRGB(220, 30, 30), Material = Enum.Material.SmoothPlastic })
	nose.Parent = model
	for i = 0, 3 do
		local fin = localPart({ Size = Vector3.new(0.4, 6, 5), CFrame = look * CFrame.Angles(0, 0, i * math.pi / 2) * CFrame.new(0, 3.5, 12), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal })
		fin.Parent = model
	end
	local tail = localPart({ Size = Vector3.one, CFrame = look * CFrame.new(0, 0, 16), Transparency = 1 })
	tail.Parent = model
	local fire = Instance.new("Fire")
	fire.Size = 18
	fire.Heat = 25
	fire.Color = Color3.fromRGB(255, 140, 30)
	fire.Parent = tail
	local trail = Instance.new("ParticleEmitter")
	trail.Texture = "rbxasset://textures/particles/smoke_main.dds"
	trail.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
	trail.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 16) })
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.Lifetime = NumberRange.new(3, 4)
	trail.Rate = 80
	trail.Speed = NumberRange.new(2, 4)
	trail.Parent = tail
	model.PrimaryPart = body
	model.Parent = fxFolder
	missile = model
	local startTime = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local alpha = math.min((os.clock() - startTime) / flightTime, 1)
		if not model.Parent then
			conn:Disconnect()
			return
		end
		local eased = alpha * alpha
		model:PivotTo(CFrame.lookAt(start:Lerp(target, eased), target))
		if alpha >= 1 then
			conn:Disconnect()
		end
	end)
	-- whistle
	UIKit.PlaySound("Whoosh", 0.8, 0.5)
end

local function grow(part: BasePart, size: Vector3, duration: number, props: { [string]: any }?)
	local goal = { Size = size }
	if props then
		for k, v in props do
			goal[k] = v
		end
	end
	TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), goal):Play()
end

local function nukeImpact(target: Vector3, shockSpeed: number)
	if missile then
		missile:Destroy()
		missile = nil
	end
	stopSiren()
	clearBeam()
	countdown.Visible = false
	statusChip.Visible = false
	vignette.Visible = false

	local cam = camera()
	local distance = (cam.CFrame.Position - target).Magnitude
	-- flash
	if C.VFX then
		C.VFX:Flash(Color3.new(1, 1, 1), 3)
	end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Brightness = 0.8
	cc.TintColor = Color3.fromRGB(255, 200, 150)
	cc.Parent = Lighting
	TweenService:Create(cc, TweenInfo.new(5), { Brightness = 0, TintColor = Color3.new(1, 1, 1) }):Play()
	Debris:AddItem(cc, 5.2)
	task.delay(math.min(distance / shockSpeed, 4), function()
		shake(math.clamp(4 - distance / 300, 0.6, 4), 1.6)
	end)

	local boom = Instance.new("Explosion")
	boom.Position = target + Vector3.new(0, 4, 0)
	boom.BlastRadius = 0
	boom.BlastPressure = 0
	boom.DestroyJointRadiusPercent = 0
	boom.Parent = workspace
	Debris:AddItem(boom, 2)

	-- fireball
	local fireball = localPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 10, Position = target + Vector3.new(0, 10, 0), Color = Color3.fromRGB(255, 170, 60), Material = Enum.Material.Neon })
	grow(fireball, Vector3.one * 170, 2.5, { Position = target + Vector3.new(0, 70, 0) })
	task.delay(2.5, function()
		TweenService:Create(fireball, TweenInfo.new(6), { Transparency = 1, Color = Color3.fromRGB(120, 60, 40) }):Play()
	end)
	Debris:AddItem(fireball, 9)
	-- stem
	local stem = localPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 30, 30), CFrame = CFrame.new(target + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(110, 95, 90), Material = Enum.Material.SmoothPlastic, Transparency = 0.25 })
	TweenService:Create(stem, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(240, 46, 46),
		CFrame = CFrame.new(target + Vector3.new(0, 120, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	}):Play()
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(120, 100, 90))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 20), NumberSequenceKeypoint.new(1, 40) })
	smoke.Transparency = NumberSequence.new(0.4, 1)
	smoke.Lifetime = NumberRange.new(4, 7)
	smoke.Rate = 40
	smoke.Speed = NumberRange.new(10, 20)
	smoke.SpreadAngle = Vector2.new(20, 20)
	smoke.Parent = stem
	task.delay(8, function()
		smoke.Enabled = false
		TweenService:Create(stem, TweenInfo.new(8), { Transparency = 1 }):Play()
	end)
	Debris:AddItem(stem, 17)
	-- cap
	local cap = localPart({ Size = Vector3.one, Position = target + Vector3.new(0, 30, 0), Color = Color3.fromRGB(255, 140, 50), Material = Enum.Material.Neon })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(40, 18, 40)
	mesh.Parent = cap
	TweenService:Create(cap, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target + Vector3.new(0, 250, 0), Color = Color3.fromRGB(140, 110, 100) }):Play()
	TweenService:Create(mesh, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = Vector3.new(300, 110, 300) }):Play()
	local capSmoke = smoke:Clone()
	capSmoke.Rate = 60
	capSmoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 40), NumberSequenceKeypoint.new(1, 70) })
	capSmoke.SpreadAngle = Vector2.new(180, 30)
	capSmoke.Parent = cap
	task.delay(9, function()
		capSmoke.Enabled = false
		TweenService:Create(cap, TweenInfo.new(8), { Transparency = 1 }):Play()
	end)
	Debris:AddItem(cap, 18)
	-- shockwave rings
	for i, color in { Color3.fromRGB(255, 240, 220), Color3.fromRGB(180, 150, 120) } do
		local ring = localPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(i == 1 and 2 or 6, 10, 10),
			CFrame = CFrame.new(target + Vector3.new(0, 1 + i, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Material = i == 1 and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			Transparency = i == 1 and 0.2 or 0.4,
		})
		local radius = 1500
		TweenService:Create(ring, TweenInfo.new(radius / shockSpeed * (i == 1 and 1 or 1.15), Enum.EasingStyle.Linear), {
			Size = Vector3.new(ring.Size.X, radius * 2, radius * 2),
			Transparency = 1,
		}):Play()
		Debris:AddItem(ring, radius / shockSpeed * 1.2 + 0.2)
	end
	UIKit.PlaySound("Boom", 1, 0.4)
end

local function aftermath(duration: number)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(255, 205, 170)
	cc.Saturation = -0.2
	cc.Parent = Lighting
	TweenService:Create(cc, TweenInfo.new(duration), { TintColor = Color3.new(1, 1, 1), Saturation = 0 }):Play()
	Debris:AddItem(cc, duration + 0.2)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		local density, color = atmosphere.Density, atmosphere.Color
		atmosphere.Density = math.min(density + 0.25, 0.8)
		atmosphere.Color = Color3.fromRGB(200, 150, 120)
		TweenService:Create(atmosphere, TweenInfo.new(duration), { Density = density, Color = color }):Play()
	end
	-- ash falling around the camera
	local ashHolder = localPart({ Size = Vector3.new(120, 1, 120), Transparency = 1 })
	local ash = Instance.new("ParticleEmitter")
	ash.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	ash.Color = ColorSequence.new(Color3.fromRGB(110, 105, 100))
	ash.Size = NumberSequence.new(0.25)
	ash.Lifetime = NumberRange.new(5, 7)
	ash.Rate = 90
	ash.Speed = NumberRange.new(3, 6)
	ash.EmissionDirection = Enum.NormalId.Bottom
	ash.RotSpeed = NumberRange.new(-60, 60)
	ash.Parent = ashHolder
	local startTime = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		ashHolder.Position = camera().CFrame.Position + Vector3.new(0, 40, 0)
		if os.clock() - startTime > duration then
			conn:Disconnect()
			ash.Enabled = false
			Debris:AddItem(ashHolder, 7)
		end
	end)
end

---------------------------------------------------------------------------
-- Meteors
---------------------------------------------------------------------------
local function meteor(target: Vector3, delay: number, radius: number, shielded: boolean)
	if (camera().CFrame.Position - target).Magnitude > 700 then
		return
	end
	local warning = localPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		CFrame = CFrame.new(target + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = shielded and Color3.fromRGB(80, 200, 255) or Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
		Transparency = 0.5,
	})
	TweenService:Create(warning, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.15 }):Play()
	local start = target + Vector3.new(math.random(-60, 60), 260, math.random(-60, 60))
	local rock = localPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 7, Position = start, Color = Color3.fromRGB(120, 50, 20), Material = Enum.Material.CrackedLava })
	local fire = Instance.new("Fire")
	fire.Size = 12
	fire.Heat = 20
	fire.Parent = rock
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 0)
	light.Range = 30
	light.Brightness = 3
	light.Parent = rock
	local tween = TweenService:Create(rock, TweenInfo.new(delay, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = target })
	tween:Play()
	tween.Completed:Connect(function()
		rock:Destroy()
		warning:Destroy()
		local boom = Instance.new("Explosion")
		boom.Position = target
		boom.BlastRadius = 0
		boom.BlastPressure = 0
		boom.DestroyJointRadiusPercent = 0
		boom.Parent = workspace
		Debris:AddItem(boom, 2)
		if C.VFX then
			C.VFX:Ring(target + Vector3.new(0, 1, 0), shielded and Color3.fromRGB(80, 200, 255) or Color3.fromRGB(255, 120, 0), radius * 3, 0.6)
			C.VFX:Burst(target, Color3.fromRGB(255, 140, 40), 30, 1.5)
		end
		local d = (camera().CFrame.Position - target).Magnitude
		if d < 80 then
			shake((80 - d) / 80 * 1.2, 0.35)
		end
	end)
end

---------------------------------------------------------------------------
-- Tornado + UFO visuals (follow server cores)
---------------------------------------------------------------------------
local function tornadoVisual(core: BasePart)
	local model = Instance.new("Model")
	model.Name = "TornadoVisual"
	model.Parent = fxFolder
	local segments = {}
	for i = 0, 11 do
		local r = 5 + i * 2.6
		local seg = localPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(14, r * 2, r * 2),
			Color = Color3.fromRGB(140 - i * 3, 140 - i * 3, 150 - i * 3),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.55 + i * 0.02,
		})
		seg.Parent = model
		segments[i + 1] = { Part = seg, Height = 7 + i * 13, Phase = i * 0.5 }
	end
	local dust = localPart({ Size = Vector3.new(30, 1, 30), Transparency = 1 })
	dust.Parent = model
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(150, 130, 110))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 20) })
	emitter.Transparency = NumberSequence.new(0.3, 1)
	emitter.Lifetime = NumberRange.new(2, 3)
	emitter.Rate = 40
	emitter.Speed = NumberRange.new(10, 20)
	emitter.SpreadAngle = Vector2.new(70, 70)
	emitter.Parent = dust
	local debris = emitter:Clone()
	debris.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	debris.Color = ColorSequence.new(Color3.fromRGB(90, 60, 40))
	debris.Size = NumberSequence.new(1)
	debris.Rate = 30
	debris.Speed = NumberRange.new(30, 50)
	debris.RotSpeed = NumberRange.new(-200, 200)
	debris.Parent = dust
	local pos = core.Position
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not core.Parent then
			conn:Disconnect()
			for _, s in segments do
				TweenService:Create(s.Part, TweenInfo.new(1.5), { Transparency = 1 }):Play()
			end
			emitter.Enabled = false
			debris.Enabled = false
			Debris:AddItem(model, 3)
			return
		end
		pos = pos:Lerp(core.Position, math.min(dt * 6, 1))
		local t = os.clock()
		for _, s in segments do
			local sway = Vector3.new(math.sin(t * 2 + s.Phase) * s.Height * 0.06, 0, math.cos(t * 1.7 + s.Phase) * s.Height * 0.06)
			s.Part.CFrame = CFrame.new(pos + Vector3.new(0, s.Height, 0) + sway) * CFrame.Angles(0, t * 4 + s.Phase, math.rad(90))
		end
		dust.Position = pos + Vector3.new(0, 1, 0)
	end)
end

local function ufoVisual(core: BasePart)
	local model = Instance.new("Model")
	model.Name = "UFOVisual"
	model.Parent = fxFolder
	local disc = localPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 30, 30), Color = Color3.fromRGB(170, 175, 190), Material = Enum.Material.Metal })
	disc.Parent = model
	local dome = localPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 13, Color = Color3.fromRGB(120, 255, 200), Material = Enum.Material.Glass, Transparency = 0.3 })
	dome.Parent = model
	local lights = {}
	for i = 1, 10 do
		local l = localPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, Color = Color3.fromHSV(i / 10, 0.8, 1), Material = Enum.Material.Neon })
		l.Parent = model
		lights[i] = l
	end
	local beam = localPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(120, 14, 14), Color = Color3.fromRGB(120, 255, 120), Material = Enum.Material.Neon, Transparency = 1 })
	beam.Parent = model
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(120, 255, 150)
	glow.Range = 50
	glow.Brightness = 2
	glow.Parent = disc
	local pos = core.Position
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		if not core.Parent then
			conn:Disconnect()
			TweenService:Create(disc, TweenInfo.new(1), { Transparency = 1 }):Play()
			Debris:AddItem(model, 1.2)
			return
		end
		pos = pos:Lerp(core.Position, math.min(dt * 5, 1))
		local t = os.clock()
		local center = pos + Vector3.new(0, math.sin(t * 2) * 1.5, 0)
		local tilt = CFrame.Angles(math.sin(t) * 0.08, 0, math.cos(t * 1.3) * 0.08)
		disc.CFrame = CFrame.new(center) * tilt * CFrame.Angles(0, 0, math.rad(90))
		dome.CFrame = CFrame.new(center + Vector3.new(0, 3, 0))
		for i, l in lights do
			local a = i / #lights * math.pi * 2 + t * 2
			l.CFrame = CFrame.new(center + Vector3.new(math.cos(a) * 14.5, -0.5, math.sin(a) * 14.5))
			l.Color = Color3.fromHSV((i / #lights + t * 0.3) % 1, 0.8, 1)
		end
		local beamOn = core:GetAttribute("BeamOn") == true
		beam.Transparency = beamOn and (0.55 + math.sin(t * 12) * 0.08) or 1
		beam.CFrame = CFrame.new(center - Vector3.new(0, 62, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end)
end

---------------------------------------------------------------------------
-- Character effects (from the server)
---------------------------------------------------------------------------
local busy = false

local function fling(velocity: Vector3)
	local root, humanoid = getRoot(), getHumanoid()
	if not root or not humanoid or busy then
		return
	end
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = Vector3.new(math.random(-6, 6), math.random(-6, 6), math.random(-6, 6))
	task.delay(1.2, function()
		if humanoid.Parent and not busy then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

local function tornadoPull(center: Vector3)
	local root = getRoot()
	if not root then
		return
	end
	local flat = (root.Position - center) * Vector3.new(1, 0, 1)
	local radial = flat.Magnitude > 0.5 and flat.Unit or Vector3.new(1, 0, 0)
	local tangent = Vector3.new(-radial.Z, 0, radial.X)
	fling(tangent * 70 - radial * 18 + Vector3.new(0, 55, 0))
end

-- move the character along a path while anchored (abduction / launch pad)
local function carry(duration: number, pathFn: (number) -> Vector3, onDone: (() -> ())?)
	local root, humanoid = getRoot(), getHumanoid()
	if not root or not humanoid or busy then
		return
	end
	busy = true
	root.Anchored = true
	local startTime = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local alpha = math.min((os.clock() - startTime) / duration, 1)
		if not root.Parent then
			conn:Disconnect()
			busy = false
			return
		end
		local p = pathFn(alpha)
		local ahead = pathFn(math.min(alpha + 0.02, 1))
		local dir = (ahead - p) * Vector3.new(1, 0, 1)
		root.CFrame = dir.Magnitude > 0.01 and CFrame.lookAt(p, p + dir) or CFrame.new(p) * root.CFrame.Rotation
		if alpha >= 1 then
			conn:Disconnect()
			root.Anchored = false
			root.AssemblyLinearVelocity = Vector3.zero
			busy = false
			if onDone then
				onDone()
			end
		end
	end)
end

local function abduct(target: Vector3, duration: number)
	local root = getRoot()
	if not root then
		return
	end
	local start = root.Position
	UIKit.PlaySound("Whoosh", 0.7, 0.6)
	carry(duration, function(alpha)
		local p = start:Lerp(target, alpha * alpha)
		return p + Vector3.new(math.sin(alpha * 20) * 1.5, 0, math.cos(alpha * 20) * 1.5)
	end, function()
		C.Notifications:Toast("🛸 You were abducted by aliens! Grab the alien cash they drop!", "info", 4)
	end)
end

local function launch(target: Vector3)
	local root = getRoot()
	if not root then
		return
	end
	local start = root.Position
	local apex = math.max(start.Y, target.Y) + 60
	UIKit.PlaySound("Whoosh", 0.8, 0.8)
	if C.VFX then
		C.VFX:Play("SpeedLines", { Duration = 3 })
	end
	carry(3, function(alpha)
		local flat = Vector3.new(start.X, 0, start.Z):Lerp(Vector3.new(target.X, 0, target.Z), alpha)
		-- quadratic bezier for height
		local y = (1 - alpha) ^ 2 * start.Y + 2 * (1 - alpha) * alpha * apex + alpha ^ 2 * target.Y
		return Vector3.new(flat.X, y, flat.Z)
	end)
end

local function vaporized()
	if C.VFX then
		C.VFX:Flash(Color3.fromRGB(255, 200, 150), 2)
	end
	local label = UIKit.Label({
		Text = "☠️ VAPORIZED! ☠️",
		Size = UDim2.fromOffset(600, 90),
		Position = UDim2.fromScale(0.5, 0.38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = Color3.fromRGB(255, 90, 40),
		ZIndex = 49,
		Parent = C.UI.FX,
	})
	local sub = UIKit.Label({
		Text = "Next time follow the green beam to a bunker!",
		Size = UDim2.fromOffset(600, 34),
		Position = UDim2.fromScale(0.5, 0.46),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Font = Theme.BodyFont,
		ZIndex = 49,
		Parent = C.UI.FX,
	})
	task.delay(4, function()
		TweenService:Create(label, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		TweenService:Create(sub, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		Debris:AddItem(label, 0.7)
		Debris:AddItem(sub, 0.7)
	end)
end

---------------------------------------------------------------------------
-- State handling
---------------------------------------------------------------------------
local ACTIVE_TEXT = {
	Meteors = { "☄️ METEOR STORM", "Dodge the red circles • grab cash crystals", Color3.fromRGB(255, 120, 30) },
	Tornado = { "🌪️ TORNADO", "Stay away from the funnel!", Color3.fromRGB(170, 180, 200) },
	UFO = { "🛸 UFO INVASION", "Avoid the tractor beams • grab alien cash", Color3.fromRGB(120, 255, 80) },
	Earthquake = { "🌍 EARTHQUAKE", "Hold on! • grab the cash geodes", Color3.fromRGB(210, 150, 90) },
}

-- one shock of an earthquake: the camera shakes, the ground rumbles, dust flies
local function quakeShock(intensity: number)
	shake(1.6 * intensity, 1.3)
	UIKit.PlaySound("Boom", 0.5 * intensity, 0.45)
	local root = getRoot()
	if root and C.VFX then
		C.VFX:Burst(root.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(150, 120, 90), 25, 1.5)
	end
end

local function onState(state)
	local phase, kind = state.Phase, state.Kind
	if phase == "Warning" and kind == "Nuke" then
		nukeActive = true
		shelters = state.Shelters or shelters
		showBanner("☢️ NUKE INCOMING ☢️", state.By and ("Launched by " .. state.By) or "Find a bunker NOW!", Theme.Red)
		countdown.Visible = true
		countdown.Text = tostring(state.TimeLeft)
		local scale = countdown:FindFirstChildOfClass("UIScale") :: UIScale
		scale.Scale = 1.4
		TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		vignette.Visible = true
		statusChip.Visible = true
		startSiren()
		updateBeam()
		if state.TimeLeft <= 3 and not missile then
			spawnMissile(state.Target, state.TimeLeft)
		end
		UIKit.PlaySound("Countdown", 0.4, state.TimeLeft <= 5 and 1.4 or 1)
	elseif phase == "Impact" and kind == "Nuke" then
		nukeImpact(state.Target, state.ShockSpeed or 320)
		showBanner("☢️ IMPACT ☢️", "Stay in cover until the shockwave passes!", Theme.Red)
	elseif phase == "Aftermath" then
		aftermath(state.Duration or 25)
		task.delay(3, hideAll)
		nukeActive = false
	elseif phase == "Active" then
		local text = ACTIVE_TEXT[kind]
		if text then
			showBanner(text[1] .. "  " .. tostring(state.TimeLeft) .. "s", text[2], text[3])
		end
	elseif phase == "Meteor" then
		meteor(state.Target, state.Delay or 1.4, state.Radius or 12, state.Shield == true)
	elseif phase == "Shock" and kind == "Earthquake" then
		quakeShock(tonumber(state.Intensity) or 1)
	elseif phase == "End" then
		stopSiren()
		clearBeam()
		nukeActive = false
		if missile then
			missile:Destroy()
			missile = nil
		end
		task.delay(1.5, hideAll)
	end
end

function Disasters:Init(controllers)
	C = controllers
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "DisasterFX"
	fxFolder.Parent = workspace
	buildUI()

	Remotes.Disaster.OnClientEvent:Connect(function(state)
		local ok, err = pcall(onState, state)
		if not ok then
			warn("[Disasters] " .. tostring(err))
		end
	end)

	Remotes.ClientCommand.OnClientEvent:Connect(function(command, a, b)
		if command == "fling" and typeof(a) == "Vector3" then
			fling(a)
		elseif command == "tornado" and typeof(a) == "Vector3" then
			tornadoPull(a)
		elseif command == "abduct" and typeof(a) == "Vector3" then
			abduct(a, tonumber(b) or 2.5)
		elseif command == "launch" and typeof(a) == "Vector3" then
			launch(a)
		elseif command == "vaporized" then
			vaporized()
		end
	end)

	for _, core in CollectionService:GetTagged("Tornado") do
		tornadoVisual(core)
	end
	CollectionService:GetInstanceAddedSignal("Tornado"):Connect(tornadoVisual)
	for _, core in CollectionService:GetTagged("UFO") do
		ufoVisual(core)
	end
	CollectionService:GetInstanceAddedSignal("UFO"):Connect(ufoVisual)

	player.CharacterAdded:Connect(function()
		busy = false
		clearBeam()
	end)
end

local function updateStatus()
	if nukeActive and statusChip.Visible then
		local root = getRoot()
		if root then
			local safe = isSheltered(root.Position)
			statusChip.Text = safe and "✅ YOU ARE SAFE" or "⚠️ EXPOSED - GET TO A BUNKER!"
			statusChip.TextColor3 = safe and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 110, 80)
			updateBeam()
		end
	end
end

function Disasters:Start()
	-- live shelter status + beam while a nuke is coming
	while true do
		task.wait(0.25)
		Util.Try("Disasters", updateStatus)
	end
end

return Disasters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">DropVisuals</string>
            <string name="Source"><![CDATA[--[[
	DropVisuals (client) - renders the falling cash drops locally.
	The server calculates income; it tags dropper / upgrader / generator
	models with attributes (Spout, BeltEnd, Interval, Worth, ...). Here we
	spawn cheap anchored parts that fall onto the conveyor, change colour
	when they pass an upgrader and pop "+$" at the collector.
	Only towers near the camera (and your current floor) are animated.
]]
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)

local player = Players.LocalPlayer

local DropVisuals = {}
local C

local MAX_DROPS = 180
local VIEW_RANGE = 150
local FLOOR_RANGE = 11
local FALL_TIME = 0.35

local droppers: { [Model]: { Next: number } } = {}
local generators: { [Model]: { Next: number } } = {}
local fireworks: { [Model]: { Next: number } } = {}
local live = 0
local folder: Folder
local enabled = true
local popTotals: { [string]: { Amount: number, Position: Vector3 } } = {}

function DropVisuals:SetEnabled(on: boolean)
	enabled = on
end

local function focusPosition(): Vector3
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position or workspace.CurrentCamera.CFrame.Position
end

local function upgradersFor(model: Model)
	local plot, floor = model:GetAttribute("Plot"), model:GetAttribute("Floor")
	local list = {}
	for _, up in CollectionService:GetTagged("Upgrader") do
		if up.Parent and up:GetAttribute("Plot") == plot and up:GetAttribute("Floor") == floor then
			local pos = up:GetAttribute("BeltPos")
			if typeof(pos) == "Vector3" then
				table.insert(list, { Pos = pos, Color = up:GetAttribute("Color") })
			end
		end
	end
	return list
end

local function spawnDrop(model: Model)
	local spout = model:GetAttribute("Spout")
	local beltEnd = model:GetAttribute("BeltEnd")
	if typeof(spout) ~= "Vector3" or typeof(beltEnd) ~= "Vector3" then
		return
	end
	local tier = model:GetAttribute("Tier") or 1
	local size = 0.9 + tier * 0.07
	local drop = Instance.new("Part")
	drop.Name = "Drop"
	drop.Anchored = true
	drop.CanCollide = false
	drop.CanQuery = false
	drop.CanTouch = false
	drop.CastShadow = false
	drop.Size = Vector3.one * size
	drop.Color = model:GetAttribute("DropColor") or Color3.fromRGB(200, 200, 200)
	local materialName = model:GetAttribute("DropMaterial")
	local ok, material = pcall(function()
		return (Enum.Material :: any)[materialName]
	end)
	drop.Material = ok and material or Enum.Material.SmoothPlastic
	drop.CFrame = CFrame.new(spout) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
	drop.Parent = folder
	live += 1

	local landing = Vector3.new(spout.X, beltEnd.Y + size / 2, spout.Z)
	local finish = Vector3.new(beltEnd.X, beltEnd.Y + size / 2, beltEnd.Z)
	local speed = model:GetAttribute("BeltSpeed") or 12
	local distance = (finish - landing).Magnitude
	local travel = distance / speed
	TweenService:Create(drop, TweenInfo.new(FALL_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = landing }):Play()
	task.delay(FALL_TIME, function()
		if drop.Parent then
			TweenService:Create(drop, TweenInfo.new(travel, Enum.EasingStyle.Linear), { Position = finish }):Play()
		end
	end)
	-- colour change at each upgrader
	local dir = distance > 0 and (finish - landing).Unit or Vector3.xAxis
	for _, up in upgradersFor(model) do
		local along = (up.Pos - landing):Dot(dir)
		if along > 0 and along < distance then
			task.delay(FALL_TIME + along / speed, function()
				if drop.Parent then
					drop.Color = up.Color or drop.Color
					drop.Material = Enum.Material.Neon
					drop.Size *= 1.12
				end
			end)
		end
	end
	local worth = model:GetAttribute("Worth") or 0
	local key = tostring(model:GetAttribute("Plot")) .. "_" .. tostring(model:GetAttribute("Floor"))
	task.delay(FALL_TIME + travel, function()
		live -= 1
		if drop.Parent then
			drop:Destroy()
		end
		local entry = popTotals[key]
		if not entry then
			entry = { Amount = 0, Position = finish + Vector3.new(0, 3, 0) }
			popTotals[key] = entry
		end
		entry.Amount += worth
	end)
end

local function launchFirework(model: Model)
	local pos = model:GetAttribute("LaunchPos")
	if typeof(pos) ~= "Vector3" then
		return
	end
	local color = Color3.fromHSV(math.random(), 0.8, 1)
	local rocket = Instance.new("Part")
	rocket.Anchored = true
	rocket.CanCollide = false
	rocket.CanQuery = false
	rocket.CanTouch = false
	rocket.Size = Vector3.new(0.6, 1.6, 0.6)
	rocket.Color = color
	rocket.Material = Enum.Material.Neon
	rocket.Position = pos
	rocket.Parent = folder
	local trail = Instance.new("Fire")
	trail.Size = 2
	trail.Heat = 6
	trail.Parent = rocket
	local top = pos + Vector3.new(math.random(-8, 8), math.random(50, 70), math.random(-8, 8))
	local tween = TweenService:Create(rocket, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = top })
	tween:Play()
	tween.Completed:Connect(function()
		rocket.Transparency = 1
		trail.Enabled = false
		local burst = Instance.new("ParticleEmitter")
		burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		burst.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		burst.LightEmission = 1
		burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
		burst.Speed = NumberRange.new(25, 40)
		burst.SpreadAngle = Vector2.new(180, 180)
		burst.Lifetime = NumberRange.new(1, 1.6)
		burst.Drag = 3
		burst.Acceleration = Vector3.new(0, -12, 0)
		burst.Rate = 0
		burst.Parent = rocket
		burst:Emit(80)
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 60
		light.Brightness = 4
		light.Parent = rocket
		TweenService:Create(light, TweenInfo.new(1.2), { Brightness = 0 }):Play()
		Debris:AddItem(rocket, 2.2)
	end)
end

local function track(map, model)
	if model:IsA("Model") then
		map[model] = { Next = os.clock() + math.random() * 2 }
	end
end

function DropVisuals:Init(controllers)
	C = controllers
	folder = Instance.new("Folder")
	folder.Name = "LocalDrops"
	folder.Parent = workspace
	for tag, map in { Dropper = droppers, Generator = generators, Fireworks = fireworks } do
		for _, model in CollectionService:GetTagged(tag) do
			track(map, model)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(model)
			track(map, model)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(model)
			map[model] = nil
		end)
	end
end

local lastPop = 0
local function step()
	local now = os.clock()
	local focus = focusPosition()
	local lowGraphics = C.Animator and C.Animator.IsLowGraphics and C.Animator:IsLowGraphics()
	if enabled and not lowGraphics then
		for model, info in droppers do
			if not model.Parent then
				droppers[model] = nil
			elseif now >= info.Next then
				local interval = model:GetAttribute("Interval") or 2
				info.Next = now + interval
				local spout = model:GetAttribute("Spout")
				if typeof(spout) == "Vector3" and live < MAX_DROPS then
					local d = spout - focus
					if Vector3.new(d.X, 0, d.Z).Magnitude < VIEW_RANGE and math.abs(d.Y - 3.5) < FLOOR_RANGE then
						spawnDrop(model)
					end
				end
			end
		end
	end
	-- "+$" pops at collectors (batched)
	if now - lastPop >= 0.8 then
		lastPop = now
		for key, entry in popTotals do
			if entry.Amount > 0 and C.VFX then
				C.VFX:FloatText(entry.Position, "+" .. Util.Money(entry.Amount), Color3.fromRGB(120, 255, 140), 0.8)
			end
			popTotals[key] = nil
		end
		-- generators
		local shown = 0
		for model, info in generators do
			if not model.Parent then
				generators[model] = nil
			elseif now >= info.Next then
				info.Next = now + (model:GetAttribute("Cycle") or 5)
				local pos = model:GetAttribute("PopPos")
				if typeof(pos) == "Vector3" and shown < 6 and C.VFX then
					local d = pos - focus
					if Vector3.new(d.X, 0, d.Z).Magnitude < 70 and math.abs(d.Y - 9) < FLOOR_RANGE then
						shown += 1
						C.VFX:FloatText(pos, "+" .. Util.Money(model:GetAttribute("Worth") or 0), Color3.fromRGB(255, 220, 90), 0.7)
					end
				end
			end
		end
	end
	for model, info in fireworks do
		if not model.Parent then
			fireworks[model] = nil
		elseif now >= info.Next then
			info.Next = now + math.random(4, 8)
			local pos = model:GetAttribute("LaunchPos")
			if typeof(pos) == "Vector3" and (pos - workspace.CurrentCamera.CFrame.Position).Magnitude < 500 then
				launchFirework(model)
			end
		end
	end
end

function DropVisuals:Start()
	while true do
		task.wait(0.1)
		Util.Try("DropVisuals", step)
	end
end

return DropVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Duo</string>
            <string name="Source"><![CDATA[--[[ Duo (client) - invite players to build one tower together + invite popups ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Duo = {}
local C

local statusLabel: TextLabel
local leaveButton: TextButton
local list: ScrollingFrame
local popup: Frame
local popupText: TextLabel
local popupTimer: TextLabel
local pendingHost: number? = nil
local popupToken = 0

local function nameOf(userId: number?): string
	local p = userId and Players:GetPlayerByUserId(userId)
	return p and p.DisplayName or "someone"
end

local function refresh()
	local host = player:GetAttribute("DuoHost")
	local partner = player:GetAttribute("DuoPartner")
	if host then
		statusLabel.Text = "👥 You're building with " .. nameOf(host) .. " (shared wallet)"
		leaveButton.Text = "LEAVE DUO"
		leaveButton.Visible = true
	elseif partner then
		statusLabel.Text = "👥 " .. nameOf(partner) .. " is building in your tower"
		leaveButton.Text = "END DUO"
		leaveButton.Visible = true
	else
		statusLabel.Text = "Invite someone to build ONE tower together. You share one wallet; it saves to the tower owner."
		leaveButton.Visible = false
	end

	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local order = 0
	for _, other in Players:GetPlayers() do
		if other ~= player then
			order += 1
			local row = UIKit.new("Frame", { Size = UDim2.new(1, -10, 0, 52), BackgroundColor3 = order % 2 == 0 and Theme.PanelLight or Theme.Panel, LayoutOrder = order, ZIndex = 7, Parent = list })
			UIKit.Corner(row, 8)
			UIKit.Label({ Text = other.DisplayName, Size = UDim2.new(1, -200, 0, 26), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = row })
			local busy = other:GetAttribute("DuoHost") or other:GetAttribute("DuoPartner")
			UIKit.Label({
				Text = busy and "in a duo" or ("Rebirth " .. (other:GetAttribute("Rebirths") or 0)),
				Size = UDim2.new(1, -200, 0, 16),
				Position = UDim2.fromOffset(12, 31),
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Theme.BodyFont,
				TextColor3 = Theme.SubText,
				Stroke = false,
				ZIndex = 8,
				Parent = row,
			})
			local canInvite = not busy and not host and not partner
			UIKit.Button({
				Text = canInvite and "INVITE 👥" or "—",
				Color = canInvite and Theme.Accent2 or Color3.fromRGB(80, 80, 95),
				Size = UDim2.fromOffset(150, 38),
				Position = UDim2.new(1, -160, 0, 7),
				ZIndex = 8,
				Parent = row,
				Callback = function()
					if canInvite then
						Remotes.DuoInvite:FireServer(other.UserId)
					end
				end,
			})
		end
	end
	if order == 0 then
		local row = UIKit.new("Frame", { Size = UDim2.new(1, -10, 0, 52), BackgroundTransparency = 1, ZIndex = 7, Parent = list })
		UIKit.Label({ Text = "Nobody else is here yet - invite a friend to the server!", Size = UDim2.new(1, 0, 1, 0), Font = Theme.BodyFont, ZIndex = 8, Parent = row })
	end
end

local function buildPanel()
	local _, content = C.UI:MakePanel("Duo", "👥 DUO BUILD", Color3.fromRGB(0, 190, 255), 620, 480, refresh)
	statusLabel = UIKit.new("TextLabel", {
		Text = "",
		Size = UDim2.new(1, -190, 0, 46),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 16,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
		Parent = content,
	})
	leaveButton = UIKit.Button({ Text = "LEAVE DUO", Color = Theme.Red, Size = UDim2.fromOffset(170, 42), Position = UDim2.new(1, -170, 0, 2), ZIndex = 7, Parent = content, Callback = function()
		Remotes.DuoLeave:FireServer()
		task.delay(0.5, refresh)
	end })
	list = UIKit.Scroll({ Size = UDim2.new(1, 0, 1, -58), Position = UDim2.fromOffset(0, 56), Parent = content })
	UIKit.List(list, 6)
end

local function buildPopup()
	popup = UIKit.new("Frame", {
		Size = UDim2.fromOffset(400, 150),
		Position = UDim2.new(0.5, 0, 0, -170),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Panel,
		ZIndex = 30,
		Parent = C.UI.FX,
	})
	UIKit.Corner(popup, 16)
	UIKit.Stroke(popup, Theme.Accent2, 3)
	UIKit.Gradient(popup, Theme.PanelLight, Theme.Panel, 90)
	UIKit.Label({ Text = "👥 DUO INVITE", Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 8), TextColor3 = Theme.Accent2, ZIndex = 31, Parent = popup })
	popupText = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 44), Font = Theme.BodyFont, ZIndex = 31, Parent = popup })
	popupTimer = UIKit.Label({ Text = "", Size = UDim2.fromOffset(60, 30), Position = UDim2.new(0, 14, 1, -46), ZIndex = 31, Parent = popup })
	local function respond(accept: boolean)
		if pendingHost then
			Remotes.DuoRespond:FireServer(pendingHost, accept)
		end
		pendingHost = nil
		popupToken += 1
		TweenService:Create(popup, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -170) }):Play()
	end
	UIKit.Button({ Text = "ACCEPT", Color = Theme.Green, Size = UDim2.fromOffset(130, 44), Position = UDim2.new(1, -290, 1, -56), ZIndex = 31, Parent = popup, Callback = function()
		respond(true)
	end })
	UIKit.Button({ Text = "DECLINE", Color = Theme.Red, Size = UDim2.fromOffset(130, 44), Position = UDim2.new(1, -150, 1, -56), ZIndex = 31, Parent = popup, Callback = function()
		respond(false)
	end })
	Duo.Respond = respond
end

function Duo:Init(controllers)
	C = controllers
	buildPanel()
	buildPopup()

	Remotes.DuoInvited.OnClientEvent:Connect(function(data)
		pendingHost = data.HostUserId
		popupToken += 1
		local token = popupToken
		popupText.Text = data.HostName .. " wants to build a tower with you!"
		UIKit.PlaySound("Notify", 0.6, 1.2)
		TweenService:Create(popup, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 90) }):Play()
		task.spawn(function()
			for t = data.Timeout or 30, 0, -1 do
				if token ~= popupToken then
					return
				end
				popupTimer.Text = "⏱ " .. t
				task.wait(1)
			end
			if token == popupToken then
				Duo.Respond(false)
			end
		end)
	end)

	for _, attr in { "DuoHost", "DuoPartner" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			if C.UI.Current == "Duo" then
				refresh()
			end
		end)
	end
	Players.PlayerAdded:Connect(function()
		if C.UI.Current == "Duo" then
			refresh()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(function()
			if C.UI.Current == "Duo" then
				refresh()
			end
		end)
	end)
end

return Duo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Gifts</string>
            <string name="Source"><![CDATA[--[[ Gifts (client) - the playtime gift button (bottom right) ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Gifts = {}
Gifts.State = nil :: { Index: number, Total: number, ReadyAt: number }?
local C

local button: TextButton
local busy = false

local function refresh()
	local state = Gifts.State
	if not state or state.Index > state.Total then
		button.Visible = false
		return
	end
	button.Visible = not player:GetAttribute("InMinigame")
	local left = state.ReadyAt - os.clock()
	if left <= 0 then
		button.Text = "🎁 OPEN GIFT " .. state.Index .. "/" .. state.Total .. "!"
		button.BackgroundColor3 = Theme.Green
	else
		button.Text = "🎁 Gift " .. state.Index .. "/" .. state.Total .. " in " .. Util.Clock(left)
		button.BackgroundColor3 = Theme.PanelLight
	end
end

function Gifts:IsReady(): boolean
	return self.State ~= nil and self.State.Index <= self.State.Total and self.State.ReadyAt - os.clock() <= 0
end

function Gifts:Init(controllers)
	C = controllers
	button = UIKit.Button({
		Name = "GiftButton",
		Text = "🎁",
		Color = Theme.PanelLight,
		Size = UDim2.fromOffset(240, 50),
		Position = UDim2.new(1, -12, 1, -14),
		AnchorPoint = Vector2.new(1, 1),
		Parent = C.UI.Gui,
		Callback = function()
			if busy or not self:IsReady() then
				return
			end
			busy = true
			local ok, message = Remotes.ClaimGift:InvokeServer()
			busy = false
			C.Notifications:Toast(tostring(message), ok and "success" or "error")
		end,
	})
	button.Visible = false
	local scale = button:FindFirstChildOfClass("UIScale") :: UIScale
	Remotes.GiftUpdate.OnClientEvent:Connect(function(state)
		if type(state) ~= "table" then
			return
		end
		local wasReady = self:IsReady()
		self.State = { Index = state.Index, Total = state.Total, ReadyAt = os.clock() + math.max(0, state.ReadyIn or 0) }
		refresh()
		if not wasReady and self:IsReady() and scale then
			scale.Scale = 1.2
			TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end)
end

function Gifts:Start()
	local announced = 0
	while true do
		task.wait(1)
		Util.Try("Gifts", refresh)
		-- tell the player once when a gift unlocks
		local state = self.State
		if state and self:IsReady() and announced < state.Index then
			announced = state.Index
			C.Notifications:Toast("🎁 A playtime gift is ready! Open it in the bottom-right corner.", "success")
			UIKit.PlaySound("Notify", 0.6, 1.3)
		end
	end
end

return Gifts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Guide</string>
            <string name="Source"><![CDATA[--[[
	Guide (client) - a glowing beam from you to your next goal in your tower:
	the cheapest button you can afford (on your floor first), or a vault pad
	when collecting would let you buy something. Only near your own tower;
	hidden during nukes and minigames. Turn it off in Settings.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local TycoonItems = require(Shared.TycoonItems)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Guide = {}
Guide.Target = nil :: { Kind: string, Id: string?, Position: Vector3 }?

local RANGE = 150 -- studs from your tower's centre
local fromAttachment: Attachment?
local anchor: BasePart
local beam: Beam
local labelGui: BillboardGui
local label: TextLabel

local function root(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function plotModel(): Instance?
	local index = player:GetAttribute("Plot")
	local tycoons = workspace:FindFirstChild("Tycoons")
	return index and tycoons and tycoons:FindFirstChild("Plot" .. tostring(index))
end

-- where should the player go next?
local function findTarget(from: BasePart)
	local plot = plotModel()
	local center = player:GetAttribute("PlotCenter")
	if not plot or typeof(center) ~= "Vector3" then
		return nil
	end
	local offset = from.Position - center
	if Vector3.new(offset.X, 0, offset.Z).Magnitude > RANGE then
		return nil
	end
	local cash = player:GetAttribute("Cash") or 0
	local buttons = plot:FindFirstChild("Buttons")
	local best, bestScore, cheapest = nil, math.huge, nil
	for _, model in buttons and buttons:GetChildren() or {} do
		local item = TycoonItems.ById[model.Name]
		local pad = model:FindFirstChild("Pad") :: BasePart?
		if item and pad then
			if not cheapest or item.Cost < cheapest.Cost then
				cheapest = item
			end
			if item.Cost <= cash then
				-- strongly prefer buttons on the floor you're standing on
				local sameFloor = math.abs(pad.Position.Y - from.Position.Y) < Config.Tycoon.FloorHeight / 2
				local score = item.Cost * (sameFloor and 1 or 1000)
				if score < bestScore then
					best, bestScore = { Kind = "Buy", Id = item.Id, Position = pad.Position, Text = "⬇ BUY: " .. item.Name }, score
				end
			end
		end
	end
	if best then
		return best
	end
	-- nothing affordable: the vault would make it affordable?
	local vault = player:GetAttribute("Vault") or 0
	if cheapest and vault > 0 and cash + vault >= cheapest.Cost and not player:GetAttribute("Pass_AutoCollect") then
		local items = plot:FindFirstChild("Items")
		local nearest, nearestD = nil, math.huge
		for floor = 1, Config.Tycoon.Floors do
			local unlock = items and items:FindFirstChild(TycoonItems.FloorUnlockId(floor))
			local pad = unlock and unlock:FindFirstChild("VaultPad", true) :: BasePart?
			if pad then
				local d = (pad.Position - from.Position).Magnitude
				if d < nearestD then
					nearest, nearestD = pad, d
				end
			end
		end
		if nearest then
			return { Kind = "Vault", Position = nearest.Position, Text = "💰 COLLECT " .. Util.Money(vault) }
		end
	end
	return nil
end

local function hide()
	Guide.Target = nil
	beam.Enabled = false
	labelGui.Enabled = false
end

local function update()
	local r = root()
	local enabled = player:GetAttribute("Guide") ~= false
	if not r or not enabled or player:GetAttribute("InMinigame") or workspace:GetAttribute("Disaster") == "Nuke" then
		hide()
		return
	end
	local target = findTarget(r)
	if not target then
		hide()
		return
	end
	if not fromAttachment or fromAttachment.Parent ~= r then
		local attachment = Instance.new("Attachment")
		attachment.Name = "GuideFrom"
		attachment.Parent = r
		beam.Attachment0 = attachment
		fromAttachment = attachment
	end
	Guide.Target = target
	anchor.CFrame = CFrame.new(target.Position + Vector3.new(0, 1, 0))
	local color = target.Kind == "Vault" and Theme.Accent or Theme.Green
	beam.Color = ColorSequence.new(color)
	beam.Enabled = true
	label.Text = target.Text
	label.TextColor3 = color
	labelGui.Enabled = true
end

function Guide:Init()
	anchor = Instance.new("Part")
	anchor.Name = "GuideTarget"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Parent = workspace
	local toAttachment = Instance.new("Attachment")
	toAttachment.Parent = anchor
	beam = Instance.new("Beam")
	beam.Attachment1 = toAttachment
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 16
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Wrap
	beam.TextureLength = 3
	beam.TextureSpeed = 2
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.2, 0.15), NumberSequenceKeypoint.new(1, 0.1) })
	beam.Enabled = false
	beam.Parent = anchor
	labelGui = Instance.new("BillboardGui")
	labelGui.Name = "GuideLabel"
	labelGui.Size = UDim2.fromOffset(240, 40)
	labelGui.StudsOffset = Vector3.new(0, 4.5, 0)
	labelGui.AlwaysOnTop = true
	labelGui.MaxDistance = 120
	labelGui.Enabled = false
	labelGui.Parent = anchor
	label = UIKit.Label({ Text = "", Size = UDim2.fromScale(1, 1), Parent = labelGui })
end

function Guide:Start()
	while true do
		task.wait(0.25)
		Util.Try("Guide", update)
	end
end

return Guide
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[ HUD - cash counter, income, multiplier/boost info, floor indicator,
	repair alert and the side menu buttons ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local HUD = {}
HUD.CashFrame = nil :: Frame?
local C

local displayedCash = 0
local cashLabel: TextLabel
local incomeLabel: TextLabel
local infoLabel: TextLabel
local vaultLabel: TextLabel
local boostLabel: TextLabel
local floorLabel: TextLabel
local repairFrame: Frame
local repairLabel: TextLabel
local menuButtons: { [string]: TextButton } = {}

local animVersion = 0
local function animateCash(target: number)
	animVersion += 1
	local myVersion = animVersion
	local start = displayedCash
	local startTime = os.clock()
	local duration = 0.35
	task.spawn(function()
		while myVersion == animVersion do
			local alpha = math.min((os.clock() - startTime) / duration, 1)
			displayedCash = start + (target - start) * alpha
			cashLabel.Text = "💵 " .. Util.Money(displayedCash)
			if alpha >= 1 then
				break
			end
			task.wait()
		end
	end)
	if target > start * 1.02 then
		local scale = cashLabel:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 1.08
			TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end
end

local function sideButton(parent: Instance, order: number, icon: string, text: string, color: Color3, callback: () -> ())
	local holder = UIKit.new("Frame", { Size = UDim2.fromOffset(70, 78), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local button = UIKit.Button({
		Text = icon,
		Color = color,
		Size = UDim2.fromOffset(62, 58),
		Position = UDim2.fromOffset(4, 0),
		Radius = 14,
		Parent = holder,
		Callback = callback,
	})
	UIKit.Label({ Text = text, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 60), Parent = holder })
	local badge = UIKit.new("TextLabel", {
		Name = "Badge",
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -18, 0, -6),
		BackgroundColor3 = Theme.Red,
		Text = "!",
		TextScaled = true,
		Font = Theme.Font,
		TextColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 3,
		Parent = button,
	})
	UIKit.Corner(badge, 11)
	return button, holder
end

function HUD:SetBadge(name: string, visible: boolean, text: string?)
	local button = menuButtons[name]
	if button then
		local badge = button:FindFirstChild("Badge") :: TextLabel?
		if badge then
			badge.Visible = visible
			badge.Text = text or "!"
		end
	end
end

function HUD:Init(controllers)
	C = controllers
	local gui = C.UI.Gui

	local cashFrame = UIKit.new("Frame", {
		Name = "Cash",
		Size = UDim2.fromOffset(300, 64),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Panel,
		Parent = gui,
	})
	UIKit.Corner(cashFrame, 16)
	UIKit.Stroke(cashFrame, Color3.new(0, 0, 0), 3, 0.1)
	UIKit.Gradient(cashFrame, Color3.fromRGB(60, 200, 100), Color3.fromRGB(30, 140, 70), 90)
	self.CashFrame = cashFrame
	cashLabel = UIKit.Label({ Text = "💵 $0", Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), Parent = cashFrame })
	UIKit.new("UIScale", { Parent = cashLabel })

	local function line(y: number, color: Color3?)
		return UIKit.Label({
			Text = "",
			Size = UDim2.fromOffset(340, 20),
			Position = UDim2.new(0.5, 0, 0, y),
			AnchorPoint = Vector2.new(0.5, 0),
			Font = Theme.BodyFont,
			TextColor3 = color or Theme.Text,
			Parent = gui,
		})
	end
	incomeLabel = line(76, Color3.fromRGB(140, 255, 160))
	infoLabel = line(97)
	vaultLabel = line(118, Color3.fromRGB(255, 220, 90))
	boostLabel = line(139, Color3.fromRGB(255, 140, 60))

	floorLabel = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(220, 26),
		Position = UDim2.new(1, -12, 0, 42),
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = gui,
	})

	-- wrecked-items alert (bottom centre)
	repairFrame = UIKit.new("Frame", {
		Size = UDim2.fromOffset(420, 46),
		Position = UDim2.new(0.5, 0, 1, -16),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.fromRGB(70, 30, 20),
		Visible = false,
		Parent = gui,
	})
	UIKit.Corner(repairFrame, 12)
	UIKit.Stroke(repairFrame, Color3.fromRGB(255, 120, 60), 2)
	repairLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, -150, 1, -10), Position = UDim2.fromOffset(10, 5), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.BodyFont, Parent = repairFrame })
	UIKit.Button({ Text = "🔧 FIX NOW", Color = Color3.fromRGB(255, 130, 40), Size = UDim2.fromOffset(130, 36), Position = UDim2.new(1, -136, 0, 5), Parent = repairFrame, Callback = function()
		Remotes.BuyProduct:FireServer("InstantRepair")
	end })

	-- side menu (left)
	local menu = UIKit.new("Frame", {
		Name = "Menu",
		Size = UDim2.new(0, 160, 0, 500),
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local grid = UIKit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(70, 80),
		CellPadding = UDim2.fromOffset(6, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	grid.FillDirectionMaxCells = 2
	grid.VerticalAlignment = Enum.VerticalAlignment.Center
	local menuScale = UIKit.new("UIScale", { Parent = menu })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		menuScale.Scale = math.clamp(vp.Y / 860, 0.55, 1.1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	local buttons = {
		{ "Shop", "🛒", "SHOP", Color3.fromRGB(255, 180, 0) },
		{ "Build", "🏗️", "BUILD", Color3.fromRGB(255, 140, 40) },
		{ "Rebirth", "🔄", "REBIRTH", Color3.fromRGB(200, 90, 255) },
		{ "Duo", "👥", "DUO", Color3.fromRGB(0, 190, 255) },
		{ "Floors", "🛗", "FLOORS", Color3.fromRGB(0, 160, 220) },
		{ "Secrets", "🕵️", "SECRETS", Color3.fromRGB(120, 200, 120) },
		{ "Daily", "🎁", "DAILY", Color3.fromRGB(255, 90, 120) },
		{ "Wheel", "🎰", "WHEEL", Color3.fromRGB(255, 120, 60) },
		{ "Pets", "🐾", "PETS", Color3.fromRGB(255, 150, 200) },
		{ "Travel", "🧭", "TRAVEL", Color3.fromRGB(60, 200, 190) },
		{ "Shield", "🛡️", "SHIELD", Color3.fromRGB(70, 170, 255) },
		{ "Codes", "🎟️", "CODES", Color3.fromRGB(0, 200, 160) },
		{ "Home", "🏠", "HOME", Color3.fromRGB(70, 200, 100) },
		{ "Settings", "⚙️", "SETTINGS", Color3.fromRGB(130, 140, 160) },
		{ "Admin", "🛡️", "ADMIN", Color3.fromRGB(235, 70, 70) },
	}
	for i, def in buttons do
		local name = def[1]
		local button, holder = sideButton(menu, i, def[2], def[3], def[4], function()
			if name == "Home" then
				Remotes.GoHome:FireServer()
			elseif name == "Floors" then
				if C.UI.Current == "Floors" then
					C.UI:Close()
				else
					C.Build:OpenFloors(nil)
				end
			else
				C.UI:Toggle(name)
			end
		end)
		menuButtons[name] = button
		if name == "Admin" then
			holder.Visible = (player:GetAttribute("AdminRank") or 0) > 0
			player:GetAttributeChangedSignal("AdminRank"):Connect(function()
				holder.Visible = (player:GetAttribute("AdminRank") or 0) > 0
			end)
		end
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			C.UI:Toggle("Shop")
		elseif input.KeyCode == Enum.KeyCode.B then
			C.UI:Toggle("Build")
		elseif input.KeyCode == Enum.KeyCode.R then
			C.UI:Toggle("Rebirth")
		end
	end)
end

local function currentFloor(): string
	local center = player:GetAttribute("PlotCenter")
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if typeof(center) ~= "Vector3" or not root then
		return ""
	end
	local d = root.Position - center
	if Vector3.new(d.X, 0, d.Z).Magnitude > 70 then
		return ""
	end
	local floor = math.floor(d.Y / Config.Tycoon.FloorHeight) + 1
	if floor > Config.Tycoon.Floors then
		return "🚁 Roof"
	end
	return "🏢 Floor " .. math.max(floor, 1)
end

function HUD:Refresh()
	local mult = player:GetAttribute("Multiplier") or 1
	local rebirths = player:GetAttribute("WalletRebirths") or player:GetAttribute("Rebirths") or 0
	local rounded = math.floor(mult * 100 + 0.5) / 100
	incomeLabel.Text = "+" .. Util.Money(player:GetAttribute("Income") or 0) .. "/s"
	local friends = math.min(tonumber(player:GetAttribute("FriendsHere")) or 0, Config.Bonuses.MaxFriends)
	local extras = (player:GetAttribute("DuoHost") and "  •  👥 Duo" or "")
		.. ((player:GetAttribute("Pass_AutoBuild") and player:GetAttribute("AutoBuild") ~= false) and "  •  🤖 Auto" or "")
		.. (player.MembershipType == Enum.MembershipType.Premium and ("  •  ⭐+" .. Config.Bonuses.PremiumPercent .. "%") or "")
		.. (friends > 0 and ("  •  👫+" .. friends * Config.Bonuses.FriendPercent .. "%") or "")
	infoLabel.Text = string.format("x%s cash  •  Rebirth %d%s", rounded >= 1000 and Util.Abbreviate(rounded) or tostring(rounded), rebirths, extras)
	local hasAuto = player:GetAttribute("Pass_AutoCollect")
	local vault = player:GetAttribute("Vault") or 0
	vaultLabel.Text = (not hasAuto and vault > 0) and ("🏦 Vault: " .. Util.Money(vault) .. " (step on a vault pad!)") or ""

	local parts = {}
	local now = Util.ServerNow()
	local boostEnd = player:GetAttribute("BoostEnd") or 0
	if boostEnd > now then
		table.insert(parts, "🚀 2x Boost " .. Util.Clock(boostEnd - now))
	end
	local eventMult = workspace:GetAttribute("EventMultiplier") or 1
	local eventEnds = workspace:GetAttribute("EventEnds") or 0
	if eventMult ~= 1 and eventEnds > now then
		table.insert(parts, "🔥 " .. eventMult .. "x Event " .. Util.Clock(eventEnds - now))
	end
	boostLabel.Text = table.concat(parts, "   ")
	floorLabel.Text = currentFloor()

	-- wrecked items
	if C.Build then
		local wrecked, soonest = C.Build:WreckedCount()
		repairFrame.Visible = wrecked > 0
		if wrecked > 0 then
			repairLabel.Text = string.format("🔧 %d upgrades wrecked - rebuilding in %s", wrecked, Util.Clock(math.max(0, soonest)))
		end
	end

	-- badges
	local lastDaily = player:GetAttribute("LastDaily") or 0
	self:SetBadge("Daily", now - lastDaily >= Config.Daily.Cooldown or (player:GetAttribute("WeeklyReady") or 0) > 0)
	local cost = player:GetAttribute("RebirthCost") or math.huge
	self:SetBadge("Rebirth", (player:GetAttribute("Cash") or 0) >= cost and not player:GetAttribute("DuoHost"))
	local found = player:GetAttribute("SecretsFound") or ""
	local count = found == "" and 0 or #string.split(found, ",")
	self:SetBadge("Secrets", count > 0, tostring(count))
end

function HUD:Start()
	if not player:GetAttribute("DataLoaded") then
		player:GetAttributeChangedSignal("DataLoaded"):Wait()
	end
	displayedCash = player:GetAttribute("Cash") or 0
	cashLabel.Text = "💵 " .. Util.Money(displayedCash)
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		animateCash(player:GetAttribute("Cash") or 0)
	end)
	for _, attr in { "Multiplier", "Rebirths", "Vault", "BoostEnd", "LastDaily", "Pass_AutoCollect", "Income", "SecretsFound" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			self:Refresh()
		end)
	end
	Util.Try("HUD", self.Refresh, self)
	while true do
		task.wait(0.5)
		Util.Try("HUD", self.Refresh, self)
	end
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Minigame</string>
            <string name="Source"><![CDATA[--[[ Minigame (client) - join popup, countdown, in-game HUD and results ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Minigame = {}
local C

local timerPill: TextLabel
local joinCard: Frame
local joinTitle: TextLabel
local joinDesc: TextLabel
local joinTimer: TextLabel
local joinButton: TextButton
local playBar: Frame
local playText: TextLabel
local countdownLabel: TextLabel
local resultsFrame: Frame
local resultsList: Frame
local lastPhase = nil

local function buildUI()
	local gui = C.UI.Gui

	timerPill = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(260, 26),
		Position = UDim2.new(1, -12, 0, 12),
		AnchorPoint = Vector2.new(1, 0),
		Font = Theme.BodyFont,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = gui,
	})

	-- join card (bottom centre)
	joinCard = UIKit.new("Frame", {
		Size = UDim2.fromOffset(420, 150),
		Position = UDim2.new(0.5, 0, 1, 200),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Panel,
		Parent = gui,
	})
	UIKit.Corner(joinCard, 16)
	UIKit.Stroke(joinCard, Theme.Purple, 3)
	UIKit.Gradient(joinCard, Theme.PanelLight, Theme.Panel, 90)
	joinTitle = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 8), TextColor3 = Color3.fromRGB(210, 160, 255), Parent = joinCard })
	joinDesc = UIKit.new("TextLabel", {
		Text = "",
		Size = UDim2.new(1, -20, 0, 36),
		Position = UDim2.fromOffset(10, 46),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 15,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		Parent = joinCard,
	})
	joinTimer = UIKit.Label({ Text = "", Size = UDim2.fromOffset(120, 40), Position = UDim2.new(0, 14, 1, -52), TextXAlignment = Enum.TextXAlignment.Left, Parent = joinCard })
	joinButton = UIKit.Button({
		Text = "JOIN! 🎮",
		Color = Theme.Green,
		Size = UDim2.fromOffset(200, 48),
		Position = UDim2.new(1, -214, 1, -58),
		Parent = joinCard,
		Callback = function()
			if not player:GetAttribute("MinigameJoined") then
				Remotes.MinigameJoin:FireServer()
			end
		end,
	})
	player:GetAttributeChangedSignal("MinigameJoined"):Connect(function()
		if player:GetAttribute("MinigameJoined") then
			joinButton.Text = "JOINED ✓"
			joinButton.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
		else
			joinButton.Text = "JOIN! 🎮"
			joinButton.BackgroundColor3 = Theme.Green
		end
	end)

	-- in-game bar (top)
	playBar = UIKit.new("Frame", {
		Size = UDim2.fromOffset(420, 40),
		Position = UDim2.new(0.5, 0, 0, 166),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	UIKit.Corner(playBar, 12)
	UIKit.Stroke(playBar, Theme.Purple, 2)
	playText = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Parent = playBar })

	countdownLabel = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(400, 180),
		Position = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = Theme.Accent,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	UIKit.new("UIScale", { Parent = countdownLabel })

	-- results
	resultsFrame = UIKit.new("Frame", {
		Size = UDim2.fromOffset(460, 340),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	UIKit.Corner(resultsFrame, 18)
	UIKit.Stroke(resultsFrame, Theme.Purple, 4)
	UIKit.Gradient(resultsFrame, Theme.PanelLight, Theme.Panel, 90)
	UIKit.new("UIScale", { Name = "PopScale", Parent = resultsFrame })
	UIKit.Label({ Name = "Title", Text = "RESULTS", Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 10), TextColor3 = Color3.fromRGB(210, 160, 255), ZIndex = 11, Parent = resultsFrame })
	resultsList = UIKit.new("Frame", { Size = UDim2.new(1, -30, 1, -70), Position = UDim2.fromOffset(15, 60), BackgroundTransparency = 1, ZIndex = 11, Parent = resultsFrame })
	UIKit.List(resultsList, 6)
end

local function showJoin(visible: boolean)
	TweenService:Create(joinCard, TweenInfo.new(0.4, Enum.EasingStyle.Back, visible and Enum.EasingDirection.Out or Enum.EasingDirection.In), {
		Position = visible and UDim2.new(0.5, 0, 1, -20) or UDim2.new(0.5, 0, 1, 200),
	}):Play()
end

local function showResults(state)
	for _, child in resultsList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	(resultsFrame:FindFirstChild("Title") :: TextLabel).Text = "🏆 " .. state.Name .. " RESULTS"
	local mine = false
	for i, r in state.Results do
		if i > 6 then
			break
		end
		local row = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = r.Winner and Color3.fromRGB(80, 70, 30) or Theme.PanelLight, LayoutOrder = i, ZIndex = 11, Parent = resultsList })
		UIKit.Corner(row, 8)
		UIKit.Label({ Text = (r.Winner and "👑 " or "") .. r.Name, Size = UDim2.new(0.45, 0, 1, -8), Position = UDim2.fromOffset(10, 4), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, Parent = row })
		UIKit.Label({ Text = tostring(r.Score), Size = UDim2.new(0.2, 0, 1, -8), Position = UDim2.new(0.47, 0, 0, 4), Font = Theme.BodyFont, ZIndex = 12, Parent = row })
		UIKit.Label({ Text = "+" .. Util.Money(r.Reward), Size = UDim2.new(0.3, -10, 1, -8), Position = UDim2.new(0.7, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Green, ZIndex = 12, Parent = row })
		if r.Name == player.DisplayName then
			mine = true
		end
	end
	if not mine then
		return -- don't pop the results for people who didn't play
	end
	UIKit.Open(resultsFrame)
	task.delay(6, function()
		UIKit.Close(resultsFrame)
	end)
end

function Minigame:Init(controllers)
	C = controllers
	buildUI()

	Remotes.MinigameState.OnClientEvent:Connect(function(state)
		local phase = state.Phase
		if phase == "Intermission" then
			timerPill.Text = "🎮 Next minigame: " .. Util.Clock(state.TimeLeft)
			playBar.Visible = false
			if lastPhase == "Join" then
				showJoin(false)
			end
		elseif phase == "Join" then
			timerPill.Text = "🎮 " .. state.Name .. " starting!"
			joinTitle.Text = "🎮 " .. state.Name:upper()
			joinDesc.Text = state.Description
			joinTimer.Text = "⏱ " .. state.TimeLeft .. "s"
			if lastPhase ~= "Join" then
				showJoin(true)
				UIKit.PlaySound("Notify", 0.6, 1.2)
			end
		elseif phase == "Cancelled" then
			showJoin(false)
			C.Notifications:Toast(state.Name .. " cancelled: " .. (state.Text or ""), "info")
		elseif phase == "Countdown" then
			showJoin(false)
			if player:GetAttribute("InMinigame") then
				countdownLabel.Visible = true
				countdownLabel.Text = state.Count > 0 and tostring(state.Count) or "GO!"
				countdownLabel.TextColor3 = state.Count > 0 and Theme.Accent or Theme.Green
				local scale = countdownLabel:FindFirstChildOfClass("UIScale") :: UIScale
				scale.Scale = 2
				TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				UIKit.PlaySound("Countdown", 0.6, state.Count > 0 and 1 or 1.5)
				if state.Count == 0 then
					task.delay(0.8, function()
						countdownLabel.Visible = false
					end)
				end
			end
			timerPill.Text = "🎮 " .. state.Name .. " in progress"
		elseif phase == "Playing" then
			timerPill.Text = "🎮 " .. state.Name .. " in progress"
			if player:GetAttribute("InMinigame") then
				playBar.Visible = true
				local score = player:GetAttribute("MinigameScore")
				local scoreText = (score and score > 0) and ("  •  🪙 " .. score) or ""
				playText.Text = string.format("%s  •  ⏱ %s  •  👥 %d alive%s", state.Name, Util.Clock(state.TimeLeft), state.Alive or 0, scoreText)
			else
				playBar.Visible = false
			end
		elseif phase == "Results" then
			playBar.Visible = false
			showResults(state)
		end
		lastPhase = phase
	end)
end

return Minigame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Music</string>
            <string name="Source"><![CDATA[--[[
	Music - background playlist with a now-playing widget (skip / mute).
	Switches to the minigame playlist while you're in a minigame and
	supports admin "DJ" overrides (;music <id>).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Music = {}
local C

local sound: Sound
local volume = Config.Music.DefaultVolume
local muted = false
local mode = "Lobby" -- Lobby | Minigame | Override
local override = nil
local index = 0
local generation = 0
local failures = 0
local titleLabel: TextLabel
local widget: Frame

local function targetVolume()
	return muted and 0 or volume
end

function Music:Init(controllers)
	C = controllers
	sound = Instance.new("Sound")
	sound.Name = "BackgroundMusic"
	sound.Volume = 0
	sound.Looped = false
	sound.Parent = SoundService

	-- widget (bottom left)
	widget = UIKit.new("Frame", {
		Name = "MusicWidget",
		Size = UDim2.fromOffset(250, 44),
		Position = UDim2.new(0, 12, 1, -12),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.15,
		Parent = C.UI.Gui,
	})
	UIKit.Corner(widget, 12)
	UIKit.Stroke(widget, Color3.new(0, 0, 0), 2, 0.3)
	local note = UIKit.Label({ Text = "🎵", Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(8, 7), Parent = widget })
	note:AddTag("UISpin")
	titleLabel = UIKit.Label({
		Text = "Loading music...",
		Size = UDim2.new(1, -130, 0, 22),
		Position = UDim2.fromOffset(42, 11),
		Font = Theme.BodyFont,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = widget,
	})
	UIKit.Button({
		Text = "⏭",
		Color = Theme.Accent2,
		Size = UDim2.fromOffset(36, 32),
		Position = UDim2.new(1, -82, 0, 6),
		Parent = widget,
		Callback = function()
			if mode == "Override" then
				mode = player:GetAttribute("InMinigame") and "Minigame" or "Lobby"
			end
			self:Next()
		end,
	})
	local muteButton
	muteButton = UIKit.Button({
		Text = "🔊",
		Color = Theme.Purple,
		Size = UDim2.fromOffset(36, 32),
		Position = UDim2.new(1, -42, 0, 6),
		Parent = widget,
		Callback = function()
			muted = not muted
			muteButton.Text = muted and "🔇" or "🔊"
			TweenService:Create(sound, TweenInfo.new(0.3), { Volume = targetVolume() }):Play()
		end,
	})

	Remotes.Music.OnClientEvent:Connect(function(action, params)
		if action == "play" and params and params.Id then
			override = params
			mode = "Override"
			self:Play(params.Id, params.Name)
		elseif action == "resume" then
			override = nil
			mode = player:GetAttribute("InMinigame") and "Minigame" or "Lobby"
			self:Next()
		end
	end)

	player:GetAttributeChangedSignal("InMinigame"):Connect(function()
		if mode == "Override" then
			return
		end
		local newMode = player:GetAttribute("InMinigame") and "Minigame" or "Lobby"
		if newMode ~= mode then
			mode = newMode
			index = 0
			self:Next()
		end
	end)

	player:GetAttributeChangedSignal("MusicVolume"):Connect(function()
		local v = player:GetAttribute("MusicVolume")
		if type(v) == "number" then
			self:SetVolume(v, true)
		end
	end)

	sound.Ended:Connect(function()
		if mode == "Override" and override then
			sound:Play()
		else
			self:Next()
		end
	end)
end

function Music:SetVolume(v: number, fromServer: boolean?)
	volume = math.clamp(v, 0, 1)
	sound.Volume = targetVolume()
	if not fromServer then
		Remotes.SaveSettings:FireServer({ MusicVolume = volume })
	end
end

function Music:GetVolume()
	return volume
end

function Music:SetWidgetVisible(visible: boolean)
	widget.Visible = visible
end

function Music:Play(id: string, name: string?)
	generation += 1
	local myGen = generation
	TweenService:Create(sound, TweenInfo.new(0.6), { Volume = 0 }):Play()
	task.wait(0.6)
	if myGen ~= generation then
		return
	end
	sound:Stop()
	sound.SoundId = id
	sound.TimePosition = 0
	sound:Play()
	titleLabel.Text = name or "Unknown Track"
	TweenService:Create(sound, TweenInfo.new(1.2), { Volume = targetVolume() }):Play()

	-- skip tracks that fail to load
	task.delay(8, function()
		if myGen ~= generation then
			return
		end
		if not sound.IsLoaded or sound.TimeLength == 0 then
			failures += 1
			if mode == "Override" then
				-- a DJ track that doesn't load: back to the normal playlist
				override = nil
				mode = player:GetAttribute("InMinigame") and "Minigame" or "Lobby"
			end
			local playlist = Config.Music[mode] or Config.Music.Lobby
			if failures >= #playlist + 1 then
				titleLabel.Text = "No music (set IDs in Config)"
				return
			end
			self:Next()
		else
			failures = 0
		end
	end)
end

function Music:Next()
	local playlist = Config.Music[mode == "Override" and "Lobby" or mode] or Config.Music.Lobby
	if #playlist == 0 then
		titleLabel.Text = "No music"
		return
	end
	index = index % #playlist + 1
	local track = playlist[index]
	task.spawn(self.Play, self, track.Id, track.Name)
end

function Music:Start()
	local v = player:GetAttribute("MusicVolume")
	if type(v) == "number" then
		volume = v
	end
	-- wait for the loading screen (with a safety timeout)
	local waited = 0
	while not player:GetAttribute("LoadingDone") and waited < 45 do
		waited += task.wait(0.25)
	end
	index = math.random(0, math.max(#Config.Music.Lobby - 1, 0))
	self:Next()
end

return Music
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Notifications</string>
            <string name="Source"><![CDATA[--[[ Notifications - toast messages (top right) + big announcement banners ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local Theme = UIKit.Theme
local player = Players.LocalPlayer

local Notifications = {}
local C
local holder: Frame
local bannerQueue = {}
local bannerBusy = false

local TYPE_COLORS = {
	success = Theme.Green,
	error = Theme.Red,
	info = Theme.Accent2,
	warning = Theme.Accent,
}
local TYPE_ICONS = {
	success = "✅",
	error = "❌",
	info = "💬",
	warning = "⚠️",
}

function Notifications:Init(controllers)
	C = controllers
	holder = UIKit.new("Frame", {
		Name = "Toasts",
		Size = UDim2.new(0, 340, 1, -80),
		Position = UDim2.new(1, -16, 0, 70),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Parent = C.UI.FX,
	})
	local layout = UIKit.List(holder, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top

	-- messages that arrive while the loading screen is up (welcome, offline
	-- earnings...) wait for it, or nobody would ever see them
	local function afterLoading(fn)
		if player:GetAttribute("LoadingDone") then
			fn()
			return
		end
		task.spawn(function()
			local waited = 0
			while not player:GetAttribute("LoadingDone") and waited < 45 do
				waited += task.wait(0.25)
			end
			fn()
		end)
	end
	Remotes.Notify.OnClientEvent:Connect(function(data)
		afterLoading(function()
			self:Toast(data.Text, data.Type, data.Duration)
		end)
	end)
	Remotes.Announce.OnClientEvent:Connect(function(data)
		afterLoading(function()
			self:Banner(data.Title, data.Text, data.Color)
		end)
	end)
end

local order = 0
function Notifications:Toast(text: string, kind: string?, duration: number?)
	kind = kind or "info"
	order += 1
	local color = TYPE_COLORS[kind] or Theme.Accent2
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.05,
		LayoutOrder = order,
		Parent = holder,
	})
	UIKit.Corner(frame, 10)
	UIKit.Stroke(frame, color, 2.5)
	UIKit.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = frame })
	UIKit.new("Frame", { Size = UDim2.new(0, 5, 1, 0), Position = UDim2.new(0, -8, 0, 0), BackgroundColor3 = color, BorderSizePixel = 0, Parent = frame })
	local label = UIKit.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = (TYPE_ICONS[kind] or "") .. "  " .. tostring(text),
		TextWrapped = true,
		TextSize = 17,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local scale = UIKit.new("UIScale", { Scale = 0.5, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	UIKit.PlaySound(kind == "error" and "Error" or "Notify", kind == "error" and 0.3 or 0.25)

	-- keep the list short
	local toasts = {}
	for _, child in holder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 5 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end

	task.delay(duration or 4, function()
		if not frame.Parent then
			return
		end
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
		TweenService:Create(frame, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
		task.wait(0.25)
		frame:Destroy()
	end)
end

local MAX_QUEUED_BANNERS = 3

function Notifications:Banner(title: string, text: string?, color: Color3?)
	table.insert(bannerQueue, { title, text, color })
	-- a busy server can announce a lot: keep only the newest few (old news is stale)
	while #bannerQueue > MAX_QUEUED_BANNERS do
		table.remove(bannerQueue, 1)
	end
	if bannerBusy then
		return
	end
	bannerBusy = true
	while #bannerQueue > 0 do
		local item = table.remove(bannerQueue, 1)
		self:_showBanner(item[1], item[2], item[3])
	end
	bannerBusy = false
end

function Notifications:_showBanner(title: string, text: string?, color: Color3?)
	color = color or Theme.Accent
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(0.6, 0, 0, 96),
		Position = UDim2.new(0.5, 0, 0, -120),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Panel,
		Parent = C.UI.FX,
	})
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(720, 96), MinSize = Vector2.new(300, 80), Parent = frame })
	UIKit.Corner(frame, 16)
	UIKit.Stroke(frame, color :: Color3, 3)
	UIKit.Gradient(frame, Theme.PanelLight, Theme.Panel, 90)
	local shine = UIKit.new("Frame", { Size = UDim2.new(0.25, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = frame })
	UIKit.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 1) }), Parent = shine })
	frame.ClipsDescendants = true
	UIKit.Label({ Text = title, Size = UDim2.new(1, -24, 0, 44), Position = UDim2.fromOffset(12, 8), TextColor3 = color, Parent = frame })
	UIKit.Label({ Text = text or "", Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 54), Font = Theme.BodyFont, TextColor3 = Theme.Text, Parent = frame })
	UIKit.PlaySound("Notify", 0.4, 0.8)

	TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 70) }):Play()
	shine.Position = UDim2.new(-0.3, 0, 0, 0)
	TweenService:Create(shine, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Position = UDim2.new(1.1, 0, 0, 0) }):Play()
	-- shorter when more banners are waiting
	local shown = 0
	while shown < 4.5 and not (shown >= 2.2 and #bannerQueue > 0) do
		shown += task.wait(0.1)
	end
	local out = TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -130) })
	out:Play()
	out.Completed:Wait()
	frame:Destroy()
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--[[ Panels - Rebirth, Daily Rewards, Codes and Settings menus ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)
local TycoonItems = require(Shared.TycoonItems)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Panels = {}
local C

---------------------------------------------------------------------------
local function buildRebirth()
	local _, panel = C.UI:MakePanel("Rebirth", "🔄 REBIRTH", Theme.Purple, 560, 520)
	local content = UIKit.Scroll({ Parent = panel })
	UIKit.List(content, 12)
	local current = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, ZIndex = 7, Parent = content })
	local arrow = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 2, TextColor3 = Color3.fromRGB(120, 255, 150), ZIndex = 7, Parent = content })
	UIKit.new("TextLabel", {
		Text = "Rebirthing resets your cash and tycoon, but gives you a PERMANENT cash multiplier.",
		Size = UDim2.new(1, -20, 0, 44),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 16,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		LayoutOrder = 3,
		ZIndex = 7,
		Parent = content,
	})
	local barBack = UIKit.new("Frame", { Size = UDim2.new(0.9, 0, 0, 34), BackgroundColor3 = Theme.Background, LayoutOrder = 4, ZIndex = 7, Parent = content })
	UIKit.Corner(barBack, 10)
	UIKit.Stroke(barBack, Color3.new(0, 0, 0), 2)
	local barFill = UIKit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Purple, ZIndex = 8, Parent = barBack })
	UIKit.Corner(barFill, 10)
	UIKit.Gradient(barFill, Color3.fromRGB(220, 160, 255), Theme.Purple, 90)
	local barText = UIKit.Label({ Text = "", Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), ZIndex = 9, Parent = barBack })

	local confirming = false
	local button
	button = UIKit.Button({
		Text = "REBIRTH",
		Color = Theme.Purple,
		Size = UDim2.fromOffset(240, 56),
		LayoutOrder = 5,
		ZIndex = 7,
		Parent = content,
		Callback = function()
			if player:GetAttribute("DuoHost") then
				C.Notifications:Toast("Only the tower owner can rebirth. Leave the duo to rebirth your own tower.", "error")
				return
			end
			local cash = player:GetAttribute("Cash") or 0
			local cost = player:GetAttribute("RebirthCost") or math.huge
			if cash < cost then
				C.Notifications:Toast("You need " .. Util.Money(cost - cash) .. " more!", "error")
				return
			end
			if not confirming then
				confirming = true
				button.Text = "ARE YOU SURE?"
				task.delay(3, function()
					confirming = false
					button.Text = "REBIRTH"
				end)
				return
			end
			confirming = false
			button.Text = "REBIRTH"
			Remotes.RequestRebirth:FireServer()
			C.UI:Close()
		end,
	})

	-- the rebirth ranks and their perks
	local ranksFrame = UIKit.new("Frame", { Name = "Ranks", Size = UDim2.new(1, -10, 0, #Config.Rebirth.Ranks * 28), BackgroundTransparency = 1, LayoutOrder = 6, ZIndex = 7, Parent = content })
	UIKit.List(ranksFrame, 4)
	local rankLabels = {}
	for i, rank in Config.Rebirth.Ranks do
		rankLabels[i] = UIKit.Label({
			Name = "Rank" .. i,
			Text = "",
			Size = UDim2.new(1, 0, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			LayoutOrder = i,
			ZIndex = 7,
			Parent = ranksFrame,
		})
	end

	local function refresh()
		local rebirths = player:GetAttribute("Rebirths") or 0
		local per = Config.Rebirth.MultiplierPerRebirth
		for i, rank in Config.Rebirth.Ranks do
			local label = rankLabels[i]
			local earned = rebirths >= rank.Rebirths
			label.Text = (earned and "✅ " or "🔒 ") .. rank.Rebirths .. " · " .. rank.Icon .. " " .. rank.Name .. " - " .. rank.Text
			label.TextColor3 = earned and Color3.fromRGB(150, 255, 160) or Theme.SubText
		end
		local cost = player:GetAttribute("RebirthCost") or TycoonItems.GetRebirthCost(rebirths)
		local cash = player:GetAttribute("Cash") or 0
		local _, rank = Config.RebirthRank(rebirths)
		current.Text = "Rebirths: " .. rebirths .. (rank and ("  ·  " .. rank.Icon .. " " .. rank.Name) or "")
		arrow.Text = string.format("x%s  ➜  x%s rebirth bonus", tostring(1 + rebirths * per + Config.RebirthPerk(rebirths, "Income")), tostring(1 + (rebirths + 1) * per + Config.RebirthPerk(rebirths + 1, "Income")))
		local alpha = math.clamp(cash / cost, 0, 1)
		TweenService:Create(barFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(alpha, 1) }):Play()
		barText.Text = Util.Money(cash) .. " / " .. Util.Money(cost)
		button.BackgroundColor3 = alpha >= 1 and Theme.Purple or Color3.fromRGB(90, 90, 110)
	end
	player:GetAttributeChangedSignal("Cash"):Connect(refresh)
	player:GetAttributeChangedSignal("Rebirths"):Connect(refresh)
	C.UI.Panels.Rebirth.OnOpen = refresh
	refresh()
end

---------------------------------------------------------------------------
local function buildDaily()
	local _, content = C.UI:MakePanel("Daily", "🎁 DAILY REWARDS", Color3.fromRGB(255, 90, 120), 760, 420)
	local row = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 170), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	local layout = UIKit.List(row, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	local cards = {}
	for day, amount in Config.Daily.Rewards do
		local cardFrame = UIKit.new("Frame", { Size = UDim2.new(1 / #Config.Daily.Rewards, -8, 0, 150), BackgroundColor3 = Theme.PanelLight, LayoutOrder = day, ZIndex = 7, Parent = row })
		UIKit.Corner(cardFrame, 12)
		local stroke = UIKit.Stroke(cardFrame, Theme.Background, 3)
		UIKit.Label({ Text = "Day " .. day, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 6), ZIndex = 8, Parent = cardFrame })
		UIKit.Label({ Text = day == #Config.Daily.Rewards and "💎" or "💵", Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 36), ZIndex = 8, Parent = cardFrame })
		UIKit.Label({ Text = Util.Money(amount), Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 100), TextColor3 = Color3.fromRGB(120, 255, 150), ZIndex = 8, Parent = cardFrame })
		cards[day] = { Frame = cardFrame, Stroke = stroke }
	end
	UIKit.Button({
		Name = "WeeklyButton",
		Text = "📅 WEEKLY REWARDS ▶",
		Color = Theme.Purple,
		Size = UDim2.fromOffset(260, 40),
		Position = UDim2.new(0.5, 0, 0, 322),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 7,
		Parent = content,
		Callback = function()
			C.UI:Open("Weekly")
		end,
	})
	local status = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 184), Font = Theme.BodyFont, ZIndex = 7, Parent = content })
	UIKit.Label({
		Text = "Rewards scale with your rebirths. VIP gets double!",
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 216),
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		ZIndex = 7,
		Parent = content,
	})
	local claim = UIKit.Button({
		Text = "CLAIM",
		Color = Theme.Green,
		Size = UDim2.fromOffset(240, 56),
		Position = UDim2.new(0.5, 0, 0, 250),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 7,
		Parent = content,
		Callback = function()
			local ok, message = Remotes.ClaimDaily:InvokeServer()
			C.Notifications:Toast(message, ok and "success" or "error")
		end,
	})

	local function refresh()
		local streak = player:GetAttribute("DailyStreak") or 0
		local last = player:GetAttribute("LastDaily") or 0
		local since = Util.ServerNow() - last
		local available = since >= Config.Daily.Cooldown
		local nextDay = streak
		if available then
			nextDay = since > Config.Daily.StreakResetAfter and 1 or streak + 1
		end
		local highlight = ((math.max(nextDay, 1) - 1) % #Config.Daily.Rewards) + 1
		for day, cardInfo in cards do
			cardInfo.Stroke.Color = day == highlight and Theme.Accent or Theme.Background
			cardInfo.Frame.BackgroundColor3 = day == highlight and Color3.fromRGB(70, 60, 30) or Theme.PanelLight
		end
		if available then
			status.Text = "Your reward is ready! 🎉"
			claim.Text = "CLAIM"
			claim.BackgroundColor3 = Theme.Green
		else
			status.Text = "Streak: " .. streak .. " days"
			claim.Text = Util.FormatTime(Config.Daily.Cooldown - since)
			claim.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
		end
	end
	C.UI.Panels.Daily.OnOpen = function()
		while C.UI.Current == "Daily" do
			refresh()
			task.wait(1)
		end
	end
	refresh()
end

---------------------------------------------------------------------------
local function buildCodes()
	local _, content = C.UI:MakePanel("Codes", "🎟️ CODES", Theme.Accent2, 520, 340)
	UIKit.List(content, 14)
	UIKit.Label({ Text = "Enter a code for free rewards!", Size = UDim2.new(1, 0, 0, 30), Font = Theme.BodyFont, LayoutOrder = 1, ZIndex = 7, Parent = content })
	local box = UIKit.TextBox({ Placeholder = "Type code here...", Size = UDim2.new(0.85, 0, 0, 50), LayoutOrder = 2, ZIndex = 7, Parent = content })
	local result = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 26), Font = Theme.BodyFont, LayoutOrder = 4, ZIndex = 7, Parent = content })
	UIKit.Button({
		Text = "REDEEM",
		Color = Theme.Accent2,
		Size = UDim2.fromOffset(220, 52),
		LayoutOrder = 3,
		ZIndex = 7,
		Parent = content,
		Callback = function()
			if box.Text == "" then
				return
			end
			local ok, message = Remotes.RedeemCode:InvokeServer(box.Text)
			result.Text = message
			result.TextColor3 = ok and Theme.Green or Theme.Red
			if ok then
				box.Text = ""
			end
		end,
	})
	UIKit.Label({ Text = "Follow the game for new codes!", Size = UDim2.new(1, 0, 0, 20), Font = Theme.BodyFont, TextColor3 = Theme.SubText, LayoutOrder = 5, ZIndex = 7, Parent = content })
end

---------------------------------------------------------------------------
local function buildSettings()
	local _, content = C.UI:MakePanel("Settings", "⚙️ SETTINGS", Color3.fromRGB(130, 140, 160), 520, 520)
	UIKit.List(content, 10)

	local function row(order: number, text: string)
		local frame = UIKit.new("Frame", { Size = UDim2.new(1, -20, 0, 52), BackgroundColor3 = Theme.PanelLight, LayoutOrder = order, ZIndex = 7, Parent = content })
		UIKit.Corner(frame, 10)
		UIKit.Label({ Text = text, Size = UDim2.new(0.5, 0, 1, -16), Position = UDim2.fromOffset(14, 8), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = frame })
		return frame
	end

	-- music volume
	local volRow = row(1, "🎵 Music Volume")
	local volLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(60, 30), Position = UDim2.new(1, -150, 0, 11), ZIndex = 8, Parent = volRow })
	local function updateVol()
		volLabel.Text = math.floor(C.Music:GetVolume() * 100 + 0.5) .. "%"
	end
	UIKit.Button({ Text = "-", Color = Theme.Red, Size = UDim2.fromOffset(40, 36), Position = UDim2.new(1, -196, 0, 8), ZIndex = 8, Parent = volRow, Callback = function()
		C.Music:SetVolume(C.Music:GetVolume() - 0.1)
		updateVol()
	end })
	UIKit.Button({ Text = "+", Color = Theme.Green, Size = UDim2.fromOffset(40, 36), Position = UDim2.new(1, -84, 0, 8), ZIndex = 8, Parent = volRow, Callback = function()
		C.Music:SetVolume(C.Music:GetVolume() + 0.1)
		updateVol()
	end })
	updateVol()

	local function toggle(order: number, text: string, initial: boolean, onChange: (boolean) -> ())
		local frame = row(order, text)
		local state = initial
		local button
		button = UIKit.Button({
			Text = state and "ON" or "OFF",
			Color = state and Theme.Green or Theme.Red,
			Size = UDim2.fromOffset(90, 36),
			Position = UDim2.new(1, -104, 0, 8),
			ZIndex = 8,
			Parent = frame,
			Callback = function()
				state = not state
				button.Text = state and "ON" or "OFF"
				button.BackgroundColor3 = state and Theme.Green or Theme.Red
				onChange(state)
			end,
		})
		return function(value: boolean)
			state = value
			button.Text = state and "ON" or "OFF"
			button.BackgroundColor3 = state and Theme.Green or Theme.Red
		end
	end

	-- toggles start from the saved settings (player attributes from the server)
	local setSfx = toggle(2, "🔊 Sound Effects", player:GetAttribute("SFX") ~= false, function(on)
		UIKit.SFXEnabled = on
		Remotes.SaveSettings:FireServer({ SFX = on })
	end)
	toggle(3, "🎶 Music Widget", true, function(on)
		C.Music:SetWidgetVisible(on)
	end)
	local setLow = toggle(4, "🥔 Low Graphics", player:GetAttribute("LowGraphics") == true, function(on)
		C.Animator:SetLowGraphics(on)
		Remotes.SaveSettings:FireServer({ LowGraphics = on })
	end)
	player:GetAttributeChangedSignal("LowGraphics"):Connect(function()
		setLow(player:GetAttribute("LowGraphics") == true)
	end)
	local setGuide = toggle(5, "🧭 Guide Arrow", player:GetAttribute("Guide") ~= false, function(on)
		player:SetAttribute("Guide", on) -- instant locally; the server saves it
		Remotes.SaveSettings:FireServer({ Guide = on })
	end)
	player:GetAttributeChangedSignal("Guide"):Connect(function()
		setGuide(player:GetAttribute("Guide") ~= false)
	end)

	-- Auto Builder (game pass): ON/OFF when owned, otherwise a shortcut to the shop
	local autoRow = row(6, "🤖 Auto Builder")
	local autoButton
	local function refreshAuto()
		if player:GetAttribute("Pass_AutoBuild") then
			local on = player:GetAttribute("AutoBuild") ~= false
			autoButton.Text = on and "ON" or "OFF"
			autoButton.BackgroundColor3 = on and Theme.Green or Theme.Red
		else
			autoButton.Text = "GET"
			autoButton.BackgroundColor3 = Theme.Accent
		end
	end
	autoButton = UIKit.Button({
		Text = "GET",
		Color = Theme.Accent,
		Size = UDim2.fromOffset(90, 36),
		Position = UDim2.new(1, -104, 0, 8),
		ZIndex = 8,
		Parent = autoRow,
		Callback = function()
			if not player:GetAttribute("Pass_AutoBuild") then
				C.UI:Open("Shop")
				return
			end
			local on = player:GetAttribute("AutoBuild") == false
			player:SetAttribute("AutoBuild", on)
			Remotes.SaveSettings:FireServer({ AutoBuild = on })
			refreshAuto()
		end,
	})
	player:GetAttributeChangedSignal("Pass_AutoBuild"):Connect(refreshAuto)
	player:GetAttributeChangedSignal("AutoBuild"):Connect(refreshAuto)
	refreshAuto()

	UIKit.Label({ Text = Config.GameName .. " v" .. Config.Version, Size = UDim2.new(1, 0, 0, 20), Font = Theme.BodyFont, TextColor3 = Theme.SubText, LayoutOrder = 9, ZIndex = 7, Parent = content })

	player:GetAttributeChangedSignal("SFX"):Connect(function()
		local on = player:GetAttribute("SFX") ~= false
		UIKit.SFXEnabled = on
		setSfx(on)
	end)
	C.UI.Panels.Settings.OnOpen = updateVol
end

---------------------------------------------------------------------------
local function buildSecrets()
	local _, content = C.UI:MakePanel("Secrets", "🕵️ SECRETS", Color3.fromRGB(90, 190, 110), 820, 560)
	local header = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Font = Theme.BodyFont, ZIndex = 7, Parent = content })
	local scroll = UIKit.Scroll({ Size = UDim2.new(1, 0, 1, -40), Position = UDim2.fromOffset(0, 40), Parent = content })
	local grid = UIKit.new("UIGridLayout", { CellSize = UDim2.new(0.31, 0, 0, 120), CellPadding = UDim2.new(0.02, 0, 0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local cards = {}
	for i, secret in Config.Secrets do
		local card = UIKit.new("Frame", { BackgroundColor3 = Theme.PanelLight, LayoutOrder = i, ZIndex = 7, Parent = scroll })
		UIKit.Corner(card, 12)
		local stroke = UIKit.Stroke(card, Theme.Background, 3)
		local icon = UIKit.Label({ Text = "❔", Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 6), ZIndex = 8, Parent = card })
		local name = UIKit.Label({ Text = "???", Size = UDim2.new(1, -12, 0, 24), Position = UDim2.fromOffset(6, 48), ZIndex = 8, Parent = card })
		local hint = UIKit.new("TextLabel", {
			Text = secret.Hint,
			Size = UDim2.new(1, -12, 0, 40),
			Position = UDim2.fromOffset(6, 74),
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextSize = 13,
			Font = Theme.BodyFont,
			TextColor3 = Theme.SubText,
			ZIndex = 8,
			Parent = card,
		})
		cards[secret.Id] = { Stroke = stroke, Icon = icon, Name = name, Hint = hint, Secret = secret }
	end
	local function refresh()
		local found = {}
		for _, id in string.split(player:GetAttribute("SecretsFound") or "", ",") do
			if id ~= "" then
				found[id] = true
			end
		end
		local count = 0
		for id, card in cards do
			local isFound = found[id] == true
			if isFound then
				count += 1
			end
			card.Icon.Text = isFound and "💎" or "❔"
			card.Name.Text = isFound and card.Secret.Name or "???"
			card.Name.TextColor3 = isFound and card.Secret.Color or Theme.Text
			card.Stroke.Color = isFound and card.Secret.Color or Theme.Background
			card.Hint.Text = isFound and "Found! Relic built in your tower." or ("Hint: " .. card.Secret.Hint)
		end
		header.Text = string.format("Found %d / %d   •   +%d%% income from secrets", count, #Config.Secrets, count * (Config.SecretRewards.BonusPercent or 5))
	end
	player:GetAttributeChangedSignal("SecretsFound"):Connect(refresh)
	C.UI.Panels.Secrets.OnOpen = refresh
	refresh()
end

function Panels:Init(controllers)
	C = controllers
	buildRebirth()
	buildSecrets()
	buildDaily()
	buildCodes()
	buildSettings()
end

function Panels:Start()
	if player:GetAttribute("SFX") == false then
		UIKit.SFXEnabled = false
	end
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[--[[
	Pets (client) - the Pets panel (eggs + your pets) and the pets that float
	behind every player. Which pets a player wears comes from their "Pets"
	attribute, so everyone sees them; the visuals are made locally.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local Theme = UIKit.Theme
local PC = Config.Pets

local Pets = {}
Pets.State = nil :: any
local C

---------------------------------------------------------------------------
-- Floating pets
---------------------------------------------------------------------------
local followers: { [Player]: { Key: string, Parts: { BasePart } } } = {}

local function clearFollowers(target: Player)
	local entry = followers[target]
	if entry then
		for _, part in entry.Parts do
			part:Destroy()
		end
		followers[target] = nil
	end
end

local function makePart(petId: string): BasePart
	local pet = Config.PetById[petId]
	local part = Instance.new("Part")
	part.Name = "Pet_" .. petId
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(54, 54)
	gui.MaxDistance = 90
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Text = pet and pet.Icon or "?"
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = pet and PC.Rarities[pet.Rarity].Color or Color3.new(1, 1, 1)
	label.Parent = gui
	part.Parent = workspace
	return part
end

-- make the floating pets match a player's "Pets" attribute
local function refreshFollowers(target: Player)
	local key = tostring(target:GetAttribute("Pets") or "")
	local entry = followers[target]
	if entry and entry.Key == key then
		return
	end
	clearFollowers(target)
	if key == "" then
		return
	end
	local parts = {}
	for id in string.gmatch(key, "[^,]+") do
		table.insert(parts, makePart(id))
	end
	followers[target] = { Key = key, Parts = parts }
end

local function follow(dt: number)
	local now = os.clock()
	for target, entry in followers do
		local character = target.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local count = #entry.Parts
			for i, part in entry.Parts do
				local angle = (i - (count + 1) / 2) * 0.75
				local offset = Vector3.new(math.sin(angle) * 3.4, 1.3 + math.sin(now * 2 + i) * 0.3, 3 + math.cos(angle) * 0.6)
				local goal = root.CFrame * CFrame.new(offset)
				part.CFrame = part.CFrame:Lerp(goal, math.min(1, dt * 7))
			end
		end
	end
end

---------------------------------------------------------------------------
-- The panel
---------------------------------------------------------------------------
local infoLabel: TextLabel
local eggButtons: { [string]: { Button: TextButton, Cost: TextLabel } } = {}
local grid: ScrollingFrame

local function act(action: string, arg: any?)
	local ok, message = Remotes.PetAction:InvokeServer(action, arg)
	if message and message ~= "" then
		C.Notifications:Toast(tostring(message), ok and "success" or "error")
	end
	return ok
end

local function render()
	local state = Pets.State
	if not state then
		return
	end
	infoLabel.Text = string.format("🐾 %d/%d equipped  •  +%sx income  •  %d pets", #state.Equipped, state.Slots, tostring(state.Bonus), #state.Owned)
	for _, egg in state.Eggs do
		local entry = eggButtons[egg.Id]
		if entry then
			entry.Cost.Text = Util.Money(egg.Cost)
		end
	end
	for _, child in grid:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local equipped = {}
	for _, uid in state.Equipped do
		equipped[uid] = true
	end
	-- best pets first
	local sorted = table.clone(state.Owned)
	table.sort(sorted, function(a, b)
		local ba, bb = Config.PetBonus(a.Id), Config.PetBonus(b.Id)
		if ba ~= bb then
			return ba > bb
		end
		return a.Uid < b.Uid
	end)
	for order, owned in sorted do
		local pet = Config.PetById[owned.Id]
		local rarity = PC.Rarities[pet.Rarity]
		local card = UIKit.new("Frame", { Name = "Pet" .. owned.Uid, BackgroundColor3 = equipped[owned.Uid] and Color3.fromRGB(40, 70, 45) or Theme.Panel, LayoutOrder = order, ZIndex = 7, Parent = grid })
		UIKit.Corner(card, 10)
		UIKit.Stroke(card, rarity.Color, 2, 0.1)
		UIKit.Label({ Text = pet.Icon, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 4), ZIndex = 8, Parent = card })
		UIKit.Label({ Text = pet.Name, Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 46), Font = Theme.BodyFont, ZIndex = 8, Parent = card })
		UIKit.Label({ Text = pet.Rarity .. " +" .. tostring(rarity.Bonus) .. "x", Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 62), Font = Theme.BodyFont, TextColor3 = rarity.Color, Stroke = false, ZIndex = 8, Parent = card })
		UIKit.Button({
			Name = "Equip",
			Text = equipped[owned.Uid] and "UNEQUIP" or "EQUIP",
			Color = equipped[owned.Uid] and Theme.PanelLight or Theme.Green,
			Size = UDim2.new(0.58, -6, 0, 26),
			Position = UDim2.new(0, 4, 1, -30),
			ZIndex = 8,
			Parent = card,
			Callback = function()
				act(equipped[owned.Uid] and "Unequip" or "Equip", owned.Uid)
			end,
		})
		UIKit.Button({
			Name = "Sell",
			Text = "SELL",
			Color = Theme.Red,
			Size = UDim2.new(0.42, -6, 0, 26),
			Position = UDim2.new(0.58, 2, 1, -30),
			ZIndex = 8,
			Parent = card,
			Callback = function()
				act("Sell", owned.Uid)
			end,
		})
	end
end

function Pets:Init(controllers)
	C = controllers
	local _, content = C.UI:MakePanel("Pets", "🐾 PETS", Color3.fromRGB(255, 150, 200), 760, 560, function()
		act("Refresh")
	end)
	infoLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = content })
	-- eggs
	local eggRow = UIKit.new("Frame", { Name = "Eggs", Size = UDim2.new(1, 0, 0, 110), Position = UDim2.fromOffset(0, 34), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	UIKit.List(eggRow, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left)
	for i, egg in PC.Eggs do
		local frame = UIKit.new("Frame", { Name = "Egg" .. egg.Id, Size = UDim2.new(1 / #PC.Eggs, -6, 1, 0), BackgroundColor3 = Theme.Panel, LayoutOrder = i, ZIndex = 7, Parent = eggRow })
		UIKit.Corner(frame, 10)
		UIKit.Stroke(frame, Theme.Accent, 2, 0.3)
		UIKit.Label({ Text = egg.Icon .. " " .. egg.Name, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 4), ZIndex = 8, Parent = frame })
		local cost = UIKit.Label({ Text = "...", Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 32), Font = Theme.BodyFont, TextColor3 = Color3.fromRGB(150, 255, 160), ZIndex = 8, Parent = frame })
		local odds = {}
		for _, name in PC.RarityOrder do
			if egg.Weights[name] then
				table.insert(odds, name:sub(1, 1) .. egg.Weights[name] .. "%")
			end
		end
		UIKit.Label({ Text = table.concat(odds, " "), Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 52), Font = Theme.BodyFont, TextColor3 = Theme.SubText, Stroke = false, ZIndex = 8, Parent = frame })
		local button = UIKit.Button({
			Name = "Hatch" .. egg.Id,
			Text = "HATCH",
			Color = Theme.Accent,
			Size = UDim2.new(1, -16, 0, 30),
			Position = UDim2.new(0, 8, 1, -36),
			ZIndex = 8,
			Parent = frame,
			Callback = function()
				act("Hatch", egg.Id)
			end,
		})
		eggButtons[egg.Id] = { Button = button, Cost = cost }
	end
	UIKit.Button({
		Name = "EquipBest",
		Text = "⭐ EQUIP BEST",
		Color = Theme.Green,
		Size = UDim2.fromOffset(170, 34),
		Position = UDim2.new(1, -170, 0, -2),
		ZIndex = 8,
		Parent = content,
		Callback = function()
			act("EquipBest")
		end,
	})
	grid = UIKit.Scroll({ Size = UDim2.new(1, 0, 1, -154), Position = UDim2.fromOffset(0, 152), Parent = content })
	local layout = UIKit.new("UIGridLayout", { CellSize = UDim2.fromOffset(112, 124), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	Remotes.PetUpdate.OnClientEvent:Connect(function(state)
		if type(state) == "table" then
			Pets.State = state
			render()
		end
	end)

	-- floating pets for every player
	local function watch(target: Player)
		target:GetAttributeChangedSignal("Pets"):Connect(function()
			refreshFollowers(target)
		end)
		target.CharacterAdded:Connect(function()
			refreshFollowers(target)
		end)
		refreshFollowers(target)
	end
	for _, target in Players:GetPlayers() do
		watch(target)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clearFollowers)
	RunService.Heartbeat:Connect(function(dt)
		Util.Try("Pets", follow, dt)
	end)
end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--[[ Quests (client) - the quest tracker in the bottom-right corner ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Quests = {}
Quests.List = {}
Quests.Claimed = 0
local C

local ICONS = {
	Buy = "🏗️", Earn = "💵", Collect = "🏦", Floor = "🏢", Secret = "🕵️",
	Obby = "🏃", Minigame = "🎮", Survive = "🛡️", Hatch = "🥚",
}
local ROW_HEIGHT = 58

local tracker: Frame
local title: TextLabel
local rowsFrame: Frame
local collapsed = false

local function claim(quest, button: TextButton)
	if button.Text == "..." then
		return -- already claiming
	end
	button.Text = "..."
	-- by type, not slot: slots shift when another quest is claimed first
	local ok, message = Remotes.ClaimQuest:InvokeServer(quest.Type)
	C.Notifications:Toast(tostring(message), ok and "success" or "error")
	if not ok then
		button.Text = "CLAIM"
	end
end

local function render()
	for _, child in rowsFrame:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local ready = 0
	for i, quest in Quests.List do
		if quest.Done then
			ready += 1
		end
		local row = UIKit.new("Frame", {
			Name = "Quest" .. i,
			Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
			BackgroundColor3 = quest.Done and Color3.fromRGB(40, 70, 45) or Theme.Panel,
			BackgroundTransparency = 0.1,
			LayoutOrder = i,
			Parent = rowsFrame,
		})
		UIKit.Corner(row, 10)
		UIKit.Stroke(row, quest.Done and Theme.Green or Color3.new(0, 0, 0), 2, 0.2)
		UIKit.Label({ Text = ICONS[quest.Type] or "📜", Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(6, 6), Parent = row })
		UIKit.new("TextLabel", {
			Text = quest.Text,
			Size = UDim2.new(1, quest.Done and -132 or -48, 0, 22),
			Position = UDim2.fromOffset(40, 5),
			BackgroundTransparency = 1,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			TextColor3 = Theme.Text,
			Parent = row,
		})
		local rewardText = "🎁 " .. Util.Money(quest.Reward) .. (quest.Boost and " + 2x" or "")
		if quest.Done then
			UIKit.Button({
				Name = "Claim",
				Text = "CLAIM",
				Color = Theme.Green,
				Size = UDim2.fromOffset(84, 40),
				Position = UDim2.new(1, -90, 0, 9),
				Parent = row,
				Callback = function()
					claim(quest, row:FindFirstChild("Claim") :: TextButton)
				end,
			})
			UIKit.Label({ Text = rewardText, Size = UDim2.new(1, -132, 0, 18), Position = UDim2.fromOffset(40, 32), Font = Theme.BodyFont, TextColor3 = Color3.fromRGB(150, 255, 160), TextXAlignment = Enum.TextXAlignment.Left, Stroke = false, Parent = row })
		else
			local back = UIKit.new("Frame", { Size = UDim2.new(1, -150, 0, 14), Position = UDim2.fromOffset(40, 34), BackgroundColor3 = Theme.Background, Parent = row })
			UIKit.Corner(back, 7)
			local alpha = quest.Target > 0 and math.clamp(quest.Progress / quest.Target, 0, 1) or 0
			local fill = UIKit.new("Frame", { Size = UDim2.fromScale(alpha, 1), BackgroundColor3 = Theme.Accent, Parent = back })
			UIKit.Corner(fill, 7)
			local progressText = quest.Target > 1 and (Util.Abbreviate(quest.Progress) .. "/" .. Util.Abbreviate(quest.Target)) or ""
			UIKit.Label({ Text = progressText, Size = UDim2.new(1, 0, 1, 0), Font = Theme.BodyFont, Stroke = false, Parent = back })
			UIKit.Label({ Text = rewardText, Size = UDim2.fromOffset(104, 18), Position = UDim2.new(1, -108, 0, 32), Font = Theme.BodyFont, TextColor3 = Color3.fromRGB(150, 255, 160), TextXAlignment = Enum.TextXAlignment.Right, Stroke = false, Parent = row })
		end
	end
	title.Text = (collapsed and "▸ " or "▾ ") .. "📜 QUESTS" .. (ready > 0 and ("  (" .. ready .. " ready!)") or "")
	tracker.Visible = #Quests.List > 0 and not player:GetAttribute("InMinigame")
	rowsFrame.Visible = not collapsed
	local height = 30 + (collapsed and 0 or (#Quests.List * (ROW_HEIGHT + 6)))
	TweenService:Create(tracker, TweenInfo.new(0.2), { Size = UDim2.fromOffset(300, height) }):Play()
	if C.HUD and C.HUD.SetBadge then
		C.HUD:SetBadge("Quests", ready > 0, tostring(ready))
	end
end

function Quests:ReadyCount(): number
	local n = 0
	for _, quest in self.List do
		if quest.Done then
			n += 1
		end
	end
	return n
end

function Quests:Init(controllers)
	C = controllers
	local gui = C.UI.Gui
	tracker = UIKit.new("Frame", {
		Name = "QuestTracker",
		Size = UDim2.fromOffset(300, 30),
		Position = UDim2.new(1, -12, 1, -76),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local scale = UIKit.new("UIScale", { Parent = tracker })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(vp.Y / 860, 0.6, 1.1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	local header = UIKit.new("TextButton", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		Text = "",
		Parent = tracker,
	})
	title = UIKit.Label({ Text = "📜 QUESTS", Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, Parent = header })
	header.Activated:Connect(function()
		collapsed = not collapsed
		UIKit.PlaySound("Click", 0.4)
		render()
	end)
	rowsFrame = UIKit.new("Frame", { Name = "Rows", Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30), BackgroundTransparency = 1, Parent = tracker })
	UIKit.List(rowsFrame, 6)

	Remotes.QuestUpdate.OnClientEvent:Connect(function(list, claimed)
		if type(list) == "table" then
			self.List = list
			self.Claimed = tonumber(claimed) or self.Claimed
			render()
		end
	end)
	-- out of the way during minigames
	player:GetAttributeChangedSignal("InMinigame"):Connect(function()
		tracker.Visible = #self.List > 0 and not player:GetAttribute("InMinigame")
	end)
	render()
end

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Shield</string>
            <string name="Source"><![CDATA[--[[
	Shield (client) - the personal shield panel: activate it, see how long it
	lasts and when it can be used again. Times come from the server's saved
	values, so rejoining doesn't change them.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme
local SC = Config.Shield

local Shield = {}
local C

local statusLabel: TextLabel
local activateButton: TextButton
local busy = false

-- "active" (seconds left), "recharging" (seconds left) or "ready"
function Shield:GetState(): (string, number)
	local now = Util.ServerNow()
	local untilTime = player:GetAttribute("ShieldEnd") or 0
	local readyAt = player:GetAttribute("ShieldReadyAt") or 0
	if now < untilTime then
		return "active", untilTime - now
	elseif now < readyAt then
		return "recharging", readyAt - now
	end
	return "ready", 0
end

local function refresh()
	local state, left = Shield:GetState()
	if state == "active" then
		statusLabel.Text = "🛡️ SHIELD ACTIVE - " .. Util.Clock(left) .. " left"
		statusLabel.TextColor3 = Theme.Accent2
		activateButton.Text = "ACTIVE"
		activateButton.BackgroundColor3 = Theme.PanelLight
	elseif state == "recharging" then
		statusLabel.Text = "Recharging: " .. Util.Clock(left)
		statusLabel.TextColor3 = Theme.SubText
		activateButton.Text = "RECHARGING"
		activateButton.BackgroundColor3 = Theme.PanelLight
	else
		statusLabel.Text = "Your shield is ready!"
		statusLabel.TextColor3 = Theme.Green
		activateButton.Text = "🛡️ ACTIVATE"
		activateButton.BackgroundColor3 = Theme.Green
	end
	if C.HUD and C.HUD.SetBadge then
		C.HUD:SetBadge("Shield", state == "ready")
	end
end

function Shield:Init(controllers)
	C = controllers
	local _, content = C.UI:MakePanel("Shield", "🛡️ SHIELD", Theme.Accent2, 520, 340)
	UIKit.List(content, 14)
	UIKit.new("TextLabel", {
		Text = "A shield protects you from every disaster for " .. Util.FormatTime(SC.Seconds) .. ", wherever you are. It recharges for " .. Util.FormatTime(SC.Cooldown) .. " after you use it - leaving and rejoining doesn't reset that.",
		Size = UDim2.new(1, -20, 0, 90),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 18,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		LayoutOrder = 1,
		ZIndex = 7,
		Parent = content,
	})
	statusLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 2, ZIndex = 7, Parent = content })
	activateButton = UIKit.Button({
		Name = "ActivateShield",
		Text = "...",
		Color = Theme.Green,
		Size = UDim2.fromOffset(280, 56),
		LayoutOrder = 3,
		ZIndex = 7,
		Parent = content,
		Callback = function()
			if busy or Shield:GetState() ~= "ready" then
				return
			end
			busy = true
			local ok, message = Remotes.ActivateShield:InvokeServer()
			busy = false
			C.Notifications:Toast(tostring(message), ok and "success" or "error")
			refresh()
		end,
	})
	player:GetAttributeChangedSignal("ShieldEnd"):Connect(refresh)
	player:GetAttributeChangedSignal("ShieldReadyAt"):Connect(refresh)
	refresh()
end

function Shield:Start()
	while true do
		task.wait(1)
		Util.Try("Shield", refresh)
	end
end

return Shield
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--[[ Shop - Robux panel with Game Passes and Developer Products ]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme
local ROBUX = utf8.char(0xE002)

local Shop = {}
local C

local function sorted(map)
	local list = {}
	for key, value in map do
		table.insert(list, { Key = key, Data = value })
	end
	table.sort(list, function(a, b)
		return (a.Data.Order or 0) < (b.Data.Order or 0)
	end)
	return list
end

local function card(parent: Instance, order: number, data, isPass: boolean, key: string)
	local accent: Color3 = data.Color or (isPass and Theme.Accent or Theme.Green)
	local frame = UIKit.new("Frame", {
		Name = key,
		BackgroundColor3 = Theme.PanelLight,
		LayoutOrder = order,
		ZIndex = 6,
		Parent = parent,
	})
	UIKit.Corner(frame, 14)
	UIKit.Stroke(frame, accent, 3)
	UIKit.Gradient(frame, Theme.PanelLight, Theme.Panel, 90)

	local icon = UIKit.Label({ Text = data.Icon or "⭐", Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 8), ZIndex = 7, Parent = frame })
	icon:AddTag("UISpin")
	UIKit.Label({ Text = data.Name, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 70), TextColor3 = accent, ZIndex = 7, Parent = frame })
	UIKit.new("TextLabel", {
		Text = data.Description or "",
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 100),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 14,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 7,
		Parent = frame,
	})
	local button = UIKit.Button({
		Text = ROBUX .. " " .. tostring(data.PriceHint or "?"),
		Color = Theme.Green,
		Size = UDim2.new(1, -24, 0, 42),
		Position = UDim2.new(0, 12, 1, -52),
		ZIndex = 7,
		Parent = frame,
		Callback = function()
			if isPass then
				if player:GetAttribute("Pass_" .. key) then
					return
				end
				Remotes.BuyPass:FireServer(key)
			else
				Remotes.BuyProduct:FireServer(key)
			end
		end,
	})

	-- real price from Roblox if configured
	if data.Id and data.Id ~= 0 then
		task.spawn(function()
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, data.Id, isPass and Enum.InfoType.GamePass or Enum.InfoType.Product)
			if ok and info and info.PriceInRobux then
				button.Text = ROBUX .. " " .. tostring(info.PriceInRobux)
			end
		end)
	end

	if isPass then
		local function refresh()
			if player:GetAttribute("Pass_" .. key) then
				button.Text = "OWNED ✓"
				button.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
			end
		end
		player:GetAttributeChangedSignal("Pass_" .. key):Connect(refresh)
		refresh()
	end
	return frame
end

function Shop:Init(controllers)
	C = controllers
	local _, content = C.UI:MakePanel("Shop", "🛒 SHOP", Theme.Accent, 820, 560)

	local tabs = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	UIKit.List(tabs, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)

	local pages = {}
	local function makePage(name)
		local scroll = UIKit.Scroll({ Size = UDim2.new(1, 0, 1, -54), Position = UDim2.fromOffset(0, 54), Parent = content })
		scroll.Name = name
		scroll.Visible = false
		UIKit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 6), Parent = scroll })
		local grid = UIKit.new("UIGridLayout", {
			CellSize = UDim2.new(0.315, 0, 0, 220),
			CellPadding = UDim2.new(0.02, 0, 0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
		grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
		pages[name] = scroll
		return scroll
	end
	local passPage = makePage("Passes")
	local productPage = makePage("Products")

	local tabButtons = {}
	local function select(name)
		for pageName, page in pages do
			page.Visible = pageName == name
			tabButtons[pageName].BackgroundColor3 = pageName == name and Theme.Accent or Theme.PanelLight
		end
	end
	tabButtons.Passes = UIKit.Button({ Text = "👑 GAME PASSES", Color = Theme.Accent, Size = UDim2.fromOffset(200, 40), ZIndex = 7, Parent = tabs, Callback = function()
		select("Passes")
	end })
	tabButtons.Products = UIKit.Button({ Text = "💰 CASH & BOOSTS", Color = Theme.PanelLight, Size = UDim2.fromOffset(200, 40), ZIndex = 7, Parent = tabs, Callback = function()
		select("Products")
	end })

	-- in Studio everything shows (purchases are simulated); in a live game only
	-- the items whose ids are set up on the Creator Dashboard
	local showAll = RunService:IsStudio() and Config.Monetization.SimulateUnconfiguredInStudio
	local function fill(page, map, isPass: boolean)
		local shown = 0
		for _, entry in sorted(map) do
			if showAll or (entry.Data.Id or 0) ~= 0 then
				shown += 1
				card(page, shown, entry.Data, isPass, entry.Key)
			end
		end
		if shown == 0 then
			UIKit.Label({ Text = "Coming soon! 🛠️", Size = UDim2.new(1, 0, 0, 40), Font = Theme.BodyFont, TextColor3 = Theme.SubText, ZIndex = 7, Parent = page })
		end
	end
	fill(passPage, Config.GamePasses, true)
	fill(productPage, Config.Products, false)
	select("Passes")
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Travel</string>
            <string name="Source"><![CDATA[--[[
	Travel (client) - the Travel panel: go to the far islands (and back to the
	plaza) and see how many treasure chests are ready on each.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme
local IC = Config.Islands

local Travel = {}
local C

local rows: { [string]: { Status: TextLabel, Button: TextButton } } = {}

local function refresh()
	local rebirths = player:GetAttribute("Rebirths") or 0
	for _, island in IC.List do
		local row = rows[island.Id]
		if row then
			local locked = rebirths < island.Rebirths
			local ready = player:GetAttribute("ChestsReady_" .. island.Id) or 0
			local nextAt = player:GetAttribute("ChestNext_" .. island.Id) or 0
			if locked then
				row.Status.Text = "🔒 Unlocks at " .. island.Rebirths .. " rebirths"
				row.Status.TextColor3 = Theme.SubText
			elseif ready > 0 then
				row.Status.Text = "💰 " .. ready .. "/" .. island.Chests .. " chests ready!"
				row.Status.TextColor3 = Color3.fromRGB(150, 255, 160)
			else
				row.Status.Text = "Next chest in " .. Util.Clock(math.max(0, nextAt - Util.ServerNow()))
				row.Status.TextColor3 = Theme.SubText
			end
			row.Button.BackgroundColor3 = locked and Color3.fromRGB(90, 90, 110) or Theme.Green
		end
	end
	if C.HUD and C.HUD.SetBadge then
		C.HUD:SetBadge("Travel", (player:GetAttribute("ChestsReady") or 0) > 0, tostring(player:GetAttribute("ChestsReady") or 0))
	end
end

local function go(destination: string)
	local ok, message = Remotes.Travel:InvokeServer(destination)
	C.Notifications:Toast(tostring(message), ok and "success" or "error")
	if ok then
		C.UI:Close()
	end
end

function Travel:Init(controllers)
	C = controllers
	local _, content = C.UI:MakePanel("Travel", "🧭 TRAVEL", Color3.fromRGB(60, 200, 190), 620, 460)
	UIKit.List(content, 10)
	UIKit.new("TextLabel", {
		Text = "Islands beyond the edge of the world, full of treasure chests. Each chest reopens 30 minutes after you open it - even if you leave the game.",
		Size = UDim2.new(1, -20, 0, 54),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 16,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		LayoutOrder = 0,
		ZIndex = 7,
		Parent = content,
	})
	local function row(order: number, id: string, title: string)
		local frame = UIKit.new("Frame", { Name = "Dest" .. id, Size = UDim2.new(1, -10, 0, 66), BackgroundColor3 = Theme.Panel, LayoutOrder = order, ZIndex = 7, Parent = content })
		UIKit.Corner(frame, 10)
		UIKit.Label({ Text = title, Size = UDim2.new(1, -170, 0, 28), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = frame })
		local status = UIKit.Label({ Text = "", Size = UDim2.new(1, -170, 0, 20), Position = UDim2.fromOffset(12, 38), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.BodyFont, Stroke = false, ZIndex = 8, Parent = frame })
		local button = UIKit.Button({
			Name = "Go" .. id,
			Text = "GO ▶",
			Color = Theme.Green,
			Size = UDim2.fromOffset(130, 44),
			Position = UDim2.new(1, -142, 0, 11),
			ZIndex = 8,
			Parent = frame,
			Callback = function()
				go(id)
			end,
		})
		rows[id] = { Status = status, Button = button }
	end
	row(1, "Plaza", "🏠 Main Island")
	rows.Plaza.Status.Text = "The spawn plaza"
	for i, island in IC.List do
		row(i + 1, island.Id, island.Icon .. " " .. island.Name)
	end
	player:GetAttributeChangedSignal("ChestsReady"):Connect(refresh)
	player:GetAttributeChangedSignal("Rebirths"):Connect(refresh)
	refresh()
end

function Travel:Start()
	while true do
		task.wait(1)
		Util.Try("Travel", refresh)
	end
end

return Travel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[ UI - owns the main ScreenGui and the "one panel at a time" manager ]]
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UIKit = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UIKit"))

local player = Players.LocalPlayer

local UI = {}
UI.Gui = nil :: ScreenGui?
UI.Panels = {}
UI.Current = nil :: string?

local blur: BlurEffect

function UI:Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "MegaTycoonUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	self.Gui = gui

	-- overlay layer for full-screen effects (flash, confetti, cash bursts)
	local fx = Instance.new("ScreenGui")
	fx.Name = "MegaTycoonFX"
	fx.ResetOnSpawn = false
	fx.IgnoreGuiInset = true
	fx.DisplayOrder = 20
	fx.Parent = player.PlayerGui
	self.FX = fx

	blur = Instance.new("BlurEffect")
	blur.Name = "UIBlur"
	blur.Size = 0
	blur.Parent = Lighting

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Escape and self.Current then
			self:Close()
		end
	end)
end

function UI:Start()
	-- show HUD once the loading screen is gone
	-- wait for the loading screen (with a safety timeout)
	local waited = 0
	while not player:GetAttribute("LoadingDone") and waited < 45 do
		waited += task.wait(0.25)
	end
	self.Gui.Enabled = true
end

-- Scale-based size so panels fit phones and big screens
function UI:PanelSize(maxW: number, maxH: number)
	return UDim2.new(0.9, 0, 0.82, 0), Vector2.new(maxW, maxH)
end

function UI:Register(name: string, frame: Frame, closeButton: GuiButton?, onOpen: (() -> ())?)
	self.Panels[name] = { Frame = frame, OnOpen = onOpen }
	if closeButton then
		closeButton.Activated:Connect(function()
			UIKit.PlaySound("Click", 0.5)
			self:Close()
		end)
	end
end

function UI:Open(name: string)
	local panel = self.Panels[name]
	if not panel then
		return
	end
	if self.Current and self.Current ~= name then
		local old = self.Panels[self.Current]
		if old then
			old.Frame.Visible = false
		end
	end
	self.Current = name
	UIKit.Open(panel.Frame)
	TweenService:Create(blur, TweenInfo.new(0.25), { Size = 14 }):Play()
	if panel.OnOpen then
		task.spawn(panel.OnOpen)
	end
end

function UI:Close()
	if not self.Current then
		return
	end
	local panel = self.Panels[self.Current]
	self.Current = nil
	if panel then
		UIKit.Close(panel.Frame)
	end
	TweenService:Create(blur, TweenInfo.new(0.25), { Size = 0 }):Play()
end

function UI:Toggle(name: string)
	if self.Current == name then
		self:Close()
	else
		self:Open(name)
	end
end

-- Builds a standard panel and registers it. Returns (frame, content)
function UI:MakePanel(name: string, title: string, color: Color3, maxW: number?, maxH: number?, onOpen: (() -> ())?)
	local frame, content, close = UIKit.Panel({
		Name = name,
		Title = title,
		Color = color,
		Size = UDim2.new(0.92, 0, 0.8, 0),
		MaxWidth = maxW or 760,
		Parent = self.Gui,
	})
	local constraint = frame:FindFirstChildOfClass("UISizeConstraint")
	if constraint then
		constraint.MaxSize = Vector2.new(maxW or 760, maxH or 520)
	end
	self:Register(name, frame, close, onOpen)
	return frame, content
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">VFX</string>
            <string name="Source"><![CDATA[--[[
	VFX - all client-side visual effects: cash popups, purchase bursts,
	build-in animations, shockwaves, confetti, cash rain, rebirth flash,
	camera shake, speed lines and more. Triggered by Remotes.VFX.
]]
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local VFX = {}
local C
local fxFolder: Folder
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(255, 200, 40),
	Color3.fromRGB(80, 220, 120),
	Color3.fromRGB(80, 160, 255),
	Color3.fromRGB(200, 90, 255),
	Color3.fromRGB(255, 130, 200),
}

local function camera()
	return workspace.CurrentCamera
end

local function localPart(props): BasePart
	local part = Instance.new(props.ClassName or "Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "ClassName" then
			(part :: any)[k] = v
		end
	end
	part.Parent = fxFolder
	return part
end

local function sound3D(name: string, position: Vector3, volume: number?, pitch: number?)
	local id = Config.Sounds[name]
	if not id or UIKit.SFXEnabled == false then
		return
	end
	local anchor = localPart({ Size = Vector3.one, Transparency = 1, Position = position })
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = pitch or 1
	s.RollOffMaxDistance = 150
	s.Parent = anchor
	s:Play()
	Debris:AddItem(anchor, 4)
end

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------
function VFX:Shake(intensity: number, duration: number)
	local start = os.clock()
	local name = "VFXShake" .. tostring(start)
	RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
		local t = os.clock() - start
		if t > duration then
			RunService:UnbindFromRenderStep(name)
			return
		end
		local falloff = 1 - t / duration
		local cam = camera()
		local offset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * intensity * falloff
		cam.CFrame = cam.CFrame * CFrame.new(offset)
	end)
end

function VFX:Flash(color: Color3?, duration: number?)
	local frame = UIKit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color or Color3.new(1, 1, 1),
		BackgroundTransparency = 0.2,
		ZIndex = 50,
		Parent = C.UI.FX,
	})
	local tween = TweenService:Create(frame, TweenInfo.new(duration or 0.6), { BackgroundTransparency = 1 })
	tween:Play()
	Debris:AddItem(frame, (duration or 0.6) + 0.1)
end

function VFX:Burst(position: Vector3, color: Color3, count: number?, size: number?)
	local anchor = localPart({ Size = Vector3.one, Transparency = 1, Position = position })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size or 1.2), NumberSequenceKeypoint.new(1, 0) })
	emitter.Speed = NumberRange.new(10, 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Drag = 4
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(count or 40)
	Debris:AddItem(anchor, 2)
end

function VFX:Sphere(position: Vector3, color: Color3, size: number)
	local sphere = localPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one,
		Position = position,
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.2,
	})
	TweenService:Create(sphere, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * size, Transparency = 1 }):Play()
	Debris:AddItem(sphere, 0.6)
end

function VFX:Ring(position: Vector3, color: Color3, size: number, duration: number?)
	local ring = localPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.1,
	})
	TweenService:Create(ring, TweenInfo.new(duration or 0.7, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, size, size),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, (duration or 0.7) + 0.1)
end

function VFX:FloatText(position: Vector3, text: string, color: Color3, size: number?)
	local anchor = localPart({ Size = Vector3.one, Transparency = 1, Position = position })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 50)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = UIKit.Label({ Text = text, Size = UDim2.fromScale(1, 1), TextColor3 = color, Parent = gui })
	local scale = UIKit.new("UIScale", { Scale = 0.3 * (size or 1), Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = size or 1 }):Play()
	TweenService:Create(anchor, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = position + Vector3.new(0, 6, 0) }):Play()
	task.delay(0.8, function()
		TweenService:Create(label, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(anchor, 1.5)
end

-- Screen confetti falling from the top
function VFX:ScreenConfetti(count: number)
	for _ = 1, count do
		local piece = UIKit.new("Frame", {
			Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22)),
			Position = UDim2.new(math.random(), 0, 0, -30),
			BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Rotation = math.random(0, 360),
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = C.UI.FX,
		})
		local duration = math.random(18, 32) / 10
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		Debris:AddItem(piece, duration + 0.1)
	end
end

-- 3D confetti burst at a position
function VFX:WorldConfetti(position: Vector3, count: number)
	for _ = 1, count do
		local piece = localPart({
			Size = Vector3.new(0.4, 0.05, 0.6),
			Position = position,
			Color = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Material = Enum.Material.Neon,
		})
		piece.Anchored = false
		piece.AssemblyLinearVelocity = Vector3.new(math.random(-25, 25), math.random(25, 50), math.random(-25, 25))
		piece.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
		Debris:AddItem(piece, 3)
	end
end

-- Cash icons flying from the middle of the screen to the cash counter
function VFX:CashToCounter(amount: number)
	local target = C.HUD and C.HUD.CashFrame
	local targetPos = target and (target.AbsolutePosition + target.AbsoluteSize / 2) or Vector2.new(camera().ViewportSize.X / 2, 40)
	local center = camera().ViewportSize / 2
	for i = 1, 10 do
		local icon = UIKit.new("TextLabel", {
			Text = "💵",
			TextScaled = true,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(36, 36),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X + math.random(-120, 120), center.Y + math.random(-80, 80)),
			ZIndex = 45,
			Parent = C.UI.FX,
		})
		task.delay(0.15 + i * 0.04, function()
			local tween = TweenService:Create(icon, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(targetPos.X, targetPos.Y),
				Size = UDim2.fromOffset(16, 16),
			})
			tween:Play()
			tween.Completed:Wait()
			icon:Destroy()
		end)
	end
	local label = UIKit.Label({
		Text = "+" .. Util.Money(amount),
		Size = UDim2.fromOffset(400, 70),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		TextColor3 = Color3.fromRGB(120, 255, 140),
		ZIndex = 46,
		Parent = C.UI.FX,
	})
	local scale = UIKit.new("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1, Position = UDim2.fromScale(0.5, 0.35) }):Play()
		Debris:AddItem(label, 0.5)
	end)
	UIKit.PlaySound("Cash", 0.5, 1.2)
end

---------------------------------------------------------------------------
-- Named effects (from the server)
---------------------------------------------------------------------------
local effects = {}

function effects.CashPop(params)
	local text = "+" .. Util.Money(params.Amount)
	VFX:FloatText(params.Position, text, params.Vault and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(120, 255, 140), 0.9)
end

function effects.CashBurst(params)
	VFX:CashToCounter(params.Amount or 0)
end

function effects.Purchase(params)
	if not params.Position then
		return
	end
	local color = params.Color or Theme.Accent
	VFX:Burst(params.Position, color, params.Big and 80 or 40)
	VFX:Sphere(params.Position, color, params.Big and 24 or 12)
	VFX:Ring(params.Position - Vector3.new(0, 2, 0), color, params.Big and 40 or 20)
	sound3D("Purchase", params.Position, 0.6)
end

function effects.BuildIn(params)
	local model: Instance? = params.Model
	local color = params.Color or Theme.Accent
	if params.Position then
		VFX:Burst(params.Position, color, 50)
		VFX:Sphere(params.Position, color, 16)
		VFX:Ring(params.Position, color, 26)
		sound3D("Purchase", params.Position, 0.7, 1.1)
	end
	if not model then
		return
	end
	local parts = {}
	for _, d in (model :: Instance):GetDescendants() do
		if d:IsA("BasePart") and not d:HasTag("Spin") and not d:HasTag("Bob") then
			table.insert(parts, d)
		end
	end
	for i, part in parts do
		local cf = part.CFrame
		local transparency = part.Transparency
		part.CFrame = cf * CFrame.new(0, 6, 0)
		part.Transparency = 1
		task.delay(i * 0.02, function()
			if not part.Parent then
				return
			end
			TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = cf, Transparency = transparency }):Play()
		end)
	end
end

function effects.ButtonPop(params)
	VFX:Ring(params.Position, params.Color or Theme.Green, 14, 0.5)
	VFX:Burst(params.Position, params.Color or Theme.Green, 20, 0.8)
end

function effects.Shockwave(params)
	local pos = params.Position
	if not pos then
		return
	end
	local color = params.Color or Theme.Accent
	VFX:Ring(pos, color, params.Size or 60, 0.9)
	VFX:Sphere(pos, color, (params.Size or 60) * 0.3)
	local cam = camera()
	local distance = (cam.CFrame.Position - pos).Magnitude
	if distance < 120 then
		VFX:Shake(math.clamp((120 - distance) / 120, 0, 1) * 1.2, 0.4)
	end
end

function effects.Confetti(params)
	if params.Position then
		VFX:WorldConfetti(params.Position, params.Small and 25 or 60)
	else
		VFX:ScreenConfetti(70)
	end
	UIKit.PlaySound("Win", 0.35)
end

function effects.Rebirth(params)
	VFX:Flash(Color3.fromRGB(255, 230, 120), 1.2)
	VFX:Shake(1.5, 1)
	VFX:ScreenConfetti(120)
	UIKit.PlaySound("Rebirth", 0.6)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(255, 220, 150)
	cc.Brightness = 0.3
	cc.Parent = Lighting
	TweenService:Create(cc, TweenInfo.new(2), { TintColor = Color3.new(1, 1, 1), Brightness = 0 }):Play()
	Debris:AddItem(cc, 2.1)
	local label = UIKit.Label({
		Text = "🔄 REBIRTH " .. tostring(params.Rebirths or "") .. "! 🔄",
		Size = UDim2.fromOffset(700, 110),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		TextColor3 = Color3.fromRGB(255, 215, 60),
		ZIndex = 48,
		Parent = C.UI.FX,
	})
	UIKit.Gradient(label, Color3.fromRGB(255, 250, 180), Color3.fromRGB(255, 160, 0), 90)
	local scale = UIKit.new("UIScale", { Scale = 0, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.4, function()
		TweenService:Create(scale, TweenInfo.new(0.3), { Scale = 0 }):Play()
		Debris:AddItem(label, 0.4)
	end)
end

function effects.CashRain(params)
	local duration = params.Duration or 8
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < duration do
			local cam = camera()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local origin = root and root.Position or cam.CFrame.Position
			for _ = 1, 6 do
				local bill = localPart({
					Size = Vector3.new(2, 0.08, 1),
					Position = origin + Vector3.new(math.random(-50, 50), math.random(35, 55), math.random(-50, 50)),
					Color = Color3.fromRGB(80, 190, 90),
					Material = Enum.Material.SmoothPlastic,
				})
				local gui = Instance.new("SurfaceGui")
				gui.Face = Enum.NormalId.Top
				gui.Parent = bill
				UIKit.Label({ Text = "$", Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(220, 255, 220), Parent = gui })
				bill.Anchored = false
				bill.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
				bill.AssemblyAngularVelocity = Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5))
				Debris:AddItem(bill, 5)
			end
			-- screen emoji
			local icon = UIKit.new("TextLabel", {
				Text = "💵",
				TextScaled = true,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(40, 40),
				Position = UDim2.new(math.random(), 0, 0, -40),
				ZIndex = 40,
				Parent = C.UI.FX,
			})
			TweenService:Create(icon, TweenInfo.new(2.5, Enum.EasingStyle.Linear), { Position = UDim2.new(icon.Position.X.Scale, 0, 1.1, 0), Rotation = math.random(-180, 180) }):Play()
			Debris:AddItem(icon, 2.6)
			task.wait(0.15)
		end
	end)
	VFX:ScreenConfetti(40)
	UIKit.PlaySound("Cash", 0.6)
end

function effects.CoinPop(params)
	VFX:Burst(params.Position, Color3.fromRGB(255, 210, 40), 15, 0.7)
	VFX:FloatText(params.Position, "+1 🪙", Color3.fromRGB(255, 220, 60), 0.7)
	UIKit.PlaySound("Coin", 0.4, 1.3 + math.random() * 0.3)
end

function effects.Error()
	UIKit.PlaySound("Error", 0.3)
end

function effects.PurchaseSound()
	UIKit.PlaySound("Purchase", 0.5)
end

function effects.WinSound()
	UIKit.PlaySound("Win", 0.6)
end

function effects.Flash()
	VFX:Flash(Color3.new(1, 1, 1), 0.5)
end

function effects.ShieldHit(params)
	local center, radius = params.Center, params.Radius or 130
	if typeof(center) ~= "Vector3" then
		return
	end
	local sphere = localPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * radius * 2,
		Position = center,
		Color = Color3.fromRGB(120, 220, 255),
		Material = Enum.Material.ForceField,
		Transparency = 0,
	})
	TweenService:Create(sphere, TweenInfo.new(2.5, Enum.EasingStyle.Quad), { Transparency = 1, Size = Vector3.one * radius * 2.08 }):Play()
	Debris:AddItem(sphere, 2.6)
end

function effects.SecretFound(params)
	local color = params.Color or Color3.fromRGB(255, 220, 80)
	VFX:Flash(color, 0.8)
	VFX:ScreenConfetti(90)
	UIKit.PlaySound("Win", 0.6, 1.1)
	local label = UIKit.Label({
		Text = "🕵️ SECRET FOUND!",
		Size = UDim2.fromOffset(640, 90),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.34),
		TextColor3 = color,
		ZIndex = 48,
		Parent = C.UI.FX,
	})
	local sub = UIKit.Label({
		Text = tostring(params.Name) .. "  (" .. tostring(params.Count) .. "/" .. tostring(params.Total) .. ")",
		Size = UDim2.fromOffset(640, 40),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		ZIndex = 48,
		Parent = C.UI.FX,
	})
	for _, l in { label, sub } do
		local scale = UIKit.new("UIScale", { Scale = 0, Parent = l })
		TweenService:Create(scale, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	task.delay(3, function()
		for _, l in { label, sub } do
			TweenService:Create(l, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			Debris:AddItem(l, 0.6)
		end
	end)
	if params.Cash then
		VFX:CashToCounter(params.Cash)
	end
end

function effects.SpeedLines(params)
	local cam = camera()
	local baseFov = 70
	TweenService:Create(cam, TweenInfo.new(0.3), { FieldOfView = 88 }):Play()
	local stop = os.clock() + (params.Duration or 5)
	task.spawn(function()
		while os.clock() < stop do
			local line = UIKit.new("Frame", {
				Size = UDim2.fromOffset(3, math.random(60, 160)),
				Position = UDim2.new(math.random(), 0, math.random(), 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.5,
				BorderSizePixel = 0,
				ZIndex = 30,
				Parent = C.UI.FX,
			})
			TweenService:Create(line, TweenInfo.new(0.25), { BackgroundTransparency = 1, Position = line.Position + UDim2.fromOffset(0, 120) }):Play()
			Debris:AddItem(line, 0.3)
			task.wait(0.05)
		end
		TweenService:Create(cam, TweenInfo.new(0.5), { FieldOfView = baseFov }):Play()
	end)
	UIKit.PlaySound("Whoosh", 0.5)
end

---------------------------------------------------------------------------
function VFX:Init(controllers)
	C = controllers
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFX"
	fxFolder.Parent = workspace

	Remotes.VFX.OnClientEvent:Connect(function(name, params)
		local fn = effects[name]
		if fn then
			local ok, err = pcall(fn, params or {})
			if not ok then
				warn("[VFX] " .. tostring(name) .. ": " .. tostring(err))
			end
		end
	end)
end

function VFX:Play(name: string, params)
	local fn = effects[name]
	if fn then
		fn(params or {})
	end
end

return VFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Weekly</string>
            <string name="Source"><![CDATA[--[[
	Weekly (client) - the weekly rewards panel (opened from the Daily panel):
	the days you joined this week and the milestones you can claim.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local Theme = UIKit.Theme
local WC = Config.Weekly
local DAY_NAMES = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }

local Weekly = {}
Weekly.State = nil :: any
local C

local summary: TextLabel
local dayLabels: { TextLabel } = {}
local cards: { [number]: { Frame: Frame, Button: TextButton } } = {}
local resetClock = 0

local function render()
	local state = Weekly.State
	if not state then
		return
	end
	summary.Text = "You joined on " .. state.Days .. " day(s) this week  •  resets in " .. Util.FormatTime(math.max(0, state.ResetsIn - (os.clock() - resetClock)))
	for i, label in dayLabels do
		local joined = state.DayFlags[i]
		label.Text = (joined and "✅ " or "▫️ ") .. DAY_NAMES[i]
		label.TextColor3 = joined and Color3.fromRGB(150, 255, 160) or Theme.SubText
	end
	for index, milestone in WC.Milestones do
		local card = cards[index]
		if card then
			local claimed = state.Claimed[index]
			local unlocked = state.Days >= milestone.Days
			card.Button.Text = claimed and "CLAIMED ✔" or (unlocked and "CLAIM" or ("🔒 " .. milestone.Days .. " days"))
			card.Button.BackgroundColor3 = (unlocked and not claimed) and Theme.Green or Color3.fromRGB(90, 90, 110)
			card.Frame.BackgroundColor3 = (unlocked and not claimed) and Color3.fromRGB(40, 70, 45) or Theme.Panel
		end
	end
end

function Weekly:Init(controllers)
	C = controllers
	local _, content = C.UI:MakePanel("Weekly", "📅 WEEKLY REWARDS", Theme.Purple, 700, 480)
	UIKit.List(content, 10)
	summary = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Font = Theme.BodyFont, LayoutOrder = 1, ZIndex = 7, Parent = content })
	local week = UIKit.new("Frame", { Name = "Days", Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 7, Parent = content })
	UIKit.List(week, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)
	for i = 1, 7 do
		dayLabels[i] = UIKit.Label({ Text = DAY_NAMES[i], Size = UDim2.new(1 / 7, -4, 1, 0), Font = Theme.BodyFont, LayoutOrder = i, ZIndex = 8, Parent = week })
	end
	for index, milestone in WC.Milestones do
		local frame = UIKit.new("Frame", { Name = "Milestone" .. index, Size = UDim2.new(1, -10, 0, 78), BackgroundColor3 = Theme.Panel, LayoutOrder = 2 + index, ZIndex = 7, Parent = content })
		UIKit.Corner(frame, 10)
		UIKit.Label({ Text = "Join " .. milestone.Days .. " days", Size = UDim2.new(1, -180, 0, 28), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = frame })
		UIKit.new("TextLabel", {
			Text = milestone.Text,
			Size = UDim2.new(1, -180, 0, 36),
			Position = UDim2.fromOffset(12, 36),
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Font = Theme.BodyFont,
			TextColor3 = Theme.SubText,
			ZIndex = 8,
			Parent = frame,
		})
		local button = UIKit.Button({
			Name = "ClaimWeekly" .. index,
			Text = "CLAIM",
			Color = Theme.Green,
			Size = UDim2.fromOffset(150, 48),
			Position = UDim2.new(1, -162, 0, 15),
			ZIndex = 8,
			Parent = frame,
			Callback = function()
				local ok, message = Remotes.ClaimWeekly:InvokeServer(index)
				C.Notifications:Toast(tostring(message), ok and "success" or "error")
			end,
		})
		cards[index] = { Frame = frame, Button = button }
	end
	Remotes.WeeklyUpdate.OnClientEvent:Connect(function(state)
		if type(state) == "table" then
			Weekly.State = state
			resetClock = os.clock()
			render()
		end
	end)
end

function Weekly:Start()
	while true do
		task.wait(1)
		Util.Try("Weekly", render)
	end
end

return Weekly
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Wheel</string>
            <string name="Source"><![CDATA[--[[
	Wheel (client) - the Lucky Wheel panel. A reel of prize cards scrolls past
	a pointer and slows down on the prize the server picked.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme
local WC = Config.Wheel

local Wheel = {}
Wheel.Spinning = false
local C

local CARD_W = 120
local CARDS = 40
local WIN_AT = 34 -- the card that stops under the pointer

local reel: Frame
local strip: Frame
local spinButton: TextButton
local infoLabel: TextLabel

-- a random segment, weighted like the server's pick (for the filler cards)
local function randomSegment()
	local total = 0
	for _, segment in WC.Segments do
		total += segment.Weight
	end
	local roll = math.random() * total
	for _, segment in WC.Segments do
		roll -= segment.Weight
		if roll < 0 then
			return segment
		end
	end
	return WC.Segments[1]
end

local function buildStrip(winIndex: number)
	strip:ClearAllChildren()
	for i = 1, CARDS do
		local segment = i == WIN_AT and WC.Segments[winIndex] or randomSegment()
		local card = UIKit.new("Frame", {
			Name = "Card" .. i,
			Size = UDim2.new(0, CARD_W - 8, 1, -16),
			Position = UDim2.fromOffset((i - 1) * CARD_W + 4, 8),
			BackgroundColor3 = segment.Color,
			Parent = strip,
		})
		UIKit.Corner(card, 10)
		UIKit.Stroke(card, Color3.new(0, 0, 0), 2, 0.3)
		UIKit.Label({ Text = segment.Icon, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 8), Parent = card })
		UIKit.Label({ Text = segment.Name, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 62), Font = Theme.BodyFont, Parent = card })
	end
	strip.Position = UDim2.fromOffset(0, 0)
end

function Wheel:IsReady(): boolean
	return Util.ServerNow() >= (player:GetAttribute("WheelReadyAt") or math.huge)
end

local function refresh()
	local readyAt = player:GetAttribute("WheelReadyAt")
	if not readyAt then
		spinButton.Text = "..."
		return
	end
	local left = readyAt - Util.ServerNow()
	if Wheel.Spinning then
		spinButton.Text = "SPINNING..."
		spinButton.BackgroundColor3 = Theme.PanelLight
	elseif left <= 0 then
		spinButton.Text = "🎰 SPIN!"
		spinButton.BackgroundColor3 = Theme.Green
		infoLabel.Text = "Your free spin is ready!"
	else
		spinButton.Text = "Next spin in " .. Util.Clock(left)
		spinButton.BackgroundColor3 = Theme.PanelLight
		infoLabel.Text = "A free spin every " .. WC.CooldownMinutes .. " minutes - it keeps counting while you're away."
	end
	if C.HUD and C.HUD.SetBadge then
		C.HUD:SetBadge("Wheel", left <= 0 and not Wheel.Spinning)
	end
end

local function spin()
	if Wheel.Spinning then
		return
	end
	if not Wheel:IsReady() then
		C.Notifications:Toast("Your next free spin isn't ready yet!", "error")
		return
	end
	Wheel.Spinning = true
	refresh()
	local ok, index, message = Remotes.SpinWheel:InvokeServer()
	if not ok or not WC.Segments[index] then
		Wheel.Spinning = false
		C.Notifications:Toast(tostring(message), "error")
		refresh()
		return
	end
	buildStrip(index)
	-- stop somewhere inside the winning card
	local stopAt = reel.AbsoluteSize.X / 2 - ((WIN_AT - 1) * CARD_W + CARD_W / 2) + math.random(-30, 30)
	UIKit.PlaySound("Notify", 0.5, 0.8)
	TweenService:Create(strip, TweenInfo.new(WC.SpinSeconds, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(stopAt, 0) }):Play()
	task.delay(WC.SpinSeconds, function()
		Wheel.Spinning = false
		UIKit.PlaySound("Notify", 0.7, 1.4)
		C.Notifications:Toast(tostring(message), "success")
		refresh()
	end)
end

function Wheel:Init(controllers)
	C = controllers
	local _, content = C.UI:MakePanel("Wheel", "🎰 LUCKY WHEEL", Color3.fromRGB(255, 120, 60), 600, 400)
	UIKit.List(content, 14)
	infoLabel = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 34), Font = Theme.BodyFont, TextColor3 = Theme.SubText, LayoutOrder = 1, ZIndex = 7, Parent = content })
	reel = UIKit.new("Frame", { Name = "Reel", Size = UDim2.new(1, -10, 0, 120), BackgroundColor3 = Theme.Background, ClipsDescendants = true, LayoutOrder = 2, ZIndex = 7, Parent = content })
	UIKit.Corner(reel, 12)
	UIKit.Stroke(reel, Color3.new(0, 0, 0), 3)
	strip = UIKit.new("Frame", { Name = "Strip", Size = UDim2.fromOffset(CARD_W * CARDS, 120), BackgroundTransparency = 1, ZIndex = 8, Parent = reel })
	UIKit.new("Frame", { Name = "Pointer", Size = UDim2.new(0, 4, 1, 0), Position = UDim2.fromScale(0.5, 0), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Theme.Accent, ZIndex = 12, Parent = reel })
	buildStrip(1)
	spinButton = UIKit.Button({
		Name = "SpinButton",
		Text = "...",
		Color = Theme.Green,
		Size = UDim2.fromOffset(300, 56),
		LayoutOrder = 3,
		ZIndex = 7,
		Parent = content,
		Callback = spin,
	})
	-- the prizes
	local prizes = {}
	for _, segment in WC.Segments do
		table.insert(prizes, segment.Icon .. " " .. segment.Name)
	end
	UIKit.new("TextLabel", {
		Text = "Prizes: " .. table.concat(prizes, "  ·  "),
		Size = UDim2.new(1, -20, 0, 44),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 14,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		LayoutOrder = 4,
		ZIndex = 7,
		Parent = content,
	})
	player:GetAttributeChangedSignal("WheelReadyAt"):Connect(refresh)
	refresh()
end

function Wheel:Start()
	while true do
		task.wait(1)
		Util.Try("Wheel", refresh)
	end
end

return Wheel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
