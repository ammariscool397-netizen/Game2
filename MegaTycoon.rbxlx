		Run = function(executor, args)
			local amount = math.floor(tonumber(args[2]) or 1)
			local affected = eachTarget(executor, args[1], false, function(target)
				local data = S.DataService:Get(target)
				if data then
					data.Rebirths = math.max(0, data.Rebirths + amount)
					S.DataService:Sync(target)
				end
			end)
			return "Rebirths +" .. amount .. ": " .. namesOf(affected)
		end,
	})
	register({
		Name = "rebirth",
		Aliases = { "forcerebirth" },
		Rank = 2,
		Args = "<player>",
		Desc = "Force a free rebirth",
		Run = function(executor, args)
			local affected = eachTarget(executor, args[1], false, function(target)
				S.TycoonService:Rebirth(target, true)
			end)
			return "Rebirthed " .. namesOf(affected)
		end,
	})
	register({
		Name = "unlockall",
		Aliases = { "maxtycoon" },
		Rank = 2,
		Args = "<player>",
		Desc = "Instantly build the whole tycoon",
		Run = function(executor, args)
			local affected = eachTarget(executor, args[1], false, function(target)
				S.TycoonService:UnlockAll(target)
			end)
			return "Unlocked all: " .. namesOf(affected)
		end,
	})
	charCommand("explode", { "boom" }, 2, "Blow players up", true, function(_, _, _, root)
		local explosion = Instance.new("Explosion")
		explosion.Position = root.Position
		explosion.BlastRadius = 8
		explosion.DestroyJointRadiusPercent = 1
		explosion.Parent = workspace
		Remotes.VFX:FireAllClients("Shockwave", { Position = root.Position, Color = Color3.fromRGB(255, 120, 0), Size = 40 })
	end)
	charCommand("giant", { "big" }, 2, "Make players huge", false, function(_, character)
		character:ScaleTo(2.5)
	end)
	charCommand("tiny", { "small" }, 2, "Make players tiny", false, function(_, character)
		character:ScaleTo(0.4)
	end)
	charCommand("normal", { "unsize" }, 2, "Reset player size", false, function(_, character)
		character:ScaleTo(1)
	end)
	charCommand("confetti", {}, 2, "Confetti explosion on players", false, function(_, _, _, root)
		Remotes.VFX:FireAllClients("Confetti", { Position = root.Position + Vector3.new(0, 3, 0) })
	end)
	register({
		Name = "cashrain",
		Aliases = { "makeitrain" },
		Rank = 2,
		Args = "",
		Desc = "Cash rain: everyone gets cash",
		Run = function(executor)
			S.MonetizationService:CashRain(executor.DisplayName)
			return "Cash rain started"
		end,
	})
	register({
		Name = "doublecash",
		Aliases = { "event", "2x" },
		Rank = 2,
		Args = "<minutes> [multiplier]",
		Desc = "Server-wide cash multiplier event",
		Run = function(executor, args)
			local minutes = math.clamp(tonumber(args[1]) or 10, 1, 600)
			local mult = math.clamp(tonumber(args[2]) or 2, 1, 100)
			workspace:SetAttribute("EventMultiplier", mult)
			workspace:SetAttribute("EventEnds", os.time() + minutes * 60)
			for _, p in Players:GetPlayers() do
				S.DataService:RefreshMultiplier(p)
			end
			Remotes.Announce:FireAllClients({
				Title = "🔥 " .. mult .. "x CASH EVENT! 🔥",
				Text = "Started by " .. executor.DisplayName .. " for " .. minutes .. " minutes!",
				Color = Color3.fromRGB(255, 90, 40),
			})
			Remotes.VFX:FireAllClients("Confetti", {})
			return mult .. "x event for " .. minutes .. " min"
		end,
	})
	register({
		Name = "music",
		Aliases = { "play", "song" },
		Rank = 2,
		Args = "<soundId>",
		Desc = "Play a song for everyone",
		Run = function(_, args)
			local id = tonumber(args[1])
			if not id then
				return "Invalid sound id"
			end
			Remotes.Music:FireAllClients("play", { Id = "rbxassetid://" .. id, Name = "DJ Track #" .. id })
			return "Playing " .. id
		end,
	})
	register({
		Name = "stopmusic",
		Aliases = { "resetmusic" },
		Rank = 2,
		Args = "",
		Desc = "Go back to the normal playlist",
		Run = function()
			Remotes.Music:FireAllClients("resume", {})
			return "Music reset"
		end,
	})
	register({
		Name = "minigame",
		Aliases = { "startminigame", "mg" },
		Rank = 2,
		Args = "[CoinRush|FallingTiles|MeteorShower]",
		Desc = "Start a minigame now",
		Run = function(_, args)
			if not S.MinigameService then
				return "Minigames unavailable"
			end
			return S.MinigameService:ForceStart(args[1])
		end,
	})
	register({
		Name = "time",
		Aliases = { "clocktime" },
		Rank = 2,
		Args = "<0-24>",
		Desc = "Set the time of day",
		Run = function(_, args)
			local t = tonumber(args[1])
			if not t then
				return "Invalid time"
			end
			Lighting.ClockTime = t % 24
			return "Time set to " .. t
		end,
	})

	---------------- Head Admin (3) ----------------
	register({
		Name = "ban",
		Aliases = {},
		Rank = 3,
		Args = "<player/username> [reason]",
		Desc = "Permanently ban a player (works offline too)",
		Run = function(executor, args)
			local reason = filterBroadcast(restText(args, 2), executor) or "No reason"
			local targets = resolvePlayers(executor, args[1])
			local banned = {}
			if #targets == 0 and args[1] then
				local ok, userId = pcall(Players.GetUserIdFromNameAsync, Players, args[1])
				if ok and userId then
					AdminService:Ban(userId, reason, executor.Name)
					return "Banned offline user " .. args[1]
				end
				return "User not found"
			end
			for _, target in targets do
				if target ~= executor and AdminService:GetRank(target) < AdminService:GetRank(executor) then
					AdminService:Ban(target.UserId, reason, executor.Name)
					target:Kick("You are banned: " .. reason)
					table.insert(banned, target)
				end
			end
			return "Banned " .. namesOf(banned)
		end,
	})
	register({
		Name = "unban",
		Aliases = {},
		Rank = 3,
		Args = "<username>",
		Desc = "Unban a user by username",
		Run = function(_, args)
			if not args[1] then
				return "Usage: unban <username>"
			end
			local ok, userId = pcall(Players.GetUserIdFromNameAsync, Players, args[1])
			if not ok or not userId then
				return "User not found"
			end
			if banStore then
				pcall(function()
					(banStore :: DataStore):RemoveAsync(tostring(userId))
				end)
			end
			return "Unbanned " .. args[1]
		end,
	})
	register({
		Name = "resetdata",
		Aliases = { "wipe" },
		Rank = 3,
		Args = "<player>",
		Desc = "Wipe a player's progress (keeps passes)",
		Run = function(executor, args)
			local affected = eachTarget(executor, args[1], true, function(target)
				S.DataService:ResetData(target)
				S.TycoonService:Rebuild(target)
			end)
			return "Reset " .. namesOf(affected)
		end,
	})
	register({
		Name = "givepass",
		Aliases = { "pass" },
		Rank = 3,
		Args = "<player> <DoubleCash|AutoCollect|FastDroppers|VIP|SuperSpeed>",
		Desc = "Give a game pass for free",
		Run = function(executor, args)
			local key
			for k in Config.GamePasses do
				if args[2] and k:lower() == args[2]:lower() then
					key = k
				end
			end
			if not key then
				return "Unknown pass"
			end
			local affected = eachTarget(executor, args[1], false, function(target)
				S.MonetizationService:GrantPass(target, key)
			end)
			return "Gave " .. key .. " to " .. namesOf(affected)
		end,
	})
	register({
		Name = "removepass",
		Aliases = { "revokepass" },
		Rank = 3,
		Args = "<player> <pass>",
		Desc = "Remove an admin-given pass",
		Run = function(executor, args)
			local key
			for k in Config.GamePasses do
				if args[2] and k:lower() == args[2]:lower() then
					key = k
				end
			end
			if not key then
				return "Unknown pass"
			end
			local affected = eachTarget(executor, args[1], false, function(target)
				S.MonetizationService:RevokePass(target, key)
			end)
			return "Removed " .. key .. " from " .. namesOf(affected)
		end,
	})

	---------------- Owner (4) ----------------
	register({
		Name = "admin",
		Aliases = { "setrank", "rank" },
		Rank = 4,
		Args = "<player> <1-3>",
		Desc = "Give a player an admin rank (this server)",
		Run = function(executor, args)
			local rank = math.clamp(math.floor(tonumber(args[2]) or 2), 0, 3)
			local affected = eachTarget(executor, args[1], false, function(target)
				if target ~= executor then
					tempRanks[target.UserId] = rank
					target:SetAttribute("AdminRank", computeRank(target))
					Remotes.Notify:FireClient(target, { Text = "You are now " .. Config.RankNames[rank] .. "! Say ;cmds", Type = "success", Duration = 6 })
				end
			end)
			return "Rank " .. rank .. ": " .. namesOf(affected)
		end,
	})
	register({
		Name = "unadmin",
		Aliases = {},
		Rank = 4,
		Args = "<player>",
		Desc = "Remove a temporary admin rank",
		Run = function(executor, args)
			local affected = eachTarget(executor, args[1], true, function(target)
				tempRanks[target.UserId] = nil
				target:SetAttribute("AdminRank", computeRank(target))
			end)
			return "Unadmined " .. namesOf(affected)
		end,
	})
	register({
		Name = "shutdown",
		Aliases = {},
		Rank = 4,
		Args = "",
		Desc = "Shut the server down (saves everyone first)",
		Run = function(executor)
			Remotes.Announce:FireAllClients({ Title = "⚠️ SERVER SHUTTING DOWN", Text = "Your data is being saved. Please rejoin!", Color = Color3.fromRGB(255, 60, 60) })
			task.delay(4, function()
				for _, p in Players:GetPlayers() do
					S.DataService:Save(p)
					p:Kick("Server shut down by " .. executor.Name .. ". Your data was saved - please rejoin!")
				end
			end)
			return "Shutting down..."
		end,
	})
end

---------------------------------------------------------------------------
-- Bans
---------------------------------------------------------------------------
function AdminService:Ban(userId: number, reason: string, by: string)
	if not banStore then
		return
	end
	pcall(function()
		(banStore :: DataStore):SetAsync(tostring(userId), { Reason = reason, By = by, Time = os.time() })
	end)
end

-- Returns true (and kicks) if banned
function AdminService:CheckBan(player: Player): boolean
	if not banStore then
		return false
	end
	local ok, entry = pcall(function()
		return (banStore :: DataStore):GetAsync(tostring(player.UserId))
	end)
	if ok and type(entry) == "table" then
		player:Kick("You are banned from this game. Reason: " .. tostring(entry.Reason))
		return true
	end
	return false
end

---------------------------------------------------------------------------
-- Execution
---------------------------------------------------------------------------
function AdminService:Execute(executor: Player, text: string): (boolean, string)
	if type(text) ~= "string" then
		return false, "Invalid command"
	end
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	local prefix = Config.Admin.Prefix
	if text:sub(1, #prefix) == prefix then
		text = text:sub(#prefix + 1)
	end
	local args = {}
	for word in text:gmatch("%S+") do
		table.insert(args, word)
	end
	if #args == 0 then
		return false, "Type a command"
	end
	local name = table.remove(args, 1):lower()
	local command = byName[name]
	if not command then
		return false, "Unknown command '" .. name .. "'. Try " .. prefix .. "cmds"
	end
	local rank = self:GetRank(executor)
	if rank < command.Rank then
		return false, "You need " .. Config.RankNames[command.Rank] .. " for that"
	end
	local ok, result = pcall(command.Run, executor, args)
	table.insert(logs, 1, { Time = os.time(), By = executor.Name, Text = prefix .. text })
	if #logs > 200 then
		table.remove(logs)
	end
	if not ok then
		warn("[Admin] " .. tostring(result))
		return false, "Error: " .. tostring(result)
	end
	return true, tostring(result or "Done")
end

function AdminService:Init(services)
	S = services
	buildCommands()

	local function onPlayer(player: Player)
		task.spawn(function()
			player:SetAttribute("AdminRank", computeRank(player))
		end)
		-- with TextChatService the client sends chat commands through the
		-- AdminCommand remote (see Admin controller); Chatted is the fallback
		-- for the legacy chat system only, so commands never run twice
		player.Chatted:Connect(function(message)
			if TextChatService.ChatVersion ~= Enum.ChatVersion.LegacyChatService then
				return
			end
			local prefix = Config.Admin.Prefix
			if message:sub(1, #prefix) ~= prefix or self:GetRank(player) <= 0 then
				return
			end
			local ok, result = self:Execute(player, message)
			Remotes.Notify:FireClient(player, { Text = result, Type = ok and "success" or "error" })
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		if jails[player] then
			jails[player]:Destroy()
			jails[player] = nil
		end
	end)

	Remotes.AdminCommand.OnServerInvoke = function(player, text)
		if self:GetRank(player) <= 0 then
			return false, "You are not an admin"
		end
		return self:Execute(player, text)
	end

	Remotes.AdminData.OnServerInvoke = function(player, what)
		local rank = self:GetRank(player)
		if rank <= 0 then
			return nil
		end
		if what == "commands" then
			local list = {}
			for _, c in commands do
				table.insert(list, { Name = c.Name, Aliases = c.Aliases, Rank = c.Rank, Args = c.Args, Desc = c.Desc, Allowed = rank >= c.Rank })
			end
			return list
		elseif what == "logs" then
			return logs
		elseif what == "players" then
			local list = {}
			for _, p in Players:GetPlayers() do
				table.insert(list, {
					Name = p.Name,
					DisplayName = p.DisplayName,
					UserId = p.UserId,
					Rank = self:GetRank(p),
					Cash = p:GetAttribute("Cash") or 0,
					Rebirths = p:GetAttribute("Rebirths") or 0,
				})
			end
			return list
		end
		return nil
	end
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">BuildKit</string>
          <string name="Source"><![CDATA[--[[ BuildKit - helpers to build geometry from code (no assets needed) ]]
local CollectionService = game:GetService("CollectionService")

local BuildKit = {}

-- BuildKit.Part({ Size=, CFrame=, Color=, Material=, Parent=, ... })
function BuildKit.Part(props: { [string]: any }): BasePart
	local className = props.ClassName or "Part"
	local part = Instance.new(className) :: any
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" and key ~= "ClassName" and key ~= "Tags" then
			part[key] = value
		end
	end
	if props.Tags then
		for _, tag in props.Tags do
			CollectionService:AddTag(part, tag)
		end
	end
	part.Parent = props.Parent
	return part
end

function BuildKit.Model(name: string, parent: Instance?): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- Floating text above a part
function BuildKit.Billboard(adornee: BasePart, text: string, props: { [string]: any }?)
	props = props or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = props.Name or "Billboard"
	gui.Size = props.Size or UDim2.fromOffset(200, 50)
	gui.StudsOffset = props.Offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = props.AlwaysOnTop or false
	gui.MaxDistance = props.MaxDistance or 120
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = props.Font or Enum.Font.FredokaOne
	label.TextColor3 = props.Color or Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = adornee
	return gui, label
end

-- Text painted on the face of a part
function BuildKit.SurfaceText(part: BasePart, face: Enum.NormalId, text: string, props: { [string]: any }?)
	props = props or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = props.PixelsPerStud or 30
	gui.LightInfluence = 0
	gui.Brightness = props.Brightness or 1.5
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = props.Font or Enum.Font.FredokaOne
	label.TextColor3 = props.Color or Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = part
	return gui, label
end

function BuildKit.Particles(parent: Instance, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.LightEmission = 1
	emitter.Rate = 10
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(30, 30)
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = parent
	return emitter
end

function BuildKit.Light(parent: Instance, color: Color3, range: number?, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 2
	light.Shadows = false
	light.Parent = parent
	return light
end

function BuildKit.Size(n: number, from: number?, to: number?)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, from or n), NumberSequenceKeypoint.new(1, to or 0) })
end

-- Is `hit` part of a character? Returns (player, humanoid)
function BuildKit.PlayerFromHit(hit: BasePart): (Player?, Humanoid?)
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil, nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return game:GetService("Players"):GetPlayerFromCharacter(model), humanoid
end

return BuildKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService - loads, saves and edits player data.
	Values the client needs are mirrored to Player attributes
	(Cash, Vault, Rebirths, TotalEarned, Multiplier, BoostEnd, LastDaily, ...)
	so UI can simply listen to GetAttributeChangedSignal.
]]
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)

local DataService = {}
DataService.PlayerLoaded = Signal.new() -- (player, data)
DataService.BeforeSave = Signal.new()

local S

local TEMPLATE = {
	Cash = Config.StartingCash,
	Vault = 0,
	TotalEarned = 0,
	Rebirths = 0,
	Purchased = {},
	Passes = {}, -- passes granted by admins / simulated in Studio
	RedeemedCodes = {},
	DailyStreak = 0,
	LastDaily = 0,
	BoostEnd = 0,
	LastObbyReward = 0,
	ObbyCompletions = 0,
	MinigameWins = 0,
	PlayTime = 0,
	Settings = { MusicVolume = Config.Music.DefaultVolume, SFX = true, LowGraphics = false },
}

local profiles: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}
local joinTime: { [Player]: number } = {}

local store: DataStore? = nil
local earnedStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
		earnedStore = DataStoreService:GetOrderedDataStore(Config.DataStoreName .. "_TotalEarned")
	end)
	if not ok then
		warn("[DataService] DataStores unavailable: " .. tostring(err))
	end
end

local function keyFor(player: Player)
	return "Player_" .. player.UserId
end

local function retry<T>(fn: () -> T, attempts: number?): (boolean, T | string)
	local lastErr
	for i = 1, attempts or 3 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		-- no point retrying when API access is disabled (Studio) or the place is unpublished
		local message = tostring(result)
		if message:find("StudioAccessToApisNotAllowed") or message:find("403") or message:find("publish") then
			break
		end
		task.wait(1 + i)
	end
	return false, tostring(lastErr)
end

---------------------------------------------------------------------------
function DataService:Init(services)
	S = services
	workspace:SetAttribute("EventMultiplier", 1)
	workspace:SetAttribute("EventEnds", 0)
end

function DataService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:_onJoin(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_onLeave(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(self._onJoin, self, player)
	end

	game:BindToClose(function()
		local threads = {}
		for _, player in Players:GetPlayers() do
			table.insert(threads, task.spawn(function()
				self:Save(player)
			end))
		end
		local start = os.clock()
		while os.clock() - start < (RunService:IsStudio() and 3 or 25) do
			local busy = false
			for _, thread in threads do
				if coroutine.status(thread) ~= "dead" then
					busy = true
				end
			end
			if not busy then
				break
			end
			task.wait(0.1)
		end
	end)

	-- autosave + boost / event expiry ticks
	task.spawn(function()
		while true do
			task.wait(Config.AutoSaveInterval)
			for _, player in Players:GetPlayers() do
				task.spawn(self.Save, self, player)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ends = workspace:GetAttribute("EventEnds") or 0
			if (workspace:GetAttribute("EventMultiplier") or 1) ~= 1 and os.time() >= ends then
				workspace:SetAttribute("EventMultiplier", 1)
				Remotes.Announce:FireAllClients({ Title = "EVENT OVER", Text = "The cash multiplier event has ended.", Color = Color3.fromRGB(200, 200, 200) })
				for _, p in Players:GetPlayers() do
					self:RefreshMultiplier(p)
				end
			end
			for player, data in profiles do
				if data.BoostEnd > 0 and os.time() >= data.BoostEnd then
					data.BoostEnd = 0
					self:Sync(player)
					Remotes.Notify:FireClient(player, { Text = "Your 2x Boost has ended.", Type = "info" })
				end
			end
		end
	end)
end

function DataService:_onJoin(player: Player)
	if profiles[player] then
		return
	end
	joinTime[player] = os.time()

	-- ban check first
	if S.AdminService and S.AdminService.CheckBan then
		local banned = S.AdminService:CheckBan(player)
		if banned then
			return
		end
	end

	local data
	if store then
		local ok, result = retry(function()
			return (store :: DataStore):GetAsync(keyFor(player))
		end)
		if ok then
			canSave[player] = true
			data = result
		else
			canSave[player] = false
			warn("[DataService] Could not load data for " .. player.Name .. ": " .. tostring(result))
			task.delay(5, function()
				if player.Parent then
					Remotes.Notify:FireClient(player, {
						Text = RunService:IsStudio() and "Data not saving: enable Studio API access in Game Settings > Security." or "We couldn't load your data. Progress this session won't be saved. Try rejoining!",
						Type = "error",
						Duration = 10,
					})
				end
			end)
		end
	else
		canSave[player] = false
	end

	if not player.Parent then
		return
	end

	if type(data) ~= "table" then
		data = Util.DeepCopy(TEMPLATE)
	else
		Util.Reconcile(data, TEMPLATE)
	end
	profiles[player] = data

	-- leaderstats
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	leaderstats.Parent = player

	self:Sync(player)
	player:SetAttribute("DataLoaded", true)
	self.PlayerLoaded:Fire(player, data)
end

function DataService:_onLeave(player: Player)
	if profiles[player] then
		self:Save(player)
	end
	profiles[player] = nil
	canSave[player] = nil
	joinTime[player] = nil
end

function DataService:Save(player: Player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return false
	end
	if joinTime[player] then
		data.PlayTime += os.time() - joinTime[player]
		joinTime[player] = os.time()
	end
	self.BeforeSave:Fire(player, data)
	local ok, err = retry(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
	if earnedStore then
		pcall(function()
			(earnedStore :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(math.min(data.TotalEarned, 2 ^ 52)))
		end)
	end
	return ok
end

function DataService:GetEarnedStore()
	return earnedStore
end

function DataService:Get(player: Player)
	return profiles[player]
end

function DataService:IsLoaded(player: Player)
	return profiles[player] ~= nil
end

function DataService:GetMultiplier(player: Player): number
	local data = profiles[player]
	if not data then
		return 1
	end
	local mult = 1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth
	if S.MonetizationService then
		if S.MonetizationService:HasPass(player, "DoubleCash") then
			mult *= 2
		end
		if S.MonetizationService:HasPass(player, "VIP") then
			mult *= 1.5
		end
	end
	if data.BoostEnd > os.time() then
		mult *= 2
	end
	mult *= workspace:GetAttribute("EventMultiplier") or 1
	return mult
end

function DataService:RefreshMultiplier(player: Player)
	player:SetAttribute("Multiplier", self:GetMultiplier(player))
end

-- Push data values to attributes + leaderstats
function DataService:Sync(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Vault", data.Vault)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("TotalEarned", data.TotalEarned)
	player:SetAttribute("BoostEnd", data.BoostEnd)
	player:SetAttribute("LastDaily", data.LastDaily)
	player:SetAttribute("DailyStreak", data.DailyStreak)
	player:SetAttribute("RebirthCost", Config.GetRebirthCost(data.Rebirths))
	player:SetAttribute("MusicVolume", data.Settings.MusicVolume)
	player:SetAttribute("SFX", data.Settings.SFX)
	self:RefreshMultiplier(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		(leaderstats :: any).Cash.Value = Util.Money(data.Cash)
		;(leaderstats :: any).Rebirths.Value = data.Rebirths
	end
end

-- Add cash. `earned` = counts toward TotalEarned (income), default true
function DataService:AddCash(player: Player, amount: number, earned: boolean?)
	local data = profiles[player]
	if not data then
		return
	end
	amount = math.floor(amount)
	data.Cash = math.max(0, data.Cash + amount)
	if earned ~= false and amount > 0 then
		data.TotalEarned += amount
	end
	self:Sync(player)
end

function DataService:SetCash(player: Player, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.Cash = math.max(0, math.floor(amount))
	self:Sync(player)
end

function DataService:SpendCash(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	self:Sync(player)
	return true
end

function DataService:AddVault(player: Player, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.Vault += math.floor(amount)
	player:SetAttribute("Vault", data.Vault)
end

function DataService:AddBoost(player: Player, seconds: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.BoostEnd = math.max(data.BoostEnd, os.time()) + seconds
	self:Sync(player)
end

function DataService:ResetData(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	local fresh = Util.DeepCopy(TEMPLATE)
	fresh.Passes = data.Passes -- never take away paid stuff
	for k in data do
		data[k] = nil
	end
	for k, v in fresh do
		data[k] = v
	end
	self:Sync(player)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	LeaderboardService - global "Top Earners" board in the lobby
	(OrderedDataStore, refreshes every 2 minutes).
]]
local Players = game:GetService("Players")

local LeaderboardService = {}
local S

local nameCache: { [number]: string } = {}
local REFRESH = 120

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	nameCache[userId] = ok and name or ("User " .. userId)
	return nameCache[userId]
end

local function abbreviate(n: number): string
	return require(game:GetService("ReplicatedStorage").Shared.Util).Money(n)
end

function LeaderboardService:Init(services)
	S = services
end

function LeaderboardService:_render(rows)
	local body = S.WorldBuilder.LeaderboardBody
	if not body then
		return
	end
	body:ClearAllChildren()
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = body
	if #rows == 0 then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 60)
		label.BackgroundTransparency = 1
		label.Text = "Leaderboard loads in the live game\n(publish + enable API access)"
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.fromRGB(200, 200, 220)
		label.Parent = body
		return
	end
	local medal = { "🥇", "🥈", "🥉" }
	for i, row in rows do
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, 0, 0, 40)
		frame.BackgroundColor3 = i % 2 == 0 and Color3.fromRGB(40, 42, 60) or Color3.fromRGB(32, 34, 50)
		frame.LayoutOrder = i
		frame.Parent = body
		local rank = Instance.new("TextLabel")
		rank.Size = UDim2.new(0.15, 0, 1, 0)
		rank.BackgroundTransparency = 1
		rank.Text = medal[i] or ("#" .. i)
		rank.TextScaled = true
		rank.Font = Enum.Font.FredokaOne
		rank.TextColor3 = Color3.new(1, 1, 1)
		rank.Parent = frame
		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(0.5, 0, 1, 0)
		name.Position = UDim2.new(0.15, 0, 0, 0)
		name.BackgroundTransparency = 1
		name.Text = row.Name
		name.TextScaled = true
		name.Font = Enum.Font.GothamBold
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = Color3.new(1, 1, 1)
		name.Parent = frame
		local value = Instance.new("TextLabel")
		value.Size = UDim2.new(0.33, 0, 1, 0)
		value.Position = UDim2.new(0.66, 0, 0, 0)
		value.BackgroundTransparency = 1
		value.Text = abbreviate(row.Value)
		value.TextScaled = true
		value.Font = Enum.Font.FredokaOne
		value.TextXAlignment = Enum.TextXAlignment.Right
		value.TextColor3 = Color3.fromRGB(120, 255, 150)
		value.Parent = frame
	end
end

function LeaderboardService:Refresh()
	local store = S.DataService:GetEarnedStore()
	local rows = {}
	if store then
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok and pages then
			for _, entry in pages:GetCurrentPage() do
				local userId = tonumber(entry.key)
				if userId then
					table.insert(rows, { Name = nameFor(userId), Value = entry.value })
				end
			end
		end
	end
	self:_render(rows)
end

function LeaderboardService:Start()
	task.wait(5)
	while true do
		self:Refresh()
		task.wait(REFRESH)
	end
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MinigameService</string>
          <string name="Source"><![CDATA[--[[
	MinigameService - round based minigames in a sky arena.
	Flow: Intermission -> Join window (players press JOIN) -> Countdown ->
	Playing -> Results -> everyone is sent home.

	Games: CoinRush, FallingTiles, MeteorShower (configure in Config.Minigames)
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part
local MG = Config.Minigames

local MinigameService = {}
local S

local running = false
local forced: string? = nil
local joined: { [Player]: boolean } = {}
local acceptingJoins = false

local function broadcast(state)
	Remotes.MinigameState:FireAllClients(state)
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function rebirthScale(player: Player): number
	return 1 + (player:GetAttribute("Rebirths") or 0)
end

local function barrier(folder: Instance, center: Vector3, size: number, height: number)
	for _, data in {
		{ Vector3.new(size, height, 2), Vector3.new(0, height / 2, size / 2 + 1) },
		{ Vector3.new(size, height, 2), Vector3.new(0, height / 2, -size / 2 - 1) },
		{ Vector3.new(2, height, size), Vector3.new(size / 2 + 1, height / 2, 0) },
		{ Vector3.new(2, height, size), Vector3.new(-size / 2 - 1, height / 2, 0) },
	} do
		Part({ Name = "Barrier", Size = data[1], Position = center + data[2], Transparency = 0.85, Color = Color3.fromRGB(120, 200, 255), Material = Enum.Material.ForceField, Parent = folder })
	end
end

---------------------------------------------------------------------------
-- Games. Each has Setup(ctx) and Run(ctx); Run returns when the round ends.
---------------------------------------------------------------------------
local Games = {}

Games.CoinRush = {
	Setup = function(ctx)
		local c = ctx.Center
		Part({ Name = "Floor", Size = Vector3.new(110, 2, 110), Position = c, Color = Color3.fromRGB(70, 60, 110), Material = Enum.Material.Slate, Parent = ctx.Folder })
		Part({ Name = "Edge", Size = Vector3.new(114, 1.8, 114), Position = c - Vector3.new(0, 0.2, 0), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Neon, Parent = ctx.Folder })
		barrier(ctx.Folder, c, 110, 30)
		local rng = Random.new()
		for _ = 1, 14 do
			local size = Vector3.new(rng:NextNumber(4, 10), rng:NextNumber(3, 9), rng:NextNumber(4, 10))
			Part({
				Name = "Obstacle",
				Size = size,
				Position = c + Vector3.new(rng:NextNumber(-45, 45), 1 + size.Y / 2, rng:NextNumber(-45, 45)),
				Color = Color3.fromHSV(rng:NextNumber(), 0.6, 0.9),
				Parent = ctx.Folder,
			})
		end
		ctx.SpawnRadius = 40
	end,
	Run = function(ctx)
		local rng = Random.new()
		local coins = 0
		local info = MG.Games.CoinRush
		local function spawnCoin()
			coins += 1
			local coin = Part({
				Name = "Coin",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.5, 3, 3),
				CFrame = CFrame.new(ctx.Center + Vector3.new(rng:NextNumber(-50, 50), 4, rng:NextNumber(-50, 50))) * CFrame.Angles(0, rng:NextNumber(0, 6), 0),
				Color = Color3.fromRGB(255, 205, 40),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Tags = { "Spin" },
				Parent = ctx.Folder,
			})
			BuildKit.Light(coin, Color3.fromRGB(255, 205, 40), 8, 1)
			local taken = false
			coin.Touched:Connect(function(hit)
				if taken then
					return
				end
				local player = BuildKit.PlayerFromHit(hit)
				if player and ctx.Alive[player] then
					taken = true
					coins -= 1
					ctx.Scores[player] = (ctx.Scores[player] or 0) + 1
					player:SetAttribute("MinigameScore", ctx.Scores[player])
					Remotes.VFX:FireClient(player, "CoinPop", { Position = coin.Position })
					coin:Destroy()
				end
			end)
		end
		for _ = 1, 20 do
			spawnCoin()
		end
		ctx:Loop(info.Duration, function()
			if coins < 40 then
				spawnCoin()
			end
			return false
		end, function(player)
			-- fell off: put them back
			ctx:Place(player)
			return true
		end)
	end,
	Rewards = function(ctx)
		local info = MG.Games.CoinRush
		local best, bestScore = nil, 0
		local results = {}
		for player in ctx.Participants do
			local score = ctx.Scores[player] or 0
			if score > bestScore then
				best, bestScore = player, score
			end
		end
		for player in ctx.Participants do
			local score = ctx.Scores[player] or 0
			local reward = score * info.CoinValue * rebirthScale(player)
			if player == best then
				reward += info.WinnerBonus * rebirthScale(player)
			end
			table.insert(results, { Player = player, Score = score .. " coins", Reward = reward, Winner = player == best })
		end
		return results
	end,
}

Games.FallingTiles = {
	Setup = function(ctx)
		local c = ctx.Center
		local tiles = 13
		local size = 7
		local offset = (tiles - 1) * size / 2
		for layer = 0, 1 do
			for x = 0, tiles - 1 do
				for z = 0, tiles - 1 do
					local hue = ((x + z) % 6) / 6
					local tile = Part({
						Name = "Tile",
						Size = Vector3.new(size - 0.2, 1, size - 0.2),
						Position = c + Vector3.new(x * size - offset, -layer * 22, z * size - offset),
						Color = Color3.fromHSV(hue, 0.55, 1),
						Material = Enum.Material.SmoothPlastic,
						Parent = ctx.Folder,
					})
					local triggered = false
					tile.Touched:Connect(function(hit)
						if triggered then
							return
						end
						local player = BuildKit.PlayerFromHit(hit)
						if not player or not ctx.Alive[player] or not ctx.Started then
							return
						end
						triggered = true
						tile.Color = Color3.fromRGB(255, 60, 60)
						tile.Material = Enum.Material.Neon
						task.delay(0.5, function()
							tile.CanCollide = false
							TweenService:Create(tile, TweenInfo.new(0.4), { Transparency = 1, Position = tile.Position - Vector3.new(0, 6, 0) }):Play()
							task.delay(0.5, function()
								tile:Destroy()
							end)
						end)
					end)
				end
			end
		end
		ctx.SpawnRadius = 35
		ctx.FallDepth = 45
	end,
	Run = function(ctx)
		ctx:Loop(MG.Games.FallingTiles.Duration, function()
			local alive = ctx:AliveCount()
			if ctx.StartCount > 1 then
				return alive <= 1
			end
			return alive == 0
		end)
	end,
	Rewards = function(ctx)
		return ctx:SurvivalRewards(MG.Games.FallingTiles)
	end,
}

Games.MeteorShower = {
	Setup = function(ctx)
		local c = ctx.Center
		Part({ Name = "Floor", Size = Vector3.new(110, 3, 110), Position = c, Color = Color3.fromRGB(90, 80, 80), Material = Enum.Material.Basalt, Parent = ctx.Folder })
		Part({ Name = "Glow", Size = Vector3.new(112, 2.6, 112), Position = c - Vector3.new(0, 0.4, 0), Color = Color3.fromRGB(255, 100, 0), Material = Enum.Material.Neon, Parent = ctx.Folder })
		ctx.SpawnRadius = 40
		ctx.FallDepth = 30
	end,
	Run = function(ctx)
		local rng = Random.new()
		local elapsed = 0
		local duration = MG.Games.MeteorShower.Duration
		local function meteor()
			local target
			local alive = {}
			for p in ctx.Alive do
				table.insert(alive, p)
			end
			if #alive > 0 and rng:NextNumber() < 0.55 then
				local root = getRoot(alive[rng:NextInteger(1, #alive)])
				if root then
					target = Vector3.new(root.Position.X + rng:NextNumber(-6, 6), ctx.Center.Y + 1.6, root.Position.Z + rng:NextNumber(-6, 6))
				end
			end
			target = target or ctx.Center + Vector3.new(rng:NextNumber(-52, 52), 1.6, rng:NextNumber(-52, 52))
			local radius = 10
			local warning = Part({
				Name = "Warning",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.2, radius * 2, radius * 2),
				CFrame = CFrame.new(target) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.Neon,
				Transparency = 0.5,
				CanCollide = false,
				CanTouch = false,
				Parent = ctx.Folder,
			})
			task.delay(1.3, function()
				if not ctx.Folder.Parent then
					return
				end
				local rock = Part({
					Name = "Meteor",
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * 7,
					Position = target + Vector3.new(rng:NextNumber(-20, 20), 120, rng:NextNumber(-20, 20)),
					Color = Color3.fromRGB(120, 50, 20),
					Material = Enum.Material.CrackedLava,
					CanCollide = false,
					CanTouch = false,
					Parent = ctx.Folder,
				})
				local fire = Instance.new("Fire")
				fire.Size = 12
				fire.Heat = 20
				fire.Parent = rock
				BuildKit.Light(rock, Color3.fromRGB(255, 120, 0), 30, 4)
				local tween = TweenService:Create(rock, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = target })
				tween:Play()
				tween.Completed:Wait()
				warning:Destroy()
				rock:Destroy()
				if not ctx.Folder.Parent then
					return
				end
				local explosion = Instance.new("Explosion")
				explosion.Position = target
				explosion.BlastRadius = radius
				explosion.BlastPressure = 0
				explosion.DestroyJointRadiusPercent = 0
				explosion.Parent = workspace
				Remotes.VFX:FireAllClients("Shockwave", { Position = target, Color = Color3.fromRGB(255, 120, 0), Size = radius * 3 })
				for p in ctx.Alive do
					local root = getRoot(p)
					local humanoid = getHumanoid(p)
					if root and humanoid and (root.Position - target).Magnitude <= radius then
						humanoid:TakeDamage(55)
						root.AssemblyLinearVelocity = ((root.Position - target).Unit + Vector3.new(0, 1.5, 0)) * 50
					end
				end
			end)
		end
		local accumulator = 0
		ctx:Loop(duration, function(dt)
			elapsed += dt
			accumulator += dt
			local interval = math.max(0.15, 0.7 - elapsed / duration * 0.55)
			while accumulator >= interval do
				accumulator -= interval
				meteor()
			end
			return ctx:AliveCount() == 0
		end)
	end,
	Rewards = function(ctx)
		return ctx:SurvivalRewards(MG.Games.MeteorShower)
	end,
}

---------------------------------------------------------------------------
-- Round context
---------------------------------------------------------------------------
local Context = {}
Context.__index = Context

function Context:AliveCount()
	local n = 0
	for _ in self.Alive do
		n += 1
	end
	return n
end

function Context:Place(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local r = self.SpawnRadius or 30
	local offset = Vector3.new(math.random(-r, r), 6, math.random(-r, r))
	character:PivotTo(CFrame.new(self.Center + offset))
	local root = getRoot(player)
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

function Context:Eliminate(player: Player, reason: string?)
	if not self.Alive[player] then
		return
	end
	self.Alive[player] = nil
	self.EliminatedAt[player] = os.clock() - self.StartTime
	player:SetAttribute("InMinigame", nil)
	if player.Parent then
		Remotes.Notify:FireClient(player, { Text = reason or "You were eliminated!", Type = "error" })
		local humanoid = getHumanoid(player)
		if humanoid and humanoid.Health > 0 then
			S.TycoonService:TeleportHome(player)
		end
	end
end

-- Runs the round loop for `duration` seconds. `tick(dt)` returns true to end early.
-- `onFall(player)` returns true if the fall was handled (otherwise: eliminated)
function Context:Loop(duration: number, tick: (number) -> boolean, onFall: ((Player) -> boolean)?)
	local endTime = os.clock() + duration
	local lastBroadcast = 0
	local last = os.clock()
	while os.clock() < endTime do
		local now = os.clock()
		local dt = now - last
		last = now
		for player in self.Alive do
			local root = getRoot(player)
			local humanoid = getHumanoid(player)
			if not player.Parent then
				self.Alive[player] = nil
			elseif not root or not humanoid or humanoid.Health <= 0 then
				self:Eliminate(player, "You died!")
			elseif root.Position.Y < self.Center.Y - (self.FallDepth or 25) then
				if not (onFall and onFall(player)) then
					self:Eliminate(player, "You fell!")
				end
			end
		end
		if tick(dt) then
			break
		end
		if self:AliveCount() == 0 then
			break
		end
		if now - lastBroadcast >= 1 then
			lastBroadcast = now
			broadcast({ Phase = "Playing", Name = self.DisplayName, TimeLeft = math.ceil(endTime - now), Alive = self:AliveCount() })
		end
		task.wait(0.1)
	end
end

function Context:SurvivalRewards(info)
	local results = {}
	local survivors = {}
	for player in self.Alive do
		table.insert(survivors, player)
	end
	local duration = os.clock() - self.StartTime
	for player in self.Participants do
		local survived = self.Alive[player] ~= nil
		local time = survived and duration or (self.EliminatedAt[player] or 0)
		local fraction = math.clamp(time / math.max(duration, 1), 0, 1)
		local reward = math.floor(info.SurviveReward * (survived and 1 or fraction * 0.5) * rebirthScale(player))
		local winner = survived and #survivors <= 3
		if winner then
			reward += info.WinnerBonus * rebirthScale(player)
		end
		table.insert(results, { Player = player, Score = string.format("%.0fs", time), Reward = reward, Winner = winner })
	end
	return results
end

---------------------------------------------------------------------------
function MinigameService:Init(services)
	S = services
	Remotes.MinigameJoin.OnServerEvent:Connect(function(player)
		if not acceptingJoins or joined[player] then
			return
		end
		if not S.DataService:IsLoaded(player) then
			return
		end
		joined[player] = true
		player:SetAttribute("MinigameJoined", true)
		Remotes.Notify:FireClient(player, { Text = "You joined the minigame! Get ready...", Type = "success" })
	end)
	Players.PlayerRemoving:Connect(function(player)
		joined[player] = nil
	end)
end

function MinigameService:ForceStart(name: string?): string
	if running then
		return "A minigame is already running"
	end
	local key
	if name then
		for k in Games do
			if k:lower() == name:lower() then
				key = k
			end
		end
		if not key then
			return "Unknown minigame. Options: CoinRush, FallingTiles, MeteorShower"
		end
	else
		local keys = {}
		for k in Games do
			table.insert(keys, k)
		end
		key = keys[math.random(1, #keys)]
	end
	forced = key
	return "Starting " .. MG.Games[key].DisplayName .. "!"
end

function MinigameService:Start()
	if not MG.Enabled then
		return
	end
	local keys = {}
	for k in Games do
		if MG.Games[k] then
			table.insert(keys, k)
		end
	end
	table.sort(keys)
	local lastKey
	while true do
		local t = MG.Intermission
		while t > 0 and not forced do
			broadcast({ Phase = "Intermission", TimeLeft = t })
			task.wait(1)
			t -= 1
		end
		local key = forced
		forced = nil
		if not key then
			repeat
				key = keys[math.random(1, #keys)]
			until key ~= lastKey or #keys == 1
		end
		lastKey = key
		local ok, err = pcall(self.RunGame, self, key)
		if not ok then
			warn("[Minigames] " .. tostring(err))
		end
		running = false
		acceptingJoins = false
		joined = {}
		for _, p in Players:GetPlayers() do
			p:SetAttribute("MinigameJoined", nil)
			p:SetAttribute("MinigameScore", nil)
		end
	end
end

function MinigameService:RunGame(key: string)
	running = true
	local info = MG.Games[key]
	local def = Games[key]

	-- join window
	joined = {}
	acceptingJoins = true
	for t = MG.JoinTime, 1, -1 do
		broadcast({ Phase = "Join", Game = key, Name = info.DisplayName, Description = info.Description, TimeLeft = t })
		task.wait(1)
	end
	acceptingJoins = false

	local participants = {}
	local count = 0
	for player in joined do
		local humanoid = getHumanoid(player)
		if player.Parent and humanoid and humanoid.Health > 0 then
			participants[player] = true
			count += 1
		end
	end
	if count < MG.MinPlayers then
		broadcast({ Phase = "Cancelled", Name = info.DisplayName, Text = "Not enough players joined." })
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "Minigame_" .. key
	folder.Parent = workspace

	local ctx = setmetatable({
		Key = key,
		DisplayName = info.DisplayName,
		Center = MG.ArenaCenter,
		Folder = folder,
		Participants = participants,
		Alive = table.clone(participants),
		Scores = {},
		EliminatedAt = {},
		StartCount = count,
		Started = false,
		StartTime = os.clock(),
	}, Context)

	local okSetup, setupErr = pcall(def.Setup, ctx)
	if not okSetup then
		warn("[Minigames] setup failed: " .. tostring(setupErr))
		folder:Destroy()
		return
	end

	-- send players in
	local deathConns = {}
	for player in participants do
		player:SetAttribute("InMinigame", true)
		player:SetAttribute("MinigameScore", 0)
		player:SetAttribute("ObbyStage", 0)
		ctx:Place(player)
		local humanoid = getHumanoid(player)
		if humanoid then
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.UseJumpPower = true
			table.insert(deathConns, humanoid.Died:Connect(function()
				ctx:Eliminate(player, "You died!")
			end))
		end
	end
	Remotes.VFX:FireAllClients("Flash", {})

	for n = 3, 1, -1 do
		broadcast({ Phase = "Countdown", Name = info.DisplayName, Count = n })
		task.wait(1)
	end
	broadcast({ Phase = "Countdown", Name = info.DisplayName, Count = 0 })
	for player in ctx.Alive do
		local humanoid = getHumanoid(player)
		if humanoid then
			humanoid.WalkSpeed = S.MonetizationService:GetBaseSpeed(player)
			humanoid.JumpPower = 50
		end
	end
	ctx.Started = true
	ctx.StartTime = os.clock()

	local okRun, runErr = pcall(def.Run, ctx)
	if not okRun then
		warn("[Minigames] run failed: " .. tostring(runErr))
	end

	-- results
	local results = {}
	local okRewards, rewardResult = pcall(def.Rewards, ctx)
	if okRewards then
		results = rewardResult
	end
	table.sort(results, function(a, b)
		return a.Reward > b.Reward
	end)
	local summary = {}
	for _, r in results do
		local player = r.Player
		if player.Parent then
			local data = S.DataService:Get(player)
			if data and r.Reward > 0 then
				S.DataService:AddCash(player, r.Reward, false)
				if r.Winner then
					data.MinigameWins += 1
				end
				Remotes.VFX:FireClient(player, r.Winner and "Confetti" or "CashBurst", { Amount = r.Reward })
			end
		end
		table.insert(summary, { Name = player.DisplayName, Score = r.Score, Reward = r.Reward, Winner = r.Winner })
	end
	broadcast({ Phase = "Results", Name = info.DisplayName, Results = summary })

	for _, conn in deathConns do
		conn:Disconnect()
	end
	for player in participants do
		if player.Parent then
			local wasAlive = player:GetAttribute("InMinigame")
			player:SetAttribute("InMinigame", nil)
			if wasAlive then
				S.TycoonService:TeleportHome(player)
			end
		end
	end
	task.delay(1, function()
		folder:Destroy()
	end)
	local winners = {}
	for _, r in summary do
		if r.Winner then
			table.insert(winners, r.Name)
		end
	end
	if #winners > 0 then
		Remotes.Announce:FireAllClients({
			Title = "🏆 " .. info.DisplayName .. " Winner" .. (#winners > 1 and "s" or ""),
			Text = table.concat(winners, ", ") .. " won " .. Util.Money(summary[1].Reward) .. "!",
			Color = Color3.fromRGB(170, 80, 255),
		})
	end
	task.wait(6)
end

return MinigameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService - game passes + developer products (Robux shop).
	Pass ownership is mirrored to player attributes "Pass_<Key>" = true.
	Unconfigured items (Id = 0) are simulated in Studio for easy testing.
]]
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local MonetizationService = {}
local S

local purchaseHistory: DataStore? = nil
pcall(function()
	purchaseHistory = DataStoreService:GetDataStore(Config.DataStoreName .. "_Purchases")
end)

local passByKey = Config.GamePasses
local passKeyById: { [number]: string } = {}
local productKeyById: { [number]: string } = {}
for key, pass in passByKey do
	if pass.Id ~= 0 then
		passKeyById[pass.Id] = key
	end
end
for key, product in Config.Products do
	if product.Id ~= 0 then
		productKeyById[product.Id] = key
	end
end

local function canSimulate()
	return RunService:IsStudio() and Config.Monetization.SimulateUnconfiguredInStudio
end

function MonetizationService:Init(services)
	S = services

	S.DataService.PlayerLoaded:Connect(function(player, data)
		for key, pass in passByKey do
			local owns = data.Passes[key] == true
			if not owns and pass.Id ~= 0 then
				local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
				owns = ok and result == true
			end
			if owns then
				self:_applyPass(player, key, false)
			end
		end
		S.DataService:RefreshMultiplier(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			self:_applyCharacterPerks(player, character)
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function(character)
			self:_applyCharacterPerks(player, character)
		end)
	end

	Remotes.BuyPass.OnServerEvent:Connect(function(player, key)
		self:PromptPass(player, key)
	end)
	Remotes.BuyProduct.OnServerEvent:Connect(function(player, key)
		self:PromptProduct(player, key)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passKeyById[passId] then
			self:_applyPass(player, passKeyById[passId], true)
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		return self:_processReceipt(receipt)
	end
end

function MonetizationService:HasPass(player: Player, key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

function MonetizationService:GetBaseSpeed(player: Player): number
	return self:HasPass(player, "SuperSpeed") and Config.BaseWalkSpeed * 2 or Config.BaseWalkSpeed
end

-- grant = also store in data (admin / simulated purchases)
function MonetizationService:GrantPass(player: Player, key: string)
	local data = S.DataService:Get(player)
	if data then
		data.Passes[key] = true
	end
	self:_applyPass(player, key, true)
end

function MonetizationService:RevokePass(player: Player, key: string)
	local data = S.DataService:Get(player)
	if data then
		data.Passes[key] = nil
	end
	player:SetAttribute("Pass_" .. key, nil)
	S.DataService:RefreshMultiplier(player)
end

function MonetizationService:_applyPass(player: Player, key: string, announce: boolean)
	if not passByKey[key] then
		return
	end
	player:SetAttribute("Pass_" .. key, true)
	S.DataService:RefreshMultiplier(player)
	if key == "AutoCollect" and S.TycoonService then
		S.TycoonService:CollectVault(player)
		S.TycoonService:RefreshVaultLabel(player)
	end
	if player.Character then
		self:_applyCharacterPerks(player, player.Character)
	end
	if announce then
		local pass = passByKey[key]
		Remotes.Notify:FireClient(player, { Text = "Thanks for buying " .. pass.Name .. "! " .. pass.Icon, Type = "success", Duration = 6 })
		Remotes.VFX:FireAllClients("Purchase", { Position = player.Character and player.Character:GetPivot().Position, Color = pass.Color, Big = true })
		Remotes.Announce:FireAllClients({ Title = "🎉 " .. player.DisplayName .. " bought " .. pass.Name .. "!", Text = pass.Description, Color = pass.Color })
	end
end

function MonetizationService:_applyCharacterPerks(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = self:GetBaseSpeed(player)
	if self:HasPass(player, "VIP") then
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and not root:FindFirstChild("VIPAura") then
			local attachment = Instance.new("Attachment")
			attachment.Name = "VIPAura"
			attachment.Parent = root
			local sparkle = Instance.new("ParticleEmitter")
			sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
			sparkle.LightEmission = 1
			sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
			sparkle.Rate = 8
			sparkle.Lifetime = NumberRange.new(1, 1.5)
			sparkle.Speed = NumberRange.new(1, 2)
			sparkle.SpreadAngle = Vector2.new(180, 180)
			sparkle.Parent = attachment
		end
		local head = character:FindFirstChild("Head")
		if head and not head:FindFirstChild("VIPTag") then
			local tag = Instance.new("BillboardGui")
			tag.Name = "VIPTag"
			tag.Size = UDim2.fromOffset(80, 26)
			tag.StudsOffset = Vector3.new(0, 2.6, 0)
			tag.AlwaysOnTop = false
			tag.MaxDistance = 80
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.Text = "👑 VIP"
			label.TextScaled = true
			label.Font = Enum.Font.FredokaOne
			label.TextColor3 = Color3.fromRGB(255, 210, 0)
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 2
			stroke.Parent = label
			label.Parent = tag
			tag.Parent = head
		end
	end
end

function MonetizationService:PromptPass(player: Player, key: any)
	local pass = type(key) == "string" and passByKey[key]
	if not pass then
		return
	end
	if self:HasPass(player, key) then
		Remotes.Notify:FireClient(player, { Text = "You already own " .. pass.Name .. "!", Type = "info" })
		return
	end
	if pass.Id == 0 then
		if canSimulate() then
			Remotes.Notify:FireClient(player, { Text = "[Studio] Simulated purchase of " .. pass.Name, Type = "info" })
			self:GrantPass(player, key)
		else
			Remotes.Notify:FireClient(player, { Text = "This pass isn't available yet!", Type = "error" })
		end
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

function MonetizationService:PromptProduct(player: Player, key: any)
	local product = type(key) == "string" and Config.Products[key]
	if not product then
		return
	end
	if product.Id == 0 then
		if canSimulate() then
			Remotes.Notify:FireClient(player, { Text = "[Studio] Simulated purchase of " .. product.Name, Type = "info" })
			self:_grantProduct(player, key)
		else
			Remotes.Notify:FireClient(player, { Text = "This product isn't available yet!", Type = "error" })
		end
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

function MonetizationService:_grantProduct(player: Player, key: string): boolean
	local product = Config.Products[key]
	local data = S.DataService:Get(player)
	if not product or not data then
		return false
	end
	if product.Cash then
		local amount = product.Cash * (1 + data.Rebirths)
		S.DataService:AddCash(player, amount, false)
		Remotes.Notify:FireClient(player, { Text = "+" .. Util.Money(amount) .. " added! Thank you! 💰", Type = "success", Duration = 6 })
		Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
	end
	if product.BoostSeconds then
		S.DataService:AddBoost(player, product.BoostSeconds)
		Remotes.Notify:FireClient(player, { Text = "2x Boost activated! 🚀", Type = "success", Duration = 6 })
	end
	if product.ServerEvent == "CashRain" then
		self:CashRain(player.DisplayName)
	end
	Remotes.VFX:FireClient(player, "Confetti", {})
	return true
end

-- Everybody in the server gets cash, with a big falling-cash effect
function MonetizationService:CashRain(byName: string)
	Remotes.Announce:FireAllClients({
		Title = "🌧️ CASH RAIN! 🌧️",
		Text = byName .. " made it rain for the whole server!",
		Color = Color3.fromRGB(80, 220, 120),
	})
	Remotes.VFX:FireAllClients("CashRain", { Duration = 8 })
	for _, p in Players:GetPlayers() do
		local data = S.DataService:Get(p)
		if data then
			local amount = 5_000 * (1 + data.Rebirths)
			S.DataService:AddCash(p, amount, false)
			Remotes.Notify:FireClient(p, { Text = "Cash Rain: +" .. Util.Money(amount), Type = "success" })
		end
	end
end

function MonetizationService:_processReceipt(receipt)
	local key = productKeyById[receipt.ProductId]
	if not key then
		warn("[Monetization] Unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not S.DataService:IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local historyKey = receipt.PlayerId .. "_" .. receipt.PurchaseId
	if purchaseHistory then
		local ok, already = pcall(function()
			return (purchaseHistory :: DataStore):GetAsync(historyKey)
		end)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if already then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	local granted = self:_grantProduct(player, key)
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- persist the player's data right away so the purchase is never lost
	S.DataService:Save(player)
	if purchaseHistory then
		pcall(function()
			(purchaseHistory :: DataStore):SetAsync(historyKey, true)
		end)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ObbyService</string>
          <string name="Source"><![CDATA[--[[
	ObbyService - generates an obstacle course west of the lobby with
	checkpoints, kill bricks, spinners, trusses and a finish reward.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part

local ObbyService = {}
local S

local checkpoints: { [number]: CFrame } = {}
local spinners = {}
local startTimes: { [Player]: number } = {}
local finishDebounce: { [Player]: boolean } = {}

local START_X = -215
local KILL_COLOR = Color3.fromRGB(255, 40, 40)

local folder: Model
local rng = Random.new(2024)

local function platform(size: Vector3, pos: Vector3, color: Color3?)
	return Part({
		Name = "Platform",
		Size = size,
		Position = pos,
		Color = color or Color3.fromHSV(rng:NextNumber(), 0.55, 0.95),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function killPart(props)
	props.Color = KILL_COLOR
	props.Material = Enum.Material.Neon
	props.Parent = props.Parent or folder
	local part = Part(props)
	part:SetAttribute("Kill", true)
	part.Touched:Connect(function(hit)
		local _, humanoid = BuildKit.PlayerFromHit(hit)
		if humanoid then
			humanoid.Health = 0
		end
	end)
	return part
end

-- every segment starts at the edge `x` (previous platform ends there) at height `y`
local segments = {}

function segments.Jumps(x: number, y: number)
	for _ = 1, 5 do
		local gap = rng:NextNumber(3.5, 5.5)
		local size = rng:NextNumber(5, 7)
		y += rng:NextNumber(0, 1.5)
		local cx = x - gap - size / 2
		platform(Vector3.new(size, 1, size), Vector3.new(cx, y, rng:NextNumber(-4, 4)))
		x = cx - size / 2
	end
	return x, y
end

function segments.KillBricks(x: number, y: number)
	local length = 40
	platform(Vector3.new(length, 1, 10), Vector3.new(x - length / 2, y, 0), Color3.fromRGB(60, 60, 75))
	for i = 1, 4 do
		killPart({ Name = "KillBrick", Size = Vector3.new(1.6, 1.4, 10), Position = Vector3.new(x - i * 8, y + 1.2, 0) })
	end
	return x - length, y
end

function segments.Beam(x: number, y: number)
	local length = 28
	platform(Vector3.new(length, 1, 1.4), Vector3.new(x - length / 2, y, 0), Color3.fromRGB(255, 200, 40))
	platform(Vector3.new(8, 1, 8), Vector3.new(x - length - 4, y, 0))
	return x - length - 8, y
end

function segments.Truss(x: number, y: number)
	local height = 18
	local truss = Instance.new("TrussPart")
	truss.Anchored = true
	truss.Size = Vector3.new(2, height, 2)
	truss.Position = Vector3.new(x - 1, y + height / 2 - 0.5, 0)
	truss.Color = Color3.fromRGB(90, 90, 100)
	truss.Parent = folder
	y += height
	platform(Vector3.new(10, 1, 10), Vector3.new(x - 2 - 5, y, 0))
	return x - 12, y
end

function segments.Spinner(x: number, y: number)
	local size = 26
	local center = Vector3.new(x - size / 2, y, 0)
	platform(Vector3.new(size, 1, size), center, Color3.fromRGB(70, 70, 90))
	local bar = killPart({ Name = "Spinner", Size = Vector3.new(24, 1.2, 1.2), Position = center + Vector3.new(0, 1.6, 0) })
	Part({ Name = "Hub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(center + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = folder })
	table.insert(spinners, { Part = bar, Center = center + Vector3.new(0, 1.6, 0), Speed = rng:NextNumber(1.6, 2.4) * (rng:NextNumber() > 0.5 and 1 or -1), Angle = 0 })
	return x - size, y
end

function segments.Stairs(x: number, y: number)
	for _ = 1, 6 do
		y += 2
		platform(Vector3.new(4, 1, 8), Vector3.new(x - 2 - 2, y, 0))
		x -= 6
	end
	return x, y
end

function segments.Zigzag(x: number, y: number)
	local side = 1
	for _ = 1, 6 do
		local cx = x - 6
		platform(Vector3.new(4, 1, 4), Vector3.new(cx, y, side * 4))
		side = -side
		x = cx - 2
	end
	return x, y
end

local LAYOUT = {
	"Jumps", "KillBricks", "Checkpoint",
	"Beam", "Jumps", "Checkpoint",
	"Truss", "Spinner", "Checkpoint",
	"Zigzag", "Stairs", "Checkpoint",
	"KillBricks", "Beam", "Checkpoint",
	"Spinner", "Jumps", "Checkpoint",
	"Truss", "Zigzag", "Spinner", "Finish",
}

function ObbyService:Init(services)
	S = services
	folder = BuildKit.Model("Obby", workspace)

	-- start area
	local start = platform(Vector3.new(20, 1, 22), Vector3.new(START_X, 0.5, 0), Color3.fromRGB(0, 200, 255))
	start.Material = Enum.Material.Neon
	for _, z in { -10, 10 } do
		Part({ Name = "Arch", Size = Vector3.new(2, 16, 2), Position = Vector3.new(START_X - 9, 8, z), Color = Color3.fromRGB(40, 40, 55), Material = Enum.Material.Metal, Parent = folder })
	end
	local arch = Part({ Name = "ArchTop", Size = Vector3.new(2, 4, 22), Position = Vector3.new(START_X - 9, 17, 0), Color = Color3.fromRGB(255, 80, 160), Material = Enum.Material.Neon, Parent = folder })
	BuildKit.SurfaceText(arch, Enum.NormalId.Right, "🏃 OBBY - " .. Util.Money(Config.Obby.Reward) .. "+ REWARD", { PixelsPerStud = 18 })
	local startLine = Part({ Name = "StartLine", Size = Vector3.new(1, 14, 18), Position = Vector3.new(START_X - 9, 7, 0), Transparency = 1, CanCollide = false, Parent = folder })
	startLine.Touched:Connect(function(hit)
		local player = BuildKit.PlayerFromHit(hit)
		if player and (player:GetAttribute("ObbyStage") or 0) == 0 then
			startTimes[player] = os.clock()
			player:SetAttribute("ObbyStage", 0)
		end
	end)

	local x, y = START_X - 10, 4
	platform(Vector3.new(8, 1, 8), Vector3.new(x - 6, y, 0))
	x -= 10
	local stage = 0
	for _, name in LAYOUT do
		if name == "Checkpoint" or name == "Finish" then
			local isFinish = name == "Finish"
			x -= 4
			local pad = platform(Vector3.new(12, 1, 12), Vector3.new(x - 6, y, 0), isFinish and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(60, 220, 100))
			pad.Material = Enum.Material.Neon
			if isFinish then
				self:_buildFinish(pad)
			else
				stage += 1
				local thisStage = stage
				checkpoints[thisStage] = CFrame.lookAt(pad.Position + Vector3.new(0, 4, 0), pad.Position + Vector3.new(-10, 4, 0))
				local flag = Part({ Name = "Flag", Size = Vector3.new(0.4, 8, 0.4), Position = pad.Position + Vector3.new(4, 4.5, 4), Color = Color3.fromRGB(230, 230, 230), Parent = folder })
				local cloth = Part({ Name = "Cloth", Size = Vector3.new(0.2, 2.4, 3.6), Position = flag.Position + Vector3.new(0, 2.6, -1.9), Color = Color3.fromRGB(60, 220, 100), Material = Enum.Material.Fabric, Parent = folder })
				BuildKit.Billboard(pad, "CHECKPOINT " .. thisStage, { Size = UDim2.fromOffset(180, 36), Offset = Vector3.new(0, 5, 0), Color = Color3.fromRGB(150, 255, 170), MaxDistance = 90 })
				pad.Touched:Connect(function(hit)
					local player = BuildKit.PlayerFromHit(hit)
					if player and (player:GetAttribute("ObbyStage") or 0) < thisStage then
						player:SetAttribute("ObbyStage", thisStage)
						cloth.Color = Color3.fromRGB(255, 220, 40)
						Remotes.Notify:FireClient(player, { Text = "Checkpoint " .. thisStage .. " reached!", Type = "success" })
						Remotes.VFX:FireClient(player, "Confetti", { Position = pad.Position + Vector3.new(0, 3, 0), Small = true })
					end
				end)
			end
			x -= 12
		else
			x, y = segments[name](x, y)
		end
	end

	-- lava floor under the whole course
	local length = START_X - 12 - x + 40
	killPart({
		Name = "Lava",
		Size = Vector3.new(length, 1, 70),
		Position = Vector3.new(START_X - 12 - length / 2, 0.4, 0),
	}).Color = Color3.fromRGB(255, 90, 0)

	Players.PlayerRemoving:Connect(function(player)
		startTimes[player] = nil
		finishDebounce[player] = nil
	end)
end

function ObbyService:_buildFinish(pad: BasePart)
	local trophy = Part({
		Name = "Trophy",
		Size = Vector3.new(3, 4, 3),
		Position = pad.Position + Vector3.new(0, 4, 0),
		Color = Color3.fromRGB(255, 210, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin", "Bob" },
		Parent = folder,
	})
	BuildKit.Light(trophy, Color3.fromRGB(255, 210, 40), 30, 3)
	BuildKit.Particles(trophy, { Color = ColorSequence.new(Color3.fromRGB(255, 230, 80)), Size = BuildKit.Size(1), Rate = 25, SpreadAngle = Vector2.new(180, 180) })
	BuildKit.Billboard(pad, "🏆 FINISH! 🏆", { Size = UDim2.fromOffset(220, 50), Offset = Vector3.new(0, 9, 0), Color = Color3.fromRGB(255, 220, 60), MaxDistance = 150 })

	pad.Touched:Connect(function(hit)
		local player = BuildKit.PlayerFromHit(hit)
		if not player or finishDebounce[player] then
			return
		end
		if (player:GetAttribute("ObbyStage") or 0) <= 0 then
			return -- must have actually run the course
		end
		finishDebounce[player] = true
		self:_finish(player)
		task.delay(3, function()
			finishDebounce[player] = nil
			if player.Parent then
				player:SetAttribute("ObbyStage", 0)
				S.TycoonService:TeleportHome(player)
			end
		end)
	end)
end

function ObbyService:_finish(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local elapsed = startTimes[player] and (os.clock() - startTimes[player]) or nil
	startTimes[player] = nil
	data.ObbyCompletions += 1
	Remotes.VFX:FireClient(player, "Confetti", {})
	Remotes.VFX:FireClient(player, "WinSound", {})
	local now = os.time()
	if now - data.LastObbyReward >= Config.Obby.Cooldown then
		data.LastObbyReward = now
		local reward = Config.Obby.Reward * (1 + data.Rebirths)
		S.DataService:AddCash(player, reward, false)
		Remotes.Notify:FireClient(player, { Text = "Obby complete! +" .. Util.Money(reward), Type = "success", Duration = 6 })
		Remotes.VFX:FireClient(player, "CashBurst", { Amount = reward })
	else
		Remotes.Notify:FireClient(player, {
			Text = "Obby complete! Next reward in " .. Util.FormatTime(Config.Obby.Cooldown - (now - data.LastObbyReward)),
			Type = "info",
			Duration = 6,
		})
	end
	Remotes.Announce:FireAllClients({
		Title = "🏃 " .. player.DisplayName .. " beat the obby!",
		Text = elapsed and ("Time: " .. string.format("%.1f", elapsed) .. "s") or "",
		Color = Color3.fromRGB(255, 80, 160),
	})
end

function ObbyService:GetCheckpointCFrame(stage: number): CFrame?
	return checkpoints[stage]
end

function ObbyService:Start()
	RunService.Heartbeat:Connect(function(dt)
		for _, spinner in spinners do
			spinner.Angle += dt * spinner.Speed
			spinner.Part.CFrame = CFrame.new(spinner.Center) * CFrame.Angles(0, spinner.Angle, 0)
		end
	end)
end

return ObbyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--[[
	RewardService - daily rewards (with streaks), codes and settings saving.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local RewardService = {}
local S

local codeCooldown: { [Player]: number } = {}

function RewardService:Init(services)
	S = services

	Remotes.ClaimDaily.OnServerInvoke = function(player)
		return self:ClaimDaily(player)
	end
	Remotes.RedeemCode.OnServerInvoke = function(player, code)
		return self:Redeem(player, code)
	end
	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		local data = S.DataService:Get(player)
		if not data or type(settings) ~= "table" then
			return
		end
		if type(settings.MusicVolume) == "number" then
			data.Settings.MusicVolume = math.clamp(settings.MusicVolume, 0, 1)
		end
		if type(settings.SFX) == "boolean" then
			data.Settings.SFX = settings.SFX
		end
		if type(settings.LowGraphics) == "boolean" then
			data.Settings.LowGraphics = settings.LowGraphics
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		codeCooldown[player] = nil
	end)
end

function RewardService:GetDailyReward(player: Player, streak: number): number
	local rewards = Config.Daily.Rewards
	local base = rewards[((streak - 1) % #rewards) + 1]
	local amount = base * (1 + (player:GetAttribute("Rebirths") or 0))
	if S.MonetizationService:HasPass(player, "VIP") then
		amount *= 2
	end
	return amount
end

function RewardService:ClaimDaily(player: Player): (boolean, string)
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	local now = os.time()
	local since = now - data.LastDaily
	if since < Config.Daily.Cooldown then
		return false, "Come back in " .. Util.FormatTime(Config.Daily.Cooldown - since)
	end
	if since > Config.Daily.StreakResetAfter then
		data.DailyStreak = 0
	end
	data.DailyStreak += 1
	data.LastDaily = now
	local amount = self:GetDailyReward(player, data.DailyStreak)
	S.DataService:AddCash(player, amount, false)
	S.DataService:Sync(player)
	Remotes.VFX:FireClient(player, "Confetti", {})
	Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
	return true, "Day " .. data.DailyStreak .. " reward: +" .. Util.Money(amount) .. "!"
end

function RewardService:Redeem(player: Player, code: any): (boolean, string)
	if type(code) ~= "string" then
		return false, "Invalid code"
	end
	if codeCooldown[player] and os.clock() - codeCooldown[player] < 2 then
		return false, "Slow down!"
	end
	codeCooldown[player] = os.clock()
	local data = S.DataService:Get(player)
	if not data then
		return false, "Data still loading..."
	end
	code = code:upper():gsub("%s", "")
	local reward = Config.Codes[code]
	if not reward or reward.Expired then
		return false, "That code doesn't exist or expired."
	end
	if data.RedeemedCodes[code] then
		return false, "You already redeemed this code!"
	end
	data.RedeemedCodes[code] = true
	local parts = {}
	if reward.Cash then
		local amount = reward.Cash * (1 + data.Rebirths)
		S.DataService:AddCash(player, amount, false)
		table.insert(parts, "+" .. Util.Money(amount))
		Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
	end
	if reward.BoostSeconds then
		S.DataService:AddBoost(player, reward.BoostSeconds)
		table.insert(parts, "2x Boost for " .. Util.FormatTime(reward.BoostSeconds))
	end
	Remotes.VFX:FireClient(player, "Confetti", {})
	return true, "Code redeemed! " .. table.concat(parts, " & ")
end

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">TycoonBuilder</string>
          <string name="Source"><![CDATA[--[[
	TycoonBuilder - procedural geometry for plots, buttons and every tycoon item.
	All positions are relative to the plot CFrame (see TycoonItems.luau).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part

local TycoonBuilder = {}

local PLOT_COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(80, 160, 255),
	Color3.fromRGB(90, 220, 110),
	Color3.fromRGB(255, 200, 40),
	Color3.fromRGB(190, 90, 255),
	Color3.fromRGB(255, 130, 40),
}

local function at(cf: CFrame, x: number, y: number, z: number): CFrame
	return cf * CFrame.new(x, y, z)
end

---------------------------------------------------------------------------
-- Plot base (always present)
---------------------------------------------------------------------------
function TycoonBuilder.BuildPlot(index: number, cf: CFrame, parent: Instance)
	local color = PLOT_COLORS[(index - 1) % #PLOT_COLORS + 1]
	local model = BuildKit.Model("Plot" .. index, parent)
	model:SetAttribute("PlotIndex", index)

	local base = BuildKit.Model("Base", model)
	Part({
		Name = "Floor",
		Size = Vector3.new(120, 1, 120),
		CFrame = at(cf, 0, 0.5, 0),
		Color = Color3.fromRGB(225, 225, 230),
		Material = Enum.Material.Concrete,
		Parent = base,
	})
	-- glowing border
	for _, data in {
		{ Vector3.new(120, 0.3, 1), Vector3.new(0, 1.1, -59.5) },
		{ Vector3.new(120, 0.3, 1), Vector3.new(0, 1.1, 59.5) },
		{ Vector3.new(1, 0.3, 120), Vector3.new(-59.5, 1.1, 0) },
		{ Vector3.new(1, 0.3, 120), Vector3.new(59.5, 1.1, 0) },
	} do
		Part({ Name = "Border", Size = data[1], CFrame = at(cf, data[2].X, data[2].Y, data[2].Z), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = base })
	end

	-- entrance gate with owner name
	for _, x in { -11, 11 } do
		Part({ Name = "GatePillar", Size = Vector3.new(2, 16, 2), CFrame = at(cf, x, 8, -58), Color = Color3.fromRGB(45, 45, 60), Material = Enum.Material.Metal, Parent = base })
		local orb = Part({ Name = "GateOrb", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, CFrame = at(cf, x, 17, -58), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = base })
		BuildKit.Light(orb, color, 20, 2)
	end
	local beam = Part({ Name = "GateSign", Size = Vector3.new(24, 4, 1.2), CFrame = at(cf, 0, 14, -58), Color = color, Material = Enum.Material.SmoothPlastic, Parent = base })
	local _, signLabel = BuildKit.SurfaceText(beam, Enum.NormalId.Front, "EMPTY PLOT", { PixelsPerStud = 20 })
	local _, signLabelBack = BuildKit.SurfaceText(beam, Enum.NormalId.Back, "EMPTY PLOT", { PixelsPerStud = 20 })

	-- conveyor
	local conveyor = Part({
		Name = "Conveyor",
		Size = Vector3.new(100, 1, 6),
		CFrame = at(cf, -2, 1.5, 10),
		Color = Color3.fromRGB(40, 40, 48),
		Material = Enum.Material.DiamondPlate,
		Parent = base,
	})
	conveyor.AssemblyLinearVelocity = cf.RightVector * Config.ConveyorSpeed
	for _, z in { 6.7, 13.3 } do
		Part({ Name = "Rail", Size = Vector3.new(100, 1.4, 0.6), CFrame = at(cf, -2, 2.7, z), Color = color, Material = Enum.Material.Neon, Parent = base })
	end
	-- end cap behind the first dropper
	Part({ Name = "Rail", Size = Vector3.new(0.6, 1.4, 7.2), CFrame = at(cf, -52, 2.7, 10), Color = color, Material = Enum.Material.Neon, Parent = base })

	-- collector
	local collector = Part({
		Name = "Collector",
		Size = Vector3.new(5, 4, 8),
		CFrame = at(cf, 50.5, 2, 10),
		Color = Color3.fromRGB(40, 230, 110),
		Material = Enum.Material.Neon,
		Tags = { "Pulse" },
		Parent = base,
	})
	BuildKit.Billboard(collector, "COLLECTOR", { Size = UDim2.fromOffset(160, 36), Offset = Vector3.new(0, 4, 0), Color = Color3.fromRGB(120, 255, 160), MaxDistance = 80 })
	BuildKit.Particles(collector, {
		Color = ColorSequence.new(Color3.fromRGB(120, 255, 160)),
		Size = BuildKit.Size(0.6),
		Rate = 6,
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
	})

	-- vault collect pad
	local pad = Part({
		Name = "CollectPad",
		Size = Vector3.new(7, 0.5, 7),
		CFrame = at(cf, 50, 1.25, -3),
		Color = Color3.fromRGB(255, 200, 30),
		Material = Enum.Material.Neon,
		Tags = { "Pulse" },
		Parent = base,
	})
	local _, vaultLabel = BuildKit.Billboard(pad, "🏦 VAULT: $0\nStep here to collect", {
		Size = UDim2.fromOffset(220, 64),
		Offset = Vector3.new(0, 4, 0),
		Color = Color3.fromRGB(255, 225, 90),
		MaxDistance = 90,
	})

	local folders = {}
	for _, name in { "Items", "Buttons", "Drops" } do
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = model
		folders[name] = f
	end

	return {
		Index = index,
		CFrame = cf,
		Color = color,
		Model = model,
		Items = folders.Items,
		Buttons = folders.Buttons,
		Drops = folders.Drops,
		SignLabels = { signLabel, signLabelBack },
		Conveyor = conveyor,
		Collector = collector,
		CollectPad = pad,
		VaultLabel = vaultLabel,
		SpawnCFrame = at(cf, 0, 4, -48) * CFrame.Angles(0, math.pi, 0),
	}
end

---------------------------------------------------------------------------
-- Purchase button
---------------------------------------------------------------------------
function TycoonBuilder.BuildButton(plot, item)
	local pos: Vector3 = item.ButtonPos
	local model = BuildKit.Model(item.Id, plot.Buttons)
	local base = Part({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 6.2, 6.2),
		CFrame = at(plot.CFrame, pos.X, 1.2, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(30, 30, 40),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	local pad = Part({
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 5, 5),
		CFrame = at(plot.CFrame, pos.X, 1.4, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(235, 70, 70),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	local gui, label = BuildKit.Billboard(pad, item.Name .. "\n" .. Util.Money(item.Cost), {
		Size = UDim2.fromOffset(170, 56),
		Offset = Vector3.new(0, 3.5, 0),
		MaxDistance = 70,
	})
	model.PrimaryPart = base
	-- tiny spawn-in pop
	pad.Size = Vector3.new(0.6, 0.5, 0.5)
	game:GetService("TweenService"):Create(pad, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = Vector3.new(0.6, 5, 5) }):Play()
	return { Model = model, Pad = pad, Label = label, Gui = gui }
end

---------------------------------------------------------------------------
-- Items
---------------------------------------------------------------------------
local builders = {}

function builders.Dropper(plot, item, model: Model)
	local p: Vector3 = item.Pos
	local cf = plot.CFrame
	local color: Color3 = item.Color or Color3.new(0.7, 0.7, 0.7)
	local material = item.Material or Enum.Material.SmoothPlastic
	local tier = item.Tier or 1

	Part({ Name = "Pillar", Size = Vector3.new(1.4, 13, 1.4), CFrame = at(cf, p.X, 7, p.Z + 5.2), Color = Color3.fromRGB(50, 50, 60), Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Arm", Size = Vector3.new(1.4, 1.4, 4), CFrame = at(cf, p.X, 12, p.Z + 3), Color = Color3.fromRGB(50, 50, 60), Material = Enum.Material.Metal, Parent = model })
	local body = Part({ Name = "Body", Size = Vector3.new(4.5, 4, 4.5), CFrame = at(cf, p.X, 11, p.Z), Color = color, Material = material, Parent = model })
	Part({ Name = "Band", Size = Vector3.new(4.7, 0.6, 4.7), CFrame = at(cf, p.X, 10, p.Z), Color = plot.Color, Material = Enum.Material.Neon, Parent = model })
	Part({ Name = "Funnel", Size = Vector3.new(2.6, 1.6, 2.6), CFrame = at(cf, p.X, 8.2, p.Z), Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = model })
	local gem = Part({
		Name = "Gem",
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = at(cf, p.X, 14, p.Z) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin" },
		Parent = model,
	})
	if tier >= 4 then
		BuildKit.Particles(body, {
			Color = ColorSequence.new(color),
			Size = BuildKit.Size(0.5),
			Rate = 3 + tier,
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(180, 180),
		})
	end
	if tier >= 6 then
		BuildKit.Light(gem, color, 14, 2)
	end
	if tier >= 9 then
		BuildKit.Particles(gem, {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Color = ColorSequence.new(Color3.fromRGB(140, 60, 255), Color3.fromRGB(0, 220, 255)),
			Size = BuildKit.Size(1.2),
			Rate = 20,
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(180, 180),
			RotSpeed = NumberRange.new(-90, 90),
		})
	end
	BuildKit.Billboard(body, item.Name, { Size = UDim2.fromOffset(120, 24), Offset = Vector3.new(0, 5.5, 0), MaxDistance = 50, Color = color:Lerp(Color3.new(1, 1, 1), 0.4) })
	return { Spout = (at(cf, p.X, 6.8, p.Z)).Position }
end

function builders.Upgrader(plot, item, model: Model)
	local p: Vector3 = item.Pos
	local cf = plot.CFrame
	local color: Color3 = item.Color or Color3.fromRGB(0, 170, 255)
	for _, dz in { -4.4, 4.4 } do
		Part({ Name = "Pillar", Size = Vector3.new(1.6, 8, 1.6), CFrame = at(cf, p.X, 5, p.Z + dz), Color = Color3.fromRGB(45, 45, 55), Material = Enum.Material.Metal, Parent = model })
	end
	Part({ Name = "Top", Size = Vector3.new(2.4, 1.4, 10.4), CFrame = at(cf, p.X, 9.4, p.Z), Color = color, Material = Enum.Material.Neon, Parent = model })
	local detector = Part({
		Name = "Detector",
		Size = Vector3.new(1.6, 5.5, 6),
		CFrame = at(cf, p.X, 5, p.Z),
		Color = color,
		Material = Enum.Material.ForceField,
		Transparency = 0.2,
		CanCollide = false,
		Parent = model,
	})
	BuildKit.Light(detector, color, 14, 2)
	BuildKit.Particles(detector, {
		Color = ColorSequence.new(color),
		Size = BuildKit.Size(0.4),
		Rate = 12,
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
	})
	local ring = Part({
		Name = "Ring",
		Size = Vector3.new(0.4, 3, 3),
		CFrame = at(cf, p.X, 12, p.Z),
		Color = color,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
		Tags = { "Spin" },
		Parent = model,
	})
	BuildKit.Billboard(ring, "x" .. tostring(item.Multiplier), { Size = UDim2.fromOffset(80, 30), Offset = Vector3.new(0, 2.5, 0), MaxDistance = 60, Color = color:Lerp(Color3.new(1, 1, 1), 0.5) })
	return { Detector = detector }
end

function builders.Walls(plot, item, model: Model)
	local cf = plot.CFrame
	local wallColor = Color3.fromRGB(235, 230, 220)
	local size, pos, strip
	if item.Side == "Left" then
		size, pos, strip = Vector3.new(2, 14, 118), Vector3.new(-59, 8, 0), Vector3.new(2.4, 0.8, 118)
	elseif item.Side == "Right" then
		size, pos, strip = Vector3.new(2, 14, 118), Vector3.new(59, 8, 0), Vector3.new(2.4, 0.8, 118)
	else
		size, pos, strip = Vector3.new(118, 14, 2), Vector3.new(0, 8, 59), Vector3.new(118, 0.8, 2.4)
	end
	Part({ Name = "Wall", Size = size, CFrame = at(cf, pos.X, pos.Y, pos.Z), Color = wallColor, Material = Enum.Material.Brick, Parent = model })
	Part({ Name = "Trim", Size = strip, CFrame = at(cf, pos.X, 15.2, pos.Z), Color = plot.Color, Material = Enum.Material.Neon, Parent = model })
	Part({ Name = "Trim", Size = strip, CFrame = at(cf, pos.X, 1.4, pos.Z), Color = plot.Color, Material = Enum.Material.Neon, Parent = model })
	-- windows
	for i = -2, 2 do
		local offset = i * 22
		local wsize = item.Side == "Back" and Vector3.new(10, 5, 2.2) or Vector3.new(2.2, 5, 10)
		local wpos = item.Side == "Back" and Vector3.new(offset, 9, pos.Z) or Vector3.new(pos.X, 9, offset)
		Part({ Name = "Window", Size = wsize, CFrame = at(cf, wpos.X, wpos.Y, wpos.Z), Color = Color3.fromRGB(150, 210, 255), Material = Enum.Material.Glass, Transparency = 0.4, Parent = model })
	end
	return {}
end

local decor = {}

function decor.Garden(plot, item, model: Model)
	local cf = plot.CFrame
	local p: Vector3 = item.Pos
	Part({ Name = "Grass", Size = Vector3.new(30, 0.4, 26), CFrame = at(cf, p.X, 1.2, p.Z), Color = Color3.fromRGB(80, 170, 70), Material = Enum.Material.Grass, Parent = model })
	local rng = Random.new(plot.Index * 77)
	for i = 1, 5 do
		local x = p.X + rng:NextNumber(-11, 11)
		local z = p.Z + rng:NextNumber(-9, 9)
		local h = rng:NextNumber(6, 10)
		Part({ Name = "Trunk", Size = Vector3.new(1.2, h, 1.2), CFrame = at(cf, x, 1.4 + h / 2, z), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Wood, Parent = model })
		Part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * rng:NextNumber(5, 7),
			CFrame = at(cf, x, 1.4 + h, z),
			Color = Color3.fromHSV(0.25 + i * 0.02, 0.65, 0.65),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = model,
		})
	end
	for i = 1, 14 do
		local flower = Part({
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.9,
			CFrame = at(cf, p.X + rng:NextNumber(-13, 13), 1.8, p.Z + rng:NextNumber(-11, 11)),
			Color = Color3.fromHSV(rng:NextNumber(), 0.7, 1),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
		flower.Name = "Flower" .. i
	end
	return {}
end

function decor.Fountain(plot, item, model: Model)
	local cf = plot.CFrame
	local p: Vector3 = item.Pos
	local flat = CFrame.Angles(0, 0, math.rad(90))
	Part({ Name = "Basin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 18, 18), CFrame = at(cf, p.X, 2, p.Z) * flat, Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Marble, Parent = model })
	Part({ Name = "Water", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 16, 16), CFrame = at(cf, p.X, 3.05, p.Z) * flat, Color = Color3.fromRGB(60, 160, 255), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false, Parent = model })
	Part({ Name = "Column", Size = Vector3.new(2, 6, 2), CFrame = at(cf, p.X, 6, p.Z), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Marble, Parent = model })
	local top = Part({ Name = "Top", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.6, CFrame = at(cf, p.X, 9.5, p.Z), Color = Color3.fromRGB(80, 200, 255), Material = Enum.Material.Neon, Tags = { "Pulse" }, Parent = model })
	BuildKit.Light(top, Color3.fromRGB(80, 200, 255), 24, 2)
	BuildKit.Particles(top, {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(160, 220, 255)),
		Size = BuildKit.Size(0.8, 0.8, 0.2),
		Rate = 60,
		Speed = NumberRange.new(10, 14),
		SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0, -30, 0),
		Lifetime = NumberRange.new(1, 1.2),
		EmissionDirection = Enum.NormalId.Top,
		Transparency = NumberSequence.new(0.2, 1),
	})
	return {}
end

function decor.Sign(plot, item, model: Model, ownerName: string?)
	local cf = plot.CFrame
	local p: Vector3 = item.Pos
	Part({ Name = "Backing", Size = Vector3.new(44, 9, 0.6), CFrame = at(cf, p.X, p.Y, p.Z - 0.4), Color = Color3.fromRGB(20, 20, 30), Parent = model })
	local sign = Part({ Name = "Sign", Size = Vector3.new(42, 7.5, 0.4), CFrame = at(cf, p.X, p.Y, p.Z - 0.9), Color = Color3.fromRGB(20, 20, 30), Material = Enum.Material.SmoothPlastic, Parent = model })
	local _, label = BuildKit.SurfaceText(sign, Enum.NormalId.Front, string.upper((ownerName or "MY") .. "'S TYCOON"), { PixelsPerStud = 20, Brightness = 3 })
	label.Name = "RainbowText"
	label:SetAttribute("Rainbow", true)
	sign:AddTag("RainbowSign")
	BuildKit.Light(sign, plot.Color, 30, 2)
	return {}
end

function decor.Statue(plot, item, model: Model, ownerName: string?)
	local cf = plot.CFrame
	local p: Vector3 = item.Pos
	local gold = Color3.fromRGB(255, 200, 40)
	Part({ Name = "Pedestal", Size = Vector3.new(8, 3, 8), CFrame = at(cf, p.X, 2.5, p.Z), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Marble, Parent = model })
	local base = at(cf, p.X, 4, p.Z) * CFrame.Angles(0, math.pi, 0)
	local function piece(name, size, offset)
		return Part({ Name = name, Size = size, CFrame = base * CFrame.new(offset), Color = gold, Material = Enum.Material.Foil, Reflectance = 0.25, Parent = model })
	end
	piece("LeftLeg", Vector3.new(1.6, 4, 1.6), Vector3.new(-0.9, 2, 0))
	piece("RightLeg", Vector3.new(1.6, 4, 1.6), Vector3.new(0.9, 2, 0))
	piece("Torso", Vector3.new(3.6, 4, 1.8), Vector3.new(0, 6, 0))
	piece("LeftArm", Vector3.new(1.6, 4, 1.6), Vector3.new(-2.6, 6, 0))
	piece("RightArm", Vector3.new(1.6, 4, 1.6), Vector3.new(2.6, 7.6, 0)).CFrame = base * CFrame.new(2.6, 8.4, 0) * CFrame.Angles(0, 0, math.rad(150))
	piece("Head", Vector3.new(2, 2, 2), Vector3.new(0, 9, 0))
	local coin = Part({
		Name = "Coin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 3, 3),
		CFrame = base * CFrame.new(0, 13, 0),
		Color = gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin", "Bob" },
		Parent = model,
	})
	BuildKit.Light(coin, gold, 20, 2)
	BuildKit.Billboard(coin, ownerName and (ownerName .. " the Great") or "The Great", { Size = UDim2.fromOffset(160, 30), Offset = Vector3.new(0, 3, 0), Color = gold, MaxDistance = 60 })
	return {}
end

function decor.Tower(plot, item, model: Model)
	local cf = plot.CFrame
	local p: Vector3 = item.Pos
	Part({ Name = "Base", Size = Vector3.new(10, 4, 10), CFrame = at(cf, p.X, 3, p.Z), Color = Color3.fromRGB(40, 40, 55), Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "Pillar", Size = Vector3.new(3, 40, 3), CFrame = at(cf, p.X, 25, p.Z), Color = Color3.fromRGB(60, 60, 75), Material = Enum.Material.Metal, Parent = model })
	for i = 1, 4 do
		Part({
			Name = "Ring" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 8 - i, 8 - i),
			CFrame = at(cf, p.X, 8 + i * 8, p.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromHSV(0.12 + i * 0.05, 0.9, 1),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Tags = { "Spin" },
			Parent = model,
		})
	end
	local orb = Part({ Name = "Orb", Shape = Enum.PartType.Ball, Size = Vector3.one * 6, CFrame = at(cf, p.X, 48, p.Z), Color = Color3.fromRGB(255, 210, 40), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
	BuildKit.Light(orb, Color3.fromRGB(255, 210, 40), 60, 4)
	BuildKit.Particles(orb, {
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 80)),
		Size = BuildKit.Size(1.5),
		Rate = 30,
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(180, 180),
		Lifetime = NumberRange.new(1.5, 2.5),
	})
	Part({ Name = "SkyBeam", Size = Vector3.new(1.5, 300, 1.5), CFrame = at(cf, p.X, 200, p.Z), Color = Color3.fromRGB(255, 220, 80), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, CanQuery = false, CanTouch = false, Parent = model })
	return {}
end

function builders.Decor(plot, item, model: Model, ownerName: string?)
	local fn = decor[item.Model]
	if fn then
		return fn(plot, item, model, ownerName)
	end
	return {}
end

function builders.SpeedPad(plot, item, model: Model)
	local cf = plot.CFrame
	local p: Vector3 = item.Pos
	local pad = Part({ Name = "SpeedPad", Size = Vector3.new(8, 0.5, 8), CFrame = at(cf, p.X, 1.25, p.Z), Color = Color3.fromRGB(0, 230, 255), Material = Enum.Material.Neon, Tags = { "Pulse" }, Parent = model })
	BuildKit.Billboard(pad, "⚡ SPEED PAD", { Size = UDim2.fromOffset(150, 34), Offset = Vector3.new(0, 3, 0), Color = Color3.fromRGB(120, 240, 255), MaxDistance = 60 })
	BuildKit.Particles(pad, {
		Color = ColorSequence.new(Color3.fromRGB(0, 230, 255)),
		Size = BuildKit.Size(0.5),
		Rate = 15,
		Speed = NumberRange.new(3, 6),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(10, 10),
	})
	return { Pad = pad }
end

-- Build an item into the plot. Returns (model, extra)
function TycoonBuilder.BuildItem(plot, item, ownerName: string?)
	local model = BuildKit.Model(item.Id, plot.Items)
	local builder = builders[item.Kind]
	local extra = {}
	if builder then
		extra = builder(plot, item, model, ownerName) or {}
	end
	return model, extra
end

-- A drop that falls out of a dropper
function TycoonBuilder.MakeDrop(item, position: Vector3): Part
	local tier = item.Tier or 1
	local size = 1 + math.min(tier, 9) * 0.08
	local drop = Instance.new("Part")
	drop.Name = "Drop"
	drop.Size = Vector3.one * size
	drop.Color = item.Color or Color3.new(0.8, 0.8, 0.8)
	drop.Material = item.Material or Enum.Material.SmoothPlastic
	drop.TopSurface = Enum.SurfaceType.Smooth
	drop.BottomSurface = Enum.SurfaceType.Smooth
	drop.CollisionGroup = "Drops"
	drop.CFrame = CFrame.new(position) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
	drop.CanQuery = false
	if tier >= 7 then
		drop.Material = Enum.Material.Neon
		BuildKit.Light(drop, drop.Color, 6, 1)
	end
	return drop
end

return TycoonBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">TycoonService</string>
          <string name="Source"><![CDATA[--[[
	TycoonService - plots, purchasing, droppers, upgraders, collecting,
	rebirths and spawning players at their tycoon.
]]
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local TycoonItems = require(Shared.TycoonItems)
local BuildKit = require(script.Parent.BuildKit)
local TycoonBuilder = require(script.Parent.TycoonBuilder)

local TycoonService = {}
local S

local plots = {}
local playerPlot: { [Player]: any } = {}
local MAX_DROPS_PER_PLOT = 220

local PLOT_POSITIONS = {
	{ Vector3.new(-150, 0, -170), 1 },
	{ Vector3.new(0, 0, -170), 1 },
	{ Vector3.new(150, 0, -170), 1 },
	{ Vector3.new(-150, 0, 170), -1 },
	{ Vector3.new(0, 0, 170), -1 },
	{ Vector3.new(150, 0, 170), -1 },
}

local GREEN = Color3.fromRGB(60, 220, 100)
local RED = Color3.fromRGB(235, 70, 70)

---------------------------------------------------------------------------
function TycoonService:Init(services)
	S = services
	local folder = Instance.new("Folder")
	folder.Name = "Tycoons"
	folder.Parent = workspace

	for index = 1, math.min(Config.MaxPlots, #PLOT_POSITIONS) do
		local pos, dir = PLOT_POSITIONS[index][1], PLOT_POSITIONS[index][2]
		local cf = CFrame.lookAt(pos, pos + Vector3.new(0, 0, dir))
		local plot = TycoonBuilder.BuildPlot(index, cf, folder)
		plot.Owner = nil
		plot.Built = {}
		plot.ButtonObjs = {}
		plot.Droppers = {}
		plot.Connections = {}
		plot.PendingPop = 0
		plot.LastPadTouch = 0
		plots[index] = plot
		self:_wirePlot(plot)
	end

	S.DataService.PlayerLoaded:Connect(function(player, data)
		self:_assign(player, data)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_release(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		self:_hookCharacter(player)
	end)
	for _, player in Players:GetPlayers() do
		self:_hookCharacter(player)
	end

	Remotes.RequestRebirth.OnServerEvent:Connect(function(player)
		self:Rebirth(player)
	end)
	Remotes.GoHome.OnServerEvent:Connect(function(player)
		if player:GetAttribute("InMinigame") then
			return
		end
		player:SetAttribute("ObbyStage", 0)
		self:TeleportHome(player)
	end)
end

function TycoonService:Start()
	-- dropper loop
	task.spawn(function()
		while true do
			local now = os.clock()
			for _, plot in plots do
				local owner = plot.Owner
				if owner then
					local fast = S.MonetizationService and S.MonetizationService:HasPass(owner, "FastDroppers")
					local count = #plot.Drops:GetChildren()
					for _, dropper in plot.Droppers do
						if now >= dropper.Next then
							dropper.Next = now + dropper.Item.Interval / (fast and 2 or 1)
							if count < MAX_DROPS_PER_PLOT then
								count += 1
								self:_spawnDrop(plot, dropper)
							end
						end
					end
				end
			end
			task.wait(0.1)
		end
	end)

	-- batched "+$123" popups at the collector
	task.spawn(function()
		while true do
			task.wait(0.6)
			for _, plot in plots do
				if plot.Owner and plot.PendingPop > 0 then
					Remotes.VFX:FireClient(plot.Owner, "CashPop", {
						Position = plot.Collector.Position + Vector3.new(0, 4, 0),
						Amount = plot.PendingPop,
						Vault = not S.MonetizationService:HasPass(plot.Owner, "AutoCollect"),
					})
					plot.PendingPop = 0
				end
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Wiring (done once per plot)
---------------------------------------------------------------------------
function TycoonService:_wirePlot(plot)
	plot.Collector.Touched:Connect(function(hit)
		if hit.Parent ~= plot.Drops then
			return
		end
		local value = hit:GetAttribute("Value")
		if not value then
			return
		end
		hit:SetAttribute("Value", nil)
		hit:Destroy()
		local owner = plot.Owner
		if not owner then
			return
		end
		local amount = value * S.DataService:GetMultiplier(owner)
		if S.MonetizationService:HasPass(owner, "AutoCollect") then
			S.DataService:AddCash(owner, amount)
		else
			S.DataService:AddVault(owner, amount)
		end
		plot.PendingPop += amount
	end)

	plot.CollectPad.Touched:Connect(function(hit)
		local player = BuildKit.PlayerFromHit(hit)
		if not player or player ~= plot.Owner then
			return
		end
		if os.clock() - plot.LastPadTouch < 1 then
			return
		end
		plot.LastPadTouch = os.clock()
		self:CollectVault(player)
	end)
end

function TycoonService:CollectVault(player: Player)
	local data = S.DataService:Get(player)
	if not data or data.Vault <= 0 then
		return
	end
	local amount = data.Vault
	data.Vault = 0
	S.DataService:AddCash(player, amount)
	Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
	Remotes.Notify:FireClient(player, { Text = "Collected " .. Util.Money(amount) .. "!", Type = "success" })
end

function TycoonService:_spawnDrop(plot, dropper)
	local drop = TycoonBuilder.MakeDrop(dropper.Item, dropper.Spout)
	drop:SetAttribute("Value", dropper.Item.Value)
	drop.Parent = plot.Drops
	pcall(function()
		drop:SetNetworkOwner(nil)
	end)
	Debris:AddItem(drop, Config.DropLifetime)
end

---------------------------------------------------------------------------
-- Plot assignment
---------------------------------------------------------------------------
function TycoonService:GetPlot(player: Player)
	return playerPlot[player]
end

function TycoonService:GetPlots()
	return plots
end

function TycoonService:_assign(player: Player, data)
	if playerPlot[player] then
		return
	end
	local plot
	for _, p in plots do
		if not p.Owner then
			plot = p
			break
		end
	end
	if not plot then
		Remotes.Notify:FireClient(player, { Text = "All plots are taken! You can still play minigames and the obby.", Type = "error", Duration = 8 })
		return
	end
	plot.Owner = player
	playerPlot[player] = plot
	player:SetAttribute("Plot", plot.Index)
	for _, label in plot.SignLabels do
		label.Text = string.upper(player.DisplayName) .. "'S TYCOON"
	end

	for _, item in TycoonItems.List do
		if data.Purchased[item.Id] then
			self:_buildItem(plot, item, false)
		end
	end
	self:_refreshButtons(plot)

	table.insert(plot.Connections, player:GetAttributeChangedSignal("Cash"):Connect(function()
		self:_updateButtonColors(plot)
	end))
	table.insert(plot.Connections, player:GetAttributeChangedSignal("Vault"):Connect(function()
		self:_updateVaultLabel(plot)
	end))
	self:_updateVaultLabel(plot)

	if player.Character then
		self:TeleportHome(player)
	end
	Remotes.Notify:FireClient(player, { Text = "Welcome! Plot #" .. plot.Index .. " is yours. Step on the buttons to build!", Type = "success", Duration = 6 })
end

function TycoonService:_release(player: Player)
	local plot = playerPlot[player]
	if not plot then
		return
	end
	playerPlot[player] = nil
	self:_clearPlot(plot)
	for _, conn in plot.Connections do
		conn:Disconnect()
	end
	plot.Connections = {}
	plot.Owner = nil
	for _, label in plot.SignLabels do
		label.Text = "EMPTY PLOT"
	end
	plot.VaultLabel.Text = "🏦 VAULT: $0\nStep here to collect"
end

function TycoonService:_clearPlot(plot)
	plot.Items:ClearAllChildren()
	plot.Buttons:ClearAllChildren()
	plot.Drops:ClearAllChildren()
	plot.Built = {}
	plot.ButtonObjs = {}
	plot.Droppers = {}
	plot.PendingPop = 0
end

function TycoonService:RefreshVaultLabel(player: Player)
	local plot = playerPlot[player]
	if plot then
		self:_updateVaultLabel(plot)
	end
end

function TycoonService:_updateVaultLabel(plot)
	local owner = plot.Owner
	if not owner then
		return
	end
	if S.MonetizationService:HasPass(owner, "AutoCollect") then
		plot.VaultLabel.Text = "🧲 AUTO COLLECT ON"
	else
		plot.VaultLabel.Text = "🏦 VAULT: " .. Util.Money(owner:GetAttribute("Vault") or 0) .. "\nStep here to collect"
	end
end

---------------------------------------------------------------------------
-- Items & buttons
---------------------------------------------------------------------------
function TycoonService:_buildItem(plot, item, withEffects: boolean)
	if plot.Built[item.Id] then
		return
	end
	local model, extra = TycoonBuilder.BuildItem(plot, item, plot.Owner and plot.Owner.DisplayName)
	plot.Built[item.Id] = model

	if item.Kind == "Dropper" then
		table.insert(plot.Droppers, { Item = item, Spout = extra.Spout, Next = 0 })
	elseif item.Kind == "Upgrader" and extra.Detector then
		local key = "U_" .. item.Id
		extra.Detector.Touched:Connect(function(hit)
			if hit.Parent ~= plot.Drops then
				return
			end
			local value = hit:GetAttribute("Value")
			if not value or hit:GetAttribute(key) then
				return
			end
			hit:SetAttribute(key, true)
			hit:SetAttribute("Value", value * item.Multiplier)
			hit.Color = item.Color
			hit.Material = Enum.Material.Neon
		end)
	elseif item.Kind == "SpeedPad" and extra.Pad then
		extra.Pad.Touched:Connect(function(hit)
			local player, humanoid = BuildKit.PlayerFromHit(hit)
			if not player or not humanoid or player:GetAttribute("SpeedBoosted") then
				return
			end
			player:SetAttribute("SpeedBoosted", true)
			local base = S.MonetizationService:GetBaseSpeed(player)
			humanoid.WalkSpeed = base * 2.2
			Remotes.VFX:FireClient(player, "SpeedLines", { Duration = 6 })
			task.delay(6, function()
				player:SetAttribute("SpeedBoosted", nil)
				if humanoid.Parent then
					humanoid.WalkSpeed = S.MonetizationService:GetBaseSpeed(player)
				end
			end)
		end)
	end

	if withEffects then
		Remotes.VFX:FireAllClients("BuildIn", { Model = model, Position = model:GetPivot().Position, Color = item.Color or plot.Color })
	end
end

function TycoonService:_refreshButtons(plot)
	local owner = plot.Owner
	if not owner then
		return
	end
	local data = S.DataService:Get(owner)
	if not data then
		return
	end
	for _, item in TycoonItems.List do
		local owned = data.Purchased[item.Id]
		local unlocked = item.Requires == nil or data.Purchased[item.Requires]
		if not owned and unlocked and not plot.ButtonObjs[item.Id] then
			local button = TycoonBuilder.BuildButton(plot, item)
			plot.ButtonObjs[item.Id] = button
			local lastFail = 0
			local busy = false
			button.Pad.Touched:Connect(function(hit)
				if busy then
					return
				end
				local player = BuildKit.PlayerFromHit(hit)
				if not player or player ~= plot.Owner then
					return
				end
				busy = true
				local ok, reason = self:TryPurchase(player, item.Id)
				if not ok and os.clock() - lastFail > 2 then
					lastFail = os.clock()
					Remotes.Notify:FireClient(player, { Text = reason, Type = "error" })
					Remotes.VFX:FireClient(player, "Error", {})
				end
				task.wait(0.4)
				busy = false
			end)
		end
	end
	self:_updateButtonColors(plot)
end

function TycoonService:_updateButtonColors(plot)
	local owner = plot.Owner
	if not owner then
		return
	end
	local cash = owner:GetAttribute("Cash") or 0
	for id, button in plot.ButtonObjs do
		local item = TycoonItems.ById[id]
		if item and button.Pad.Parent then
			local affordable = cash >= item.Cost
			button.Pad.Color = affordable and GREEN or RED
			button.Label.TextColor3 = affordable and Color3.fromRGB(180, 255, 190) or Color3.fromRGB(255, 190, 190)
		end
	end
end

function TycoonService:TryPurchase(player: Player, itemId: string): (boolean, string)
	local plot = playerPlot[player]
	local data = S.DataService:Get(player)
	local item = TycoonItems.ById[itemId]
	if not plot or not data or not item then
		return false, "Can't buy that right now."
	end
	if data.Purchased[itemId] then
		return false, "You already own this!"
	end
	if item.Requires and not data.Purchased[item.Requires] then
		return false, "Buy the previous upgrade first!"
	end
	if data.Cash < item.Cost then
		return false, "You need " .. Util.Money(item.Cost - data.Cash) .. " more!"
	end
	S.DataService:SpendCash(player, item.Cost)
	data.Purchased[itemId] = true

	local button = plot.ButtonObjs[itemId]
	if button then
		plot.ButtonObjs[itemId] = nil
		Remotes.VFX:FireAllClients("ButtonPop", { Position = button.Pad.Position, Color = GREEN })
		button.Model:Destroy()
	end
	self:_buildItem(plot, item, true)
	self:_refreshButtons(plot)
	Remotes.Notify:FireClient(player, { Text = "Purchased " .. item.Name .. "!", Type = "success" })
	Remotes.VFX:FireClient(player, "PurchaseSound", {})
	return true, "ok"
end

-- Admin helper: give every item
function TycoonService:UnlockAll(player: Player)
	local plot = playerPlot[player]
	local data = S.DataService:Get(player)
	if not plot or not data then
		return
	end
	for _, item in TycoonItems.List do
		if not data.Purchased[item.Id] then
			data.Purchased[item.Id] = true
			local button = plot.ButtonObjs[item.Id]
			if button then
				button.Model:Destroy()
				plot.ButtonObjs[item.Id] = nil
			end
			self:_buildItem(plot, item, true)
		end
	end
end

-- Rebuild the whole plot from data (after reset / rebirth)
function TycoonService:Rebuild(player: Player)
	local plot = playerPlot[player]
	local data = S.DataService:Get(player)
	if not plot or not data then
		return
	end
	self:_clearPlot(plot)
	for _, item in TycoonItems.List do
		if data.Purchased[item.Id] then
			self:_buildItem(plot, item, false)
		end
	end
	self:_refreshButtons(plot)
	self:_updateVaultLabel(plot)
end

function TycoonService:Rebirth(player: Player, free: boolean?)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local cost = Config.GetRebirthCost(data.Rebirths)
	if not free and data.Cash < cost then
		Remotes.Notify:FireClient(player, { Text = "You need " .. Util.Money(cost) .. " to rebirth!", Type = "error" })
		return
	end
	data.Rebirths += 1
	data.Cash = Config.StartingCash
	data.Vault = 0
	data.Purchased = {}
	S.DataService:Sync(player)
	self:Rebuild(player)

	Remotes.VFX:FireClient(player, "Rebirth", { Rebirths = data.Rebirths })
	local plot = playerPlot[player]
	if plot then
		Remotes.VFX:FireAllClients("Shockwave", { Position = plot.CFrame.Position + Vector3.new(0, 2, 0), Color = Color3.fromRGB(255, 200, 40), Size = 140 })
	end
	Remotes.Announce:FireAllClients({
		Title = "🔄 " .. player.DisplayName .. " REBIRTHED!",
		Text = "Now at Rebirth " .. data.Rebirths .. " (" .. (1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth) .. "x cash)",
		Color = Color3.fromRGB(255, 200, 40),
	})
	task.spawn(S.DataService.Save, S.DataService, player)
end

---------------------------------------------------------------------------
-- Spawning
---------------------------------------------------------------------------
function TycoonService:GetSpawnCFrame(player: Player): CFrame
	local stage = player:GetAttribute("ObbyStage") or 0
	if stage > 0 and S.ObbyService then
		local cf = S.ObbyService:GetCheckpointCFrame(stage)
		if cf then
			return cf
		end
	end
	local plot = playerPlot[player]
	if plot then
		return plot.SpawnCFrame
	end
	return CFrame.new(0, 5, 0)
end

function TycoonService:TeleportHome(player: Player)
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(self:GetSpawnCFrame(player))
	end
end

function TycoonService:_hookCharacter(player: Player)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait()
		if player:GetAttribute("InMinigame") then
			return
		end
		character:PivotTo(self:GetSpawnCFrame(player))
	end)
end

return TycoonService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--[[
	WorldBuilder - builds the lobby, lighting, ground, paths, boards and
	decorations entirely from code so the place works with zero assets.
]]
local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part

local WorldBuilder = {}
WorldBuilder.Folder = nil :: Folder?
WorldBuilder.LeaderboardGui = nil :: SurfaceGui?

local PLAZA_RADIUS = 50

local function setupLighting()
	for _, child in Lighting:GetChildren() do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(90, 90, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 160)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GeographicLatitude = 30

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.StarCount = 3000
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(199, 220, 255)
	atmosphere.Decay = Color3.fromRGB(106, 112, 160)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.8
	rays.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "BaseColorCorrection"
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	cc.Parent = Lighting
end

local function setupCollisionGroups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Drops")
		PhysicsService:RegisterCollisionGroup("Players")
		PhysicsService:CollisionGroupSetCollidable("Drops", "Players", false)
		PhysicsService:CollisionGroupSetCollidable("Players", "Players", true)
	end)
	local function setGroup(character: Model)
		for _, d in character:GetDescendants() do
			if d:IsA("BasePart") then
				d.CollisionGroup = "Players"
			end
		end
		character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				d.CollisionGroup = "Players"
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(setGroup)
		if player.Character then
			setGroup(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
end

local function tree(parent: Instance, position: Vector3, scale: number)
	local model = BuildKit.Model("Tree", parent)
	local trunkHeight = 8 * scale
	Part({
		Name = "Trunk",
		ClassName = "Part",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.6 * scale, 1.6 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(110, 75, 45),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local leafColor = Color3.fromHSV(0.28 + math.random() * 0.08, 0.6, 0.55 + math.random() * 0.2)
	for i = 1, 3 do
		local size = (7 - i * 1.3) * scale
		Part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			Position = position + Vector3.new((math.random() - 0.5) * 2 * scale, trunkHeight + (i - 1) * 2.4 * scale, (math.random() - 0.5) * 2 * scale),
			Color = leafColor,
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = model,
		})
	end
	return model
end

local function lamp(parent: Instance, position: Vector3, color: Color3)
	local model = BuildKit.Model("Lamp", parent)
	Part({ Size = Vector3.new(0.8, 12, 0.8), Position = position + Vector3.new(0, 6, 0), Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = model })
	local bulb = Part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2.2,
		Position = position + Vector3.new(0, 12.6, 0),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Pulse" },
		Parent = model,
	})
	BuildKit.Light(bulb, color, 24, 1.5)
end

-- Board standing on the ground at `position`, facing `lookAt`
function WorldBuilder.Board(parent: Instance, position: Vector3, lookAt: Vector3, title: string, color: Color3)
	local model = BuildKit.Model(title .. "Board", parent)
	local cf = CFrame.lookAt(position + Vector3.new(0, 13, 0), Vector3.new(lookAt.X, position.Y + 13, lookAt.Z))
	local board = Part({
		Name = "Screen",
		Size = Vector3.new(26, 20, 1),
		CFrame = cf,
		Color = Color3.fromRGB(20, 22, 35),
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	Part({ Name = "Frame", Size = Vector3.new(28, 22, 0.8), CFrame = cf * CFrame.new(0, 0, 0.6), Color = color, Material = Enum.Material.Neon, Parent = model })
	for _, x in { -9, 9 } do
		Part({ Name = "Leg", Size = Vector3.new(1.5, 3, 1.5), CFrame = cf * CFrame.new(x, -11.5, 0.6), Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = model })
	end

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = board
	local header = Instance.new("TextLabel")
	header.Name = "Title"
	header.Size = UDim2.new(1, 0, 0.16, 0)
	header.BackgroundColor3 = color
	header.Text = title
	header.TextScaled = true
	header.Font = Enum.Font.FredokaOne
	header.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = header
	header.Parent = gui
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.Size = UDim2.new(1, -30, 0.82, -10)
	body.Position = UDim2.new(0, 15, 0.17, 5)
	body.BackgroundTransparency = 1
	body.Parent = gui
	return gui, body, model
end

local function infoText(body: Frame, lines: { string })
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = body
	for i, line in lines do
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 52)
		label.BackgroundTransparency = 1
		label.Text = line
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.LayoutOrder = i
		label.Parent = body
	end
end

function WorldBuilder:Init()
	setupLighting()
	setupCollisionGroups()

	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace
	self.Folder = world

	-- remove a default baseplate if one exists
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end

	Part({
		Name = "Ground",
		Size = Vector3.new(2048, 4, 2048),
		Position = Vector3.new(0, -2, 0),
		Color = Color3.fromRGB(86, 160, 70),
		Material = Enum.Material.Grass,
		Parent = world,
	})

	-- central plaza
	local lobby = BuildKit.Model("Lobby", world)
	Part({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, PLAZA_RADIUS * 2, PLAZA_RADIUS * 2),
		CFrame = CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(205, 205, 215),
		Material = Enum.Material.Slate,
		Parent = lobby,
	})
	Part({
		Name = "PlazaRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, PLAZA_RADIUS * 2 + 4, PLAZA_RADIUS * 2 + 4),
		CFrame = CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 196, 0),
		Material = Enum.Material.Neon,
		Parent = lobby,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = Vector3.new(0, 1, 0)
	spawn.Material = Enum.Material.Neon
	spawn.Color = Color3.fromRGB(0, 200, 255)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end

	-- giant floating title
	local titleAnchor = Part({
		Name = "Title",
		Size = Vector3.new(1, 1, 1),
		Position = Vector3.new(0, 30, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = lobby,
	})
	local _, titleLabel = BuildKit.Billboard(titleAnchor, Config.GameName, {
		Size = UDim2.fromScale(40, 8),
		Offset = Vector3.zero,
		MaxDistance = 600,
		Color = Color3.fromRGB(255, 210, 40),
	})
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 120)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 170, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 120)),
	})
	gradient.Rotation = 90
	gradient.Parent = titleLabel

	-- center fountain feature with sparkles
	local core = Part({
		Name = "Crystal",
		Size = Vector3.new(4, 4, 4),
		CFrame = CFrame.new(0, 18, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = Color3.fromRGB(255, 196, 0),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin", "Bob" },
		Parent = lobby,
	})
	BuildKit.Light(core, Color3.fromRGB(255, 200, 60), 40, 3)
	BuildKit.Particles(core, {
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 80)),
		Size = BuildKit.Size(1),
		Rate = 25,
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(180, 180),
		Lifetime = NumberRange.new(1, 2),
	})

	-- paths to the plots
	local pathColor = Color3.fromRGB(170, 150, 120)
	for _, sign in { -1, 1 } do
		Part({ Name = "Path", Size = Vector3.new(14, 0.4, 70), Position = Vector3.new(0, 0.2, sign * 75), Color = pathColor, Material = Enum.Material.Cobblestone, Parent = lobby })
		Part({ Name = "Path", Size = Vector3.new(380, 0.4, 14), Position = Vector3.new(0, 0.2, sign * 95), Color = pathColor, Material = Enum.Material.Cobblestone, Parent = lobby })
		for _, x in { -150, 150 } do
			Part({ Name = "Path", Size = Vector3.new(14, 0.4, 16), Position = Vector3.new(x, 0.2, sign * 104), Color = pathColor, Material = Enum.Material.Cobblestone, Parent = lobby })
		end
		for x = -180, 180, 45 do
			if x ~= 0 then
				lamp(lobby, Vector3.new(x, 0, sign * 86), Color3.fromHSV(((x + 180) / 360), 0.7, 1))
			end
		end
	end
	-- path to obby (west) and minigame board area (east)
	Part({ Name = "Path", Size = Vector3.new(160, 0.4, 14), Position = Vector3.new(-125, 0.2, 0), Color = pathColor, Material = Enum.Material.Cobblestone, Parent = lobby })

	-- boards
	local lbGui, lbBody = WorldBuilder.Board(lobby, Vector3.new(-62, 0, -26), Vector3.new(0, 0, 0), "🏆 TOP EARNERS", Color3.fromRGB(255, 180, 0))
	self.LeaderboardGui = lbGui
	self.LeaderboardBody = lbBody

	local _, infoBody = WorldBuilder.Board(lobby, Vector3.new(62, 0, -26), Vector3.new(0, 0, 0), "📜 HOW TO PLAY", Color3.fromRGB(0, 170, 255))
	infoText(infoBody, {
		"💵 Step on buttons in your tycoon to buy",
		"⬇️ Droppers make cash, upgraders multiply",
		"🏦 Step on the vault pad to collect cash",
		"🔄 Rebirth for a permanent multiplier",
		"🎮 Join minigames for big rewards",
		"🏃 Beat the obby (west) for cash",
		"🎁 Daily rewards + codes in the menu",
	})

	local _, mgBody = WorldBuilder.Board(lobby, Vector3.new(62, 0, 26), Vector3.new(0, 0, 0), "🎮 MINIGAMES", Color3.fromRGB(170, 70, 255))
	local mgLines = {}
	for _, mg in Config.Minigames.Games do
		table.insert(mgLines, "• " .. mg.DisplayName .. ": " .. mg.Description)
	end
	table.insert(mgLines, "Every " .. math.floor(Config.Minigames.Intermission / 60 * 10) / 10 .. " min - press JOIN!")
	infoText(mgBody, mgLines)

	local _, credBody = WorldBuilder.Board(lobby, Vector3.new(-62, 0, 26), Vector3.new(0, 0, 0), "⭐ VIP & SHOP", Color3.fromRGB(255, 80, 160))
	infoText(credBody, {
		"👑 VIP: +50% cash, aura & chat tag",
		"💵 2x Cash: double all income",
		"🧲 Auto Collect: skip the vault",
		"⚡ Fast Droppers: 2x drop speed",
		"Open the SHOP button on the left!",
	})

	-- trees around the map (deterministic)
	local rng = Random.new(1337)
	local trees = BuildKit.Model("Trees", world)
	for _ = 1, 140 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(290, 700)
		local pos = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		-- keep the obby lane (west) clear
		if not (pos.X < -200 and math.abs(pos.Z) < 60) then
			tree(trees, pos, rng:NextNumber(0.9, 1.8))
		end
	end
	for _, pos in { Vector3.new(-90, 0, -50), Vector3.new(90, 0, -50), Vector3.new(-90, 0, 50), Vector3.new(90, 0, 50), Vector3.new(-40, 0, -60), Vector3.new(40, 0, 60) } do
		tree(lobby, pos, 1.2)
	end
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="25">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">50</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	MEGA TYCOON - client bootstrap. Loads every controller in Controllers/,
	calls :Init(C) on each (C = registry of all controllers), then :Start().
]]
local controllersFolder = script.Parent:WaitForChild("Controllers")

local ORDER = {
	"UI",
	"Notifications",
	"Music",
	"VFX",
	"Animator",
	"HUD",
	"Shop",
	"Panels",
	"Admin",
	"Minigame",
	"ChatTags",
}

local C = {}
for _, name in ORDER do
	local module = controllersFolder:WaitForChild(name, 10)
	if module then
		local ok, result = pcall(require, module)
		if ok then
			C[name] = result
		else
			warn("[MegaTycoon] Failed to load controller " .. name .. ": " .. tostring(result))
		end
	end
end

for _, name in ORDER do
	local controller = C[name]
	if controller and controller.Init then
		local ok, err = pcall(controller.Init, controller, C)
		if not ok then
			warn("[MegaTycoon] Init failed for " .. name .. ": " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local controller = C[name]
	if controller and controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start, controller)
			if not ok then
				warn("[MegaTycoon] Start failed for " .. name .. ": " .. tostring(err))
			end
		end)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Admin</string>
            <string name="Source"><![CDATA[--[[
	Admin (client) - Admin Panel UI + client-side admin effects
	(fly, noclip, spectate). Opens with the 🛡️ button or F2.
	Chat commands (";speed me 50") are routed through here too.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Admin = {}
local C

local commandBox: TextBox
local resultLabel: TextLabel
local pages = {}
local tabButtons = {}
local currentTab = "Commands"

---------------------------------------------------------------------------
-- Fly / noclip / view
---------------------------------------------------------------------------
local flying = false
local flyParts = {}
local flyConn: RBXScriptConnection?
local noclipConn: RBXScriptConnection?

local function stopFly()
	flying = false
	if flyConn then
		flyConn:Disconnect()
		flyConn = nil
	end
	for _, inst in flyParts do
		inst:Destroy()
	end
	flyParts = {}
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
	end
end

local function startFly()
	stopFly()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return
	end
	flying = true
	local attachment = Instance.new("Attachment")
	attachment.Name = "FlyAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Attachment0 = attachment
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.MaxTorque = math.huge
	align.Responsiveness = 40
	align.Parent = root
	flyParts = { attachment, velocity, align }
	humanoid.PlatformStand = true

	flyConn = RunService.RenderStepped:Connect(function()
		if not root.Parent then
			stopFly()
			return
		end
		local cam = workspace.CurrentCamera
		local move = humanoid.MoveDirection
		local vertical = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
			vertical += 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			vertical -= 1
		end
		-- fly where the camera looks when moving forward
		local look = cam.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0 and move.Magnitude > 0 then
			local forwardAmount = move:Dot(flatLook.Unit)
			move += Vector3.new(0, look.Y * forwardAmount, 0)
		end
		local speed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 160 or 70
		velocity.VectorVelocity = (move + Vector3.new(0, vertical, 0)) * speed
		align.CFrame = cam.CFrame.Rotation
	end)
end

local function setNoclip(enabled: boolean)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
	if enabled then
		noclipConn = RunService.Stepped:Connect(function()
			local character = player.Character
			if character then
				for _, part in character:GetDescendants() do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end

local function view(target: Player?)
	local cam = workspace.CurrentCamera
	local character = (target or player).Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		cam.CameraSubject = humanoid
	end
end

---------------------------------------------------------------------------
-- Panel
---------------------------------------------------------------------------
local function run(text: string)
	if text == "" then
		return
	end
	local ok, message = Remotes.AdminCommand:InvokeServer(text)
	if resultLabel then
		resultLabel.Text = tostring(message)
		resultLabel.TextColor3 = ok and Theme.Green or Theme.Red
	end
	C.Notifications:Toast(tostring(message), ok and "success" or "error", 3)
	return ok
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function rowFrame(parent: Instance, order: number, height: number?)
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(1, -10, 0, height or 46),
		BackgroundColor3 = order % 2 == 0 and Theme.PanelLight or Theme.Panel,
		LayoutOrder = order,
		ZIndex = 7,
		Parent = parent,
	})
	UIKit.Corner(frame, 8)
	return frame
end

local function smallButton(parent: Instance, text: string, color: Color3, x: number, width: number, callback: () -> ())
	return UIKit.Button({
		Text = text,
		Color = color,
		Size = UDim2.fromOffset(width, 32),
		Position = UDim2.new(1, x, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 8,
		Parent = parent,
		Callback = callback,
	})
end

local function fillCommands()
	local page = pages.Commands
	clear(page)
	local list = Remotes.AdminData:InvokeServer("commands")
	if not list then
		return
	end
	table.sort(list, function(a, b)
		if a.Rank ~= b.Rank then
			return a.Rank < b.Rank
		end
		return a.Name < b.Name
	end)
	for i, cmd in list do
		local frame = rowFrame(page, i, 50)
		local rankColor = ({ Theme.Accent2, Theme.Green, Theme.Accent, Theme.Red })[cmd.Rank] or Theme.SubText
		local badge = UIKit.Label({ Text = Config.RankNames[cmd.Rank] or "?", Size = UDim2.fromOffset(84, 20), Position = UDim2.fromOffset(8, 15), TextColor3 = rankColor, Font = Theme.BodyFont, ZIndex = 8, Parent = frame })
		badge.TextXAlignment = Enum.TextXAlignment.Left
		UIKit.Label({
			Text = Config.Admin.Prefix .. cmd.Name .. " " .. (cmd.Args or ""),
			Size = UDim2.new(0.42, -90, 0, 22),
			Position = UDim2.fromOffset(96, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = cmd.Allowed and Theme.Text or Theme.SubText,
			ZIndex = 8,
			Parent = frame,
		})
		local aliases = (#cmd.Aliases > 0) and ("aliases: " .. table.concat(cmd.Aliases, ", ")) or ""
		UIKit.Label({
			Text = aliases,
			Size = UDim2.new(0.42, -90, 0, 16),
			Position = UDim2.fromOffset(96, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.SubText,
			Font = Theme.BodyFont,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
		UIKit.Label({
			Text = cmd.Desc,
			Size = UDim2.new(0.58, -90, 0, 30),
			Position = UDim2.new(0.42, 6, 0, 10),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			TextColor3 = Theme.SubText,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
		if cmd.Allowed then
			smallButton(frame, "USE", Theme.Accent, -76, 66, function()
				commandBox.Text = cmd.Name .. " "
				commandBox:CaptureFocus()
				commandBox.CursorPosition = #commandBox.Text + 1
			end)
		end
	end
end

local function fillPlayers()
	local page = pages.Players
	clear(page)
	local list = Remotes.AdminData:InvokeServer("players")
	if not list then
		return
	end
	for i, info in list do
		local frame = rowFrame(page, i, 56)
		UIKit.Label({
			Text = info.DisplayName .. "  (@" .. info.Name .. ")",
			Size = UDim2.new(0.4, 0, 0, 24),
			Position = UDim2.fromOffset(10, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 8,
			Parent = frame,
		})
		UIKit.Label({
			Text = (Config.RankNames[info.Rank] or "Player") .. " • " .. Util.Money(info.Cash) .. " • R" .. info.Rebirths,
			Size = UDim2.new(0.4, 0, 0, 18),
			Position = UDim2.fromOffset(10, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			TextColor3 = Theme.SubText,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
		local name = info.Name
		local actions = {
			{ "TO", Theme.Accent2, "to " .. name },
			{ "BRING", Theme.Accent2, "bring " .. name },
			{ "VIEW", Theme.Purple, "view " .. name },
			{ "+1M", Theme.Green, "givecash " .. name .. " 1m" },
			{ "FREEZE", Color3.fromRGB(120, 200, 255), "freeze " .. name },
			{ "KILL", Theme.Red, "kill " .. name },
			{ "KICK", Color3.fromRGB(150, 30, 30), "kick " .. name },
		}
		local x = -8
		for j = #actions, 1, -1 do
			local action = actions[j]
			x -= 62
			smallButton(frame, action[1], action[2], x, 58, function()
				run(action[3])
				if action[1] == "KICK" then
					task.wait(0.5)
					fillPlayers()
				end
			end)
		end
	end
end

local function fillLogs()
	local page = pages.Logs
	clear(page)
	local logs = Remotes.AdminData:InvokeServer("logs") or {}
	if #logs == 0 then
		UIKit.Label({ Text = "No commands run yet.", Size = UDim2.new(1, 0, 0, 30), Font = Theme.BodyFont, ZIndex = 8, Parent = page })
	end
	for i, entry in logs do
		local frame = rowFrame(page, i, 34)
		UIKit.Label({
			Text = os.date("%H:%M:%S", entry.Time) .. "  " .. entry.By .. ":  " .. entry.Text,
			Size = UDim2.new(1, -20, 1, -10),
			Position = UDim2.fromOffset(10, 5),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.BodyFont,
			Stroke = false,
			ZIndex = 8,
			Parent = frame,
		})
	end
end

local function buildServerPage()
	local page = pages.Server
	local order = 0
	local function section(title: string)
		order += 1
		UIKit.Label({ Text = title, Size = UDim2.new(1, -10, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Accent, LayoutOrder = order, ZIndex = 8, Parent = page })
	end
	local function buttonRow(buttons)
		order += 1
		local frame = UIKit.new("Frame", { Size = UDim2.new(1, -10, 0, 44), BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 7, Parent = page })
		UIKit.List(frame, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left)
		for _, def in buttons do
			UIKit.Button({ Text = def[1], Color = def[2], Size = UDim2.fromOffset(def[4] or 150, 40), ZIndex = 8, Parent = frame, Callback = function()
				run(def[3])
			end })
		end
	end
	local function inputRow(placeholder: string, buttonText: string, color: Color3, build: (string) -> string)
		order += 1
		local frame = UIKit.new("Frame", { Size = UDim2.new(1, -10, 0, 44), BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 7, Parent = page })
		local box = UIKit.TextBox({ Placeholder = placeholder, Size = UDim2.new(1, -170, 0, 40), ZIndex = 8, Parent = frame })
		UIKit.Button({ Text = buttonText, Color = color, Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -155, 0, 0), ZIndex = 8, Parent = frame, Callback = function()
			if box.Text ~= "" then
				run(build(box.Text))
				box.Text = ""
			end
		end })
	end

	section("💰 Economy")
	buttonRow({
		{ "🌧️ Cash Rain", Theme.Green, "cashrain" },
		{ "🔥 2x Event 10m", Color3.fromRGB(255, 110, 40), "doublecash 10 2" },
		{ "⚡ 5x Event 5m", Theme.Red, "doublecash 5 5" },
		{ "Me +$1B", Theme.Accent, "givecash me 1b", 120 },
	})
	buttonRow({
		{ "🏗️ Unlock All (me)", Theme.Accent2, "unlockall me", 190 },
		{ "🔄 Free Rebirth (me)", Theme.Purple, "rebirth me", 200 },
		{ "👑 VIP (me)", Theme.Accent, "givepass me VIP", 140 },
	})
	section("🎮 Minigames")
	buttonRow({
		{ "🪙 Coin Rush", Theme.Accent, "minigame CoinRush" },
		{ "🟥 Falling Tiles", Theme.Red, "minigame FallingTiles" },
		{ "☄️ Meteors", Color3.fromRGB(255, 120, 0), "minigame MeteorShower" },
	})
	section("🌍 World")
	buttonRow({
		{ "☀️ Day", Theme.Accent, "time 14", 110 },
		{ "🌙 Night", Theme.Purple, "time 0", 110 },
		{ "🌅 Sunset", Color3.fromRGB(255, 120, 80), "time 18", 120 },
		{ "🎉 Confetti All", Theme.Green, "confetti all", 160 },
	})
	buttonRow({
		{ "🕊️ Fly", Theme.Accent2, "fly me", 110 },
		{ "🚫 Unfly", Theme.SubText, "unfly me", 110 },
		{ "👻 Noclip", Theme.Purple, "noclip me", 120 },
		{ "🧱 Clip", Theme.SubText, "clip me", 110 },
		{ "💪 God", Theme.Green, "god me", 100 },
	})
	section("📢 Messages & Music")
	inputRow("Announcement text...", "📢 ANNOUNCE", Theme.Accent, function(text)
		return "m " .. text
	end)
	inputRow("Sound id (numbers only)...", "🎵 PLAY", Theme.Purple, function(text)
		return "music " .. text
	end)
	buttonRow({ { "⏹ Reset Music", Theme.SubText, "stopmusic", 170 } })
end

local function selectTab(name: string)
	currentTab = name
	for tabName, page in pages do
		page.Visible = tabName == name
		tabButtons[tabName].BackgroundColor3 = tabName == name and Theme.Red or Theme.PanelLight
	end
	if name == "Commands" then
		task.spawn(fillCommands)
	elseif name == "Players" then
		task.spawn(fillPlayers)
	elseif name == "Logs" then
		task.spawn(fillLogs)
	end
end

local function buildPanel()
	local _, content = C.UI:MakePanel("Admin", "🛡️ ADMIN PANEL", Theme.Red, 900, 600, function()
		selectTab(currentTab)
	end)

	-- command bar
	local bar = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	commandBox = UIKit.TextBox({ Placeholder = "Command (e.g. speed me 50) - press Enter", Size = UDim2.new(1, -130, 0, 42), ZIndex = 7, Parent = bar })
	UIKit.Button({ Text = "RUN ▶", Color = Theme.Green, Size = UDim2.fromOffset(120, 42), Position = UDim2.new(1, -120, 0, 0), ZIndex = 7, Parent = bar, Callback = function()
		run(commandBox.Text)
	end })
	commandBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			run(commandBox.Text)
		end
	end)
	resultLabel = UIKit.Label({ Text = "Rank: " .. (Config.RankNames[player:GetAttribute("AdminRank") or 0] or "?"), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 48), Font = Theme.BodyFont, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = content })

	-- tabs
	local tabs = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 74), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	UIKit.List(tabs, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left)
	for i, name in { "Commands", "Players", "Server", "Logs" } do
		tabButtons[name] = UIKit.Button({ Text = name:upper(), Color = Theme.PanelLight, Size = UDim2.fromOffset(140, 38), LayoutOrder = i, ZIndex = 7, Parent = tabs, Callback = function()
			selectTab(name)
		end })
		local page = UIKit.Scroll({ Size = UDim2.new(1, 0, 1, -124), Position = UDim2.fromOffset(0, 122), Parent = content })
		page.Visible = false
		UIKit.List(page, 6)
		UIKit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = page })
		pages[name] = page
	end
	buildServerPage()
end

---------------------------------------------------------------------------
function Admin:Init(controllers)
	C = controllers
	buildPanel()

	Remotes.ClientCommand.OnClientEvent:Connect(function(command, value)
		if command == "fly" then
			if value then
				startFly()
				C.Notifications:Toast("Fly ON: WASD + Space/E up, Ctrl/Q down, Shift = fast", "info", 6)
			else
				stopFly()
			end
		elseif command == "noclip" then
			setNoclip(value == true)
		elseif command == "view" then
			view(value)
		elseif command == "openadmin" then
			currentTab = value or "Commands"
			C.UI:Open("Admin")
		end
	end)

	player.CharacterAdded:Connect(function()
		flying = false
		flyParts = {}
		if flyConn then
			flyConn:Disconnect()
			flyConn = nil
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F2 and (player:GetAttribute("AdminRank") or 0) > 0 then
			C.UI:Toggle("Admin")
		end
	end)

	-- chat commands (TextChatService): ";cmd args"
	pcall(function()
		TextChatService.SendingMessage:Connect(function(message: TextChatMessage)
			local text = message.Text
			local prefix = Config.Admin.Prefix
			if text:sub(1, #prefix) == prefix and (player:GetAttribute("AdminRank") or 0) > 0 then
				task.spawn(run, text)
			end
		end)
	end)
end

function Admin:IsFlying()
	return flying
end

return Admin
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--[[
	Animator - smooth client-side animation for tagged parts:
	  Spin  - rotates around world Y
	  Bob   - floats up and down
	  Pulse - neon glow pulsing
	  RainbowSign - rainbow text on owner signs
	Only animates things near the camera to keep FPS high.
]]
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Animator = {}
local C

local spinning: { [BasePart]: { Base: CFrame, Speed: number, Phase: number, Spin: boolean, Bob: boolean } } = {}
local pulsing: { [BasePart]: { Color: Color3, Phase: number } } = {}
local rainbow: { [TextLabel]: boolean } = {}
local uiSpin: { [GuiObject]: boolean } = {}
local lowGraphics = false
local RANGE = 260

local function track(part: Instance)
	if not part:IsA("BasePart") or spinning[part] then
		return
	end
	spinning[part] = {
		Base = part.CFrame,
		Speed = 1.2 + math.random() * 0.8,
		Phase = math.random() * math.pi * 2,
		Spin = CollectionService:HasTag(part, "Spin"),
		Bob = CollectionService:HasTag(part, "Bob"),
	}
end

local function untrack(part: Instance)
	if part:IsA("BasePart") and not CollectionService:HasTag(part, "Spin") and not CollectionService:HasTag(part, "Bob") then
		spinning[part] = nil
	end
end

function Animator:SetLowGraphics(enabled: boolean)
	lowGraphics = enabled
	for _, d in workspace:GetDescendants() do
		if d:IsA("ParticleEmitter") then
			d.Enabled = not enabled
		end
	end
end

function Animator:Init(controllers)
	C = controllers
	for _, tag in { "Spin", "Bob" } do
		for _, part in CollectionService:GetTagged(tag) do
			track(part)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(part)
			-- refresh tag info (a part can have both tags)
			spinning[part] = nil
			track(part)
		end)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(untrack)
	end
	for _, part in CollectionService:GetTagged("Pulse") do
		if part:IsA("BasePart") then
			pulsing[part] = { Color = part.Color, Phase = math.random() * 6 }
		end
	end
	CollectionService:GetInstanceAddedSignal("Pulse"):Connect(function(part)
		if part:IsA("BasePart") then
			pulsing[part] = { Color = part.Color, Phase = math.random() * 6 }
		end
	end)
	CollectionService:GetInstanceRemovedSignal("Pulse"):Connect(function(part)
		pulsing[part] = nil
	end)

	local function trackSign(sign: Instance)
		for _, d in sign:GetDescendants() do
			if d:IsA("TextLabel") then
				rainbow[d] = true
			end
		end
	end
	for _, sign in CollectionService:GetTagged("RainbowSign") do
		trackSign(sign)
	end
	CollectionService:GetInstanceAddedSignal("RainbowSign"):Connect(function(sign)
		task.wait()
		trackSign(sign)
	end)

	for _, ui in CollectionService:GetTagged("UISpin") do
		uiSpin[ui] = true
	end
	CollectionService:GetInstanceAddedSignal("UISpin"):Connect(function(ui)
		uiSpin[ui] = true
	end)
end

function Animator:Start()
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = workspace.CurrentCamera
		local camPos = cam.CFrame.Position

		for ui in uiSpin do
			if ui.Parent then
				ui.Rotation = math.sin(t * 2) * 15
			else
				uiSpin[ui] = nil
			end
		end

		if lowGraphics then
			return
		end

		for part, info in spinning do
			if not part.Parent then
				spinning[part] = nil
				continue
			end
			local base = info.Base
			if (base.Position - camPos).Magnitude > RANGE then
				continue
			end
			local pos = base.Position
			if info.Bob then
				pos += Vector3.new(0, math.sin(t * 2 + info.Phase) * 0.8, 0)
			end
			local rotation = base.Rotation
			if info.Spin then
				rotation = CFrame.Angles(0, t * info.Speed + info.Phase, 0) * rotation
			end
			part.CFrame = CFrame.new(pos) * rotation
		end

		for part, info in pulsing do
			if not part.Parent then
				pulsing[part] = nil
				continue
			end
			if (part.Position - camPos).Magnitude > RANGE then
				continue
			end
			local alpha = (math.sin(t * 3 + info.Phase) + 1) / 2
			part.Color = info.Color:Lerp(Color3.new(1, 1, 1), alpha * 0.3)
		end

		for label in rainbow do
			if not label.Parent then
				rainbow[label] = nil
				continue
			end
			label.TextColor3 = Color3.fromHSV((t * 0.15) % 1, 0.75, 1)
		end
	end)
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ChatTags</string>
            <string name="Source"><![CDATA[--[[ ChatTags - [Owner] / [Admin] / [VIP] / rebirth tags in the chat ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local ChatTags = {}

local RANK_COLORS = {
	[1] = "#4FC3F7",
	[2] = "#66BB6A",
	[3] = "#FFA726",
	[4] = "#EF5350",
}

function ChatTags:Init()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if not source then
			return properties
		end
		local sender = Players:GetPlayerByUserId(source.UserId)
		if not sender then
			return properties
		end
		local tags = {}
		local rank = sender:GetAttribute("AdminRank") or 0
		if rank > 0 then
			table.insert(tags, string.format("<font color='%s'>[%s]</font>", RANK_COLORS[rank] or "#FFFFFF", Config.RankNames[rank]))
		end
		if sender:GetAttribute("Pass_VIP") then
			table.insert(tags, "<font color='#FFD700'>[👑 VIP]</font>")
		end
		local rebirths = sender:GetAttribute("Rebirths") or 0
		if rebirths > 0 then
			table.insert(tags, string.format("<font color='#CE93D8'>[R%d]</font>", rebirths))
		end
		if #tags > 0 then
			properties.PrefixText = table.concat(tags, " ") .. " " .. message.PrefixText
		end
		return properties
	end
end

return ChatTags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[ HUD - cash counter, multiplier/boost info and the side menu buttons ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local HUD = {}
HUD.CashFrame = nil :: Frame?
local C

local displayedCash = 0
local cashLabel: TextLabel
local infoLabel: TextLabel
local vaultLabel: TextLabel
local boostLabel: TextLabel
local menuButtons: { [string]: TextButton } = {}

local animVersion = 0
local function animateCash(target: number)
	animVersion += 1
	local myVersion = animVersion
	local start = displayedCash
	local startTime = os.clock()
	local duration = 0.35
	task.spawn(function()
		while myVersion == animVersion do
			local alpha = math.min((os.clock() - startTime) / duration, 1)
			displayedCash = start + (target - start) * alpha
			cashLabel.Text = "💵 " .. Util.Money(displayedCash)
			if alpha >= 1 then
				break
			end
			task.wait()
		end
	end)
	if target > start then
		local scale = cashLabel:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 1.12
			TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end
end

local function sideButton(parent: Instance, order: number, icon: string, text: string, color: Color3, callback: () -> ())
	local holder = UIKit.new("Frame", { Size = UDim2.fromOffset(70, 78), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local button = UIKit.Button({
		Text = icon,
		Color = color,
		Size = UDim2.fromOffset(62, 58),
		Position = UDim2.fromOffset(4, 0),
		Radius = 14,
		Parent = holder,
		Callback = callback,
	})
	UIKit.Label({ Text = text, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 60), Parent = holder })
	local badge = UIKit.new("TextLabel", {
		Name = "Badge",
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -18, 0, -6),
		BackgroundColor3 = Theme.Red,
		Text = "!",
		TextScaled = true,
		Font = Theme.Font,
		TextColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 3,
		Parent = button,
	})
	UIKit.Corner(badge, 11)
	return button, holder
end

function HUD:SetBadge(name: string, visible: boolean)
	local button = menuButtons[name]
	if button then
		local badge = button:FindFirstChild("Badge") :: TextLabel?
		if badge then
			badge.Visible = visible
		end
	end
end

function HUD:Init(controllers)
	C = controllers
	local gui = C.UI.Gui

	-- cash display (top centre)
	local cashFrame = UIKit.new("Frame", {
		Name = "Cash",
		Size = UDim2.fromOffset(300, 64),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Panel,
		Parent = gui,
	})
	UIKit.Corner(cashFrame, 16)
	UIKit.Stroke(cashFrame, Color3.new(0, 0, 0), 3, 0.1)
	UIKit.Gradient(cashFrame, Color3.fromRGB(60, 200, 100), Color3.fromRGB(30, 140, 70), 90)
	self.CashFrame = cashFrame
	cashLabel = UIKit.Label({ Text = "💵 $0", Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), Parent = cashFrame })
	UIKit.new("UIScale", { Parent = cashLabel })

	infoLabel = UIKit.Label({
		Text = "x1 cash • Rebirth 0",
		Size = UDim2.fromOffset(300, 22),
		Position = UDim2.new(0.5, 0, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.BodyFont,
		Parent = gui,
	})
	vaultLabel = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(300, 20),
		Position = UDim2.new(0.5, 0, 0, 100),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.BodyFont,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		Parent = gui,
	})
	boostLabel = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(300, 20),
		Position = UDim2.new(0.5, 0, 0, 122),
		AnchorPoint = Vector2.new(0.5, 0),
		Font = Theme.BodyFont,
		TextColor3 = Color3.fromRGB(255, 140, 60),
		Parent = gui,
	})

	-- side menu (left)
	local menu = UIKit.new("Frame", {
		Name = "Menu",
		Size = UDim2.new(0, 160, 0, 340),
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local grid = UIKit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(70, 80),
		CellPadding = UDim2.fromOffset(6, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	grid.FillDirectionMaxCells = 2
	local menuScale = UIKit.new("UIScale", { Parent = menu })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		menuScale.Scale = math.clamp(vp.Y / 800, 0.6, 1.1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	local buttons = {
		{ "Shop", "🛒", "SHOP", Color3.fromRGB(255, 180, 0) },
		{ "Rebirth", "🔄", "REBIRTH", Color3.fromRGB(200, 90, 255) },
		{ "Daily", "🎁", "DAILY", Color3.fromRGB(255, 90, 120) },
		{ "Codes", "🎟️", "CODES", Color3.fromRGB(0, 190, 255) },
		{ "Settings", "⚙️", "SETTINGS", Color3.fromRGB(130, 140, 160) },
		{ "Home", "🏠", "HOME", Color3.fromRGB(70, 200, 100) },
		{ "Admin", "🛡️", "ADMIN", Color3.fromRGB(235, 70, 70) },
	}
	for i, def in buttons do
		local name = def[1]
		local button, holder = sideButton(menu, i, def[2], def[3], def[4], function()
			if name == "Home" then
				Remotes.GoHome:FireServer()
			else
				C.UI:Toggle(name)
			end
		end)
		menuButtons[name] = button
		if name == "Admin" then
			holder.Visible = (player:GetAttribute("AdminRank") or 0) > 0
			player:GetAttributeChangedSignal("AdminRank"):Connect(function()
				holder.Visible = (player:GetAttribute("AdminRank") or 0) > 0
			end)
		end
	end

	-- keyboard shortcuts
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			C.UI:Toggle("Shop")
		elseif input.KeyCode == Enum.KeyCode.R then
			C.UI:Toggle("Rebirth")
		end
	end)
end

function HUD:Refresh()
	local mult = player:GetAttribute("Multiplier") or 1
	local rebirths = player:GetAttribute("Rebirths") or 0
	local rounded = math.floor(mult * 100 + 0.5) / 100
	infoLabel.Text = string.format("x%s cash  •  Rebirth %d", rounded >= 1000 and Util.Abbreviate(rounded) or tostring(rounded), rebirths)
	local hasAuto = player:GetAttribute("Pass_AutoCollect")
	local vault = player:GetAttribute("Vault") or 0
	vaultLabel.Text = (not hasAuto and vault > 0) and ("🏦 Vault: " .. Util.Money(vault) .. " (step on the pad!)") or ""

	local parts = {}
	local boostEnd = player:GetAttribute("BoostEnd") or 0
	if boostEnd > os.time() then
		table.insert(parts, "🚀 2x Boost " .. Util.Clock(boostEnd - os.time()))
	end
	local eventMult = workspace:GetAttribute("EventMultiplier") or 1
	local eventEnds = workspace:GetAttribute("EventEnds") or 0
	if eventMult ~= 1 and eventEnds > os.time() then
		table.insert(parts, "🔥 " .. eventMult .. "x Event " .. Util.Clock(eventEnds - os.time()))
	end
	boostLabel.Text = table.concat(parts, "   ")

	-- badges
	local lastDaily = player:GetAttribute("LastDaily") or 0
	self:SetBadge("Daily", os.time() - lastDaily >= Config.Daily.Cooldown)
	local cost = player:GetAttribute("RebirthCost") or math.huge
	self:SetBadge("Rebirth", (player:GetAttribute("Cash") or 0) >= cost)
end

function HUD:Start()
	if not player:GetAttribute("DataLoaded") then
		player:GetAttributeChangedSignal("DataLoaded"):Wait()
	end
	displayedCash = player:GetAttribute("Cash") or 0
	cashLabel.Text = "💵 " .. Util.Money(displayedCash)
	player:GetAttributeChangedSignal("Cash"):Connect(function()
		animateCash(player:GetAttribute("Cash") or 0)
		self:Refresh()
	end)
	for _, attr in { "Multiplier", "Rebirths", "Vault", "BoostEnd", "LastDaily", "Pass_AutoCollect" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			self:Refresh()
		end)
	end
	self:Refresh()
	while true do
		task.wait(1)
		self:Refresh()
	end
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Minigame</string>
            <string name="Source"><![CDATA[--[[ Minigame (client) - join popup, countdown, in-game HUD and results ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Minigame = {}
local C

local timerPill: TextLabel
local joinCard: Frame
local joinTitle: TextLabel
local joinDesc: TextLabel
local joinTimer: TextLabel
local joinButton: TextButton
local playBar: Frame
local playText: TextLabel
local countdownLabel: TextLabel
local resultsFrame: Frame
local resultsList: Frame
local lastPhase = nil

local function buildUI()
	local gui = C.UI.Gui

	timerPill = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(260, 26),
		Position = UDim2.new(1, -12, 0, 12),
		AnchorPoint = Vector2.new(1, 0),
		Font = Theme.BodyFont,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = gui,
	})

	-- join card (bottom centre)
	joinCard = UIKit.new("Frame", {
		Size = UDim2.fromOffset(420, 150),
		Position = UDim2.new(0.5, 0, 1, 200),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Panel,
		Parent = gui,
	})
	UIKit.Corner(joinCard, 16)
	UIKit.Stroke(joinCard, Theme.Purple, 3)
	UIKit.Gradient(joinCard, Theme.PanelLight, Theme.Panel, 90)
	joinTitle = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 8), TextColor3 = Color3.fromRGB(210, 160, 255), Parent = joinCard })
	joinDesc = UIKit.new("TextLabel", {
		Text = "",
		Size = UDim2.new(1, -20, 0, 36),
		Position = UDim2.fromOffset(10, 46),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 15,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		Parent = joinCard,
	})
	joinTimer = UIKit.Label({ Text = "", Size = UDim2.fromOffset(120, 40), Position = UDim2.new(0, 14, 1, -52), TextXAlignment = Enum.TextXAlignment.Left, Parent = joinCard })
	joinButton = UIKit.Button({
		Text = "JOIN! 🎮",
		Color = Theme.Green,
		Size = UDim2.fromOffset(200, 48),
		Position = UDim2.new(1, -214, 1, -58),
		Parent = joinCard,
		Callback = function()
			if not player:GetAttribute("MinigameJoined") then
				Remotes.MinigameJoin:FireServer()
			end
		end,
	})
	player:GetAttributeChangedSignal("MinigameJoined"):Connect(function()
		if player:GetAttribute("MinigameJoined") then
			joinButton.Text = "JOINED ✓"
			joinButton.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
		else
			joinButton.Text = "JOIN! 🎮"
			joinButton.BackgroundColor3 = Theme.Green
		end
	end)

	-- in-game bar (top)
	playBar = UIKit.new("Frame", {
		Size = UDim2.fromOffset(420, 40),
		Position = UDim2.new(0.5, 0, 0, 150),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = gui,
	})
	UIKit.Corner(playBar, 12)
	UIKit.Stroke(playBar, Theme.Purple, 2)
	playText = UIKit.Label({ Text = "", Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Parent = playBar })

	countdownLabel = UIKit.Label({
		Text = "",
		Size = UDim2.fromOffset(400, 180),
		Position = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = Theme.Accent,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	})
	UIKit.new("UIScale", { Parent = countdownLabel })

	-- results
	resultsFrame = UIKit.new("Frame", {
		Size = UDim2.fromOffset(460, 340),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	UIKit.Corner(resultsFrame, 18)
	UIKit.Stroke(resultsFrame, Theme.Purple, 4)
	UIKit.Gradient(resultsFrame, Theme.PanelLight, Theme.Panel, 90)
	UIKit.new("UIScale", { Name = "PopScale", Parent = resultsFrame })
	UIKit.Label({ Name = "Title", Text = "RESULTS", Size = UDim2.new(1, -20, 0, 44), Position = UDim2.fromOffset(10, 10), TextColor3 = Color3.fromRGB(210, 160, 255), ZIndex = 11, Parent = resultsFrame })
	resultsList = UIKit.new("Frame", { Size = UDim2.new(1, -30, 1, -70), Position = UDim2.fromOffset(15, 60), BackgroundTransparency = 1, ZIndex = 11, Parent = resultsFrame })
	UIKit.List(resultsList, 6)
end

local function showJoin(visible: boolean)
	TweenService:Create(joinCard, TweenInfo.new(0.4, Enum.EasingStyle.Back, visible and Enum.EasingDirection.Out or Enum.EasingDirection.In), {
		Position = visible and UDim2.new(0.5, 0, 1, -20) or UDim2.new(0.5, 0, 1, 200),
	}):Play()
end

local function showResults(state)
	for _, child in resultsList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	(resultsFrame:FindFirstChild("Title") :: TextLabel).Text = "🏆 " .. state.Name .. " RESULTS"
	local mine = false
	for i, r in state.Results do
		if i > 6 then
			break
		end
		local row = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = r.Winner and Color3.fromRGB(80, 70, 30) or Theme.PanelLight, LayoutOrder = i, ZIndex = 11, Parent = resultsList })
		UIKit.Corner(row, 8)
		UIKit.Label({ Text = (r.Winner and "👑 " or "") .. r.Name, Size = UDim2.new(0.45, 0, 1, -8), Position = UDim2.fromOffset(10, 4), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, Parent = row })
		UIKit.Label({ Text = tostring(r.Score), Size = UDim2.new(0.2, 0, 1, -8), Position = UDim2.new(0.47, 0, 0, 4), Font = Theme.BodyFont, ZIndex = 12, Parent = row })
		UIKit.Label({ Text = "+" .. Util.Money(r.Reward), Size = UDim2.new(0.3, -10, 1, -8), Position = UDim2.new(0.7, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Green, ZIndex = 12, Parent = row })
		if r.Name == player.DisplayName then
			mine = true
		end
	end
	if not mine then
		return -- don't pop the results for people who didn't play
	end
	UIKit.Open(resultsFrame)
	task.delay(6, function()
		UIKit.Close(resultsFrame)
	end)
end

function Minigame:Init(controllers)
	C = controllers
	buildUI()

	Remotes.MinigameState.OnClientEvent:Connect(function(state)
		local phase = state.Phase
		if phase == "Intermission" then
			timerPill.Text = "🎮 Next minigame: " .. Util.Clock(state.TimeLeft)
			playBar.Visible = false
			if lastPhase == "Join" then
				showJoin(false)
			end
		elseif phase == "Join" then
			timerPill.Text = "🎮 " .. state.Name .. " starting!"
			joinTitle.Text = "🎮 " .. state.Name:upper()
			joinDesc.Text = state.Description
			joinTimer.Text = "⏱ " .. state.TimeLeft .. "s"
			if lastPhase ~= "Join" then
				showJoin(true)
				UIKit.PlaySound("Notify", 0.6, 1.2)
			end
		elseif phase == "Cancelled" then
			showJoin(false)
			C.Notifications:Toast(state.Name .. " cancelled: " .. (state.Text or ""), "info")
		elseif phase == "Countdown" then
			showJoin(false)
			if player:GetAttribute("InMinigame") then
				countdownLabel.Visible = true
				countdownLabel.Text = state.Count > 0 and tostring(state.Count) or "GO!"
				countdownLabel.TextColor3 = state.Count > 0 and Theme.Accent or Theme.Green
				local scale = countdownLabel:FindFirstChildOfClass("UIScale") :: UIScale
				scale.Scale = 2
				TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				UIKit.PlaySound("Countdown", 0.6, state.Count > 0 and 1 or 1.5)
				if state.Count == 0 then
					task.delay(0.8, function()
						countdownLabel.Visible = false
					end)
				end
			end
			timerPill.Text = "🎮 " .. state.Name .. " in progress"
		elseif phase == "Playing" then
			timerPill.Text = "🎮 " .. state.Name .. " in progress"
			if player:GetAttribute("InMinigame") then
				playBar.Visible = true
				local score = player:GetAttribute("MinigameScore")
				local scoreText = (score and score > 0) and ("  •  🪙 " .. score) or ""
				playText.Text = string.format("%s  •  ⏱ %s  •  👥 %d alive%s", state.Name, Util.Clock(state.TimeLeft), state.Alive or 0, scoreText)
			else
				playBar.Visible = false
			end
		elseif phase == "Results" then
			playBar.Visible = false
			showResults(state)
		end
		lastPhase = phase
	end)
end

return Minigame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Music</string>
            <string name="Source"><![CDATA[--[[
	Music - background playlist with a now-playing widget (skip / mute).
	Switches to the minigame playlist while you're in a minigame and
	supports admin "DJ" overrides (;music <id>).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Music = {}
local C

local sound: Sound
local volume = Config.Music.DefaultVolume
local muted = false
local mode = "Lobby" -- Lobby | Minigame | Override
local override = nil
local index = 0
local generation = 0
local failures = 0
local titleLabel: TextLabel
local widget: Frame

local function targetVolume()
	return muted and 0 or volume
end

function Music:Init(controllers)
	C = controllers
	sound = Instance.new("Sound")
	sound.Name = "BackgroundMusic"
	sound.Volume = 0
	sound.Looped = false
	sound.Parent = SoundService

	-- widget (bottom left)
	widget = UIKit.new("Frame", {
		Name = "MusicWidget",
		Size = UDim2.fromOffset(250, 44),
		Position = UDim2.new(0, 12, 1, -12),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.15,
		Parent = C.UI.Gui,
	})
	UIKit.Corner(widget, 12)
	UIKit.Stroke(widget, Color3.new(0, 0, 0), 2, 0.3)
	local note = UIKit.Label({ Text = "🎵", Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(8, 7), Parent = widget })
	note:AddTag("UISpin")
	titleLabel = UIKit.Label({
		Text = "Loading music...",
		Size = UDim2.new(1, -130, 0, 22),
		Position = UDim2.fromOffset(42, 11),
		Font = Theme.BodyFont,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = widget,
	})
	UIKit.Button({
		Text = "⏭",
		Color = Theme.Accent2,
		Size = UDim2.fromOffset(36, 32),
		Position = UDim2.new(1, -82, 0, 6),
		Parent = widget,
		Callback = function()
			if mode == "Override" then
				mode = player:GetAttribute("InMinigame") and "Minigame" or "Lobby"
			end
			self:Next()
		end,
	})
	local muteButton
	muteButton = UIKit.Button({
		Text = "🔊",
		Color = Theme.Purple,
		Size = UDim2.fromOffset(36, 32),
		Position = UDim2.new(1, -42, 0, 6),
		Parent = widget,
		Callback = function()
			muted = not muted
			muteButton.Text = muted and "🔇" or "🔊"
			TweenService:Create(sound, TweenInfo.new(0.3), { Volume = targetVolume() }):Play()
		end,
	})

	Remotes.Music.OnClientEvent:Connect(function(action, params)
		if action == "play" and params and params.Id then
			override = params
			mode = "Override"
			self:Play(params.Id, params.Name)
		elseif action == "resume" then
			override = nil
			mode = player:GetAttribute("InMinigame") and "Minigame" or "Lobby"
			self:Next()
		end
	end)

	player:GetAttributeChangedSignal("InMinigame"):Connect(function()
		if mode == "Override" then
			return
		end
		local newMode = player:GetAttribute("InMinigame") and "Minigame" or "Lobby"
		if newMode ~= mode then
			mode = newMode
			index = 0
			self:Next()
		end
	end)

	player:GetAttributeChangedSignal("MusicVolume"):Connect(function()
		local v = player:GetAttribute("MusicVolume")
		if type(v) == "number" then
			self:SetVolume(v, true)
		end
	end)

	sound.Ended:Connect(function()
		if mode == "Override" and override then
			sound:Play()
		else
			self:Next()
		end
	end)
end

function Music:SetVolume(v: number, fromServer: boolean?)
	volume = math.clamp(v, 0, 1)
	sound.Volume = targetVolume()
	if not fromServer then
		Remotes.SaveSettings:FireServer({ MusicVolume = volume })
	end
end

function Music:GetVolume()
	return volume
end

function Music:SetWidgetVisible(visible: boolean)
	widget.Visible = visible
end

function Music:Play(id: string, name: string?)
	generation += 1
	local myGen = generation
	TweenService:Create(sound, TweenInfo.new(0.6), { Volume = 0 }):Play()
	task.wait(0.6)
	if myGen ~= generation then
		return
	end
	sound:Stop()
	sound.SoundId = id
	sound.TimePosition = 0
	sound:Play()
	titleLabel.Text = name or "Unknown Track"
	TweenService:Create(sound, TweenInfo.new(1.2), { Volume = targetVolume() }):Play()

	-- skip tracks that fail to load
	task.delay(8, function()
		if myGen ~= generation then
			return
		end
		if not sound.IsLoaded or sound.TimeLength == 0 then
			failures += 1
			local playlist = Config.Music[mode] or Config.Music.Lobby
			if failures >= #playlist + 1 then
				titleLabel.Text = "No music (set IDs in Config)"
				return
			end
			self:Next()
		else
			failures = 0
		end
	end)
end

function Music:Next()
	local playlist = Config.Music[mode == "Override" and "Lobby" or mode] or Config.Music.Lobby
	if #playlist == 0 then
		titleLabel.Text = "No music"
		return
	end
	index = index % #playlist + 1
	local track = playlist[index]
	task.spawn(self.Play, self, track.Id, track.Name)
end

function Music:Start()
	local v = player:GetAttribute("MusicVolume")
	if type(v) == "number" then
		volume = v
	end
	-- wait for the loading screen (with a safety timeout)
	local waited = 0
	while not player:GetAttribute("LoadingDone") and waited < 45 do
		waited += task.wait(0.25)
	end
	index = math.random(0, math.max(#Config.Music.Lobby - 1, 0))
	self:Next()
end

return Music
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Notifications</string>
            <string name="Source"><![CDATA[--[[ Notifications - toast messages (top right) + big announcement banners ]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local Theme = UIKit.Theme

local Notifications = {}
local C
local holder: Frame
local bannerQueue = {}
local bannerBusy = false

local TYPE_COLORS = {
	success = Theme.Green,
	error = Theme.Red,
	info = Theme.Accent2,
	warning = Theme.Accent,
}
local TYPE_ICONS = {
	success = "✅",
	error = "❌",
	info = "💬",
	warning = "⚠️",
}

function Notifications:Init(controllers)
	C = controllers
	holder = UIKit.new("Frame", {
		Name = "Toasts",
		Size = UDim2.new(0, 340, 1, -80),
		Position = UDim2.new(1, -16, 0, 70),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Parent = C.UI.FX,
	})
	local layout = UIKit.List(holder, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top

	Remotes.Notify.OnClientEvent:Connect(function(data)
		self:Toast(data.Text, data.Type, data.Duration)
	end)
	Remotes.Announce.OnClientEvent:Connect(function(data)
		self:Banner(data.Title, data.Text, data.Color)
	end)
end

local order = 0
function Notifications:Toast(text: string, kind: string?, duration: number?)
	kind = kind or "info"
	order += 1
	local color = TYPE_COLORS[kind] or Theme.Accent2
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.05,
		LayoutOrder = order,
		Parent = holder,
	})
	UIKit.Corner(frame, 10)
	UIKit.Stroke(frame, color, 2.5)
	UIKit.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = frame })
	UIKit.new("Frame", { Size = UDim2.new(0, 5, 1, 0), Position = UDim2.new(0, -8, 0, 0), BackgroundColor3 = color, BorderSizePixel = 0, Parent = frame })
	local label = UIKit.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = (TYPE_ICONS[kind] or "") .. "  " .. tostring(text),
		TextWrapped = true,
		TextSize = 17,
		Font = Theme.BodyFont,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local scale = UIKit.new("UIScale", { Scale = 0.5, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	UIKit.PlaySound(kind == "error" and "Error" or "Notify", kind == "error" and 0.3 or 0.25)

	-- keep the list short
	local toasts = {}
	for _, child in holder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 5 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end

	task.delay(duration or 4, function()
		if not frame.Parent then
			return
		end
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
		TweenService:Create(frame, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
		task.wait(0.25)
		frame:Destroy()
	end)
end

function Notifications:Banner(title: string, text: string?, color: Color3?)
	table.insert(bannerQueue, { title, text, color })
	if bannerBusy then
		return
	end
	bannerBusy = true
	while #bannerQueue > 0 do
		local item = table.remove(bannerQueue, 1)
		self:_showBanner(item[1], item[2], item[3])
	end
	bannerBusy = false
end

function Notifications:_showBanner(title: string, text: string?, color: Color3?)
	color = color or Theme.Accent
	local frame = UIKit.new("Frame", {
		Size = UDim2.new(0.6, 0, 0, 96),
		Position = UDim2.new(0.5, 0, 0, -120),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Panel,
		Parent = C.UI.FX,
	})
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(720, 96), MinSize = Vector2.new(300, 80), Parent = frame })
	UIKit.Corner(frame, 16)
	UIKit.Stroke(frame, color :: Color3, 3)
	UIKit.Gradient(frame, Theme.PanelLight, Theme.Panel, 90)
	local shine = UIKit.new("Frame", { Size = UDim2.new(0.25, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = frame })
	UIKit.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 1) }), Parent = shine })
	frame.ClipsDescendants = true
	UIKit.Label({ Text = title, Size = UDim2.new(1, -24, 0, 44), Position = UDim2.fromOffset(12, 8), TextColor3 = color, Parent = frame })
	UIKit.Label({ Text = text or "", Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 54), Font = Theme.BodyFont, TextColor3 = Theme.Text, Parent = frame })
	UIKit.PlaySound("Notify", 0.4, 0.8)

	TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 70) }):Play()
	shine.Position = UDim2.new(-0.3, 0, 0, 0)
	TweenService:Create(shine, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Position = UDim2.new(1.1, 0, 0, 0) }):Play()
	task.wait(4.5)
	local out = TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -130) })
	out:Play()
	out.Completed:Wait()
	frame:Destroy()
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--[[ Panels - Rebirth, Daily Rewards, Codes and Settings menus ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local Panels = {}
local C

---------------------------------------------------------------------------
local function buildRebirth()
	local _, content = C.UI:MakePanel("Rebirth", "🔄 REBIRTH", Theme.Purple, 560, 440)
	UIKit.List(content, 12)
	local current = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, ZIndex = 7, Parent = content })
	local arrow = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 2, TextColor3 = Color3.fromRGB(120, 255, 150), ZIndex = 7, Parent = content })
	UIKit.new("TextLabel", {
		Text = "Rebirthing resets your cash and tycoon, but gives you a PERMANENT cash multiplier.",
		Size = UDim2.new(1, -20, 0, 44),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 16,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		LayoutOrder = 3,
		ZIndex = 7,
		Parent = content,
	})
	local barBack = UIKit.new("Frame", { Size = UDim2.new(0.9, 0, 0, 34), BackgroundColor3 = Theme.Background, LayoutOrder = 4, ZIndex = 7, Parent = content })
	UIKit.Corner(barBack, 10)
	UIKit.Stroke(barBack, Color3.new(0, 0, 0), 2)
	local barFill = UIKit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Purple, ZIndex = 8, Parent = barBack })
	UIKit.Corner(barFill, 10)
	UIKit.Gradient(barFill, Color3.fromRGB(220, 160, 255), Theme.Purple, 90)
	local barText = UIKit.Label({ Text = "", Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), ZIndex = 9, Parent = barBack })

	local confirming = false
	local button
	button = UIKit.Button({
		Text = "REBIRTH",
		Color = Theme.Purple,
		Size = UDim2.fromOffset(240, 56),
		LayoutOrder = 5,
		ZIndex = 7,
		Parent = content,
		Callback = function()
			local cash = player:GetAttribute("Cash") or 0
			local cost = player:GetAttribute("RebirthCost") or math.huge
			if cash < cost then
				C.Notifications:Toast("You need " .. Util.Money(cost - cash) .. " more!", "error")
				return
			end
			if not confirming then
				confirming = true
				button.Text = "ARE YOU SURE?"
				task.delay(3, function()
					confirming = false
					button.Text = "REBIRTH"
				end)
				return
			end
			confirming = false
			button.Text = "REBIRTH"
			Remotes.RequestRebirth:FireServer()
			C.UI:Close()
		end,
	})

	local function refresh()
		local rebirths = player:GetAttribute("Rebirths") or 0
		local per = Config.Rebirth.MultiplierPerRebirth
		local cost = player:GetAttribute("RebirthCost") or Config.GetRebirthCost(rebirths)
		local cash = player:GetAttribute("Cash") or 0
		current.Text = "Rebirths: " .. rebirths
		arrow.Text = string.format("x%s  ➜  x%s rebirth bonus", tostring(1 + rebirths * per), tostring(1 + (rebirths + 1) * per))
		local alpha = math.clamp(cash / cost, 0, 1)
		TweenService:Create(barFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(alpha, 1) }):Play()
		barText.Text = Util.Money(cash) .. " / " .. Util.Money(cost)
		button.BackgroundColor3 = alpha >= 1 and Theme.Purple or Color3.fromRGB(90, 90, 110)
	end
	player:GetAttributeChangedSignal("Cash"):Connect(refresh)
	player:GetAttributeChangedSignal("Rebirths"):Connect(refresh)
	C.UI.Panels.Rebirth.OnOpen = refresh
	refresh()
end

---------------------------------------------------------------------------
local function buildDaily()
	local _, content = C.UI:MakePanel("Daily", "🎁 DAILY REWARDS", Color3.fromRGB(255, 90, 120), 760, 420)
	local row = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 170), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	local layout = UIKit.List(row, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	local cards = {}
	for day, amount in Config.Daily.Rewards do
		local cardFrame = UIKit.new("Frame", { Size = UDim2.new(1 / #Config.Daily.Rewards, -8, 0, 150), BackgroundColor3 = Theme.PanelLight, LayoutOrder = day, ZIndex = 7, Parent = row })
		UIKit.Corner(cardFrame, 12)
		local stroke = UIKit.Stroke(cardFrame, Theme.Background, 3)
		UIKit.Label({ Text = "Day " .. day, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 6), ZIndex = 8, Parent = cardFrame })
		UIKit.Label({ Text = day == #Config.Daily.Rewards and "💎" or "💵", Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 36), ZIndex = 8, Parent = cardFrame })
		UIKit.Label({ Text = Util.Money(amount), Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 100), TextColor3 = Color3.fromRGB(120, 255, 150), ZIndex = 8, Parent = cardFrame })
		cards[day] = { Frame = cardFrame, Stroke = stroke }
	end
	local status = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 184), Font = Theme.BodyFont, ZIndex = 7, Parent = content })
	UIKit.Label({
		Text = "Rewards scale with your rebirths. VIP gets double!",
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 216),
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		ZIndex = 7,
		Parent = content,
	})
	local claim = UIKit.Button({
		Text = "CLAIM",
		Color = Theme.Green,
		Size = UDim2.fromOffset(240, 56),
		Position = UDim2.new(0.5, 0, 0, 250),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 7,
		Parent = content,
		Callback = function()
			local ok, message = Remotes.ClaimDaily:InvokeServer()
			C.Notifications:Toast(message, ok and "success" or "error")
		end,
	})

	local function refresh()
		local streak = player:GetAttribute("DailyStreak") or 0
		local last = player:GetAttribute("LastDaily") or 0
		local since = os.time() - last
		local available = since >= Config.Daily.Cooldown
		local nextDay = streak
		if available then
			nextDay = since > Config.Daily.StreakResetAfter and 1 or streak + 1
		end
		local highlight = ((math.max(nextDay, 1) - 1) % #Config.Daily.Rewards) + 1
		for day, cardInfo in cards do
			cardInfo.Stroke.Color = day == highlight and Theme.Accent or Theme.Background
			cardInfo.Frame.BackgroundColor3 = day == highlight and Color3.fromRGB(70, 60, 30) or Theme.PanelLight
		end
		if available then
			status.Text = "Your reward is ready! 🎉"
			claim.Text = "CLAIM"
			claim.BackgroundColor3 = Theme.Green
		else
			status.Text = "Streak: " .. streak .. " days"
			claim.Text = Util.FormatTime(Config.Daily.Cooldown - since)
			claim.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
		end
	end
	C.UI.Panels.Daily.OnOpen = function()
		while C.UI.Current == "Daily" do
			refresh()
			task.wait(1)
		end
	end
	refresh()
end

---------------------------------------------------------------------------
local function buildCodes()
	local _, content = C.UI:MakePanel("Codes", "🎟️ CODES", Theme.Accent2, 520, 340)
	UIKit.List(content, 14)
	UIKit.Label({ Text = "Enter a code for free rewards!", Size = UDim2.new(1, 0, 0, 30), Font = Theme.BodyFont, LayoutOrder = 1, ZIndex = 7, Parent = content })
	local box = UIKit.TextBox({ Placeholder = "Type code here...", Size = UDim2.new(0.85, 0, 0, 50), LayoutOrder = 2, ZIndex = 7, Parent = content })
	local result = UIKit.Label({ Text = "", Size = UDim2.new(1, 0, 0, 26), Font = Theme.BodyFont, LayoutOrder = 4, ZIndex = 7, Parent = content })
	UIKit.Button({
		Text = "REDEEM",
		Color = Theme.Accent2,
		Size = UDim2.fromOffset(220, 52),
		LayoutOrder = 3,
		ZIndex = 7,
		Parent = content,
		Callback = function()
			if box.Text == "" then
				return
			end
			local ok, message = Remotes.RedeemCode:InvokeServer(box.Text)
			result.Text = message
			result.TextColor3 = ok and Theme.Green or Theme.Red
			if ok then
				box.Text = ""
			end
		end,
	})
	UIKit.Label({ Text = "Follow the game for new codes!", Size = UDim2.new(1, 0, 0, 20), Font = Theme.BodyFont, TextColor3 = Theme.SubText, LayoutOrder = 5, ZIndex = 7, Parent = content })
end

---------------------------------------------------------------------------
local function buildSettings()
	local _, content = C.UI:MakePanel("Settings", "⚙️ SETTINGS", Color3.fromRGB(130, 140, 160), 520, 420)
	UIKit.List(content, 12)

	local function row(order: number, text: string)
		local frame = UIKit.new("Frame", { Size = UDim2.new(1, -20, 0, 52), BackgroundColor3 = Theme.PanelLight, LayoutOrder = order, ZIndex = 7, Parent = content })
		UIKit.Corner(frame, 10)
		UIKit.Label({ Text = text, Size = UDim2.new(0.5, 0, 1, -16), Position = UDim2.fromOffset(14, 8), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 8, Parent = frame })
		return frame
	end

	-- music volume
	local volRow = row(1, "🎵 Music Volume")
	local volLabel = UIKit.Label({ Text = "", Size = UDim2.fromOffset(60, 30), Position = UDim2.new(1, -150, 0, 11), ZIndex = 8, Parent = volRow })
	local function updateVol()
		volLabel.Text = math.floor(C.Music:GetVolume() * 100 + 0.5) .. "%"
	end
	UIKit.Button({ Text = "-", Color = Theme.Red, Size = UDim2.fromOffset(40, 36), Position = UDim2.new(1, -196, 0, 8), ZIndex = 8, Parent = volRow, Callback = function()
		C.Music:SetVolume(C.Music:GetVolume() - 0.1)
		updateVol()
	end })
	UIKit.Button({ Text = "+", Color = Theme.Green, Size = UDim2.fromOffset(40, 36), Position = UDim2.new(1, -84, 0, 8), ZIndex = 8, Parent = volRow, Callback = function()
		C.Music:SetVolume(C.Music:GetVolume() + 0.1)
		updateVol()
	end })
	updateVol()

	local function toggle(order: number, text: string, initial: boolean, onChange: (boolean) -> ())
		local frame = row(order, text)
		local state = initial
		local button
		button = UIKit.Button({
			Text = state and "ON" or "OFF",
			Color = state and Theme.Green or Theme.Red,
			Size = UDim2.fromOffset(90, 36),
			Position = UDim2.new(1, -104, 0, 8),
			ZIndex = 8,
			Parent = frame,
			Callback = function()
				state = not state
				button.Text = state and "ON" or "OFF"
				button.BackgroundColor3 = state and Theme.Green or Theme.Red
				onChange(state)
			end,
		})
		return function(value: boolean)
			state = value
			button.Text = state and "ON" or "OFF"
			button.BackgroundColor3 = state and Theme.Green or Theme.Red
		end
	end

	local setSfx = toggle(2, "🔊 Sound Effects", true, function(on)
		UIKit.SFXEnabled = on
		Remotes.SaveSettings:FireServer({ SFX = on })
	end)
	toggle(3, "🎶 Music Widget", true, function(on)
		C.Music:SetWidgetVisible(on)
	end)
	toggle(4, "🥔 Low Graphics", false, function(on)
		C.Animator:SetLowGraphics(on)
		Remotes.SaveSettings:FireServer({ LowGraphics = on })
	end)

	UIKit.Label({ Text = Config.GameName .. " v" .. Config.Version, Size = UDim2.new(1, 0, 0, 20), Font = Theme.BodyFont, TextColor3 = Theme.SubText, LayoutOrder = 9, ZIndex = 7, Parent = content })

	player:GetAttributeChangedSignal("SFX"):Connect(function()
		local on = player:GetAttribute("SFX") ~= false
		UIKit.SFXEnabled = on
		setSfx(on)
	end)
	C.UI.Panels.Settings.OnOpen = updateVol
end

function Panels:Init(controllers)
	C = controllers
	buildRebirth()
	buildDaily()
	buildCodes()
	buildSettings()
end

function Panels:Start()
	if player:GetAttribute("SFX") == false then
		UIKit.SFXEnabled = false
	end
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--[[ Shop - Robux panel with Game Passes and Developer Products ]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme
local ROBUX = utf8.char(0xE002)

local Shop = {}
local C

local function sorted(map)
	local list = {}
	for key, value in map do
		table.insert(list, { Key = key, Data = value })
	end
	table.sort(list, function(a, b)
		return (a.Data.Order or 0) < (b.Data.Order or 0)
	end)
	return list
end

local function card(parent: Instance, order: number, data, isPass: boolean, key: string)
	local accent: Color3 = data.Color or (isPass and Theme.Accent or Theme.Green)
	local frame = UIKit.new("Frame", {
		Name = key,
		BackgroundColor3 = Theme.PanelLight,
		LayoutOrder = order,
		ZIndex = 6,
		Parent = parent,
	})
	UIKit.Corner(frame, 14)
	UIKit.Stroke(frame, accent, 3)
	UIKit.Gradient(frame, Theme.PanelLight, Theme.Panel, 90)

	local icon = UIKit.Label({ Text = data.Icon or "⭐", Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 8), ZIndex = 7, Parent = frame })
	icon:AddTag("UISpin")
	UIKit.Label({ Text = data.Name, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 70), TextColor3 = accent, ZIndex = 7, Parent = frame })
	UIKit.new("TextLabel", {
		Text = data.Description or "",
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 100),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextSize = 14,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 7,
		Parent = frame,
	})
	local button = UIKit.Button({
		Text = ROBUX .. " " .. tostring(data.PriceHint or "?"),
		Color = Theme.Green,
		Size = UDim2.new(1, -24, 0, 42),
		Position = UDim2.new(0, 12, 1, -52),
		ZIndex = 7,
		Parent = frame,
		Callback = function()
			if isPass then
				if player:GetAttribute("Pass_" .. key) then
					return
				end
				Remotes.BuyPass:FireServer(key)
			else
				Remotes.BuyProduct:FireServer(key)
			end
		end,
	})

	-- real price from Roblox if configured
	if data.Id and data.Id ~= 0 then
		task.spawn(function()
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, data.Id, isPass and Enum.InfoType.GamePass or Enum.InfoType.Product)
			if ok and info and info.PriceInRobux then
				button.Text = ROBUX .. " " .. tostring(info.PriceInRobux)
			end
		end)
	end

	if isPass then
		local function refresh()
			if player:GetAttribute("Pass_" .. key) then
				button.Text = "OWNED ✓"
				button.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
			end
		end
		player:GetAttributeChangedSignal("Pass_" .. key):Connect(refresh)
		refresh()
	end
	return frame
end

function Shop:Init(controllers)
	C = controllers
	local _, content = C.UI:MakePanel("Shop", "🛒 SHOP", Theme.Accent, 820, 560)

	local tabs = UIKit.new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, ZIndex = 6, Parent = content })
	UIKit.List(tabs, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)

	local pages = {}
	local function makePage(name)
		local scroll = UIKit.Scroll({ Size = UDim2.new(1, 0, 1, -54), Position = UDim2.fromOffset(0, 54), Parent = content })
		scroll.Name = name
		scroll.Visible = false
		UIKit.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 6), Parent = scroll })
		local grid = UIKit.new("UIGridLayout", {
			CellSize = UDim2.new(0.315, 0, 0, 220),
			CellPadding = UDim2.new(0.02, 0, 0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = scroll,
		})
		grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
		pages[name] = scroll
		return scroll
	end
	local passPage = makePage("Passes")
	local productPage = makePage("Products")

	local tabButtons = {}
	local function select(name)
		for pageName, page in pages do
			page.Visible = pageName == name
			tabButtons[pageName].BackgroundColor3 = pageName == name and Theme.Accent or Theme.PanelLight
		end
	end
	tabButtons.Passes = UIKit.Button({ Text = "👑 GAME PASSES", Color = Theme.Accent, Size = UDim2.fromOffset(200, 40), ZIndex = 7, Parent = tabs, Callback = function()
		select("Passes")
	end })
	tabButtons.Products = UIKit.Button({ Text = "💰 CASH & BOOSTS", Color = Theme.PanelLight, Size = UDim2.fromOffset(200, 40), ZIndex = 7, Parent = tabs, Callback = function()
		select("Products")
	end })

	for i, entry in sorted(Config.GamePasses) do
		card(passPage, i, entry.Data, true, entry.Key)
	end
	for i, entry in sorted(Config.Products) do
		card(productPage, i, entry.Data, false, entry.Key)
	end
	select("Passes")
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[ UI - owns the main ScreenGui and the "one panel at a time" manager ]]
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UIKit = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UIKit"))

local player = Players.LocalPlayer

local UI = {}
UI.Gui = nil :: ScreenGui?
UI.Panels = {}
UI.Current = nil :: string?

local blur: BlurEffect

function UI:Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "MegaTycoonUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	self.Gui = gui

	-- overlay layer for full-screen effects (flash, confetti, cash bursts)
	local fx = Instance.new("ScreenGui")
	fx.Name = "MegaTycoonFX"
	fx.ResetOnSpawn = false
	fx.IgnoreGuiInset = true
	fx.DisplayOrder = 20
	fx.Parent = player.PlayerGui
	self.FX = fx

	blur = Instance.new("BlurEffect")
	blur.Name = "UIBlur"
	blur.Size = 0
	blur.Parent = Lighting

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Escape and self.Current then
			self:Close()
		end
	end)
end

function UI:Start()
	-- show HUD once the loading screen is gone
	-- wait for the loading screen (with a safety timeout)
	local waited = 0
	while not player:GetAttribute("LoadingDone") and waited < 45 do
		waited += task.wait(0.25)
	end
	self.Gui.Enabled = true
end

-- Scale-based size so panels fit phones and big screens
function UI:PanelSize(maxW: number, maxH: number)
	return UDim2.new(0.9, 0, 0.82, 0), Vector2.new(maxW, maxH)
end

function UI:Register(name: string, frame: Frame, closeButton: GuiButton?, onOpen: (() -> ())?)
	self.Panels[name] = { Frame = frame, OnOpen = onOpen }
	if closeButton then
		closeButton.Activated:Connect(function()
			UIKit.PlaySound("Click", 0.5)
			self:Close()
		end)
	end
end

function UI:Open(name: string)
	local panel = self.Panels[name]
	if not panel then
		return
	end
	if self.Current and self.Current ~= name then
		local old = self.Panels[self.Current]
		if old then
			old.Frame.Visible = false
		end
	end
	self.Current = name
	UIKit.Open(panel.Frame)
	TweenService:Create(blur, TweenInfo.new(0.25), { Size = 14 }):Play()
	if panel.OnOpen then
		task.spawn(panel.OnOpen)
	end
end

function UI:Close()
	if not self.Current then
		return
	end
	local panel = self.Panels[self.Current]
	self.Current = nil
	if panel then
		UIKit.Close(panel.Frame)
	end
	TweenService:Create(blur, TweenInfo.new(0.25), { Size = 0 }):Play()
end

function UI:Toggle(name: string)
	if self.Current == name then
		self:Close()
	else
		self:Open(name)
	end
end

-- Builds a standard panel and registers it. Returns (frame, content)
function UI:MakePanel(name: string, title: string, color: Color3, maxW: number?, maxH: number?, onOpen: (() -> ())?)
	local frame, content, close = UIKit.Panel({
		Name = name,
		Title = title,
		Color = color,
		Size = UDim2.new(0.92, 0, 0.8, 0),
		MaxWidth = maxW or 760,
		Parent = self.Gui,
	})
	local constraint = frame:FindFirstChildOfClass("UISizeConstraint")
	if constraint then
		constraint.MaxSize = Vector2.new(maxW or 760, maxH or 520)
	end
	self:Register(name, frame, close, onOpen)
	return frame, content
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">VFX</string>
            <string name="Source"><![CDATA[--[[
	VFX - all client-side visual effects: cash popups, purchase bursts,
	build-in animations, shockwaves, confetti, cash rain, rebirth flash,
	camera shake, speed lines and more. Triggered by Remotes.VFX.
]]
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local UIKit = require(Shared.UIKit)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Theme = UIKit.Theme

local VFX = {}
local C
local fxFolder: Folder
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(255, 200, 40),
	Color3.fromRGB(80, 220, 120),
	Color3.fromRGB(80, 160, 255),
	Color3.fromRGB(200, 90, 255),
	Color3.fromRGB(255, 130, 200),
}

local function camera()
	return workspace.CurrentCamera
end

local function localPart(props): BasePart
	local part = Instance.new(props.ClassName or "Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "ClassName" then
			(part :: any)[k] = v
		end
	end
	part.Parent = fxFolder
	return part
end

local function sound3D(name: string, position: Vector3, volume: number?, pitch: number?)
	local id = Config.Sounds[name]
	if not id or UIKit.SFXEnabled == false then
		return
	end
	local anchor = localPart({ Size = Vector3.one, Transparency = 1, Position = position })
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = pitch or 1
	s.RollOffMaxDistance = 150
	s.Parent = anchor
	s:Play()
	Debris:AddItem(anchor, 4)
end

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------
function VFX:Shake(intensity: number, duration: number)
	local start = os.clock()
	local name = "VFXShake" .. tostring(start)
	RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
		local t = os.clock() - start
		if t > duration then
			RunService:UnbindFromRenderStep(name)
			return
		end
		local falloff = 1 - t / duration
		local cam = camera()
		local offset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * intensity * falloff
		cam.CFrame = cam.CFrame * CFrame.new(offset)
	end)
end

function VFX:Flash(color: Color3?, duration: number?)
	local frame = UIKit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color or Color3.new(1, 1, 1),
		BackgroundTransparency = 0.2,
		ZIndex = 50,
		Parent = C.UI.FX,
	})
	local tween = TweenService:Create(frame, TweenInfo.new(duration or 0.6), { BackgroundTransparency = 1 })
	tween:Play()
	Debris:AddItem(frame, (duration or 0.6) + 0.1)
end

function VFX:Burst(position: Vector3, color: Color3, count: number?, size: number?)
	local anchor = localPart({ Size = Vector3.one, Transparency = 1, Position = position })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size or 1.2), NumberSequenceKeypoint.new(1, 0) })
	emitter.Speed = NumberRange.new(10, 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Drag = 4
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(count or 40)
	Debris:AddItem(anchor, 2)
end

function VFX:Sphere(position: Vector3, color: Color3, size: number)
	local sphere = localPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one,
		Position = position,
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.2,
	})
	TweenService:Create(sphere, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * size, Transparency = 1 }):Play()
	Debris:AddItem(sphere, 0.6)
end

function VFX:Ring(position: Vector3, color: Color3, size: number, duration: number?)
	local ring = localPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.1,
	})
	TweenService:Create(ring, TweenInfo.new(duration or 0.7, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, size, size),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, (duration or 0.7) + 0.1)
end

function VFX:FloatText(position: Vector3, text: string, color: Color3, size: number?)
	local anchor = localPart({ Size = Vector3.one, Transparency = 1, Position = position })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 50)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = UIKit.Label({ Text = text, Size = UDim2.fromScale(1, 1), TextColor3 = color, Parent = gui })
	local scale = UIKit.new("UIScale", { Scale = 0.3 * (size or 1), Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = size or 1 }):Play()
	TweenService:Create(anchor, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = position + Vector3.new(0, 6, 0) }):Play()
	task.delay(0.8, function()
		TweenService:Create(label, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(anchor, 1.5)
end

-- Screen confetti falling from the top
function VFX:ScreenConfetti(count: number)
	for _ = 1, count do
		local piece = UIKit.new("Frame", {
			Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22)),
			Position = UDim2.new(math.random(), 0, 0, -30),
			BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Rotation = math.random(0, 360),
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = C.UI.FX,
		})
		local duration = math.random(18, 32) / 10
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		Debris:AddItem(piece, duration + 0.1)
	end
end

-- 3D confetti burst at a position
function VFX:WorldConfetti(position: Vector3, count: number)
	for _ = 1, count do
		local piece = localPart({
			Size = Vector3.new(0.4, 0.05, 0.6),
			Position = position,
			Color = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Material = Enum.Material.Neon,
		})
		piece.Anchored = false
		piece.AssemblyLinearVelocity = Vector3.new(math.random(-25, 25), math.random(25, 50), math.random(-25, 25))
		piece.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
		Debris:AddItem(piece, 3)
	end
end

-- Cash icons flying from the middle of the screen to the cash counter
function VFX:CashToCounter(amount: number)
	local target = C.HUD and C.HUD.CashFrame
	local targetPos = target and (target.AbsolutePosition + target.AbsoluteSize / 2) or Vector2.new(camera().ViewportSize.X / 2, 40)
	local center = camera().ViewportSize / 2
	for i = 1, 10 do
		local icon = UIKit.new("TextLabel", {
			Text = "💵",
			TextScaled = true,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(36, 36),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X + math.random(-120, 120), center.Y + math.random(-80, 80)),
			ZIndex = 45,
			Parent = C.UI.FX,
		})
		task.delay(0.15 + i * 0.04, function()
			local tween = TweenService:Create(icon, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(targetPos.X, targetPos.Y),
				Size = UDim2.fromOffset(16, 16),
			})
			tween:Play()
			tween.Completed:Wait()
			icon:Destroy()
		end)
	end
	local label = UIKit.Label({
		Text = "+" .. Util.Money(amount),
		Size = UDim2.fromOffset(400, 70),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		TextColor3 = Color3.fromRGB(120, 255, 140),
		ZIndex = 46,
		Parent = C.UI.FX,
	})
	local scale = UIKit.new("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1, Position = UDim2.fromScale(0.5, 0.35) }):Play()
		Debris:AddItem(label, 0.5)
	end)
	UIKit.PlaySound("Cash", 0.5, 1.2)
end

---------------------------------------------------------------------------
-- Named effects (from the server)
---------------------------------------------------------------------------
local effects = {}

function effects.CashPop(params)
	local text = "+" .. Util.Money(params.Amount)
	VFX:FloatText(params.Position, text, params.Vault and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(120, 255, 140), 0.9)
end

function effects.CashBurst(params)
	VFX:CashToCounter(params.Amount or 0)
end

function effects.Purchase(params)
	if not params.Position then
		return
	end
	local color = params.Color or Theme.Accent
	VFX:Burst(params.Position, color, params.Big and 80 or 40)
	VFX:Sphere(params.Position, color, params.Big and 24 or 12)
	VFX:Ring(params.Position - Vector3.new(0, 2, 0), color, params.Big and 40 or 20)
	sound3D("Purchase", params.Position, 0.6)
end

function effects.BuildIn(params)
	local model: Instance? = params.Model
	local color = params.Color or Theme.Accent
	if params.Position then
		VFX:Burst(params.Position, color, 50)
		VFX:Sphere(params.Position, color, 16)
		VFX:Ring(params.Position, color, 26)
		sound3D("Purchase", params.Position, 0.7, 1.1)
	end
	if not model then
		return
	end
	local parts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and not d:HasTag("Spin") and not d:HasTag("Bob") then
			table.insert(parts, d)
		end
	end
	for i, part in parts do
		local cf = part.CFrame
		local transparency = part.Transparency
		part.CFrame = cf * CFrame.new(0, 6, 0)
		part.Transparency = 1
		task.delay(i * 0.02, function()
			if not part.Parent then
				return
			end
			TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = cf, Transparency = transparency }):Play()
		end)
	end
end

function effects.ButtonPop(params)
	VFX:Ring(params.Position, params.Color or Theme.Green, 14, 0.5)
	VFX:Burst(params.Position, params.Color or Theme.Green, 20, 0.8)
end

function effects.Shockwave(params)
	local pos = params.Position
	if not pos then
		return
	end
	local color = params.Color or Theme.Accent
	VFX:Ring(pos, color, params.Size or 60, 0.9)
	VFX:Sphere(pos, color, (params.Size or 60) * 0.3)
	local cam = camera()
	local distance = (cam.CFrame.Position - pos).Magnitude
	if distance < 120 then
		VFX:Shake(math.clamp((120 - distance) / 120, 0, 1) * 1.2, 0.4)
	end
end

function effects.Confetti(params)
	if params.Position then
		VFX:WorldConfetti(params.Position, params.Small and 25 or 60)
	else
		VFX:ScreenConfetti(70)
	end
	UIKit.PlaySound("Win", 0.35)
end

function effects.Rebirth(params)
	VFX:Flash(Color3.fromRGB(255, 230, 120), 1.2)
	VFX:Shake(1.5, 1)
	VFX:ScreenConfetti(120)
	UIKit.PlaySound("Rebirth", 0.6)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(255, 220, 150)
	cc.Brightness = 0.3
	cc.Parent = Lighting
	TweenService:Create(cc, TweenInfo.new(2), { TintColor = Color3.new(1, 1, 1), Brightness = 0 }):Play()
	Debris:AddItem(cc, 2.1)
	local label = UIKit.Label({
		Text = "🔄 REBIRTH " .. tostring(params.Rebirths or "") .. "! 🔄",
		Size = UDim2.fromOffset(700, 110),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		TextColor3 = Color3.fromRGB(255, 215, 60),
		ZIndex = 48,
		Parent = C.UI.FX,
	})
	UIKit.Gradient(label, Color3.fromRGB(255, 250, 180), Color3.fromRGB(255, 160, 0), 90)
	local scale = UIKit.new("UIScale", { Scale = 0, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.4, function()
		TweenService:Create(scale, TweenInfo.new(0.3), { Scale = 0 }):Play()
		Debris:AddItem(label, 0.4)
	end)
end

function effects.CashRain(params)
	local duration = params.Duration or 8
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < duration do
			local cam = camera()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local origin = root and root.Position or cam.CFrame.Position
			for _ = 1, 6 do
				local bill = localPart({
					Size = Vector3.new(2, 0.08, 1),
					Position = origin + Vector3.new(math.random(-50, 50), math.random(35, 55), math.random(-50, 50)),
					Color = Color3.fromRGB(80, 190, 90),
					Material = Enum.Material.SmoothPlastic,
				})
				local gui = Instance.new("SurfaceGui")
				gui.Face = Enum.NormalId.Top
				gui.Parent = bill
				UIKit.Label({ Text = "$", Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(220, 255, 220), Parent = gui })
				bill.Anchored = false
				bill.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
				bill.AssemblyAngularVelocity = Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5))
				Debris:AddItem(bill, 5)
			end
			-- screen emoji
			local icon = UIKit.new("TextLabel", {
				Text = "💵",
				TextScaled = true,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(40, 40),
				Position = UDim2.new(math.random(), 0, 0, -40),
				ZIndex = 40,
				Parent = C.UI.FX,
			})
			TweenService:Create(icon, TweenInfo.new(2.5, Enum.EasingStyle.Linear), { Position = UDim2.new(icon.Position.X.Scale, 0, 1.1, 0), Rotation = math.random(-180, 180) }):Play()
			Debris:AddItem(icon, 2.6)
			task.wait(0.15)
		end
	end)
	VFX:ScreenConfetti(40)
	UIKit.PlaySound("Cash", 0.6)
end

function effects.CoinPop(params)
	VFX:Burst(params.Position, Color3.fromRGB(255, 210, 40), 15, 0.7)
	VFX:FloatText(params.Position, "+1 🪙", Color3.fromRGB(255, 220, 60), 0.7)
	UIKit.PlaySound("Coin", 0.4, 1.3 + math.random() * 0.3)
end

function effects.Error()
	UIKit.PlaySound("Error", 0.3)
end

function effects.PurchaseSound()
	UIKit.PlaySound("Purchase", 0.5)
end

function effects.WinSound()
	UIKit.PlaySound("Win", 0.6)
end

function effects.Flash()
	VFX:Flash(Color3.new(1, 1, 1), 0.5)
end

function effects.SpeedLines(params)
	local cam = camera()
	local baseFov = 70
	TweenService:Create(cam, TweenInfo.new(0.3), { FieldOfView = 88 }):Play()
	local stop = os.clock() + (params.Duration or 5)
	task.spawn(function()
		while os.clock() < stop do
			local line = UIKit.new("Frame", {
				Size = UDim2.fromOffset(3, math.random(60, 160)),
				Position = UDim2.new(math.random(), 0, math.random(), 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.5,
				BorderSizePixel = 0,
				ZIndex = 30,
				Parent = C.UI.FX,
			})
			TweenService:Create(line, TweenInfo.new(0.25), { BackgroundTransparency = 1, Position = line.Position + UDim2.fromOffset(0, 120) }):Play()
			Debris:AddItem(line, 0.3)
			task.wait(0.05)
		end
		TweenService:Create(cam, TweenInfo.new(0.5), { FieldOfView = baseFov }):Play()
	end)
	UIKit.PlaySound("Whoosh", 0.5)
end

---------------------------------------------------------------------------
function VFX:Init(controllers)
	C = controllers
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LocalFX"
	fxFolder.Parent = workspace

	Remotes.VFX.OnClientEvent:Connect(function(name, params)
		local fn = effects[name]
		if fn then
			local ok, err = pcall(fn, params or {})
			if not ok then
				warn("[VFX] " .. tostring(name) .. ": " .. tostring(err))
			end
		end
	end)
end

function VFX:Play(name: string, params)
	local fn = effects[name]
	if fn then
		fn(params or {})
	end
end

return VFX
