-- Loading screen tips
---------------------------------------------------------------------------
Config.Tips = {
	"Your tower has 8 floors and over 500 upgrades. Can you max it out?",
	"Use the elevator (or the FLOORS button) to move between floors.",
	"Invite a friend with the DUO button and build one tower together!",
