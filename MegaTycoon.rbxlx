<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
    </Properties>
  </Item>
  <Item class="ReplicatedFirst" referent="1">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="2">
      <Properties>
        <string name="Name">LoadingScreen</string>
        <string name="Source"><![CDATA[--[[
	Loading screen - animated background, spinning logo, progress bar with
	asset preloading, rotating tips, loading music and a skip button.
]]
local ContentProvider = game:GetService("ContentProvider")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

ReplicatedFirst:RemoveDefaultLoadingScreen()

-- defaults until the shared config replicates
local GAME_NAME = "MEGA TYCOON"
local TIPS = { "Loading the money printers..." }

local function new(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function stroke(parent: Instance, thickness: number?)
	return new("UIStroke", { Thickness = thickness or 3, Color = Color3.new(0, 0, 0), Parent = parent })
end

local gui = new("ScreenGui", {
	Name = "LoadingScreen",
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	DisplayOrder = 1000,
	Parent = playerGui,
})

local background = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(1, 1, 1),
	Parent = gui,
})
local bgGradient = new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 20, 70)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 30, 140)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 90, 120)),
	}),
	Rotation = 45,
	Parent = background,
})

-- floating money in the background
local floaters = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = background })
local EMOJIS = { "💵", "💰", "🪙", "💎", "⭐" }

local title = new("TextLabel", {
	Text = GAME_NAME,
	Size = UDim2.new(0.8, 0, 0.16, 0),
	Position = UDim2.fromScale(0.5, 0.3),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.FredokaOne,
	TextColor3 = Color3.new(1, 1, 1),
	Parent = background,
})
stroke(title, 5)
new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 245, 140)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 180, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 0)),
	}),
	Rotation = 90,
	Parent = title,
})
local titleScale = new("UIScale", { Scale = 0, Parent = title })
new("UISizeConstraint", { MaxSize = Vector2.new(900, 160), Parent = title })

local subtitle = new("TextLabel", {
	Text = "Build your empire. Rule the server.",
	Size = UDim2.new(0.6, 0, 0, 30),
	Position = UDim2.fromScale(0.5, 0.41),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextColor3 = Color3.fromRGB(220, 220, 255),
	TextTransparency = 1,
	Parent = background,
})

-- spinner (two rotating rounded squares)
local spinnerHolder = new("Frame", {
	Size = UDim2.fromOffset(70, 70),
	Position = UDim2.fromScale(0.5, 0.58),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	Parent = background,
})
local spinA = new("Frame", { Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 196, 0), Parent = spinnerHolder })
new("UICorner", { CornerRadius = UDim.new(0, 14), Parent = spinA })
stroke(spinA, 3)
local spinB = new("Frame", { Size = UDim2.fromScale(0.55, 0.55), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(0, 200, 255), Parent = spinnerHolder })
new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = spinB })
stroke(spinB, 3)
local coin = new("TextLabel", { Text = "$", Size = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, TextScaled = true, Font = Enum.Font.FredokaOne, TextColor3 = Color3.new(1, 1, 1), Parent = spinB })
stroke(coin, 2)

-- progress bar
local barBack = new("Frame", {
	Size = UDim2.new(0.5, 0, 0, 26),
	Position = UDim2.fromScale(0.5, 0.72),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundColor3 = Color3.fromRGB(20, 15, 40),
	Parent = background,
})
new("UICorner", { CornerRadius = UDim.new(0, 13), Parent = barBack })
stroke(barBack, 3)
new("UISizeConstraint", { MinSize = Vector2.new(260, 26), MaxSize = Vector2.new(600, 26), Parent = barBack })
local barFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = barBack })
new("UICorner", { CornerRadius = UDim.new(0, 13), Parent = barFill })
local fillGradient = new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 255, 140)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 230, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 255, 140)),
	}),
	Parent = barFill,
})
local percent = new("TextLabel", {
	Text = "0%",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.FredokaOne,
	TextColor3 = Color3.new(1, 1, 1),
	ZIndex = 3,
	Parent = barBack,
})
stroke(percent, 2)

local status = new("TextLabel", {
	Text = "Connecting...",
	Size = UDim2.new(0.6, 0, 0, 22),
	Position = UDim2.fromScale(0.5, 0.77),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextColor3 = Color3.fromRGB(200, 200, 230),
	Parent = background,
})

local tip = new("TextLabel", {
	Text = "",
	Size = UDim2.new(0.8, 0, 0, 26),
	Position = UDim2.fromScale(0.5, 0.9),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextColor3 = Color3.fromRGB(255, 230, 120),
	Parent = background,
})
stroke(tip, 2)

local skip = new("TextButton", {
	Text = "SKIP ▶",
	Size = UDim2.fromOffset(130, 44),
	Position = UDim2.new(1, -20, 1, -20),
	AnchorPoint = Vector2.new(1, 1),
	BackgroundColor3 = Color3.fromRGB(255, 196, 0),
	TextScaled = true,
	Font = Enum.Font.FredokaOne,
	TextColor3 = Color3.new(1, 1, 1),
	Visible = false,
	Parent = background,
})
new("UICorner", { CornerRadius = UDim.new(0, 10), Parent = skip })
stroke(skip, 3)
new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = skip })

local blur = new("BlurEffect", { Name = "LoadingBlur", Size = 24, Parent = Lighting })

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

---------------------------------------------------------------------------
-- Animation loop
---------------------------------------------------------------------------
local finished = false
local skipped = false
local displayed = 0
local target = 0

TweenService:Create(titleScale, TweenInfo.new(0.9, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
task.delay(0.5, function()
	TweenService:Create(subtitle, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
end)

local renderConn = RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	bgGradient.Rotation = (bgGradient.Rotation + dt * 12) % 360
	spinA.Rotation = (t * 180) % 360
	spinB.Rotation = -(t * 260) % 360
	titleScale.Scale = finished and titleScale.Scale or (titleScale.Scale > 0.95 and (1 + math.sin(t * 2.5) * 0.03) or titleScale.Scale)
	fillGradient.Offset = Vector2.new(math.sin(t * 2) * 0.5, 0)
	displayed += (target - displayed) * math.min(dt * 6, 1)
	barFill.Size = UDim2.fromScale(math.clamp(displayed, 0, 1), 1)
	percent.Text = math.floor(displayed * 100 + 0.5) .. "%"
end)

task.spawn(function()
	while not finished do
		local label = new("TextLabel", {
			Text = EMOJIS[math.random(1, #EMOJIS)],
			Size = UDim2.fromOffset(math.random(26, 54), math.random(26, 54)),
			Position = UDim2.new(math.random(), 0, 1.1, 0),
			BackgroundTransparency = 1,
			TextScaled = true,
			TextTransparency = 0.35,
			Rotation = math.random(-30, 30),
			Parent = floaters,
		})
		local duration = math.random(40, 80) / 10
		TweenService:Create(label, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
			Position = UDim2.new(label.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, -0.15, 0),
			Rotation = math.random(-180, 180),
		}):Play()
		task.delay(duration, function()
			label:Destroy()
		end)
		task.wait(0.25)
	end
end)

-- loading music + config
local music: Sound? = nil
task.spawn(function()
	local shared = ReplicatedStorage:WaitForChild("Shared", 20)
	local configModule = shared and shared:WaitForChild("Config", 10)
	if not configModule then
		return
	end
	local Config = require(configModule) :: any
	GAME_NAME = Config.GameName
	title.Text = GAME_NAME
	TIPS = Config.Tips
	if Config.Music.Loading and not finished then
		local sound = Instance.new("Sound")
		sound.SoundId = Config.Music.Loading.Id
		sound.Volume = 0
		sound.Looped = true
		sound.Parent = SoundService
		sound:Play()
		TweenService:Create(sound, TweenInfo.new(2), { Volume = 0.3 }):Play()
		music = sound
	end
end)

task.spawn(function()
	local i = 0
	while not finished do
		i = i % #TIPS + 1
		tip.Text = "💡 TIP: " .. TIPS[i]
		tip.TextTransparency = 1
		TweenService:Create(tip, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
		task.wait(4)
	end
end)

task.delay(6, function()
	if not finished then
		skip.Visible = true
	end
end)
skip.Activated:Connect(function()
	skipped = true
end)

---------------------------------------------------------------------------
-- Actual loading
---------------------------------------------------------------------------
local startTime = os.clock()

status.Text = "Loading game..."
if not game:IsLoaded() then
	game.Loaded:Wait()
end
target = 0.2

-- wait for the server to finish building the world
status.Text = "Building the world..."
local waited = 0
while not workspace:GetAttribute("ServerReady") and waited < 20 and not skipped do
	waited += task.wait(0.2)
end
target = 0.35

-- preload assets (in chunks so the bar moves)
status.Text = "Loading assets..."
local assets = {}
for _, d in workspace:GetDescendants() do
	if d:IsA("ParticleEmitter") or d:IsA("Decal") or d:IsA("Texture") or d:IsA("MeshPart") or d:IsA("Sound") then
		table.insert(assets, d)
	end
end
local total = math.max(#assets, 1)
local chunk = 25
for i = 1, #assets, chunk do
	if skipped then
		break
	end
	local slice = {}
	for j = i, math.min(i + chunk - 1, #assets) do
		table.insert(slice, assets[j])
	end
	pcall(function()
		ContentProvider:PreloadAsync(slice)
	end)
	target = 0.35 + 0.45 * (math.min(i + chunk, total) / total)
	status.Text = string.format("Loading assets... %d / %d", math.min(i + chunk - 1, #assets), #assets)
end
target = 0.8

-- wait for player data
status.Text = "Loading your tycoon..."
waited = 0
while not player:GetAttribute("DataLoaded") and waited < 25 and not skipped do
	waited += task.wait(0.2)
end
target = 1
status.Text = "Ready!"

-- minimum time so the screen doesn't just flash
while os.clock() - startTime < 3.5 and not skipped do
	task.wait(0.1)
end
task.wait(0.4)

---------------------------------------------------------------------------
-- Fade out
---------------------------------------------------------------------------
finished = true
skip.Visible = false
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
end)
local fadeInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
TweenService:Create(titleScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 }):Play()
TweenService:Create(background, fadeInfo, { BackgroundTransparency = 1 }):Play()
TweenService:Create(blur, TweenInfo.new(1.2), { Size = 0 }):Play()
for _, d in background:GetDescendants() do
	if d:IsA("TextLabel") or d:IsA("TextButton") then
		TweenService:Create(d, fadeInfo, { TextTransparency = 1 }):Play()
	end
	if d:IsA("Frame") then
		TweenService:Create(d, fadeInfo, { BackgroundTransparency = 1 }):Play()
	end
	if d:IsA("UIStroke") then
		TweenService:Create(d, fadeInfo, { Transparency = 1 }):Play()
	end
end
if music then
	TweenService:Create(music, TweenInfo.new(1), { Volume = 0 }):Play()
end
player:SetAttribute("LoadingDone", true)
task.wait(1.3)
renderConn:Disconnect()
blur:Destroy()
gui:Destroy()
if music then
	music:Destroy()
end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="3">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	MEGA TYCOON - Main configuration
	Everything you might want to tweak lives here: economy, floors, game passes,
	developer products, admins, disasters, secrets, music, minigames and codes.

	>>> BEFORE PUBLISHING <<<
	1. Create your Game Passes / Developer Products on the Creator Dashboard
	   and paste their IDs into GamePasses / Products below.
	2. Add your own UserId to Admin.Admins (the game creator is always Owner).
	3. Replace the music IDs with tracks you can use (Creator Store > Audio).
	4. Game Settings > Security > Enable Studio Access to API Services
	   (needed for saving in Studio).
	5. Set the place's Max Players to 8 (one tower per player).
]]

local Config = {}

Config.GameName = "MEGA TYCOON"
Config.Version = "2.1.0"

---------------------------------------------------------------------------
-- Data / economy
---------------------------------------------------------------------------
Config.DataStoreName = "MegaTycoon_PlayerData_v1"
Config.AutoSaveInterval = 90 -- seconds

Config.StartingCash = 100
Config.BaseWalkSpeed = 16
Config.MaxPlots = 8

Config.Tycoon = {
	Floors = 8,
	FloorHeight = 22,
	DropInterval = 2, -- seconds between drops of a dropper
	GeneratorCycle = 5, -- generators pay out every N seconds (visual)
	ConveyorSpeed = 12, -- studs per second (visual drops)
	-- Pacing: how long (in seconds of income) items cost, from the first item to
	-- the last one. Bigger = slower game. With the defaults a full 8-floor
	-- tower takes about 3 hours (much less with rebirths / passes).
	PaceStartSeconds = 4,
	PaceEndSeconds = 44,
	ButtonSlotsPerFloor = 12,
	MaxBuildPerTick = 30, -- items built per frame when a big tycoon loads
}

Config.OfflineEarnings = {
	Enabled = true,
	Percent = 0.25, -- earn 25% of your income while offline
	MaxHours = 8,
}

Config.Rebirth = {
	RequiredFloor = 5, -- the first rebirth costs as much as unlocking this floor
	CostGrowth = 4, -- each rebirth costs 4x more
	MultiplierPerRebirth = 0.5, -- each rebirth adds +0.5x to all income
	-- Rebirth ranks: reaching rebirth N earns that rank and its perk, forever.
	-- Perk kinds: Income (+x to the income multiplier), Start (extra cash after a
	-- rebirth), Offline (+% offline earnings, 0.05 = +5%), Quest / Gift (+% rewards),
	-- Speed (+walk speed). Perks of every rank earned so far add up.
	Ranks = {
		{ Rebirths = 1, Name = "Reborn", Icon = "🌱", Perks = { Start = 500 }, Text = "+500 starting cash after each rebirth" },
		{ Rebirths = 2, Name = "Hustler", Icon = "💼", Perks = { Speed = 2 }, Text = "+2 walk speed" },
		{ Rebirths = 3, Name = "Saver", Icon = "💤", Perks = { Offline = 0.05 }, Text = "+5% offline earnings" },
		{ Rebirths = 4, Name = "Quest Hunter", Icon = "📜", Perks = { Quest = 0.1 }, Text = "+10% quest rewards" },
		{ Rebirths = 5, Name = "Gift Magnet", Icon = "🎁", Perks = { Gift = 0.1 }, Text = "+10% playtime gifts" },
		{ Rebirths = 6, Name = "Mogul", Icon = "🏢", Perks = { Income = 0.5 }, Text = "+0.5x income" },
		{ Rebirths = 7, Name = "Sprinter", Icon = "👟", Perks = { Speed = 2 }, Text = "+2 more walk speed" },
		{ Rebirths = 8, Name = "Banker", Icon = "🏦", Perks = { Start = 5000, Offline = 0.05 }, Text = "+5,000 starting cash, +5% offline" },
		{ Rebirths = 9, Name = "Legend", Icon = "🏆", Perks = { Quest = 0.15, Gift = 0.15 }, Text = "+15% quest rewards and gifts" },
		{ Rebirths = 10, Name = "Mythic", Icon = "👑", Perks = { Income = 1, Offline = 0.1 }, Text = "+1x income, +10% offline" },
	},
}

---------------------------------------------------------------------------
-- Duo building
---------------------------------------------------------------------------
Config.Duo = {
	Enabled = true,
	InviteTimeout = 30,
}

---------------------------------------------------------------------------
-- Disasters (random server events). Nukes/meteors/tornadoes knock out
-- tycoon items for a while unless the tower has the Nuke Shield Dome.
---------------------------------------------------------------------------
Config.Disasters = {
	Enabled = true,
	FirstDelay = 240, -- seconds after the server starts
	MinInterval = 300,
	MaxInterval = 480,
	MainMapMaxY = 400, -- players above this (minigame arena) are not affected
	Nuke = {
		Weight = 1,
		Warning = 30, -- seconds to reach a bunker
		ShockSpeed = 320, -- studs per second
		KnockoutFraction = 0.25, -- share of an unshielded tower that gets wrecked
		KnockoutSeconds = 180,
	},
	Meteors = {
		Weight = 3,
		Duration = 40,
		Interval = 0.35,
		Radius = 12,
		Damage = 45,
		KnockoutSeconds = 90,
		CrystalChance = 0.3,
		CrystalIncomeSeconds = 20,
	},
	Tornado = {
		Weight = 3,
		Duration = 45,
		Radius = 22,
		Speed = 30,
		KnockoutSeconds = 60,
	},
	UFO = {
		Weight = 3,
		Duration = 45,
		Count = 3,
		AbductEvery = 6,
		CashEvery = 1.5,
		CashIncomeSeconds = 10,
	},
	Earthquake = {
		Weight = 2,
		Duration = 25,
		WaveEvery = 3, -- seconds between shocks
		Damage = 6, -- per shock, if you're not in a shelter
		KnockoutFraction = 0.03, -- share of an unshielded tower wrecked per shock
		KnockoutSeconds = 90,
		GeodeCount = 6, -- cash geodes pushed out of the ground
		GeodeIncomeSeconds = 15,
	},
}

---------------------------------------------------------------------------
-- Secrets hidden around the map. Each one gives cash and permanently builds
-- a secret relic in your tower (+5% income each, kept through rebirths).
---------------------------------------------------------------------------
Config.SecretRewards = {
	IncomeSeconds = 180,
	MinCash = 5_000,
	BonusPercent = 5,
}

Config.Secrets = {
	{ Id = "Board", Name = "Behind the Scenes", Hint = "Leaders always have something behind them...", Color = Color3.fromRGB(255, 200, 40), BadgeId = 0 },
	{ Id = "Bunker", Name = "Doomsday Stash", Hint = "Preppers hide snacks where it's safe from the bomb.", Color = Color3.fromRGB(150, 160, 170), BadgeId = 0 },
	{ Id = "Summit", Name = "Top of the World", Hint = "Climb the snowy mountain all the way up.", Color = Color3.fromRGB(220, 240, 255), BadgeId = 0 },
	{ Id = "Cave", Name = "Crystal Cave", Hint = "The mountain is hollow. Look for a gap behind the trees.", Color = Color3.fromRGB(150, 80, 255), BadgeId = 0 },
	{ Id = "LakeFloor", Name = "Sunken Treasure", Hint = "Hold your breath and dive to the bottom of the lake.", Color = Color3.fromRGB(0, 170, 255), BadgeId = 0 },
	{ Id = "Island", Name = "Castaway", Hint = "A lonely tree on a lonely island is hiding something.", Color = Color3.fromRGB(90, 220, 110), BadgeId = 0 },
	{ Id = "Obby", Name = "Shortcut Seeker", Hint = "Some obby platforms are almost invisible...", Color = Color3.fromRGB(255, 80, 160), BadgeId = 0 },
	{ Id = "Cloud", Name = "Head in the Clouds", Hint = "A strange pad in the east forest sends you flying.", Color = Color3.fromRGB(255, 255, 255), BadgeId = 0 },
	{ Id = "Edge", Name = "End of the World", Hint = "Walk until the world ends. Then check the corner.", Color = Color3.fromRGB(60, 60, 80), BadgeId = 0 },
	{ Id = "GiantTree", Name = "Tree House", Hint = "The biggest tree in the forest has a door.", Color = Color3.fromRGB(140, 90, 50), BadgeId = 0 },
	{ Id = "Graveyard", Name = "Spooky Secret", Hint = "Not everyone in the graveyard is resting.", Color = Color3.fromRGB(120, 255, 120), BadgeId = 0 },
	{ Id = "Waterfall", Name = "Behind the Falls", Hint = "Walk through the waterfall next to the mountain.", Color = Color3.fromRGB(120, 220, 255), BadgeId = 0 },
}

---------------------------------------------------------------------------
-- Monetization
-- Id = 0 means "not configured yet". While in Roblox Studio, buying an item
-- with Id 0 simulates the purchase so you can test everything for free.
---------------------------------------------------------------------------
Config.Monetization = {
	SimulateUnconfiguredInStudio = true,
}

Config.GamePasses = {
	DoubleCash = {
		Id = 0,
		Name = "2x Cash",
		Description = "Double ALL income, forever! Works for your duo partner too.",
		PriceHint = 299,
		Icon = "💵",
		Color = Color3.fromRGB(70, 200, 90),
		Order = 1,
	},
	AutoCollect = {
		Id = 0,
		Name = "Auto Collect",
		Description = "Cash goes straight to your wallet. No more vault!",
		PriceHint = 149,
		Icon = "🧲",
		Color = Color3.fromRGB(80, 160, 255),
		Order = 2,
	},
	FastDroppers = {
		Id = 0,
		Name = "Fast Droppers",
		Description = "All droppers drop 2x faster (2x dropper income).",
		PriceHint = 249,
		Icon = "⚡",
		Color = Color3.fromRGB(255, 200, 40),
		Order = 3,
	},
	VIP = {
		Id = 0,
		Name = "VIP",
		Description = "+50% cash, golden VIP chat tag, VIP aura & daily bonus x2.",
		PriceHint = 399,
		Icon = "👑",
		Color = Color3.fromRGB(255, 170, 0),
		Order = 4,
	},
	SuperSpeed = {
		Id = 0,
		Name = "Super Speed",
		Description = "Run 2x faster around the map (great for escaping nukes!).",
		PriceHint = 99,
		Icon = "👟",
		Color = Color3.fromRGB(255, 90, 160),
		Order = 5,
	},
	AutoBuild = {
