function builders.Decor(plot, item, model: Model, cf: CFrame)
	local fn = decor[item.Model] or decor[1]
	fn(model, cf, item.LocalPos, themeOf(item))
	return {}
end

function builders.Wall(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local side = item.Side
	local wallColor = theme.Primary:Lerp(Color3.new(1, 1, 1), 0.3)
	local H = FH - 1
	if side == "Left" or side == "Right" then
		local x = side == "Left" and -41.5 or 41.5
		Part({ Name = "Wall", Size = Vector3.new(1, H, 84), CFrame = at(cf, x, H / 2, 0), Color = wallColor, Material = theme.Wall, Parent = model })
		for i = -2, 2 do
			Part({ Name = "Window", Size = Vector3.new(1.2, 5, 9), CFrame = at(cf, x, 11, i * 16), Color = Color3.fromRGB(150, 210, 255), Material = Enum.Material.Glass, Transparency = 0.4, Parent = model })
		end
	elseif side == "Back" then
		Part({ Name = "Wall", Size = Vector3.new(84, H, 1), CFrame = at(cf, 0, H / 2, 41.5), Color = wallColor, Material = theme.Wall, Parent = model })
	elseif side == "Front" then
		-- glass front with a door gap on the ground floor
		local door = item.Floor == 1
		for _, seg in { { -24, 36 }, { 24, 36 } } do
			Part({ Name = "Glass", Size = Vector3.new(seg[2], H, 0.6), CFrame = at(cf, seg[1], H / 2, -41.5), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.55, Parent = model })
		end
		if door then
			Part({ Name = "DoorTop", Size = Vector3.new(12, H - 12, 0.6), CFrame = at(cf, 0, 12 + (H - 12) / 2, -41.5), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.55, Parent = model })
			Part({ Name = "DoorFrame", Size = Vector3.new(13, 1, 1), CFrame = at(cf, 0, 12, -41.5), Color = theme.Accent, Material = Enum.Material.Neon, Parent = model })
		else
			Part({ Name = "Glass", Size = Vector3.new(12, H, 0.6), CFrame = at(cf, 0, H / 2, -41.5), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.55, Parent = model })
		end
		for _, x in { -36, -12, 12, 36 } do
			Part({ Name = "Mullion", Size = Vector3.new(0.8, H, 0.8), CFrame = at(cf, x, H / 2, -41.5), Color = DARK, Material = Enum.Material.Metal, Parent = model })
		end
	elseif side == "Pillars" then
		for _, o in { Vector2.new(-41.5, -41.5), Vector2.new(41.5, -41.5), Vector2.new(-41.5, 41.5), Vector2.new(41.5, 41.5), Vector2.new(0, 41.5), Vector2.new(-41.5, 0), Vector2.new(41.5, 0) } do
			Part({ Name = "Pillar", Size = Vector3.new(2.4, FH, 2.4), CFrame = at(cf, o.X, FH / 2 - 0.5, o.Y), Color = theme.Secondary, Material = Enum.Material.Concrete, Parent = model })
		end
	elseif side == "Trim" then
		for _, y in { 0.3, H - 0.3 } do
			for _, data in {
				{ Vector3.new(84, 0.5, 0.5), Vector3.new(0, y, -42.1) },
				{ Vector3.new(84, 0.5, 0.5), Vector3.new(0, y, 42.1) },
				{ Vector3.new(0.5, 0.5, 84), Vector3.new(-42.1, y, 0) },
				{ Vector3.new(0.5, 0.5, 84), Vector3.new(42.1, y, 0) },
			} do
				Part({ Name = "Trim", Size = data[1], CFrame = at(cf, data[2].X, data[2].Y, data[2].Z), Color = theme.Accent, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
			end
		end
	end
	return {}
end

function builders.Boost(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local p = item.LocalPos
	local color = Color3.fromHSV((theme.Hue + 0.5 + item.Slot * 0.1) % 1, 0.8, 1)
	local sign = Part({ Name = "Sign", Size = Vector3.new(10, 5, 0.6), CFrame = at(cf, p.X, p.Y, p.Z), Color = Color3.fromRGB(20, 20, 30), Parent = model })
	Part({ Name = "Frame", Size = Vector3.new(10.6, 5.6, 0.4), CFrame = at(cf, p.X, p.Y, p.Z + 0.4), Color = color, Material = Enum.Material.Neon, Parent = model })
	BuildKit.SurfaceText(sign, Enum.NormalId.Front, "x" .. item.Multiplier .. " BOOST", { PixelsPerStud = 20, Color = color, Brightness = 3 })
	BuildKit.Light(sign, color, 20, 2)
	return {}
end

function builders.Conveyor(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local color = item.Slot == 1 and theme.Accent or Color3.fromRGB(0, 230, 255)
	for i = 0, 7 do
		local x = Items.BeltStartX + 6 + i * 8.5 + (item.Slot - 1) * 4
		Part({ Name = "Chevron", Size = Vector3.new(0.6, 0.1, 3.6), CFrame = at(cf, x, 1.25, Items.BeltZ) * CFrame.Angles(0, math.rad(item.Slot == 1 and 30 or -30), 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
	end
	if item.Slot == 2 then
		for _, dz in { -3.3, 3.3 } do
			Part({ Name = "Glow", Size = Vector3.new(Items.BeltEndX - Items.BeltStartX, 0.3, 0.3), CFrame = at(cf, (Items.BeltEndX + Items.BeltStartX) / 2, 2.1, Items.BeltZ + dz), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		end
	end
	return {}
end

-- Specials ---------------------------------------------------------------
local function monument(model, cf, p, color, shape)
	Part({ Name = "Pedestal", Size = Vector3.new(8, 2, 8), CFrame = at(cf, p.X, 1, p.Z), Color = DARK, Material = Enum.Material.Marble, Parent = model })
	local core
	if shape == "Ring" then
		core = Part({ Name = "Portal", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 9, 9), CFrame = at(cf, p.X, 7.5, p.Z) * CFrame.Angles(0, math.rad(90), 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
		Part({ Name = "Void", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 7.4, 7.4), CFrame = at(cf, p.X, 7.5, p.Z) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(10, 0, 30), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
	elseif shape == "Crystal" then
		core = Part({ Name = "Gem", Size = Vector3.new(3.5, 6, 3.5), CFrame = at(cf, p.X, 7, p.Z) * CFrame.Angles(0, math.rad(45), 0), Color = color, Material = Enum.Material.Glass, Transparency = 0.15, CanCollide = false, Tags = { "Spin", "Bob" }, Parent = model })
	elseif shape == "Tower" then
		Part({ Name = "Base", Size = Vector3.new(4, 10, 4), CFrame = at(cf, p.X, 7, p.Z), Color = Color3.fromRGB(20, 20, 30), Material = Enum.Material.Metal, Parent = model })
		core = Part({ Name = "Holo", Size = Vector3.new(5, 5, 5), CFrame = at(cf, p.X, 15, p.Z), Color = color, Material = Enum.Material.ForceField, CanCollide = false, Tags = { "Spin" }, Parent = model })
	elseif shape == "Dragon" then
		Part({ Name = "Body", Size = Vector3.new(3, 3, 6), CFrame = at(cf, p.X, 4.5, p.Z), Color = color, Material = Enum.Material.Ice, Parent = model })
		Part({ Name = "Neck", Size = Vector3.new(1.6, 4, 1.6), CFrame = at(cf, p.X, 7, p.Z - 2.6) * CFrame.Angles(math.rad(-25), 0, 0), Color = color, Material = Enum.Material.Ice, Parent = model })
		core = Part({ Name = "Head", Size = Vector3.new(2.2, 2, 3), CFrame = at(cf, p.X, 9.2, p.Z - 3.8), Color = color, Material = Enum.Material.Ice, Parent = model })
		for _, dx in { -3, 3 } do
			Part({ Name = "Wing", Size = Vector3.new(4, 0.3, 3.6), CFrame = at(cf, p.X + dx, 6.4, p.Z + 0.5) * CFrame.Angles(0, 0, math.rad(dx > 0 and -25 or 25)), Color = Color3.fromRGB(150, 220, 255), Material = Enum.Material.Glass, Transparency = 0.3, Parent = model })
		end
	else -- Orb / Fountain / Reactor
		core = Part({ Name = "Orb", Shape = Enum.PartType.Ball, Size = Vector3.one * 5, CFrame = at(cf, p.X, 6.5, p.Z), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse", "Bob" }, Parent = model })
		for i = 1, 2 do
			Part({ Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 7 + i, 7 + i), CFrame = at(cf, p.X, 6.5, p.Z) * CFrame.Angles(math.rad(60 * i), 0, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Spin" }, Parent = model })
		end
	end
	BuildKit.Light(core, color, 30, 2.5)
	BuildKit.Particles(core, { Color = ColorSequence.new(color, Color3.new(1, 1, 1)), Size = BuildKit.Size(0.8), Rate = 20, Speed = NumberRange.new(3, 6), SpreadAngle = Vector2.new(180, 180) })
	return core
end

local SPECIAL_SHAPES = {
	["Money Fountain"] = "Orb",
	["Diamond Vault"] = "Crystal",
	["Lava Reactor"] = "Orb",
	["Ice Dragon Statue"] = "Dragon",
	["Hologram Tower"] = "Tower",
	["Galaxy Portal"] = "Ring",
}

function builders.Special(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local p = item.LocalPos
	if item.Effect == "Bunker" then
		local concrete = Color3.fromRGB(120, 120, 125)
		local W, D, H = 11, 9, 8
		-- walls (door on the -X side)
		Part({ Name = "Roof", Size = Vector3.new(W + 1, 1.2, D + 1), CFrame = at(cf, p.X, H + 0.6, p.Z), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
		Part({ Name = "WallBack", Size = Vector3.new(W, H, 1), CFrame = at(cf, p.X, H / 2, p.Z + D / 2), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
		Part({ Name = "WallFront", Size = Vector3.new(W, H, 1), CFrame = at(cf, p.X, H / 2, p.Z - D / 2), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
		Part({ Name = "WallRight", Size = Vector3.new(1, H, D), CFrame = at(cf, p.X + W / 2, H / 2, p.Z), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
		Part({ Name = "WallLeftA", Size = Vector3.new(1, H, 2.5), CFrame = at(cf, p.X - W / 2, H / 2, p.Z - D / 2 + 1.25), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
		Part({ Name = "WallLeftB", Size = Vector3.new(1, H, 2.5), CFrame = at(cf, p.X - W / 2, H / 2, p.Z + D / 2 - 1.25), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
		Part({ Name = "WallLeftTop", Size = Vector3.new(1, 2, 4), CFrame = at(cf, p.X - W / 2, H - 1, p.Z), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
		local sign = Part({ Name = "Sign", Size = Vector3.new(0.3, 1.6, 4), CFrame = at(cf, p.X - W / 2 - 0.7, H + 1.6, p.Z), Color = Color3.fromRGB(255, 210, 0), Material = Enum.Material.Neon, Parent = model })
		BuildKit.SurfaceText(sign, Enum.NormalId.Left, "☢️ BUNKER", { PixelsPerStud = 20, Color = Color3.new(0, 0, 0) })
		local lamp = Part({ Name = "Lamp", Size = Vector3.new(2, 0.3, 2), CFrame = at(cf, p.X, H - 0.3, p.Z), Color = Color3.fromRGB(255, 80, 60), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
		BuildKit.Light(lamp, Color3.fromRGB(255, 120, 90), 14, 1.5)
		return {
			ShelterCF = at(cf, p.X, H / 2, p.Z),
			ShelterSize = Vector3.new(W - 1, H, D - 1),
			Door = at(cf, p.X - W / 2 - 2, 2.5, p.Z).Position,
		}
	elseif item.Effect == "Shield" then
		local color = Color3.fromRGB(80, 200, 255)
		Part({ Name = "Base", Size = Vector3.new(6, 1.5, 6), CFrame = at(cf, p.X, 0.75, p.Z), Color = DARK, Material = Enum.Material.Metal, Parent = model })
		Part({ Name = "Pylon", Size = Vector3.new(1.6, 9, 1.6), CFrame = at(cf, p.X, 6, p.Z), Color = Color3.fromRGB(70, 70, 90), Material = Enum.Material.Metal, Parent = model })
		local orb = Part({ Name = "Emitter", Shape = Enum.PartType.Ball, Size = Vector3.one * 3, CFrame = at(cf, p.X, 11.5, p.Z), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
		BuildKit.Light(orb, color, 30, 3)
		BuildKit.Billboard(orb, "🛡️ NUKE SHIELD", { Size = UDim2.fromOffset(150, 28), Offset = Vector3.new(0, 3, 0), Color = color, MaxDistance = 60 })
		local dome = Part({
			Name = "ShieldDome",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (plot.ShieldRadius * 2),
			Position = plot.ShieldCenter,
			Color = color,
			Material = Enum.Material.ForceField,
			Transparency = 0.15,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Parent = model,
		})
		dome:AddTag("ShieldDome")
		return { ShieldCenter = plot.ShieldCenter, ShieldRadius = plot.ShieldRadius }
	end
	local color = theme.Accent
	local core = monument(model, cf, p, color, SPECIAL_SHAPES[item.Name] or "Orb")
	BuildKit.Billboard(core, item.Name .. " (+" .. math.floor((item.Bonus or 0) * 100 + 0.5) .. "%)", { Size = UDim2.fromOffset(180, 28), Offset = Vector3.new(0, 5, 0), Color = shade(color, 0.4), MaxDistance = 60 })
	return {}
end

function builders.Trophy(plot, item, model: Model, cf: CFrame)
	local theme = themeOf(item)
	local p = item.LocalPos
	local gold = Color3.fromRGB(255, 205, 40)
	Part({ Name = "Shelf", Size = Vector3.new(8, 0.6, 4), CFrame = at(cf, p.X, p.Y - 3, p.Z + 2), Color = theme.Secondary, Material = Enum.Material.Marble, Parent = model })
	Part({ Name = "Base", Size = Vector3.new(2.6, 1, 2.6), CFrame = at(cf, p.X, p.Y - 2.2, p.Z + 2), Color = DARK, Parent = model })
	Part({ Name = "Stem", Size = Vector3.new(0.8, 1.6, 0.8), CFrame = at(cf, p.X, p.Y - 0.9, p.Z + 2), Color = gold, Material = Enum.Material.Foil, Parent = model })
	local cup = Part({ Name = "Cup", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 3, 3), CFrame = at(cf, p.X, p.Y + 1.4, p.Z + 2) * FLAT, Color = gold, Material = Enum.Material.Foil, Reflectance = 0.3, Tags = { "Spin" }, Parent = model })
	BuildKit.Light(cup, gold, 20, 2)
	BuildKit.Billboard(cup, "🏆 FLOOR " .. item.Floor .. " COMPLETE", { Size = UDim2.fromOffset(190, 28), Offset = Vector3.new(0, 3, 0), Color = gold, MaxDistance = 60 })
	return {}
end

-- Roof -----------------------------------------------------------------------
local roofBuilders = {}

roofBuilders.Helipad = function(plot, model, cf, p, ownerName)
	Part({ Name = "Roof", Size = Vector3.new(84, 1, 84), CFrame = at(cf, 0, -0.5, 0), Color = Color3.fromRGB(70, 70, 80), Material = Enum.Material.Concrete, Parent = model })
	Part({ Name = "Pad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 26, 26), CFrame = at(cf, p.X, 0.1, p.Z) * FLAT, Color = Color3.fromRGB(40, 40, 45), Material = Enum.Material.Asphalt, Parent = model })
	Part({ Name = "H1", Size = Vector3.new(1.6, 0.25, 10), CFrame = at(cf, p.X - 3, 0.2, p.Z), Color = Color3.fromRGB(255, 220, 0), Material = Enum.Material.Neon, Parent = model })
	Part({ Name = "H2", Size = Vector3.new(1.6, 0.25, 10), CFrame = at(cf, p.X + 3, 0.2, p.Z), Color = Color3.fromRGB(255, 220, 0), Material = Enum.Material.Neon, Parent = model })
	Part({ Name = "H3", Size = Vector3.new(6, 0.25, 1.6), CFrame = at(cf, p.X, 0.2, p.Z), Color = Color3.fromRGB(255, 220, 0), Material = Enum.Material.Neon, Parent = model })
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local light = Part({ Name = "Light", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.8, CFrame = at(cf, p.X + math.cos(a) * 13, 0.5, p.Z + math.sin(a) * 13), Color = Color3.fromRGB(80, 255, 120), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
		light.Name = "Light" .. i
	end
	-- railing
	for _, data in {
		{ Vector3.new(84, 1, 0.4), Vector3.new(0, 1.5, -42) },
		{ Vector3.new(84, 1, 0.4), Vector3.new(0, 1.5, 42) },
		{ Vector3.new(0.4, 1, 84), Vector3.new(-42, 1.5, 0) },
		{ Vector3.new(0.4, 1, 84), Vector3.new(42, 1.5, 0) },
	} do
		Part({ Name = "Rail", Size = data[1], CFrame = at(cf, data[2].X, data[2].Y, data[2].Z), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal, Parent = model })
	end
end
roofBuilders.Antenna = function(plot, model, cf, p)
	local truss = Instance.new("TrussPart")
	truss.Anchored = true
	truss.Size = Vector3.new(2, 40, 2)
	truss.CFrame = at(cf, p.X, 20, p.Z)
	truss.Color = Color3.fromRGB(180, 180, 190)
	truss.Parent = model
	local tip = Part({ Name = "Tip", Shape = Enum.PartType.Ball, Size = Vector3.one * 2, CFrame = at(cf, p.X, 41, p.Z), Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
	BuildKit.Light(tip, Color3.fromRGB(255, 40, 40), 40, 3)
end
roofBuilders.Pool = function(plot, model, cf, p)
	Part({ Name = "Rim", Size = Vector3.new(20, 1.4, 14), CFrame = at(cf, p.X, 0.7, p.Z), Color = Color3.fromRGB(230, 230, 235), Material = Enum.Material.Marble, Parent = model })
	Part({ Name = "Water", Size = Vector3.new(18, 0.4, 12), CFrame = at(cf, p.X, 1.25, p.Z), Color = Color3.fromRGB(40, 170, 255), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, Parent = model })
	Part({ Name = "Board", Size = Vector3.new(1.6, 0.3, 6), CFrame = at(cf, p.X, 2.6, p.Z - 8), Color = Color3.fromRGB(240, 240, 240), Parent = model })
end
roofBuilders.Billboard = function(plot, model, cf, p, ownerName)
	for _, dx in { -14, 14 } do
		Part({ Name = "Leg", Size = Vector3.new(1, 12, 1), CFrame = at(cf, p.X + dx, 6, p.Z), Color = DARK, Material = Enum.Material.Metal, Parent = model })
	end
	local board = Part({ Name = "Board", Size = Vector3.new(34, 10, 0.8), CFrame = at(cf, p.X, 17, p.Z), Color = Color3.fromRGB(15, 15, 25), Parent = model })
	local _, label = BuildKit.SurfaceText(board, Enum.NormalId.Front, string.upper(ownerName or "MY") .. "'S EMPIRE", { PixelsPerStud = 14, Brightness = 3 })
	label:SetAttribute("Rainbow", true)
	board:AddTag("RainbowSign")
	BuildKit.Light(board, Color3.fromRGB(255, 220, 120), 40, 2)
end
roofBuilders.Fireworks = function(plot, model, cf, p)
	Part({ Name = "Crate", Size = Vector3.new(5, 2, 5), CFrame = at(cf, p.X, 1, p.Z), Color = Color3.fromRGB(170, 40, 40), Material = Enum.Material.WoodPlanks, Parent = model })
	for i = 1, 4 do
		local tube = Part({ Name = "Tube", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 0.9, 0.9), CFrame = at(cf, p.X + ((i - 1) % 2 - 0.5) * 2, 3.5, p.Z + ((i - 1) // 2 - 0.5) * 2) * FLAT, Color = Color3.fromHSV(i / 4, 0.8, 1), Parent = model })
		tube.Name = "Tube" .. i
	end
	model:AddTag("Fireworks")
	model:SetAttribute("LaunchPos", at(cf, p.X, 5, p.Z).Position)
end
roofBuilders.Crown = function(plot, model, cf, p)
	local gold = Color3.fromRGB(255, 205, 40)
	Part({ Name = "Band", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 12, 12), CFrame = at(cf, p.X, 4, p.Z) * FLAT, Color = gold, Material = Enum.Material.Foil, Reflectance = 0.3, Parent = model })
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Part({ Name = "Spike", Size = Vector3.new(1.4, 4, 1.4), CFrame = at(cf, p.X + math.cos(a) * 5.4, 7.2, p.Z + math.sin(a) * 5.4) * CFrame.Angles(0, -a, 0), Color = gold, Material = Enum.Material.Foil, Parent = model })
		local gem = Part({ Name = "Jewel", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.2, CFrame = at(cf, p.X + math.cos(a) * 5.9, 4, p.Z + math.sin(a) * 5.9), Color = Color3.fromHSV(i / 8, 0.8, 1), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		gem.Name = "Jewel" .. i
	end
	BuildKit.Light(model:FindFirstChild("Band") :: BasePart, gold, 40, 3)
end

function builders.Roof(plot, item, model: Model, cf: CFrame, ownerName: string?)
	local fn = roofBuilders[item.Model]
	if fn then
		fn(plot, model, cf, item.LocalPos, ownerName)
	end
	return {}
end

function builders.Secret(plot, item, model: Model)
	local p = item.LocalPos
	local cf = plot.CFrame
	local color = item.Color or Color3.fromRGB(255, 255, 255)
	Part({ Name = "Pedestal", Size = Vector3.new(4, 2, 4), CFrame = at(cf, p.X, 2, p.Z), Color = Color3.fromRGB(35, 35, 45), Material = Enum.Material.Marble, Parent = model })
	Part({ Name = "Trim", Size = Vector3.new(4.4, 0.3, 4.4), CFrame = at(cf, p.X, 3.1, p.Z), Color = color, Material = Enum.Material.Neon, Parent = model })
	local relic = Part({
		Name = "Relic",
		Size = Vector3.one * 1.8,
		CFrame = at(cf, p.X, 5.2, p.Z) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin", "Bob" },
		Parent = model,
	})
	BuildKit.Light(relic, color, 16, 2)
	BuildKit.Particles(relic, { Color = ColorSequence.new(color, Color3.new(1, 1, 1)), Size = BuildKit.Size(0.5), Rate = 10, SpreadAngle = Vector2.new(180, 180) })
	BuildKit.Billboard(relic, "🕵️ " .. item.Name, { Size = UDim2.fromOffset(170, 26), Offset = Vector3.new(0, 2.4, 0), Color = color, MaxDistance = 60 })
	return {}
end

-- Build an item into the plot. Returns (model, extra)
function TycoonBuilder.BuildItem(plot, item, ownerName: string?)
	local model = BuildKit.Model(item.Id, plot.Items)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local floorCF = TycoonBuilder.FloorCF(plot, math.max(item.Floor, 1))
	local builder = builders[item.Kind]
	local extra = {}
	if builder then
		extra = builder(plot, item, model, floorCF, ownerName) or {}
	end
	return model, extra
end

-- world position of an item (for knockouts, tornado hits, effects)
function TycoonBuilder.ItemWorldPos(plot, item): Vector3
	if item.Kind == "Secret" then
		return (plot.CFrame * CFrame.new(item.LocalPos)).Position
	end
	local floorCF = TycoonBuilder.FloorCF(plot, math.max(item.Floor, 1))
	local p = item.LocalPos or Vector3.new(0, 0, 0)
	return (floorCF * CFrame.new(p.X, p.Y + 3, p.Z)).Position
end

return TycoonBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">TycoonService</string>
          <string name="Source"><![CDATA[--[[
	TycoonService - plots, 8-floor towers, purchasing (buttons + Build menu),
	income ticks, vaults, elevators, rebirths, disaster knockouts/repairs,
	shelters and duo plot membership.

	Income is computed on the server from TycoonItems.ComputeIncome (no physics
	drops on the server). Clients render the falling drops locally using the
	attributes set on dropper / upgrader / generator models.
]]
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local TycoonItems = require(Shared.TycoonItems)
local BuildKit = require(script.Parent.BuildKit)
local TycoonBuilder = require(script.Parent.TycoonBuilder)

local TycoonService = {}
local S

local TC = Config.Tycoon
local FLOORS = TC.Floors
local PLOT_RADIUS = 270

local plots = {}
local playerPlot: { [Player]: any } = {}

local GREEN = Color3.fromRGB(60, 220, 100)
local RED = Color3.fromRGB(235, 70, 70)

local KNOCKOUT_KINDS = {
	Dropper = true,
	Upgrader = true,
	Generator = true,
	Decor = true,
	Boost = true,
	Conveyor = true,
	Special = true,
	Roof = true,
}

local function isMember(player: Player, plot): boolean
	return plot ~= nil and (plot.Owner == player or plot.Partner == player)
end

local function members(plot): { Player }
	local list = {}
	if plot.Owner then
		table.insert(list, plot.Owner)
	end
	if plot.Partner then
		table.insert(list, plot.Partner)
	end
	return list
end

local function sendUpdate(plot, payload)
	for _, member in members(plot) do
		Remotes.TycoonUpdate:FireClient(member, payload)
	end
end

local function quest(player: Player, kind: string, amount: number?)
	if S.QuestService then
		S.QuestService:Progress(player, kind, amount)
	end
end

local function canKnockOut(item): boolean
	if not KNOCKOUT_KINDS[item.Kind] then
		return false
	end
	if item.Kind == "Special" and item.Effect ~= "Bonus" then
		return false -- bunkers and shields can't be wrecked
	end
	if item.Kind == "Roof" and item.Model == "Helipad" then
		return false -- it's the roof itself
	end
	return true
end

---------------------------------------------------------------------------
function TycoonService:Init(services)
	S = services
	local folder = Instance.new("Folder")
	folder.Name = "Tycoons"
	folder.Parent = workspace

	for index = 1, Config.MaxPlots do
		local angle = math.rad(22.5 + (index - 1) * (360 / Config.MaxPlots))
		local pos = Vector3.new(math.cos(angle) * PLOT_RADIUS, 0, math.sin(angle) * PLOT_RADIUS)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
		local plot = TycoonBuilder.BuildPlot(index, cf, folder)
		plot.Owner = nil
		plot.Partner = nil
		plot.Built = {}
		plot.Extra = {}
		plot.ButtonObjs = {}
		plot.SlotUsed = {}
		plot.Disabled = {}
		plot.RubbleModels = {}
		plot.ItemPos = {}
		plot.Worth = {}
		plot.Income = 0
		plot.Connections = {}
		plot.VaultLabels = {}
		plot.Queue = {}
		plot.LastPad = 0
		plot.Generation = 0
		plots[index] = plot
	end

	S.DataService.PlayerLoaded:Connect(function(player, data)
		self:_assign(player, data)
	end)
	-- offline earnings use the player's OWN tower (also while they're a duo
	-- partner). Computed from data, so it works no matter whether the tower
	-- was already cleared when the leave-save runs.
	S.DataService.BeforeSave:Connect(function(player, data)
		data.LastIncome = self:GetOfflineIncome(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_onLeave(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		self:_hookCharacter(player)
	end)
	for _, player in Players:GetPlayers() do
		self:_hookCharacter(player)
	end

	Remotes.RequestRebirth.OnServerEvent:Connect(function(player)
		self:Rebirth(player)
	end)
	Remotes.GoHome.OnServerEvent:Connect(function(player)
		if player:GetAttribute("InMinigame") then
			return
		end
		player:SetAttribute("ObbyStage", 0)
		self:TeleportHome(player)
	end)
	Remotes.BuyItem.OnServerInvoke = function(player, itemId)
		if type(itemId) ~= "string" then
			return false, "Invalid item"
		end
		return self:TryPurchase(player, itemId)
	end
	Remotes.BuyAll.OnServerEvent:Connect(function(player, floor)
		self:BuyAll(player, type(floor) == "number" and floor or nil)
	end)
	Remotes.TeleportFloor.OnServerEvent:Connect(function(player, plotIndex, floor)
		self:TeleportToFloor(player, plotIndex, floor)
	end)
	Remotes.GetTycoonState.OnServerInvoke = function(player)
		return self:GetState(player)
	end
end

function TycoonService:Start()
	-- build queues: spread big towers over several frames
	RunService.Heartbeat:Connect(function()
		for _, plot in plots do
			if #plot.Queue > 0 then
				local n = 0
				while #plot.Queue > 0 and n < TC.MaxBuildPerTick do
					local job = table.remove(plot.Queue, 1)
					if job.Generation == plot.Generation and plot.Owner then
						local ok, err = pcall(self._buildItem, self, plot, job.Item, false)
						if not ok then
							warn("[Tycoon] Failed to build " .. job.Item.Id .. ": " .. tostring(err))
						end
					end
					n += 1
				end
				if #plot.Queue == 0 then
					self:_afterBulkBuild(plot)
				end
			end
		end
	end)

	-- income tick + repairs (each tower protected on its own: one bug must
	-- never stop everybody's income)
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for _, plot in plots do
				Util.Try("Tycoon income", self._tick, self, plot, now)
			end
		end
	end)
end

function TycoonService:_tick(plot, now: number)
	local owner = plot.Owner
	if not owner or not S.DataService:IsLoaded(owner) then
		return
	end
	-- repair wrecked items whose timer ran out
	local due = {}
	for id, untilTime in plot.Disabled do
		if now >= untilTime then
			table.insert(due, id)
		end
	end
	for _, id in due do
		self:_repair(plot, id)
	end
	if #due > 0 then
		self:_recompute(plot)
	end
	-- Auto Builder pass: buys the cheapest affordable upgrade every few seconds
	local data = S.DataService:Get(owner)
	if data and data.Settings.AutoBuild ~= false and S.DataService:TeamHasPass(owner, "AutoBuild") then
		plot.AutoBuildTimer = (plot.AutoBuildTimer or 0) + 1
		if plot.AutoBuildTimer >= Config.AutoBuild.Interval and #plot.Queue == 0 then
			plot.AutoBuildTimer = 0
			local bought = self:_buyCheapest(owner, plot, data, Config.AutoBuild.PerTick)
			if #bought > 0 then
				self:_refreshButtons(plot)
				self:_recompute(plot)
				local last = TycoonItems.ById[bought[#bought]]
				Remotes.VFX:FireAllClients("BuildIn", { Model = plot.Built[last.Id], Position = plot.ItemPos[last.Id], Color = last.Theme and last.Theme.Accent or plot.Color })
			end
		end
	end

	local mult = S.DataService:GetMultiplier(owner)
	local amount = plot.Income * mult
	if amount > 0 then
		if S.DataService:TeamHasPass(owner, "AutoCollect") then
			S.DataService:AddCash(owner, amount)
		else
			S.DataService:AddVault(owner, amount)
		end
	end
	for _, member in members(plot) do
		member:SetAttribute("Income", amount)
		if amount > 0 then
			quest(member, "Earn", amount)
		end
	end
end

---------------------------------------------------------------------------
-- Queries
---------------------------------------------------------------------------
function TycoonService:GetPlot(player: Player)
	return playerPlot[player]
end

function TycoonService:GetPlots()
	return plots
end

function TycoonService:IsMember(player: Player, plot): boolean
	return isMember(player, plot)
end

-- current income per second (with all multipliers) of the player's tower
function TycoonService:GetIncome(player: Player): number
	local plot = playerPlot[player]
	if not plot or not plot.Owner then
		return 0
	end
	return plot.Income * S.DataService:GetMultiplier(plot.Owner)
end

-- income per second used for offline earnings: the player's full tower
-- (wrecked items repair while they're away) with permanent multipliers only
function TycoonService:GetOfflineIncome(player: Player): number
	local data = S.DataService:Get(player)
	if not data then
		return 0
	end
	local fast = S.MonetizationService ~= nil and S.MonetizationService:HasPass(player, "FastDroppers")
	local income = TycoonItems.ComputeIncome(data.Purchased, nil, data.Secrets, fast)
	return income * S.DataService:GetMultiplier(player, true)
end

function TycoonService:IsFloorUnlocked(plot, floor: number): boolean
	if not plot.Owner then
		return false
	end
	local data = S.DataService:Get(plot.Owner)
	if not data then
		return false
	end
	if floor == FLOORS + 1 then
		return data.Purchased["Roof_1"] == true
	end
	return data.Purchased[TycoonItems.FloorUnlockId(floor)] == true
end

function TycoonService:GetState(player: Player)
	local plot = playerPlot[player]
	if not plot or not plot.Owner then
		return { Plot = nil }
	end
	local data = S.DataService:Get(plot.Owner)
	if not data then
		return { Plot = nil }
	end
	local purchased = {}
	for id in data.Purchased do
		purchased[id] = true
	end
	local disabled = {}
	for id, untilTime in plot.Disabled do
		disabled[id] = math.max(0, untilTime - os.time())
	end
	local secrets = {}
	for id in data.Secrets do
		secrets[id] = true
	end
	return {
		Plot = plot.Index,
		IsOwner = plot.Owner == player,
		OwnerName = plot.Owner.DisplayName,
		Purchased = purchased,
		Disabled = disabled,
		Secrets = secrets,
		Shielded = plot.Shielded == true,
	}
end

---------------------------------------------------------------------------
-- Assignment
---------------------------------------------------------------------------
function TycoonService:_updateSign(plot)
	local text = "EMPTY PLOT"
	if plot.Owner then
		text = string.upper(plot.Owner.DisplayName) .. "'S TOWER"
		if plot.Partner then
			text = string.upper(plot.Owner.DisplayName) .. " & " .. string.upper(plot.Partner.DisplayName)
		end
	end
	for _, label in plot.SignLabels do
		label.Text = text
	end
end

function TycoonService:_assign(player: Player, data)
	if playerPlot[player] or player:GetAttribute("DuoHost") then
		return
	end
	local plot
	for _, p in plots do
		if not p.Owner then
			plot = p
			break
		end
	end
	if not plot then
		Remotes.Notify:FireClient(player, { Text = "All plots are taken! Ask someone to DUO with you, or play minigames and the obby.", Type = "error", Duration = 8 })
		return
	end
	plot.Owner = player
	plot.Partner = nil
	playerPlot[player] = plot
	player:SetAttribute("Plot", plot.Index)
	player:SetAttribute("PlotCenter", plot.TowerCF.Position)
	self:_updateSign(plot)

	table.insert(plot.Connections, player:GetAttributeChangedSignal("Cash"):Connect(function()
		self:_updateButtonColors(plot)
	end))
	table.insert(plot.Connections, player:GetAttributeChangedSignal("Vault"):Connect(function()
		self:_updateVaultLabels(plot)
	end))
	table.insert(plot.Connections, player:GetAttributeChangedSignal("Multiplier"):Connect(function()
		self:_refreshWorth(plot)
	end))

	self:_queueFullBuild(plot)
	if player.Character then
		self:TeleportHome(player)
	end
	Remotes.Notify:FireClient(player, { Text = "Welcome! Tower #" .. plot.Index .. " is yours. Step on the buttons (or open BUILD) to grow it!", Type = "success", Duration = 6 })
	sendUpdate(plot, { Type = "Reset" })
end

function TycoonService:_queueFullBuild(plot)
	local data = S.DataService:Get(plot.Owner)
	if not data then
		return
	end
	plot.Generation += 1
	plot.Queue = {}
	for _, item in TycoonItems.List do
		local owned = data.Purchased[item.Id] or (item.Kind == "Secret" and data.Secrets[item.SecretId])
		if owned and not plot.Built[item.Id] and not plot.Disabled[item.Id] then
			table.insert(plot.Queue, { Item = item, Generation = plot.Generation })
		end
	end
	if #plot.Queue == 0 then
		self:_afterBulkBuild(plot)
	end
	plot.PendingOffline = true
end

function TycoonService:_afterBulkBuild(plot)
	self:_recompute(plot)
	self:_refreshButtons(plot)
	self:_updateVaultLabels(plot)
	-- offline earnings (once, after the first full build)
	if plot.PendingOffline and plot.Owner then
		plot.PendingOffline = false
		local owner = plot.Owner
		local data = S.DataService:Get(owner)
		local oe = Config.OfflineEarnings
		if data and oe.Enabled and data.LastOnline > 0 and data.LastIncome > 0 and not plot.OfflinePaid then
			plot.OfflinePaid = true
			local away = math.min(os.time() - data.LastOnline, oe.MaxHours * 3600)
			if away > 60 then
				local amount = data.LastIncome * away * (oe.Percent + Config.RebirthPerk(data.Rebirths, "Offline"))
				S.DataService:AddVault(owner, amount)
				Remotes.Notify:FireClient(owner, { Text = "💤 While you were away (" .. Util.FormatTime(away) .. ") your tower made " .. Util.Money(amount) .. "! Collect it at the vault.", Type = "success", Duration = 10 })
			end
		end
	end
end

function TycoonService:_clearPlot(plot)
	plot.Generation += 1
	plot.Queue = {}
	plot.Items:ClearAllChildren()
	plot.Buttons:ClearAllChildren()
	plot.Rubble:ClearAllChildren()
	plot.Built = {}
	plot.Extra = {}
	plot.ButtonObjs = {}
	plot.SlotUsed = {}
	plot.Disabled = {}
	plot.RubbleModels = {}
	plot.ItemPos = {}
	plot.Worth = {}
	plot.Income = 0
	plot.VaultLabels = {}
	plot.Shielded = false
	plot.Shelter = nil
end

function TycoonService:_releaseOwner(player: Player)
	local plot = playerPlot[player]
	if not plot or plot.Owner ~= player then
		return
	end
	self:_clearPlot(plot)
	for _, conn in plot.Connections do
		conn:Disconnect()
	end
	plot.Connections = {}
	plot.Owner = nil
	plot.OfflinePaid = false
	playerPlot[player] = nil
	player:SetAttribute("Plot", nil)
	player:SetAttribute("PlotCenter", nil)
	self:_updateSign(plot)
end

function TycoonService:_onLeave(player: Player)
	local plot = playerPlot[player]
	if not plot then
		return
	end
	if plot.Owner == player then
		local partner = plot.Partner
		if partner then
			self:RemovePartner(plot, false)
		end
		self:_releaseOwner(player)
		-- give the partner their own tower back
		if partner and partner.Parent then
			Remotes.Notify:FireClient(partner, { Text = player.DisplayName .. " left, so your duo ended. Building your own tower...", Type = "info", Duration = 6 })
			task.defer(function()
				local data = S.DataService:Get(partner)
				if data then
					self:_assign(partner, data)
				end
			end)
		end
	elseif plot.Partner == player then
		self:RemovePartner(plot, false)
	end
end

---------------------------------------------------------------------------
-- Duo membership (called by DuoService)
---------------------------------------------------------------------------
function TycoonService:AddPartner(host: Player, partner: Player): boolean
	local plot = playerPlot[host]
	if not plot or plot.Owner ~= host or plot.Partner then
		return false
	end
	if playerPlot[partner] then
		if playerPlot[partner].Owner == partner then
			if playerPlot[partner].Partner then
				return false
			end
			self:_releaseOwner(partner)
		else
			return false
		end
	end
	plot.Partner = partner
	playerPlot[partner] = plot
	partner:SetAttribute("DuoHost", host.UserId)
	host:SetAttribute("DuoPartner", partner.UserId)
	partner:SetAttribute("Plot", plot.Index)
	partner:SetAttribute("PlotCenter", plot.TowerCF.Position)
	self:_updateSign(plot)
	S.DataService:Sync(host)
	self:_recompute(plot)
	sendUpdate(plot, { Type = "Reset" })
	if S.QuestService then
		S.QuestService:Refresh(partner) -- tower quests now follow the host's tower
	end
	if partner.Character then
		partner.Character:PivotTo(plot.SpawnCFrame * CFrame.new(4, 0, 0))
	end
	return true
end

-- removes the partner; reassign = give them their own tower again
function TycoonService:RemovePartner(plot, reassign: boolean)
	local partner = plot.Partner
	if not partner then
		return
	end
	plot.Partner = nil
	playerPlot[partner] = nil
	partner:SetAttribute("DuoHost", nil)
	partner:SetAttribute("Plot", nil)
	partner:SetAttribute("PlotCenter", nil)
	partner:SetAttribute("Income", 0)
	if plot.Owner then
		plot.Owner:SetAttribute("DuoPartner", nil)
		S.DataService:Sync(plot.Owner)
	end
	self:_updateSign(plot)
	if partner.Parent then
		S.DataService:Sync(partner)
		Remotes.TycoonUpdate:FireClient(partner, { Type = "Reset" })
		if reassign then
			local data = S.DataService:Get(partner)
			if data then
				self:_assign(partner, data)
			end
		end
		if S.QuestService then
			S.QuestService:Refresh(partner)
		end
	end
end

---------------------------------------------------------------------------
-- Items
---------------------------------------------------------------------------
function TycoonService:_ownerName(plot): string?
	return plot.Owner and plot.Owner.DisplayName
end

function TycoonService:_buildItem(plot, item, withEffects: boolean)
	if plot.Built[item.Id] or plot.Disabled[item.Id] then
		return
	end
	local model, extra = TycoonBuilder.BuildItem(plot, item, self:_ownerName(plot))
	plot.Built[item.Id] = model
	plot.Extra[item.Id] = extra
	plot.ItemPos[item.Id] = TycoonBuilder.ItemWorldPos(plot, item)
	model:SetAttribute("Plot", plot.Index)
	model:SetAttribute("Floor", item.Floor)
	model:SetAttribute("ItemId", item.Id)

	local kind = item.Kind
	if kind == "Unlock" then
		if extra.VaultPad then
			table.insert(plot.VaultLabels, extra.VaultLabel)
			extra.VaultPad.Touched:Connect(function(hit)
				local player = BuildKit.PlayerFromHit(hit)
				if player and isMember(player, plot) and os.clock() - plot.LastPad > 1 and BuildKit.IsNear(player, extra.VaultPad) then
					plot.LastPad = os.clock()
					self:CollectVault(player)
				end
			end)
		end
		if extra.ElevatorPrompt then
			extra.ElevatorPrompt.Triggered:Connect(function(player)
				Remotes.ClientCommand:FireClient(player, "openfloors", plot.Index)
			end)
		end
	elseif kind == "Dropper" then
		model:SetAttribute("Interval", item.Interval)
		model:SetAttribute("Spout", extra.Spout)
		model:SetAttribute("BeltEnd", extra.BeltEnd)
		model:SetAttribute("BeltSpeed", TC.ConveyorSpeed)
		model:SetAttribute("Tier", item.Slot)
		model:SetAttribute("DropColor", (item.Theme.Primary :: Color3):Lerp(item.Theme.Accent, (item.Slot - 1) / 9))
		model:SetAttribute("DropMaterial", (item.Slot >= 6 and item.Theme.Drop or Enum.Material.SmoothPlastic).Name)
		CollectionService:AddTag(model, "Dropper")
	elseif kind == "Upgrader" then
		model:SetAttribute("BeltPos", extra.BeltPos)
		model:SetAttribute("Color", extra.Color)
		CollectionService:AddTag(model, "Upgrader")
	elseif kind == "Generator" then
		model:SetAttribute("PopPos", extra.PopPos)
		model:SetAttribute("Cycle", item.Cycle)
		CollectionService:AddTag(model, "Generator")
	elseif kind == "Special" then
		if item.Effect == "Shield" then
			plot.Shielded = true
		elseif item.Effect == "Bunker" then
			plot.Shelter = { CFrame = extra.ShelterCF, Size = extra.ShelterSize, Door = extra.Door }
		end
	end

	if withEffects then
		Remotes.VFX:FireAllClients("BuildIn", { Model = model, Position = plot.ItemPos[item.Id], Color = item.Theme and item.Theme.Accent or plot.Color })
	end
end

-- recompute income + per-model worth attributes
function TycoonService:_recompute(plot)
	if not plot.Owner then
		return
	end
	local data = S.DataService:Get(plot.Owner)
	if not data then
		return
	end
	local disabled = {}
	for id in plot.Disabled do
		disabled[id] = true
	end
	local fast = S.DataService:TeamHasPass(plot.Owner, "FastDroppers")
	local income, worth = TycoonItems.ComputeIncome(data.Purchased, disabled, data.Secrets, fast)
	plot.Income = income
	plot.Worth = worth
	self:_refreshWorth(plot)
end

function TycoonService:_refreshWorth(plot)
	if not plot.Owner then
		return
	end
	local mult = S.DataService:GetMultiplier(plot.Owner)
	local fast = S.DataService:TeamHasPass(plot.Owner, "FastDroppers")
	for id, model in plot.Built do
		local worth = plot.Worth[id]
		if worth then
			model:SetAttribute("Worth", worth * mult)
			if model:GetAttribute("Interval") then
				model:SetAttribute("Interval", TC.DropInterval / (fast and 2 or 1))
			end
		end
	end
end

-- called when passes change (Fast Droppers etc.)
function TycoonService:RefreshPlayer(player: Player)
	local plot = playerPlot[player]
	if plot then
		self:_recompute(plot)
		self:_updateVaultLabels(plot)
	end
end

function TycoonService:_freeSlot(plot, floor: number): number?
	plot.SlotUsed[floor] = plot.SlotUsed[floor] or {}
	for slot = 1, TC.ButtonSlotsPerFloor do
		if not plot.SlotUsed[floor][slot] then
			return slot
		end
	end
	return nil
end

function TycoonService:_removeButton(plot, id: string)
	local button = plot.ButtonObjs[id]
	if button then
		plot.ButtonObjs[id] = nil
		if plot.SlotUsed[button.Floor] then
			plot.SlotUsed[button.Floor][button.Slot] = nil
		end
		button.Model:Destroy()
	end
end

function TycoonService:_refreshButtons(plot)
	local owner = plot.Owner
	if not owner then
		return
	end
	local data = S.DataService:Get(owner)
	if not data then
		return
	end
	for id in plot.ButtonObjs do
		if data.Purchased[id] then
			self:_removeButton(plot, id)
		end
	end
	for _, item in TycoonItems.List do
		if item.ButtonFloor and not plot.ButtonObjs[item.Id] and TycoonItems.IsAvailable(item, data.Purchased) then
			local floor = item.ButtonFloor
			local slot = self:_freeSlot(plot, floor)
			if slot then
				local button = TycoonBuilder.BuildButton(plot, item, slot)
				plot.SlotUsed[floor][slot] = item.Id
				plot.ButtonObjs[item.Id] = button
				local lastFail = 0
				local busy = false
				button.Pad.Touched:Connect(function(hit)
					if busy then
						return
					end
					local player = BuildKit.PlayerFromHit(hit)
					if not player or not isMember(player, plot) or not BuildKit.IsNear(player, button.Pad) then
						return
					end
					busy = true
					local ok, reason = self:TryPurchase(player, item.Id)
					if not ok and os.clock() - lastFail > 2 then
						lastFail = os.clock()
						Remotes.Notify:FireClient(player, { Text = reason, Type = "error" })
						Remotes.VFX:FireClient(player, "Error", {})
					end
					task.wait(0.4)
					busy = false
				end)
			end
		end
	end
	self:_updateButtonColors(plot)
end

function TycoonService:_updateButtonColors(plot)
	local owner = plot.Owner
	if not owner then
		return
	end
	local cash = owner:GetAttribute("Cash") or 0
	for id, button in plot.ButtonObjs do
		local item = TycoonItems.ById[id]
		if item and button.Pad.Parent then
			local affordable = cash >= item.Cost
			button.Pad.Color = affordable and GREEN or RED
			button.Label.TextColor3 = affordable and Color3.fromRGB(180, 255, 190) or Color3.fromRGB(255, 190, 190)
		end
	end
end

function TycoonService:_updateVaultLabels(plot)
	local owner = plot.Owner
	if not owner then
		return
	end
	local text
	if S.DataService:TeamHasPass(owner, "AutoCollect") then
		text = "🧲 AUTO COLLECT ON"
	else
		text = "🏦 VAULT: " .. Util.Money(owner:GetAttribute("Vault") or 0) .. "\nStep here to collect"
	end
	for _, label in plot.VaultLabels do
		label.Text = text
	end
end

function TycoonService:CollectVault(player: Player)
	local amount = S.DataService:CollectVault(player)
	if amount > 0 then
		quest(player, "Collect", 1)
		Remotes.VFX:FireClient(player, "CashBurst", { Amount = amount })
		Remotes.Notify:FireClient(player, { Text = "Collected " .. Util.Money(amount) .. "!", Type = "success" })
	end
end

function TycoonService:TryPurchase(player: Player, itemId: string, silent: boolean?): (boolean, string)
	local plot = playerPlot[player]
	local item = TycoonItems.ById[itemId]
	if not plot or not plot.Owner or not item or item.Kind == "Secret" then
		return false, "Can't buy that right now."
	end
	if #plot.Queue > 0 then
		return false, "Your tower is still loading..."
	end
	local data = S.DataService:Get(plot.Owner)
	if not data then
		return false, "Data still loading..."
	end
	if data.Purchased[itemId] then
		return false, "You already own this!"
	end
	if not TycoonItems.IsAvailable(item, data.Purchased) then
		return false, "Buy the previous upgrades first!"
	end
	if data.Cash < item.Cost then
		return false, "You need " .. Util.Money(item.Cost - data.Cash) .. " more!"
	end
	S.DataService:SpendCash(plot.Owner, item.Cost)
	data.Purchased[itemId] = true

	local button = plot.ButtonObjs[itemId]
	if button and not silent then
		Remotes.VFX:FireAllClients("ButtonPop", { Position = button.Pad.Position, Color = GREEN })
	end
	self:_removeButton(plot, itemId)
	self:_buildItem(plot, item, not silent)
	if not silent then
		self:_refreshButtons(plot)
		self:_recompute(plot)
		Remotes.VFX:FireClient(player, "PurchaseSound", {})
		if item.Kind == "Unlock" then
			Remotes.Announce:FireAllClients({ Title = "🏢 " .. player.DisplayName .. " unlocked " .. item.Name .. "!", Text = "", Color = item.Theme.Accent })
		elseif item.Kind == "Trophy" then
			Remotes.VFX:FireClient(player, "Confetti", {})
		end
	end
	sendUpdate(plot, { Type = "Bought", Id = itemId })
	quest(player, "Buy", 1)
	if (item.Kind == "Unlock" or itemId == "Roof_1") and S.QuestService then
		S.QuestService:FloorUnlocked(plot)
	end
	return true, "Purchased " .. item.Name .. "!"
end

-- buys up to `max` of the cheapest affordable upgrades (quietly); returns their ids
function TycoonService:_buyCheapest(player: Player, plot, data, max: number, floor: number?): { string }
	local bought = {}
	for _ = 1, max do
		local best
		for _, item in TycoonItems.List do
			if item.Kind ~= "Secret" and (floor == nil or item.Floor == floor) and item.Cost <= data.Cash and TycoonItems.IsAvailable(item, data.Purchased) then
				if not best or item.Cost < best.Cost then
					best = item
				end
			end
		end
		if not best or not self:TryPurchase(player, best.Id, true) then
			break
		end
		table.insert(bought, best.Id)
	end
	return bought
end

-- Buy every affordable upgrade (cheapest first). floor = only that floor
function TycoonService:BuyAll(player: Player, floor: number?)
	local plot = playerPlot[player]
	if not plot or not plot.Owner then
		return
	end
	local data = S.DataService:Get(plot.Owner)
	if not data then
		return
	end
	local spent = data.Cash
	local count = #self:_buyCheapest(player, plot, data, 80, floor)
	spent -= data.Cash
	if count > 0 then
		self:_refreshButtons(plot)
		self:_recompute(plot)
		Remotes.VFX:FireAllClients("Purchase", { Position = plot.TowerCF.Position + Vector3.new(0, 10, 0), Color = plot.Color, Big = true })
		Remotes.Notify:FireClient(player, { Text = "Bought " .. count .. " upgrades for " .. Util.Money(spent) .. "!", Type = "success" })
	else
		Remotes.Notify:FireClient(player, { Text = "Nothing affordable right now.", Type = "info" })
	end
end

-- Admin helper: give every item
function TycoonService:UnlockAll(player: Player, upToFloor: number?)
	local plot = playerPlot[player]
	if not plot or not plot.Owner then
		return
	end
	local data = S.DataService:Get(plot.Owner)
	if not data then
		return
	end
	for _, item in TycoonItems.List do
		if item.Kind ~= "Secret" and (not upToFloor or item.Floor <= upToFloor) then
			data.Purchased[item.Id] = true
		end
	end
	self:Rebuild(plot.Owner)
	if S.QuestService then
		S.QuestService:FloorUnlocked(plot)
	end
end

-- Rebuild the whole tower from data (after reset / rebirth)
function TycoonService:Rebuild(player: Player)
	local plot = playerPlot[player]
	if not plot or not plot.Owner then
		return
	end
	self:_clearPlot(plot)
	self:_queueFullBuild(plot)
	plot.PendingOffline = false
	sendUpdate(plot, { Type = "Reset" })
end

function TycoonService:Rebirth(player: Player, free: boolean?)
	local plot = playerPlot[player]
	if plot and plot.Owner ~= player then
		Remotes.Notify:FireClient(player, { Text = "Only the tower owner can rebirth!", Type = "error" })
		return
	end
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local cost = TycoonItems.GetRebirthCost(data.Rebirths)
	if not free and data.Cash < cost then
		Remotes.Notify:FireClient(player, { Text = "You need " .. Util.Money(cost) .. " to rebirth!", Type = "error" })
		return
	end
	local rankBefore = Config.RebirthRank(data.Rebirths)
	data.Rebirths += 1
	data.Cash = Config.StartingCash + Config.RebirthPerk(data.Rebirths, "Start")
	data.Vault = 0
	data.Purchased = { F1_1 = true }
	S.DataService:Sync(player)
	self:Rebuild(player)
	if S.QuestService then
		S.QuestService:Refresh(player)
		if plot and plot.Partner then
			S.QuestService:Refresh(plot.Partner) -- the tower they build was reset too
		end
	end

	if S.MonetizationService then
		S.MonetizationService:RefreshCharacter(player) -- new rank tag and speed
	end
	local rankIndex, rank = Config.RebirthRank(data.Rebirths)
	if rank and rankIndex ~= rankBefore then
		Remotes.Notify:FireClient(player, { Text = rank.Icon .. " New rank: " .. rank.Name .. "! " .. rank.Text, Type = "success", Duration = 8 })
	end
	Remotes.VFX:FireClient(player, "Rebirth", { Rebirths = data.Rebirths })
	if plot then
		Remotes.VFX:FireAllClients("Shockwave", { Position = plot.TowerCF.Position + Vector3.new(0, 2, 0), Color = Color3.fromRGB(255, 200, 40), Size = 160 })
	end
	Remotes.Announce:FireAllClients({
		Title = "🔄 " .. player.DisplayName .. " REBIRTHED!",
		Text = "Now at Rebirth " .. data.Rebirths .. " (" .. (1 + data.Rebirths * Config.Rebirth.MultiplierPerRebirth) .. "x cash)",
		Color = Color3.fromRGB(255, 200, 40),
	})
	task.spawn(S.DataService.Save, S.DataService, player)
end

-- a secret was found: build its relic in the finder's tower
function TycoonService:OnSecretFound(player: Player, secretId: string)
	local plot = playerPlot[player]
	local item = TycoonItems.ById["Secret_" .. secretId]
	if plot and plot.Owner == player and item then
		self:_buildItem(plot, item, true)
		self:_recompute(plot)
	end
	if plot then
		sendUpdate(plot, { Type = "Secret", Id = secretId })
	end
end

---------------------------------------------------------------------------
-- Disasters: knockouts / repairs / shelters
---------------------------------------------------------------------------
function TycoonService:IsShielded(plot): boolean
	return plot.Owner ~= nil and plot.Shielded == true
end

function TycoonService:KnockOut(plot, id: string, seconds: number): boolean
	local item = TycoonItems.ById[id]
	local model = plot.Built[id]
	if not item or not model or plot.Disabled[id] or not canKnockOut(item) then
		return false
	end
	local pos = plot.ItemPos[id] or model:GetPivot().Position
	model:Destroy()
	plot.Built[id] = nil
	plot.Extra[id] = nil
	plot.Disabled[id] = os.time() + seconds
	plot.RubbleModels[id] = TycoonBuilder.BuildRubble(plot, pos - Vector3.new(0, 2.5, 0), id)
	-- a wrecked dropper takes its Mk II ring with it
	if item.Kind == "Dropper" then
		for _, other in TycoonItems.ByFloor[item.Floor] do
			if other.Kind == "Mk2" and other.Slot == item.Slot and plot.Built[other.Id] then
				plot.Built[other.Id]:Destroy()
				plot.Built[other.Id] = nil
				plot.Disabled[other.Id] = os.time() + seconds
			end
		end
	end
	sendUpdate(plot, { Type = "Disabled", Id = id, Seconds = seconds })
	return true
end

function TycoonService:_repair(plot, id: string)
	plot.Disabled[id] = nil
	local rubble = plot.RubbleModels[id]
	if rubble then
		rubble:Destroy()
		plot.RubbleModels[id] = nil
	end
	local item = TycoonItems.ById[id]
	local data = plot.Owner and S.DataService:Get(plot.Owner)
	if item and data and data.Purchased[id] then
		self:_buildItem(plot, item, true)
	end
	sendUpdate(plot, { Type = "Repaired", Id = id })
end

function TycoonService:RepairAll(player: Player): number
	local plot = playerPlot[player]
	if not plot then
		return 0
	end
	local count = 0
	for id in plot.Disabled do
		self:_repair(plot, id)
		count += 1
	end
	if count > 0 then
		self:_recompute(plot)
	end
	return count
end

function TycoonService:WreckedCount(plot): number
	local n = 0
	for _ in plot.Disabled do
		n += 1
	end
	return n
end

-- wreck a share of the tower (nukes)
function TycoonService:KnockOutFraction(plot, fraction: number, seconds: number): number
	local candidates = {}
	for id in plot.Built do
		local item = TycoonItems.ById[id]
		if item and canKnockOut(item) and not plot.Disabled[id] then
			table.insert(candidates, id)
		end
	end
	local count = math.floor(#candidates * fraction)
	local wrecked = 0
	for _ = 1, count do
		if #candidates == 0 then
			break
		end
		local id = table.remove(candidates, math.random(1, #candidates))
		if self:KnockOut(plot, id, seconds) then
			wrecked += 1
		end
	end
	if wrecked > 0 then
		self:_recompute(plot)
	end
	return wrecked
end

-- wreck items near a world position (meteors, tornadoes). horizontal = ignore height
function TycoonService:KnockOutNear(plot, position: Vector3, radius: number, maxCount: number, seconds: number, horizontal: boolean?): number
	local hits = {}
	for id, pos in plot.ItemPos do
		if plot.Built[id] and not plot.Disabled[id] then
			local item = TycoonItems.ById[id]
			if item and canKnockOut(item) then
				local delta = pos - position
				if horizontal then
					delta = Vector3.new(delta.X, 0, delta.Z)
				end
				local d = delta.Magnitude
				if d <= radius then
					table.insert(hits, { Id = id, D = d })
				end
			end
		end
	end
	table.sort(hits, function(a, b)
		return a.D < b.D
	end)
	local wrecked = 0
	for i = 1, math.min(maxCount, #hits) do
		if self:KnockOut(plot, hits[i].Id, seconds) then
			wrecked += 1
		end
	end
	if wrecked > 0 then
		self:_recompute(plot)
	end
	return wrecked
end

-- which plot (if any) contains this world position (x/z)
function TycoonService:PlotAt(position: Vector3)
	for _, plot in plots do
		local localPos = plot.CFrame:PointToObjectSpace(position)
		if math.abs(localPos.X) <= 60 and math.abs(localPos.Z) <= 60 then
			return plot
		end
	end
	return nil
end

-- shelter info for disasters: bunkers + shield domes
function TycoonService:GetShelters()
	local boxes, spheres, doors = {}, {}, {}
	for _, plot in plots do
		if plot.Owner then
			if plot.Shelter then
				table.insert(boxes, { CFrame = plot.Shelter.CFrame, Size = plot.Shelter.Size })
				table.insert(doors, plot.Shelter.Door)
			end
			if plot.Shielded then
				table.insert(spheres, { Center = plot.ShieldCenter, Radius = plot.ShieldRadius })
				table.insert(doors, (plot.SpawnCFrame).Position)
			end
		end
	end
	return boxes, spheres, doors
end

function TycoonService:IsInsideShield(position: Vector3)
	for _, plot in plots do
		if plot.Owner and plot.Shielded and (position - plot.ShieldCenter).Magnitude <= plot.ShieldRadius then
			return plot
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Spawning / teleporting
---------------------------------------------------------------------------
local function streamAround(player: Player, position: Vector3)
	pcall(function()
		player:RequestStreamAroundAsync(position, 3)
	end)
end

function TycoonService:GetSpawnCFrame(player: Player): CFrame
	local stage = player:GetAttribute("ObbyStage") or 0
	if stage > 0 and S.ObbyService then
		local cf = S.ObbyService:GetCheckpointCFrame(stage)
		if cf then
			return cf
		end
	end
	local plot = playerPlot[player]
	if plot then
		return plot.SpawnCFrame
	end
	return CFrame.new(0, 5, 0)
end

-- streams the destination in first (non-blocking for the caller)
function TycoonService:TeleportHome(player: Player)
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local cf = self:GetSpawnCFrame(player)
		task.spawn(function()
			streamAround(player, cf.Position)
			if player.Character == character then
				character:PivotTo(cf)
			end
		end)
	end
end

function TycoonService:TeleportToFloor(player: Player, plotIndex: any, floor: any)
	if player:GetAttribute("InMinigame") then
		return
	end
	local plot = plots[tonumber(plotIndex) or -1]
	floor = tonumber(floor)
	if not plot or not floor or floor < 1 or floor > FLOORS + 1 then
		return
	end
	if not self:IsFloorUnlocked(plot, floor) then
		Remotes.Notify:FireClient(player, { Text = "That floor isn't built yet!", Type = "error" })
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local cf = TycoonBuilder.FloorCF(plot, floor) * CFrame.new(-28, 4, -28) * CFrame.Angles(0, math.pi, 0)
	if floor == FLOORS + 1 then
		cf = TycoonBuilder.FloorCF(plot, floor) * CFrame.new(0, 4, -20) * CFrame.Angles(0, math.pi, 0)
	end
	player:SetAttribute("ObbyStage", 0)
	Remotes.VFX:FireClient(player, "Flash", {})
	task.spawn(function()
		streamAround(player, cf.Position)
		if player.Character == character then
			character:PivotTo(cf)
		end
	end)
end

function TycoonService:_hookCharacter(player: Player)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait()
		if player:GetAttribute("InMinigame") then
			return
		end
		local cf = self:GetSpawnCFrame(player)
		streamAround(player, cf.Position)
		character:PivotTo(cf)
	end)
end

return TycoonService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">WeeklyService</string>
          <string name="Source"><![CDATA[--[[
	WeeklyService - weekly rewards (see Config.Weekly). Every day you join
	counts toward the week (Monday to Sunday, UTC); at 3, 5 and 7 days you can
	claim a bigger reward, once per week. Everything is saved with the player.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local WC = Config.Weekly

local WeeklyService = {}
local S

local function today(): number
	return os.time() // 86400
end

-- weeks run Monday to Sunday (day 0 of the epoch was a Thursday)
local function weekOf(day: number): number
	return (day + 3) // 7
end

local function weekStart(week: number): number
	return week * 7 - 3
end

local function count(map): number
	local n = 0
	for _ in map do
		n += 1
	end
	return n
end

-- the saved week: starts over in a new week, and today counts as a day joined
function WeeklyService:Refresh(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local weekly = data.Weekly
	local day = today()
	if weekly.Week ~= weekOf(day) then
		weekly.Week, weekly.Days, weekly.Claimed = weekOf(day), {}, {}
	end
	weekly.Days[tostring(day)] = true
	self:_send(player)
end

function WeeklyService:GetState(player: Player)
	local data = S.DataService:Get(player)
	if not data then
		return nil
	end
	local weekly = data.Weekly
	local flags, claimed = {}, {}
	for i = 0, 6 do
		table.insert(flags, weekly.Days[tostring(weekStart(weekly.Week) + i)] == true)
	end
	local days = count(weekly.Days)
	local ready = 0
	for index, milestone in WC.Milestones do
		claimed[index] = weekly.Claimed[tostring(index)] == true
		if not claimed[index] and days >= milestone.Days then
			ready += 1
		end
	end
	return { Days = days, DayFlags = flags, Claimed = claimed, Ready = ready, ResetsIn = math.max(0, weekStart(weekly.Week + 1) * 86400 - os.time()) }
end

function WeeklyService:_send(player: Player)
	local state = self:GetState(player)
	if state and player.Parent then
		player:SetAttribute("WeeklyReady", state.Ready)
		Remotes.WeeklyUpdate:FireClient(player, state)
	end
end

function WeeklyService:Claim(player: Player, index: any): (boolean, string)
	local data = S.DataService:Get(player)
	local milestone = type(index) == "number" and WC.Milestones[index]
	if not data or not milestone then
		return false, "That reward doesn't exist."
	end
	self:Refresh(player)
	local state = self:GetState(player)
	if state.Claimed[index] then
		return false, "You already claimed that this week."
	end
	if state.Days < milestone.Days then
		return false, "Join on " .. (milestone.Days - state.Days) .. " more day(s) this week to unlock it."
	end
	data.Weekly.Claimed[tostring(index)] = true
	local wallet = S.DataService:GetWallet(player)
	local rebirths = wallet and wallet.Rebirths or 0
	local cash = math.floor(math.max(milestone.MinCash * (1 + rebirths), S.TycoonService:GetIncome(player) * milestone.IncomeMinutes * 60))
	S.DataService:AddCash(player, cash, false)
	local text = "📅 Weekly reward: +" .. Util.Money(cash)
	if milestone.BoostSeconds then
		S.DataService:AddBoost(player, milestone.BoostSeconds)
		text ..= " & 2x Boost for " .. Util.FormatTime(milestone.BoostSeconds)
	end
	if milestone.Egg and S.PetService then
		for _, egg in Config.Pets.Eggs do
			if egg.Id == milestone.Egg then
				local pet = S.PetService:_roll(egg)
				S.PetService:Give(player, pet.Id, 1)
				text ..= " & a " .. pet.Rarity .. " " .. pet.Name .. " " .. pet.Icon
			end
		end
	end
	Remotes.VFX:FireClient(player, "CashBurst", { Amount = cash })
	Remotes.VFX:FireClient(player, "Confetti", {})
	self:_send(player)
	return true, text .. "!"
end

function WeeklyService:Init(services)
	S = services
	Remotes.ClaimWeekly.OnServerInvoke = function(player, index)
		if not WC.Enabled then
			return false, "Weekly rewards are turned off."
		end
		return self:Claim(player, index)
	end
	S.DataService.PlayerLoaded:Connect(function(player)
		if WC.Enabled then
			self:Refresh(player)
		end
	end)
end

-- a new day or week while you're playing
function WeeklyService:Start()
	if not WC.Enabled then
		return
	end
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			Util.Try("Weekly", self.Refresh, self, player)
		end
	end
end

return WeeklyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">WheelService</string>
          <string name="Source"><![CDATA[--[[
	WheelService - the Lucky Wheel (see Config.Wheel): a free spin every
	CooldownMinutes. The server picks the prize; the client only animates it.
	The time of the last spin is saved, so the wait also counts while offline.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local WC = Config.Wheel

local WheelService = {}
local S

-- picks a segment index by weight
function WheelService:_pick(): number
	local total = 0
	for _, segment in WC.Segments do
		total += segment.Weight
	end
	local roll = math.random() * total
	for i, segment in WC.Segments do
		roll -= segment.Weight
		if roll < 0 then
			return i
		end
	end
	return #WC.Segments
end

-- (cash, boost seconds) a segment pays this player
function WheelService:GetPrize(player: Player, segment): (number, number)
	local wallet = S.DataService:GetWallet(player)
	local rebirths = wallet and wallet.Rebirths or 0
	local cash = 0
	if segment.Minutes then
		cash = math.floor(math.max((segment.MinCash or 0) * (1 + rebirths), S.TycoonService:GetIncome(player) * segment.Minutes * 60))
	end
	return cash, segment.BoostSeconds or 0
end

function WheelService:_sync(player: Player)
	local data = S.DataService:Get(player)
	if data then
		player:SetAttribute("WheelReadyAt", data.Wheel.Last + WC.CooldownMinutes * 60)
	end
end

function WheelService:Spin(player: Player): (boolean, number, string)
	local data = S.DataService:Get(player)
	if not data then
		return false, 0, "Data still loading..."
	end
	local readyAt = data.Wheel.Last + WC.CooldownMinutes * 60
	if os.time() < readyAt then
		return false, 0, "Your next free spin is in " .. Util.FormatTime(readyAt - os.time())
	end
	local index = self:_pick()
	local segment = WC.Segments[index]
	local cash, boost = self:GetPrize(player, segment)
	data.Wheel.Last = os.time()
	data.Wheel.Spins += 1
	self:_sync(player)
	if cash > 0 then
		S.DataService:AddCash(player, cash, false)
	end
	if boost > 0 then
		S.DataService:AddBoost(player, boost)
	end
	local text = segment.Icon .. " " .. segment.Name .. ": "
	if cash > 0 then
		text ..= "+" .. Util.Money(cash)
	else
		text ..= "2x cash for " .. Util.FormatTime(boost)
	end
	-- the effects wait until the client's reel has stopped
	task.delay(WC.SpinSeconds, function()
		if player.Parent then
			if cash > 0 then
				Remotes.VFX:FireClient(player, "CashBurst", { Amount = cash })
			end
			Remotes.VFX:FireClient(player, "Confetti", {})
		end
		if segment.Weight <= 3 then
			Remotes.Announce:FireAllClients({
				Title = "🎰 " .. player.DisplayName .. " won " .. segment.Name .. "!",
				Text = text,
				Color = segment.Color,
			})
		end
	end)
	return true, index, text
end

function WheelService:Init(services)
	S = services
	Remotes.SpinWheel.OnServerInvoke = function(player)
		if not WC.Enabled then
			return false, 0, "The wheel is turned off."
		end
		return self:Spin(player)
	end
	S.DataService.PlayerLoaded:Connect(function(player)
		self:_sync(player)
	end)
end

return WheelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--[[
	WorldBuilder - builds the whole map from code (terrain + parts):

	  centre        lobby plaza, spawn, boards, PUBLIC NUKE BUNKER
	  ring (r=270)  8 tycoon towers (TycoonService) + ring road
	  north         terraced snowy mountain with a hidden cave
	  north-east    waterfall cliff
	  south         lake with an island and a dock
	  east          dense forest, giant tree house, launch pad -> cloud island
	  north-west    graveyard
	  west          obby (ObbyService)
	  far corner    the world's edge

	Secret spots are exposed in WorldBuilder.SecretSpots for SecretService.
]]
local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local BuildKit = require(script.Parent.BuildKit)

local Part = BuildKit.Part

local WorldBuilder = {}
WorldBuilder.Folder = nil :: Folder?
WorldBuilder.LeaderboardBody = nil :: Frame?
WorldBuilder.SecretSpots = {} :: { [string]: Vector3 }
WorldBuilder.LaunchPads = {}
WorldBuilder.Shelter = nil -- public bunker { CFrame, Size, Door }
WorldBuilder.Islands = {} :: { [string]: { Center: Vector3, Spawn: Vector3 } } -- the far islands (Config.Islands)
WorldBuilder.Chests = {} :: { { Id: string, Island: string, Part: BasePart } } -- their treasure chests
WorldBuilder.ReturnPads = {} :: { { Island: string, Part: BasePart } } -- pads that bring you back

local PLAZA_RADIUS = 70
local MAP_HALF = 1000
local MOUNTAIN = Vector3.new(0, 0, -720)
local LAKE = Vector3.new(0, 0, 650)
local LAKE_RADIUS = 150
local ISLAND = Vector3.new(40, 0, 690)
local CAVE = Vector3.new(0, 0, -620)
local WATERFALL = Vector3.new(240, 0, -560)
local GIANT_TREE = Vector3.new(620, 0, -150)
local LAUNCH_PAD = Vector3.new(560, 0, 380)
local CLOUD = Vector3.new(720, 222, 300)
local GRAVEYARD = Vector3.new(-540, 0, -420)
local EDGE = Vector3.new(965, 0, 965)
local BUNKER = Vector3.new(-88, 0, -88)

local terrain = workspace.Terrain

---------------------------------------------------------------------------
-- Lighting / physics setup
---------------------------------------------------------------------------
local function setupLighting()
	for _, child in Lighting:GetChildren() do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	Lighting.ClockTime = Config.DayNight.StartTime or 14
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(90, 90, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 160)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GeographicLatitude = 30

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.StarCount = 3000
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(199, 220, 255)
	atmosphere.Decay = Color3.fromRGB(106, 112, 160)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.8
	rays.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "BaseColorCorrection"
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	cc.Parent = Lighting

	terrain.WaterColor = Color3.fromRGB(40, 140, 200)
	terrain.WaterTransparency = 0.6
	terrain.WaterReflectance = 0.4
	terrain.WaterWaveSize = 0.15
	terrain.WaterWaveSpeed = 8
end

local function setupCollisionGroups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Players")
		PhysicsService:CollisionGroupSetCollidable("Players", "Players", true)
	end)
	local function setGroup(character: Model)
		for _, d in character:GetDescendants() do
			if d:IsA("BasePart") then
				d.CollisionGroup = "Players"
			end
		end
		character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				d.CollisionGroup = "Players"
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(setGroup)
		if player.Character then
			setGroup(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
end

---------------------------------------------------------------------------
-- Small builders
---------------------------------------------------------------------------
local function tree(parent: Instance, position: Vector3, scale: number, rng: Random, dead: boolean?)
	local model = BuildKit.Model("Tree", parent)
	local trunkHeight = 8 * scale
	Part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkHeight, 1.6 * scale, 1.6 * scale),
		CFrame = CFrame.new(position + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = dead and Color3.fromRGB(60, 50, 45) or Color3.fromRGB(110, 75, 45),
		Material = Enum.Material.Wood,
		Parent = model,
	})
	if dead then
		for i = 1, 3 do
			local a = rng:NextNumber(0, math.pi * 2)
			Part({
				Name = "Branch",
				Size = Vector3.new(0.6 * scale, 4 * scale, 0.6 * scale),
				CFrame = CFrame.new(position + Vector3.new(math.cos(a), trunkHeight * (0.55 + i * 0.12), math.sin(a))) * CFrame.Angles(math.cos(a) * 0.9, 0, math.sin(a) * 0.9),
				Color = Color3.fromRGB(60, 50, 45),
				Material = Enum.Material.Wood,
				CanCollide = false,
				Parent = model,
			})
		end
		return model
	end
	local leafColor = Color3.fromHSV(0.26 + rng:NextNumber() * 0.1, 0.6, 0.5 + rng:NextNumber() * 0.25)
	for i = 1, 3 do
		local size = (7 - i * 1.3) * scale
		Part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			Position = position + Vector3.new((rng:NextNumber() - 0.5) * 2 * scale, trunkHeight + (i - 1) * 2.4 * scale, (rng:NextNumber() - 0.5) * 2 * scale),
			Color = leafColor,
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = model,
		})
	end
	return model
end

local function lamp(parent: Instance, position: Vector3, color: Color3)
	local model = BuildKit.Model("Lamp", parent)
	Part({ Size = Vector3.new(0.8, 12, 0.8), Position = position + Vector3.new(0, 6, 0), Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = model })
	local bulb = Part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2.2, Position = position + Vector3.new(0, 12.6, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
	BuildKit.Light(bulb, color, 26, 1.5)
end

-- Board standing on the ground at `position`, facing `lookAt`
function WorldBuilder.Board(parent: Instance, position: Vector3, lookAt: Vector3, title: string, color: Color3)
	local model = BuildKit.Model(title .. "Board", parent)
	local cf = CFrame.lookAt(position + Vector3.new(0, 13, 0), Vector3.new(lookAt.X, position.Y + 13, lookAt.Z))
	local board = Part({ Name = "Screen", Size = Vector3.new(26, 20, 1), CFrame = cf, Color = Color3.fromRGB(20, 22, 35), Parent = model })
	Part({ Name = "Frame", Size = Vector3.new(28, 22, 0.8), CFrame = cf * CFrame.new(0, 0, 0.6), Color = color, Material = Enum.Material.Neon, Parent = model })
	for _, x in { -9, 9 } do
		Part({ Name = "Leg", Size = Vector3.new(1.5, 3, 1.5), CFrame = cf * CFrame.new(x, -11.5, 0.6), Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = model })
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = board
	local header = Instance.new("TextLabel")
	header.Name = "Title"
	header.Size = UDim2.new(1, 0, 0.16, 0)
	header.BackgroundColor3 = color
	header.Text = title
	header.TextScaled = true
	header.Font = Enum.Font.FredokaOne
	header.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = header
	header.Parent = gui
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.Size = UDim2.new(1, -30, 0.82, -10)
	body.Position = UDim2.new(0, 15, 0.17, 5)
	body.BackgroundTransparency = 1
	body.Parent = gui
	return gui, body, model, cf
end

local function infoText(body: Frame, lines: { string })
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = body
	for i, line in lines do
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 46)
		label.BackgroundTransparency = 1
		label.Text = line
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.LayoutOrder = i
		label.Parent = body
	end
end

local function pathSegment(parent: Instance, a: Vector3, b: Vector3, width: number)
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	Part({
		Name = "Path",
		Size = Vector3.new(width, 0.4, length),
		CFrame = CFrame.lookAt(Vector3.new(mid.X, 0.2, mid.Z), Vector3.new(b.X, 0.2, b.Z)),
		Color = Color3.fromRGB(170, 150, 120),
		Material = Enum.Material.Cobblestone,
		Parent = parent,
	})
end

---------------------------------------------------------------------------
-- Terrain
---------------------------------------------------------------------------
local function buildTerrain()
	terrain:Clear()
	terrain:FillBlock(CFrame.new(0, -8, 0), Vector3.new(MAP_HALF * 2 + 48, 16, MAP_HALF * 2 + 48), Enum.Material.Grass)

	-- terraced mountain (walkable: 4-stud steps)
	for i = 0, 40 do
		local radius = 230 - i * 5.2
		local material = i < 8 and Enum.Material.Grass or (i < 30 and Enum.Material.Rock or Enum.Material.Snow)
		terrain:FillCylinder(CFrame.new(MOUNTAIN.X, i * 4 + 2, MOUNTAIN.Z), 4, radius, material)
	end
	-- cave: tunnel + room
	terrain:FillBlock(CFrame.new(CAVE.X, 6, -540), Vector3.new(12, 12, 124), Enum.Material.Air)
	terrain:FillBall(Vector3.new(CAVE.X, 22, CAVE.Z), 22, Enum.Material.Air)

	-- lake
	local lakeCF = CFrame.new(LAKE.X, 0, LAKE.Z)
	terrain:FillCylinder(lakeCF * CFrame.new(0, -12, 0), 28, LAKE_RADIUS, Enum.Material.Air)
	terrain:FillCylinder(lakeCF * CFrame.new(0, -1, 0), 2, LAKE_RADIUS + 16, Enum.Material.Sand)
	terrain:FillCylinder(lakeCF * CFrame.new(0, -12, 0), 28, LAKE_RADIUS, Enum.Material.Air)
	terrain:FillCylinder(lakeCF * CFrame.new(0, -22, 0), 4, LAKE_RADIUS, Enum.Material.Sand)
	terrain:FillCylinder(lakeCF * CFrame.new(0, -11, 0), 18, LAKE_RADIUS, Enum.Material.Water)
	-- island
	terrain:FillCylinder(CFrame.new(ISLAND.X, -11, ISLAND.Z), 22, 32, Enum.Material.Sand)
	terrain:FillCylinder(CFrame.new(ISLAND.X, 0, ISLAND.Z), 4, 26, Enum.Material.Grass)
end

---------------------------------------------------------------------------
-- Lobby
---------------------------------------------------------------------------
local function buildLobby(world: Folder)
	local lobby = BuildKit.Model("Lobby", world)
	Part({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, PLAZA_RADIUS * 2, PLAZA_RADIUS * 2),
		CFrame = CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(205, 205, 215),
		Material = Enum.Material.Slate,
		Parent = lobby,
	})
	Part({
		Name = "PlazaRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, PLAZA_RADIUS * 2 + 4, PLAZA_RADIUS * 2 + 4),
		CFrame = CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 196, 0),
		Material = Enum.Material.Neon,
		Parent = lobby,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = Vector3.new(0, 1, 0)
	spawn.Material = Enum.Material.Neon
	spawn.Color = Color3.fromRGB(0, 200, 255)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end

	local titleAnchor = Part({ Name = "Title", Size = Vector3.one, Position = Vector3.new(0, 34, 0), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = lobby })
	local _, titleLabel = BuildKit.Billboard(titleAnchor, Config.GameName, { Size = UDim2.fromScale(44, 9), Offset = Vector3.zero, MaxDistance = 900, Color = Color3.fromRGB(255, 210, 40) })
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 120)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 170, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 120)),
	})
	gradient.Rotation = 90
	gradient.Parent = titleLabel

	local core = Part({
		Name = "Crystal",
		Size = Vector3.new(4, 4, 4),
		CFrame = CFrame.new(0, 20, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = Color3.fromRGB(255, 196, 0),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "Spin", "Bob" },
		Parent = lobby,
	})
	BuildKit.Light(core, Color3.fromRGB(255, 200, 60), 40, 3)
	BuildKit.Particles(core, { Color = ColorSequence.new(Color3.fromRGB(255, 220, 80)), Size = BuildKit.Size(1), Rate = 25, Speed = NumberRange.new(4, 8), SpreadAngle = Vector2.new(180, 180) })

	-- boards
	local _, lbBody, _, lbCF = WorldBuilder.Board(lobby, Vector3.new(65, 0, 65), Vector3.zero, "🏆 TOP EARNERS", Color3.fromRGB(255, 180, 0))
	WorldBuilder.LeaderboardBody = lbBody
	-- secret: something is hiding behind the leaderboard...
	WorldBuilder.SecretSpots.Board = (lbCF * CFrame.new(6, -10.5, 3.5)).Position

	local _, howBody = WorldBuilder.Board(lobby, Vector3.new(-82, 0, 48), Vector3.zero, "📜 HOW TO PLAY", Color3.fromRGB(0, 170, 255))
	infoText(howBody, {
		"🏢 8-floor tower, 500+ upgrades",
		"💵 Step on buttons or open BUILD",
		"🏦 Collect cash at any VAULT pad",
		"🛗 Elevator = travel between floors",
		"👥 DUO: build one tower with a friend",
		"🔄 Rebirth for a permanent multiplier",
		"🕵️ Find 12 secrets for +5% each!",
		"💤 Your tower earns while you're offline",
	})
	local _, mgBody = WorldBuilder.Board(lobby, Vector3.new(-48, 0, 82), Vector3.zero, "🎮 MINIGAMES", Color3.fromRGB(170, 70, 255))
	local mgLines = {}
	for _, mg in Config.Minigames.Games do
		table.insert(mgLines, "• " .. mg.DisplayName .. ": " .. mg.Description)
	end
	table.insert(mgLines, "Every " .. math.floor(Config.Minigames.Intermission / 60 * 10) / 10 .. " min - press JOIN!")
	table.insert(mgLines, "🏃 Obby: follow the west road")
	infoText(mgBody, mgLines)
	local _, dzBody = WorldBuilder.Board(lobby, Vector3.new(65, 0, -65), Vector3.zero, "☢️ DISASTERS", Color3.fromRGB(255, 70, 40))
	infoText(dzBody, {
		"☢️ NUKES: get inside a bunker in 30s!",
		"🟩 Follow the green beam to safety",
		"☄️ Meteor storms leave cash crystals",
		"🌪️ Tornadoes fling you and wreck stuff",
		"🛸 UFOs abduct players & drop cash",
		"🛡️ Nuke Shield (floor 2) protects all",
		"🔧 Wrecked upgrades repair themselves",
	})

	-- ring road + lanes
	for i = 0, 47 do
		local a1 = i / 48 * math.pi * 2
		local a2 = (i + 1) / 48 * math.pi * 2
		pathSegment(lobby, Vector3.new(math.cos(a1) * 195, 0, math.sin(a1) * 195), Vector3.new(math.cos(a2) * 195, 0, math.sin(a2) * 195), 12)
		if i % 4 == 2 then
			lamp(lobby, Vector3.new(math.cos(a1) * 185, 0, math.sin(a1) * 185), Color3.fromHSV(i / 48, 0.7, 1))
		end
	end
	local lanes = {
		{ Vector3.new(0, 0, -PLAZA_RADIUS), Vector3.new(0, 0, -480) }, -- north: mountain
		{ Vector3.new(0, 0, PLAZA_RADIUS), Vector3.new(0, 0, 486) }, -- south: lake
		{ Vector3.new(-PLAZA_RADIUS, 0, 0), Vector3.new(-410, 0, 0) }, -- west: obby
		{ Vector3.new(PLAZA_RADIUS, 0, 0), Vector3.new(430, 0, 0) }, -- east: forest
	}
	for _, lane in lanes do
		pathSegment(lobby, lane[1], lane[2], 14)
		local dir = (lane[2] - lane[1]).Unit
		local side = Vector3.new(-dir.Z, 0, dir.X)
		local length = (lane[2] - lane[1]).Magnitude
		for d = 40, length, 50 do
			local p = lane[1] + dir * d
			if math.abs(p.Magnitude - 195) > 16 then
				lamp(lobby, p + side * 11, Color3.fromRGB(255, 230, 160))
			end
		end
	end
	-- spokes from the ring road to every plot gate
	for index = 1, Config.MaxPlots do
		local a = math.rad(22.5 + (index - 1) * (360 / Config.MaxPlots))
		pathSegment(lobby, Vector3.new(math.cos(a) * 195, 0, math.sin(a) * 195), Vector3.new(math.cos(a) * 212, 0, math.sin(a) * 212), 12)
	end
	-- signposts
	for _, data in { { Vector3.new(14, 0, -110), "⛰️ MOUNTAIN" }, { Vector3.new(-14, 0, 110), "🌊 LAKE" }, { Vector3.new(-110, 0, -14), "🏃 OBBY" }, { Vector3.new(110, 0, 14), "🌲 FOREST" } } do
		local post = Part({ Name = "SignPost", Size = Vector3.new(0.8, 7, 0.8), Position = data[1] + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Wood, Parent = lobby })
		BuildKit.Billboard(post, data[2], { Size = UDim2.fromOffset(160, 36), Offset = Vector3.new(0, 5, 0), MaxDistance = 150 })
	end
	return lobby
end

local function buildBunker(world: Folder)
	local model = BuildKit.Model("PublicBunker", world)
	local cf = CFrame.lookAt(BUNKER, Vector3.new(0, 0, 0))
	local concrete = Color3.fromRGB(125, 125, 130)
	local W, H, T = 36, 12, 2
	local function wall(size: Vector3, offset: Vector3)
		return Part({ Name = "Wall", Size = size, CFrame = cf * CFrame.new(offset), Color = concrete, Material = Enum.Material.Concrete, Parent = model })
	end
	Part({ Name = "Floor", Size = Vector3.new(W, 0.6, W), CFrame = cf * CFrame.new(0, 0.3, 0), Color = Color3.fromRGB(80, 80, 85), Material = Enum.Material.Concrete, Parent = model })
	wall(Vector3.new(W + 2, T, W + 2), Vector3.new(0, H + T / 2, 0)) -- roof
	wall(Vector3.new(W, H, T), Vector3.new(0, H / 2, W / 2)) -- back
	wall(Vector3.new(T, H, W), Vector3.new(-W / 2, H / 2, 0)) -- sides
	wall(Vector3.new(T, H, W), Vector3.new(W / 2, H / 2, 0))
	wall(Vector3.new(14, H, T), Vector3.new(-11, H / 2, -W / 2)) -- front with door gap
	wall(Vector3.new(14, H, T), Vector3.new(11, H / 2, -W / 2))
	wall(Vector3.new(8, 3, T), Vector3.new(0, H - 1.5, -W / 2))
	for i = -3, 3 do
		Part({ Name = "Stripe", Size = Vector3.new(1.4, 0.3, 4), CFrame = cf * CFrame.new(i * 2.4, 0.5, -W / 2 - 3) * CFrame.Angles(0, math.rad(35), 0), Color = i % 2 == 0 and Color3.fromRGB(255, 210, 0) or Color3.fromRGB(30, 30, 30), Parent = model })
	end
	local sign = Part({ Name = "Sign", Size = Vector3.new(20, 4, 0.6), CFrame = cf * CFrame.new(0, H + 4, -W / 2), Color = Color3.fromRGB(255, 210, 0), Material = Enum.Material.Neon, Parent = model })
	BuildKit.SurfaceText(sign, Enum.NormalId.Front, "☢️ PUBLIC BUNKER ☢️", { PixelsPerStud = 16, Color = Color3.new(0, 0, 0) })
	for i = 1, 4 do
		local lampPart = Part({ Name = "Lamp", Size = Vector3.new(3, 0.3, 3), CFrame = cf * CFrame.new(i % 2 == 0 and 8 or -8, H - 0.3, i <= 2 and -6 or 8), Color = Color3.fromRGB(255, 120, 90), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
		BuildKit.Light(lampPart, Color3.fromRGB(255, 160, 120), 24, 1.5)
	end
	for _, offset in { Vector3.new(-12, 1.8, 10), Vector3.new(12, 1.8, 2), Vector3.new(-12, 1.8, -2) } do
		Part({ Name = "Bench", Size = Vector3.new(8, 1, 2.5), CFrame = cf * CFrame.new(offset) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(110, 80, 50), Material = Enum.Material.WoodPlanks, Parent = model })
	end
	-- supply crates (the stash secret hides behind them)
	for i, offset in { Vector3.new(12, 1.5, 12.5), Vector3.new(9, 1.5, 13), Vector3.new(12, 4.3, 12.5), Vector3.new(14.5, 1.5, 9.5) } do
		local crate = Part({ Name = "Crate", Size = Vector3.new(3, 3, 3), CFrame = cf * CFrame.new(offset) * CFrame.Angles(0, i * 0.3, 0), Color = Color3.fromRGB(150, 110, 60), Material = Enum.Material.WoodPlanks, Parent = model })
		crate.Name = "Crate" .. i
	end
	WorldBuilder.SecretSpots.Bunker = (cf * CFrame.new(15.6, 1.4, 15.6)).Position
	WorldBuilder.Shelter = {
		CFrame = cf * CFrame.new(0, H / 2, 0),
		Size = Vector3.new(W - T, H, W - T),
		Door = (cf * CFrame.new(0, 3, -W / 2 - 4)).Position,
	}
end

---------------------------------------------------------------------------
-- Zones
---------------------------------------------------------------------------
local function buildMountainExtras(world: Folder, rng: Random)
	local model = BuildKit.Model("Mountain", world)
	-- hide the cave entrance behind trees and bushes
	for _, x in { -12, 12, -22, 22 } do
		tree(model, Vector3.new(CAVE.X + x, 0, -476 + math.abs(x) * 0.2), 1.6, rng)
	end
	for _, x in { -6, 6 } do
		Part({ Name = "Bush", Shape = Enum.PartType.Ball, Size = Vector3.one * 7, Position = Vector3.new(CAVE.X + x, 2, -480), Color = Color3.fromRGB(60, 140, 60), Material = Enum.Material.Grass, CanCollide = false, Parent = model })
	end
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		local crystal = Part({
			Name = "CaveCrystal",
			Size = Vector3.new(1.6, rng:NextNumber(3, 7), 1.6),
			CFrame = CFrame.new(CAVE.X + math.cos(a) * 16, 2, CAVE.Z + math.sin(a) * 16) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), 0, rng:NextNumber(-0.5, 0.5)),
			Color = Color3.fromHSV(0.7 + rng:NextNumber() * 0.15, 0.7, 1),
			Material = Enum.Material.Neon,
			Parent = model,
		})
		BuildKit.Light(crystal, crystal.Color, 18, 1.5)
	end
	for z = -500, -590, -18 do
		local torch = Part({ Name = "Torch", Size = Vector3.new(0.6, 3, 0.6), Position = Vector3.new(CAVE.X - 5.4, 5, z), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = model })
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 4
		fire.Parent = torch
		BuildKit.Light(torch, Color3.fromRGB(255, 160, 60), 16, 1.5)
	end
	WorldBuilder.SecretSpots.Cave = Vector3.new(CAVE.X, 2.5, CAVE.Z - 6)
	local pole = Part({ Name = "SummitPole", Size = Vector3.new(0.6, 14, 0.6), Position = Vector3.new(MOUNTAIN.X + 4, 171, MOUNTAIN.Z), Color = Color3.fromRGB(220, 220, 220), Material = Enum.Material.Metal, Parent = model })
	Part({ Name = "SummitFlag", Size = Vector3.new(0.2, 3.5, 6), Position = pole.Position + Vector3.new(0, 5, 3), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Fabric, Parent = model })
	WorldBuilder.SecretSpots.Summit = Vector3.new(MOUNTAIN.X, 167, MOUNTAIN.Z)
end

local function buildWaterfall(world: Folder)
	local model = BuildKit.Model("Waterfall", world)
	local rock = Color3.fromRGB(105, 100, 95)
	local x, z = WATERFALL.X, WATERFALL.Z
	-- cliff with a hidden pocket behind the falls
	Part({ Name = "CliffLeft", Size = Vector3.new(26, 60, 22), Position = Vector3.new(x - 17, 30, z - 14), Color = rock, Material = Enum.Material.Slate, Parent = model })
	Part({ Name = "CliffRight", Size = Vector3.new(26, 60, 22), Position = Vector3.new(x + 17, 30, z - 14), Color = rock, Material = Enum.Material.Slate, Parent = model })
	Part({ Name = "CliffTop", Size = Vector3.new(8, 50, 22), Position = Vector3.new(x, 35, z - 14), Color = rock, Material = Enum.Material.Slate, Parent = model })
	Part({ Name = "CliffBack", Size = Vector3.new(8, 10, 12), Position = Vector3.new(x, 5, z - 19), Color = rock, Material = Enum.Material.Slate, Parent = model })
	local fall = Part({ Name = "Waterfall", Size = Vector3.new(14, 58, 1), Position = Vector3.new(x, 29, z - 2.4), Color = Color3.fromRGB(150, 210, 255), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false, Parent = model })
	BuildKit.Particles(fall, {
		Color = ColorSequence.new(Color3.fromRGB(220, 240, 255)),
		Size = BuildKit.Size(2, 1, 3),
		Rate = 40,
		Speed = NumberRange.new(20, 30),
		Lifetime = NumberRange.new(1.5, 2),
		EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(5, 5),
		Transparency = NumberSequence.new(0.4, 1),
	})
	local pool = Part({ Name = "Pool", Size = Vector3.new(34, 0.6, 18), Position = Vector3.new(x, 0.3, z + 8), Color = Color3.fromRGB(60, 160, 230), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false, Parent = model })
	BuildKit.Particles(pool, { Color = ColorSequence.new(Color3.new(1, 1, 1)), Size = BuildKit.Size(3, 2, 5), Rate = 15, Speed = NumberRange.new(2, 4), Lifetime = NumberRange.new(2, 3), Transparency = NumberSequence.new(0.6, 1), EmissionDirection = Enum.NormalId.Top })
	WorldBuilder.SecretSpots.Waterfall = Vector3.new(x, 2.5, z - 8)
end

local function buildLake(world: Folder, rng: Random)
	local model = BuildKit.Model("Lake", world)
	for i = 0, 9 do
		Part({ Name = "Plank", Size = Vector3.new(8, 0.5, 2.6), Position = Vector3.new(0, 0.6, LAKE.Z - LAKE_RADIUS - 14 + i * 3), Color = Color3.fromRGB(140, 100, 60), Material = Enum.Material.WoodPlanks, Parent = model })
	end
	for _, dx in { -3.6, 3.6 } do
		for i = 0, 3 do
			Part({ Name = "Post", Size = Vector3.new(0.8, 6, 0.8), Position = Vector3.new(dx, -1, LAKE.Z - LAKE_RADIUS - 13 + i * 9), Color = Color3.fromRGB(110, 80, 50), Material = Enum.Material.Wood, Parent = model })
		end
	end
	-- the island's hollow tree (trunk ring with a gap facing +X)
	local cx, cz = ISLAND.X, ISLAND.Z
	for i = 1, 9 do
		local a = i / 10 * math.pi * 2
		Part({
			Name = "Bark",
			Size = Vector3.new(2.8, 16, 1.4),
			CFrame = CFrame.new(cx + math.cos(a) * 4.2, 10, cz + math.sin(a) * 4.2) * CFrame.Angles(0, -a + math.pi / 2, 0),
			Color = Color3.fromRGB(100, 70, 45),
			Material = Enum.Material.Wood,
			Parent = model,
		})
	end
	for i = 1, 4 do
		Part({ Name = "Canopy", Shape = Enum.PartType.Ball, Size = Vector3.one * (16 - i * 2), Position = Vector3.new(cx + rng:NextNumber(-3, 3), 18 + i * 2.5, cz + rng:NextNumber(-3, 3)), Color = Color3.fromRGB(70, 160, 70), Material = Enum.Material.Grass, CanCollide = false, Parent = model })
	end
	WorldBuilder.SecretSpots.Island = Vector3.new(cx, 3.5, cz)
	WorldBuilder.SecretSpots.LakeFloor = Vector3.new(-70, -18, LAKE.Z - 30)
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2 + 0.6
		tree(model, Vector3.new(cx + math.cos(a) * 16, 2, cz + math.sin(a) * 16), 1, rng)
	end
end

local function buildForest(world: Folder, rng: Random)
	local model = BuildKit.Model("Forest", world)
	-- giant tree house (door faces west, toward the lobby)
	local gx, gz = GIANT_TREE.X, GIANT_TREE.Z
	local segments = 16
	for i = 0, segments - 1 do
		if i ~= 8 then
			local a = i / segments * math.pi * 2
			Part({
				Name = "GiantBark",
				Size = Vector3.new(5.2, 70, 3),
				CFrame = CFrame.new(gx + math.cos(a) * 12, 35, gz + math.sin(a) * 12) * CFrame.Angles(0, -a + math.pi / 2, 0),
				Color = Color3.fromRGB(95, 65, 40),
				Material = Enum.Material.Wood,
				Parent = model,
			})
		end
	end
	Part({ Name = "DoorFrame", Size = Vector3.new(2, 2, 7), Position = Vector3.new(gx - 12, 12, gz), Color = Color3.fromRGB(70, 45, 30), Material = Enum.Material.Wood, Parent = model })
	for _ = 1, 6 do
		Part({
			Name = "GiantCanopy",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * rng:NextNumber(40, 60),
			Position = Vector3.new(gx + rng:NextNumber(-25, 25), 80 + rng:NextNumber(0, 25), gz + rng:NextNumber(-25, 25)),
			Color = Color3.fromRGB(50, 140, 60),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = model,
		})
	end
	local glow = Part({ Name = "Lantern", Size = Vector3.new(1.2, 1.6, 1.2), Position = Vector3.new(gx, 8, gz), Color = Color3.fromRGB(255, 200, 100), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
	BuildKit.Light(glow, Color3.fromRGB(255, 200, 120), 20, 1.5)
	WorldBuilder.SecretSpots.GiantTree = Vector3.new(gx + 2, 2.5, gz)

	-- launch pad (hidden among trees) -> cloud island
	local pad = Part({ Name = "LaunchPad", Size = Vector3.new(7, 0.6, 7), Position = LAUNCH_PAD + Vector3.new(0, 0.3, 0), Color = Color3.fromRGB(170, 70, 255), Material = Enum.Material.Neon, Tags = { "Pulse" }, Parent = model })
	BuildKit.Particles(pad, { Color = ColorSequence.new(Color3.fromRGB(200, 120, 255)), Size = BuildKit.Size(0.6), Rate = 20, Speed = NumberRange.new(6, 10), EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(10, 10) })
	table.insert(WorldBuilder.LaunchPads, { Part = pad, Target = CLOUD + Vector3.new(0, 5, 0) })

	-- cloud island
	local cloud = BuildKit.Model("CloudIsland", world)
	cloud.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	Part({ Name = "CloudTop", Size = Vector3.new(36, 2, 36), Position = CLOUD, Color = Color3.fromRGB(245, 245, 255), Parent = cloud })
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		Part({ Name = "Puff", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(12, 18), Position = CLOUD + Vector3.new(math.cos(a) * 17, rng:NextNumber(-4, 1), math.sin(a) * 17), Color = Color3.fromRGB(250, 250, 255), CanCollide = false, Parent = cloud })
	end
	Part({ Name = "Rainbow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 30, 30), CFrame = CFrame.new(CLOUD + Vector3.new(0, 6, 12)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(255, 120, 200), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, Tags = { "Pulse" }, Parent = cloud })
	WorldBuilder.SecretSpots.Cloud = CLOUD + Vector3.new(0, 3.5, 0)

	-- dense forest
	local count, tries = 0, 0
	while count < 220 and tries < 3000 do
		tries += 1
		local p = Vector3.new(rng:NextNumber(440, 960), 0, rng:NextNumber(-620, 620))
		if (p - GIANT_TREE).Magnitude > 40 and (p - LAUNCH_PAD).Magnitude > 9 and math.abs(p.Z) > 12 then
			tree(model, p, rng:NextNumber(1.1, 2.2), rng)
			count += 1
		end
	end
end

local function buildGraveyard(world: Folder, rng: Random)
	local model = BuildKit.Model("Graveyard", world)
	local gx, gz = GRAVEYARD.X, GRAVEYARD.Z
	for i = -6, 6 do
		for _, offset in { Vector3.new(i * 5, 0, -32), Vector3.new(i * 5, 0, 32), Vector3.new(-32, 0, i * 5), Vector3.new(32, 0, i * 5) } do
			if not (offset.Z == 32 and math.abs(offset.X) < 6) then
				Part({ Name = "Fence", Size = Vector3.new(0.5, 4, 0.5), Position = Vector3.new(gx, 2, gz) + offset, Color = Color3.fromRGB(40, 40, 45), Material = Enum.Material.Metal, Parent = model })
			end
		end
	end
	for row = -2, 2 do
		for col = -3, 3 do
			if not (row == 0 and col == 0) then
				local p = Vector3.new(gx + col * 8 + rng:NextNumber(-1, 1), 0, gz + row * 10 + rng:NextNumber(-1, 1))
				local stone = Part({ Name = "Tombstone", Size = Vector3.new(3, 4, 0.8), CFrame = CFrame.new(p + Vector3.new(0, 2, 0)) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), rng:NextNumber(-0.15, 0.15)), Color = Color3.fromRGB(130, 130, 135), Material = Enum.Material.Slate, Parent = model })
				stone.Name = "Tombstone"
				Part({ Name = "Mound", Size = Vector3.new(3, 0.8, 5), Position = p + Vector3.new(0, 0.4, 3), Color = Color3.fromRGB(90, 70, 50), Material = Enum.Material.Ground, Parent = model })
			end
		end
	end
	-- the open grave in the middle
	local stone = Part({ Name = "OddTombstone", Size = Vector3.new(3, 4, 0.8), Position = Vector3.new(gx, 2, gz), Color = Color3.fromRGB(110, 110, 115), Material = Enum.Material.Slate, Parent = model })
	BuildKit.SurfaceText(stone, Enum.NormalId.Back, "R.I.P.\nNOOB", { PixelsPerStud = 20, Color = Color3.fromRGB(60, 60, 60) })
	Part({ Name = "Coffin", Size = Vector3.new(3, 1.2, 6), Position = Vector3.new(gx, 0.6, gz + 3.5), Color = Color3.fromRGB(70, 45, 30), Material = Enum.Material.WoodPlanks, Parent = model })
	Part({ Name = "CoffinLid", Size = Vector3.new(3, 0.3, 6), CFrame = CFrame.new(gx + 2.8, 1.2, gz + 3.5) * CFrame.Angles(0, 0, math.rad(-30)), Color = Color3.fromRGB(70, 45, 30), Material = Enum.Material.WoodPlanks, Parent = model })
	WorldBuilder.SecretSpots.Graveyard = Vector3.new(gx, 2.2, gz + 3.5)
	for _ = 1, 8 do
		tree(model, Vector3.new(gx + rng:NextNumber(-45, 45), 0, gz + rng:NextNumber(-45, 45)), rng:NextNumber(1, 1.6), rng, true)
	end
	for i = 1, 6 do
		local wisp = Part({ Name = "Wisp", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.8, Position = Vector3.new(gx + rng:NextNumber(-25, 25), 3, gz + rng:NextNumber(-25, 25)), Color = Color3.fromRGB(120, 255, 140), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Bob" }, Parent = model })
		BuildKit.Light(wisp, Color3.fromRGB(120, 255, 140), 14, 1.5)
		wisp.Name = "Wisp" .. i
	end
	local gate = Part({ Name = "GateSign", Size = Vector3.new(12, 2, 0.4), Position = Vector3.new(gx, 6, gz + 32), Color = Color3.fromRGB(30, 30, 35), Parent = model })
	BuildKit.SurfaceText(gate, Enum.NormalId.Back, "🪦 GRAVEYARD", { PixelsPerStud = 20, Color = Color3.fromRGB(150, 255, 150) })
end

local function buildEdge(world: Folder)
	local model = BuildKit.Model("WorldEdge", world)
	for _, data in {
		{ Vector3.new(MAP_HALF * 2, 800, 4), Vector3.new(0, 400, -MAP_HALF) },
		{ Vector3.new(MAP_HALF * 2, 800, 4), Vector3.new(0, 400, MAP_HALF) },
		{ Vector3.new(4, 800, MAP_HALF * 2), Vector3.new(-MAP_HALF, 400, 0) },
		{ Vector3.new(4, 800, MAP_HALF * 2), Vector3.new(MAP_HALF, 400, 0) },
	} do
		Part({ Name = "Boundary", Size = data[1], Position = data[2], Transparency = 1, CanQuery = false, Parent = model })
	end
	for i = 1, 5 do
		Part({ Name = "Boulder", Shape = Enum.PartType.Ball, Size = Vector3.one * (6 + i), Position = EDGE + Vector3.new(-12 + i * 3, 2, -6 - i * 2), Color = Color3.fromRGB(110, 105, 100), Material = Enum.Material.Rock, Parent = model })
	end
	local sign = Part({ Name = "EdgeSign", Size = Vector3.new(0.6, 6, 10), Position = EDGE + Vector3.new(-20, 5, -20), Color = Color3.fromRGB(90, 70, 50), Material = Enum.Material.WoodPlanks, Parent = model })
	BuildKit.SurfaceText(sign, Enum.NormalId.Left, "⚠️ THE END OF THE WORLD ⚠️", { PixelsPerStud = 16 })
	WorldBuilder.SecretSpots.Edge = EDGE + Vector3.new(14, 2, 14)
end

---------------------------------------------------------------------------
-- Far islands (Config.Islands): a round island, scenery in the island's
-- style, treasure chests, a spawn dock and a pad back to the plaza
---------------------------------------------------------------------------
local function chest(parent: Instance, island, index: number, position: Vector3)
	local gold = Color3.fromRGB(255, 205, 60)
	local model = BuildKit.Model("Chest" .. index, parent)
	local body = Part({ Name = "Body", Size = Vector3.new(4.4, 2.6, 3), Position = position + Vector3.new(0, 1.3, 0), Color = Color3.fromRGB(120, 78, 40), Material = Enum.Material.Wood, Parent = model })
	Part({ Name = "Lid", Size = Vector3.new(4.6, 1.2, 3.2), Position = position + Vector3.new(0, 3.2, 0), Color = gold, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
	BuildKit.Light(body, gold, 16, 2)
	BuildKit.Billboard(body, "💰 TREASURE CHEST", { Offset = Vector3.new(0, 4.5, 0), MaxDistance = 90, Color = gold, Size = UDim2.fromOffset(190, 36) })
	table.insert(WorldBuilder.Chests, { Id = island.Id .. "_" .. index, Island = island.Id, Part = body })
end

local function buildIsland(world: Folder, island, rng: Random)
	local model = BuildKit.Model("Island_" .. island.Id, world)
	local c = island.Position
	local r = island.Radius
	local function at(angle: number, distance: number, y: number?): Vector3
		return c + Vector3.new(math.cos(angle) * distance, y or 0, math.sin(angle) * distance)
	end
	-- the ground: a thick disc whose top is at y = 0
	Part({ Name = "Ground", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, r * 2, r * 2), CFrame = CFrame.new(c + Vector3.new(0, -4, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = island.Color, Material = island.Material, Parent = model })
	Part({ Name = "Cliff", Shape = Enum.PartType.Cylinder, Size = Vector3.new(30, r * 1.7, r * 1.7), CFrame = CFrame.new(c + Vector3.new(0, -23, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(90, 85, 80), Material = Enum.Material.Rock, CanCollide = false, Parent = model })

	-- scenery
	if island.Id == "Treasure" then
		for i = 1, 14 do
			tree(model, at(rng:NextNumber(0, math.pi * 2), rng:NextNumber(30, r - 14)), rng:NextNumber(0.9, 1.5), rng)
		end
		Part({ Name = "ShipHull", Size = Vector3.new(34, 9, 12), CFrame = CFrame.new(at(2.2, 62, 3.5)) * CFrame.Angles(0.12, 0.6, 0.2), Color = Color3.fromRGB(95, 62, 35), Material = Enum.Material.WoodPlanks, Parent = model })
		Part({ Name = "ShipMast", Size = Vector3.new(1.4, 26, 1.4), CFrame = CFrame.new(at(2.2, 62, 16)) * CFrame.Angles(0.1, 0, 0.18), Color = Color3.fromRGB(80, 55, 32), Material = Enum.Material.Wood, Parent = model })
		for _ = 1, 8 do
			Part({ Name = "Dune", Shape = Enum.PartType.Ball, Size = Vector3.new(rng:NextNumber(14, 26), 7, rng:NextNumber(14, 26)), Position = at(rng:NextNumber(0, math.pi * 2), rng:NextNumber(20, r - 20), -1.5), Color = island.Color, Material = Enum.Material.Sand, CanCollide = false, Parent = model })
		end
	elseif island.Id == "Volcano" then
		-- the volcano: stacked cones of rock with glowing lava on top
		Part({ Name = "Cone1", Shape = Enum.PartType.Cylinder, Size = Vector3.new(26, 70, 70), CFrame = CFrame.new(c + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 45, 45), Material = Enum.Material.Basalt, Parent = model })
		Part({ Name = "Cone2", Shape = Enum.PartType.Cylinder, Size = Vector3.new(22, 44, 44), CFrame = CFrame.new(c + Vector3.new(0, 35, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(55, 40, 40), Material = Enum.Material.Basalt, Parent = model })
		local lava = Part({ Name = "Crater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 26, 26), CFrame = CFrame.new(c + Vector3.new(0, 47, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 110, 20), Material = Enum.Material.Neon, CanCollide = false, Tags = { "Pulse" }, Parent = model })
		BuildKit.Light(lava, Color3.fromRGB(255, 120, 30), 60, 3)
		for i = 1, 6 do
			local angle = i / 6 * math.pi * 2 + 0.4
			Part({ Name = "LavaStream", Size = Vector3.new(5, 0.4, 34), CFrame = CFrame.new(at(angle, 48, 0.2)) * CFrame.Angles(0, -angle + math.pi / 2, 0), Color = Color3.fromRGB(255, 100, 20), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		end
		for _ = 1, 12 do
			local size = rng:NextNumber(5, 12)
			Part({ Name = "Rock", Shape = Enum.PartType.Ball, Size = Vector3.one * size, Position = at(rng:NextNumber(0, math.pi * 2), rng:NextNumber(60, r - 8), size / 3), Color = Color3.fromRGB(70, 60, 60), Material = Enum.Material.Rock, Parent = model })
		end
	else
		for _ = 1, 14 do
			local height = rng:NextNumber(8, 22)
			Part({ Name = "IceSpike", Size = Vector3.new(rng:NextNumber(3, 6), height, rng:NextNumber(3, 6)), CFrame = CFrame.new(at(rng:NextNumber(0, math.pi * 2), rng:NextNumber(35, r - 10), height / 2)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 3), rng:NextNumber(-0.2, 0.2)), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Ice, Transparency = 0.25, Parent = model })
		end
		for i = 1, 3 do
			local angle = i / 3 * math.pi * 2 + 1
			local igloo = at(angle, 62, 0)
			Part({ Name = "Igloo", Shape = Enum.PartType.Ball, Size = Vector3.one * 22, Position = igloo, Color = Color3.fromRGB(240, 248, 255), Material = Enum.Material.Snow, Parent = model })
			Part({ Name = "IglooDoor", Size = Vector3.new(6, 7, 8), CFrame = CFrame.new(igloo + Vector3.new(math.cos(angle + math.pi) * 10, 3.5, math.sin(angle + math.pi) * 10)) * CFrame.Angles(0, -angle, 0), Color = Color3.fromRGB(230, 240, 250), Material = Enum.Material.Snow, Parent = model })
		end
		Part({ Name = "FrozenPond", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 40, 40), CFrame = CFrame.new(at(0.5, 20, 0.3)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(150, 205, 255), Material = Enum.Material.Ice, Parent = model })
	end

	-- the treasure chests, spread around
	for i = 1, island.Chests do
		local angle = (i / island.Chests) * math.pi * 2 + 0.7
		chest(model, island, i, at(angle, r * 0.72, 0))
	end

	-- the dock where you arrive, with a sign and the pad back
	local spawnPosition = at(-math.pi / 2, 16, 0)
	Part({ Name = "Dock", Size = Vector3.new(22, 1, 22), Position = spawnPosition + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(110, 85, 55), Material = Enum.Material.WoodPlanks, Parent = model })
	local sign = Part({ Name = "WelcomeSign", Size = Vector3.new(0.6, 8, 16), CFrame = CFrame.new(spawnPosition + Vector3.new(0, 5, 11)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(90, 70, 50), Material = Enum.Material.WoodPlanks, Parent = model })
	BuildKit.SurfaceText(sign, Enum.NormalId.Front, island.Icon .. " " .. island.Name .. "\n" .. island.Text, { PixelsPerStud = 16 })
	local back = Part({ Name = "ReturnPad", Size = Vector3.new(7, 0.6, 7), Position = spawnPosition + Vector3.new(7, 1.3, 4), Color = Color3.fromRGB(70, 200, 100), Material = Enum.Material.Neon, Tags = { "Pulse" }, Parent = model })
	BuildKit.Billboard(back, "🏠 Back to the main island", { Offset = Vector3.new(0, 4, 0), MaxDistance = 70, Size = UDim2.fromOffset(220, 34) })
	table.insert(WorldBuilder.ReturnPads, { Island = island.Id, Part = back })
	WorldBuilder.Islands[island.Id] = { Center = c, Spawn = spawnPosition + Vector3.new(-3, 4, 0) }
end

local function buildIslands(world: Folder)
	if not Config.Islands.Enabled then
		return
	end
	for index, island in Config.Islands.List do
		buildIsland(world, island, Random.new(9000 + index))
	end
end

local function scatterTrees(world: Folder, rng: Random)
	local model = BuildKit.Model("Trees", world)
	local placed, tries = 0, 0
	while placed < 160 and tries < 4000 do
		tries += 1
		local p = Vector3.new(rng:NextNumber(-950, 430), 0, rng:NextNumber(-950, 950))
		local ok = p.Magnitude > 360
			and (p - MOUNTAIN).Magnitude > 270
			and (p - LAKE).Magnitude > LAKE_RADIUS + 30
			and not (p.X < -380 and math.abs(p.Z) < 70)
			and (p - GRAVEYARD).Magnitude > 60
			and math.abs(p.X) > 14
			and math.abs(p.Z) > 14
			and (p - WATERFALL).Magnitude > 50
		if ok then
			tree(model, p, rng:NextNumber(0.9, 1.9), rng)
			placed += 1
		end
	end
	for _, deg in { 45, 135, 315 } do
		local a = math.rad(deg)
		tree(model, Vector3.new(math.cos(a) * 150, 0, math.sin(a) * 150), 1.3, rng)
	end
end

---------------------------------------------------------------------------
function WorldBuilder:Init()
	setupLighting()
	setupCollisionGroups()

	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace
	self.Folder = world

	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end

	local rng = Random.new(1337)
	buildTerrain()
	buildLobby(world)
	buildBunker(world)
	buildMountainExtras(world, rng)
	buildWaterfall(world)
	buildLake(world, rng)
	buildForest(world, rng)
	buildGraveyard(world, rng)
	buildEdge(world)
	buildIslands(world)
	scatterTrees(world, rng)

	for _, pad in WorldBuilder.LaunchPads do
		local debounce = {}
		pad.Part.Touched:Connect(function(hit)
			local player = BuildKit.PlayerFromHit(hit)
			if player and not debounce[player] and BuildKit.IsNear(player, pad.Part) then
				debounce[player] = true
				Remotes.ClientCommand:FireClient(player, "launch", pad.Target)
				task.delay(4, function()
					debounce[player] = nil
				end)
			end
		end)
	end
end

function WorldBuilder:Start()
	if not Config.DayNight.Enabled then
		return
	end
	-- advance the clock twice a second (no need to replicate every frame)
	local speed = 24 / (Config.DayNight.MinutesPerDay * 60)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.5 then
			Lighting.ClockTime = (Lighting.ClockTime + acc * speed) % 24
			acc = 0
		end
	end)
end

return WorldBuilder
]]></string>
